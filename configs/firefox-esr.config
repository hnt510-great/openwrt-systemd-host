# Firefox ESR additions for the existing x86_64/glibc desktop profile.
# Merge with scripts/kconfig.pl +, then run make defconfig.
CONFIG_BUILD_PATENTED=y
CONFIG_PACKAGE_audio-support=y
CONFIG_PACKAGE_noto-sans-cjk-sc=y
CONFIG_PACKAGE_kmod-sound-core=y
CONFIG_PACKAGE_libX11=y
CONFIG_PACKAGE_libXau=y
CONFIG_PACKAGE_libXcomposite=y
CONFIG_PACKAGE_libXcursor=y
CONFIG_PACKAGE_libXdamage=y
CONFIG_PACKAGE_libXdmcp=y
CONFIG_PACKAGE_libXext=y
CONFIG_PACKAGE_libXfixes=y
CONFIG_PACKAGE_libXi=y
CONFIG_PACKAGE_libXrandr=y
CONFIG_PACKAGE_libXrender=y
CONFIG_PACKAGE_libxcb=y
CONFIG_PACKAGE_alsa-lib=y
CONFIG_PACKAGE_libffmpeg=y
CONFIG_FFMPEG_LIBX264=y
CONFIG_PACKAGE_libopus=y
CONFIG_PACKAGE_libx264=y
CONFIG_PACKAGE_lame-lib=y
CONFIG_PACKAGE_firefox-esr-bin=y
