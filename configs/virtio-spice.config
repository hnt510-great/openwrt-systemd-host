# Graphics settings for an existing x86_64/glibc native-systemd profile.
# Merge with scripts/kconfig.pl +, then run make defconfig.
CONFIG_PACKAGE_accel-support=y
CONFIG_PACKAGE_json-glib=y
CONFIG_PACKAGE_libglvnd=y
CONFIG_PACKAGE_libgst1audio=y
CONFIG_PACKAGE_libgst1tag=y
# CONFIG_PACKAGE_libmesa-amd is not set
# CONFIG_PACKAGE_libmesa-intel is not set
# CONFIG_PACKAGE_libmesa-llvmpipe is not set
# CONFIG_PACKAGE_libmesa-nouveau is not set
# CONFIG_PACKAGE_libmesa-softpipe is not set
# CONFIG_PACKAGE_libmesa-virgl is not set
CONFIG_PACKAGE_libmesa-virtualization=y
# CONFIG_PACKAGE_libmesa-zink is not set
CONFIG_PACKAGE_libspice-server=y
CONFIG_PACKAGE_spice-gtk=y
CONFIG_QEMU_OPENGL=y
CONFIG_QEMU_UI_SPICE=y
CONFIG_QEMU_UI_VNC=y
CONFIG_QEMU_VIRGLRENDERER=y
CONFIG_MESA_USE_LLVM=y
CONFIG_PACKAGE_libvirt-daemon=y
CONFIG_PACKAGE_virsh=y
CONFIG_PACKAGE_virt-install=y
CONFIG_PACKAGE_virt-manager=y
CONFIG_PACKAGE_qemu-x86_64-softmmu=y
