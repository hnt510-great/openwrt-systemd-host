# Optional Konsole terminal emulator with its full desktop feature set.
#
# Konsole is a KDE Gear application and needs the Qt6 desktop stack plus the
# KDE Frameworks 6 modules it links against.  This fragment is deliberately
# not part of the default desktop snapshot: merge it by hand when a build or
# image should contain Konsole.
#
#   ./scripts/kconfig.pl + .config configs/konsole.config > .config.new
#   mv .config.new .config
#   make defconfig

# Qt 6 base modules and platform/input plugins
CONFIG_PACKAGE_qt6base-concurrent=y
CONFIG_PACKAGE_qt6base-core=y
CONFIG_PACKAGE_qt6base-gui=y
CONFIG_PACKAGE_qt6base-widgets=y
CONFIG_PACKAGE_qt6base-network=y
CONFIG_PACKAGE_qt6base-xml=y
CONFIG_PACKAGE_qt6base-dbus=y
CONFIG_PACKAGE_qt6base-printsupport=y
CONFIG_PACKAGE_qt6base-plugin-platforms-xcb=y
CONFIG_PACKAGE_qt6base-plugin-inputcontexts-ibus=y
CONFIG_PACKAGE_qt6svg=y

# Qt Quick, needed by KNewStuff's build requirements and the QML package
CONFIG_PACKAGE_qt6quick=y
CONFIG_PACKAGE_qt6quick-widgets=y

# Native Wayland and the Qt platform plugin
CONFIG_PACKAGE_qt6waylandclient=y

# Multimedia (FFmpeg/PulseAudio) for iTerm2 inline audio
CONFIG_PACKAGE_libffmpeg=y
CONFIG_PACKAGE_libpulse=y
CONFIG_PACKAGE_qt6multimedia=y
CONFIG_PACKAGE_qt6multimedia-widgets=y

# Text-to-speech through Flite
CONFIG_PACKAGE_libflite=y
CONFIG_PACKAGE_qt6speech=y

# Spell checking through Hunspell
CONFIG_PACKAGE_hunspell=y
CONFIG_PACKAGE_hunspell-en=y

# utmp/wtmp login accounting
CONFIG_PACKAGE_libutempter=y

# Qt xcb plugin dependencies
CONFIG_PACKAGE_libxcb-image=y
CONFIG_PACKAGE_libxcb-keysyms=y
CONFIG_PACKAGE_libxcb-render-util=y
CONFIG_PACKAGE_libxcb-wm=y
CONFIG_PACKAGE_libxcb-cursor=y
CONFIG_PACKAGE_libxkbcommon-x11=y

# Fcitx5 Qt6 input method module for CJK input in Qt applications
CONFIG_PACKAGE_fcitx5=y
CONFIG_PACKAGE_fcitx5-qt=y

# KDE Frameworks 6
CONFIG_PACKAGE_kf6-attica=y
CONFIG_PACKAGE_kf6-breeze-icons=y
CONFIG_PACKAGE_kf6-karchive=y
CONFIG_PACKAGE_kf6-kcmutils=y
CONFIG_PACKAGE_kf6-kbookmarks=y
CONFIG_PACKAGE_kf6-kcodecs=y
CONFIG_PACKAGE_kf6-kcolorscheme=y
CONFIG_PACKAGE_kf6-kcompletion=y
CONFIG_PACKAGE_kf6-kconfig=y
CONFIG_PACKAGE_kf6-kconfigwidgets=y
CONFIG_PACKAGE_kf6-kcoreaddons=y
CONFIG_PACKAGE_kf6-kcrash=y
CONFIG_PACKAGE_kf6-kdbusaddons=y
CONFIG_PACKAGE_kf6-kglobalaccel=y
CONFIG_PACKAGE_kf6-kguiaddons=y
CONFIG_PACKAGE_kf6-ki18n=y
CONFIG_PACKAGE_kf6-kirigami=y
CONFIG_PACKAGE_kf6-kiconthemes=y
CONFIG_PACKAGE_kf6-kio=y
CONFIG_PACKAGE_kf6-kitemviews=y
CONFIG_PACKAGE_kf6-kjobwidgets=y
CONFIG_PACKAGE_kf6-knewstuff=y
CONFIG_PACKAGE_kf6-knotifications=y
CONFIG_PACKAGE_kf6-knotifyconfig=y
CONFIG_PACKAGE_kf6-kpackage=y
CONFIG_PACKAGE_kf6-kparts=y
CONFIG_PACKAGE_kf6-kpty=y
CONFIG_PACKAGE_kf6-kservice=y
CONFIG_PACKAGE_kf6-ktextwidgets=y
CONFIG_PACKAGE_kf6-kwidgetsaddons=y
CONFIG_PACKAGE_kf6-kwindowsystem=y
CONFIG_PACKAGE_kf6-kxmlgui=y
CONFIG_PACKAGE_kf6-solid=y
CONFIG_PACKAGE_kf6-sonnet=y

CONFIG_PACKAGE_konsole=y
