# Flatpak additions for the existing x86_64/glibc native-systemd desktop.
# Merge with scripts/kconfig.pl +, then run make defconfig.
CONFIG_PACKAGE_appstream=y
CONFIG_PACKAGE_flatpak=y
CONFIG_PACKAGE_libarchive=y
CONFIG_PACKAGE_libfyaml=y
CONFIG_PACKAGE_libksba=y
CONFIG_PACKAGE_libnpth=y
CONFIG_PACKAGE_libostree=y
CONFIG_PACKAGE_libpipewire=y
CONFIG_PACKAGE_libxmlb=y
CONFIG_PACKAGE_xdg-desktop-portal=y
CONFIG_PACKAGE_xdg-desktop-portal-gtk=y
CONFIG_PACKAGE_libgst1pbutils=y
CONFIG_PACKAGE_gnupg2=y
CONFIG_PACKAGE_gnupg2-utils=y
CONFIG_PACKAGE_fuse3-utils=y
CONFIG_FUSE3_UTILS_SETUID=y
CONFIG_PACKAGE_bubblewrap=y
CONFIG_PACKAGE_openwrt-flatpak=y
CONFIG_PACKAGE_xdg-dbus-proxy=y
