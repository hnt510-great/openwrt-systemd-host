# Headless QEMU/KVM, libvirt, CLI tools, and LuCI management without desktop dependencies.
# Merge with scripts/kconfig.pl + on top of configs/x86-64-systemd-router.config, then run make defconfig.
CONFIG_PACKAGE_libvirt-daemon=y
CONFIG_PACKAGE_virsh=y
CONFIG_PACKAGE_virt-install=y
CONFIG_PACKAGE_qemu-x86_64-softmmu=y
CONFIG_PACKAGE_luci-app-qemu=y
