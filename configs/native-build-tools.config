# Target-native GCC kernel builds, including host-tool development headers.
CONFIG_PACKAGE_gcc=y
CONFIG_PACKAGE_binutils=y
CONFIG_PACKAGE_make=y
CONFIG_PACKAGE_native-libs-dev=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_git=y
CONFIG_PACKAGE_git-http=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_perl=y
CONFIG_PACKAGE_perlbase-getopt=y
CONFIG_PACKAGE_perlbase-file=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_zstd=y
CONFIG_PACKAGE_flex=y
CONFIG_PACKAGE_bison=y
CONFIG_PACKAGE_bc=y
CONFIG_PACKAGE_pahole=y
