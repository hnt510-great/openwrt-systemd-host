  "components": [
    {
      "id": "gnome",
      "label": "GNOME Desktop",
      "description": "GNOME Wayland desktop, core apps, and browsers (Firefox ESR, Chrome)",
      "depends": [],
      "default": true,
      "packages": [
        "openwrt-desktop-core",
        "firefox-esr-bin",
        "google-chrome-bin",
        "gstreamer1-plugins-base",
        "libva-utils",
        "intel-gpu-tools",
        "libseat",
        "libneatvnc"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-desktop-base",
        "openwrt-desktop-core",
        "openwrt-desktop",
        "gnome-shell",
        "firefox-esr-bin",
        "google-chrome-bin"
      ]
    },
    {
      "id": "audio",
      "label": "Desktop Audio",
      "description": "PipeWire, WirePlumber, PulseAudio/ALSA audio integration",
      "depends": [
        "gnome"
      ],
      "default": true,
      "packages": [
        "openwrt-desktop-audio"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-desktop-audio",
        "wireplumber",
        "pipewire-pulse"
      ]
    },
    {
      "id": "ime",
      "label": "Chinese IME",
      "description": "Fcitx5, Pinyin, CJK fonts, and GNOME Kimpanel integration",
      "depends": [
        "gnome"
      ],
      "default": true,
      "packages": [
        "openwrt-desktop-ime"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-desktop-ime",
        "openwrt-desktop-ime-base",
        "fcitx5"
      ]
    },
    {
      "id": "rdp",
      "label": "Remote Desktop (RDP)",
