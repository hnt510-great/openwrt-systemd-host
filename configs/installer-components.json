      "depends": [],
      "default": true,
      "packages": [
        "libvirt-daemon",
        "virsh",
        "virt-install",
        "qemu-x86_64-softmmu",
        "qemu-bridge-helper",
        "virtio-console-helper",
        "luci-app-qemu",
        "luci-i18n-qemu-zh-cn"
      ],
      "conditional_packages": [
        {
          "when_all": [
            "gnome"
          ],
          "packages": [
            "virt-manager"
          ]
        }
      ],
      "forbidden_when_unselected": [
        "libvirt-daemon",
        "qemu-x86_64-softmmu",
        "virt-manager",
        "luci-app-qemu"
      ]
    },
    {
      "id": "containers",
