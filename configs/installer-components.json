      "depends": [
        "gnome"
      ],
      "default": true,
      "packages": [
        "openwrt-desktop-rdp",
        "winpr-hash"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-desktop-rdp",
        "gnome-remote-desktop"
      ]
    },
    {
      "id": "sunshine",
      "label": "Sunshine Streaming",
      "description": "Moonlight game/desktop streaming host",
      "depends": [
        "gnome",
        "audio"
      ],
      "default": true,
      "packages": [
        "sunshine"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "sunshine"
      ]
    },
    {
      "id": "flatpak",
      "label": "Flatpak",
      "description": "Ordinary-user Flatpak runtime and desktop portal integration",
      "depends": [
        "gnome"
      ],
      "default": true,
      "packages": [
        "openwrt-flatpak"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-flatpak",
        "openwrt-flatpak-base",
        "flatpak"
      ]
    },
    {
      "id": "appimage",
      "label": "AppImage",
      "description": "FUSE and host library support for x86_64 AppImages",
      "depends": [
        "gnome"
      ],
      "default": true,
      "packages": [
        "openwrt-appimage"
      ],
      "conditional_packages": [],
      "forbidden_when_unselected": [
        "openwrt-appimage"
      ]
    },
    {
      "id": "virtualization",
      "label": "Virtualization (KVM/QEMU)",
