# Core GNOME Wayland desktop with LAN RDP and xdg-desktop-portal (without Flatpak).
# Merge with scripts/kconfig.pl + on top of configs/x86-64-systemd-router.config, then run make defconfig.
# Add configs/flatpak.config (or CONFIG_PACKAGE_openwrt-flatpak=y) separately if Flatpak runtime is desired.
CONFIG_PACKAGE_audio-support=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_gstreamer1-libs=y
CONFIG_PACKAGE_gstreamer1-plugins-base=y
CONFIG_PACKAGE_openwrt-desktop=y
CONFIG_KERNEL_PREEMPT=y
# CONFIG_KERNEL_PREEMPT_NONE is not set
CONFIG_KERNEL_RT_GROUP_SCHED_DEFAULT_DISABLED=y
