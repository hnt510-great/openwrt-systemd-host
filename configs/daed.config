# daed (dae eBPF transparent proxy with its web dashboard) for the x86-64
# native-systemd image. Merge into the existing .config, then run make defconfig.
# The kernel options change the kernel ABI and need a new kernel generation.
# See docs/daed.md.

# Kernel BTF for BPF CO-RE. Full DWARF is required to generate it.
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_MODULE_ALLOW_BTF_MISMATCH=y

# SOCKMAP/SOCKHASH for the in-kernel TCP relay, and the netkit link device.
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_NETKIT=y

# Datapath, tc BPF classifier and geodata shared with v2ray-geoip/geosite.
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_daed=y
CONFIG_PACKAGE_daed-geoip=y
CONFIG_PACKAGE_daed-geosite=y
