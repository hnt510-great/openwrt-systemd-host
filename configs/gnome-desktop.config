# Merge this fragment into an x86_64/glibc native-systemd configuration.
# GNOME replaces Weston; VNC and the old launcher are excluded.
CONFIG_OPENWRT_SYSTEMD=y
CONFIG_PACKAGE_systemd-udev=y
CONFIG_PACKAGE_libudev-systemd=y
# CONFIG_PACKAGE_libudev-zero is not set
# CONFIG_PACKAGE_weston is not set
# CONFIG_PACKAGE_seatd is not set
# CONFIG_PACKAGE_openwrt-desktop-launcher is not set
# CONFIG_WESTON_VNC is not set
# CONFIG_WESTON_RDP is not set
CONFIG_PACKAGE_openwrt-desktop=y
CONFIG_PACKAGE_openwrt-desktop-ime=y
CONFIG_PACKAGE_openwrt-desktop-audio=y
CONFIG_PACKAGE_sunshine=y
CONFIG_PACKAGE_openwrt-flatpak=y
CONFIG_PACKAGE_openwrt-appimage=y
CONFIG_PACKAGE_gnome-shell=y
# Use one GLVND-compatible Mesa provider for GNOME and Xwayland.
# CONFIG_PACKAGE_libmesa-softpipe is not set
CONFIG_PACKAGE_libmesa-virtualization=y
CONFIG_PACKAGE_libgio-gnutls=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_gnome-session=y
CONFIG_PACKAGE_gnome-settings-daemon=y
CONFIG_PACKAGE_gnome-control-center=y
CONFIG_PACKAGE_gnome-remote-desktop=y
CONFIG_PACKAGE_xdg-desktop-portal-gnome=y
CONFIG_PACKAGE_gvfs=y
CONFIG_PACKAGE_nautilus=y
CONFIG_PACKAGE_gnome-terminal=y
CONFIG_PACKAGE_gnome-tweaks=y
CONFIG_PACKAGE_wl-clipboard=y
CONFIG_PACKAGE_resources=y
CONFIG_PACKAGE_gnome-text-editor=y
CONFIG_PACKAGE_loupe=y
CONFIG_PACKAGE_gnome-calculator=y
CONFIG_PACKAGE_baobab=y
CONFIG_PACKAGE_file-roller=y
CONFIG_PACKAGE_evince=y
CONFIG_PACKAGE_gnome-keyring=y
CONFIG_PACKAGE_gnome-shell-extension-kimpanel=y
CONFIG_PACKAGE_rtkit=y
# Desktop latency baseline (docs/gnome-desktop.md): full dynamic preemption
# and cgroup v2 RT scheduling for rtkit, PipeWire and Mutter.
CONFIG_KERNEL_PREEMPT=y
# CONFIG_KERNEL_PREEMPT_NONE is not set
CONFIG_KERNEL_RT_GROUP_SCHED_DEFAULT_DISABLED=y

# First-run LuCI enrollment for the ordinary-user desktop.
CONFIG_PACKAGE_luci-app-desktop-setup=y
CONFIG_PACKAGE_luci-i18n-desktop-setup-zh-cn=y
