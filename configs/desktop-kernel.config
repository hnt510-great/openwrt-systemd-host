# Desktop kernel additions for the x86-64 native-systemd image.
# Merge into the existing .config, then run make defconfig.
# CONFIG_KVM_HYPERV=y is kept in target/linux/x86/64/config-6.18.

# VM host acceleration, virtual sockets and IOMMU-backed device access.
CONFIG_PACKAGE_kmod-vhost-net=y
CONFIG_PACKAGE_kmod-vhost-vsock=y
CONFIG_PACKAGE_kmod-vsock-virtio=y
CONFIG_PACKAGE_kmod-vfio-pci=y
CONFIG_PACKAGE_kmod-fs-9p=y

# Desktop memory management, accounting and runtime diagnostics.
CONFIG_PACKAGE_kmod=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_KERNEL_TASKSTATS=y
CONFIG_KERNEL_PSI=y
CONFIG_KERNEL_PROC_PAGE_MONITOR=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_HUGETLB_PAGE=y
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE=y
CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_PACKAGE_kmod-ikconfig=y

# HDA analog/HDMI audio, USB sound and MIDI.
CONFIG_PACKAGE_kmod-sound-hda-core=y
CONFIG_PACKAGE_kmod-sound-hda-intel=y
CONFIG_PACKAGE_kmod-sound-hda-codec-realtek=y
CONFIG_PACKAGE_kmod-sound-hda-codec-cmedia=y
CONFIG_PACKAGE_kmod-sound-hda-codec-analog=y
CONFIG_PACKAGE_kmod-sound-hda-codec-idt=y
CONFIG_PACKAGE_kmod-sound-hda-codec-cirrus=y
CONFIG_PACKAGE_kmod-sound-hda-codec-conexant=y
CONFIG_PACKAGE_kmod-sound-hda-codec-via=y
CONFIG_PACKAGE_kmod-sound-hda-codec-hdmi=y
CONFIG_PACKAGE_kmod-sound-seq=y
CONFIG_PACKAGE_kmod-usb-audio=y

# Keyboard, mouse, touch, gamepad and userspace-created input devices.
CONFIG_PACKAGE_kmod-hid-generic=y
CONFIG_PACKAGE_kmod-hid-multitouch=y
CONFIG_PACKAGE_kmod-input-joydev=y
CONFIG_PACKAGE_kmod-input-uinput=y
CONFIG_PACKAGE_kmod-input-mouse-ps2=y
CONFIG_PACKAGE_kmod-uhid=y

# USB Bluetooth, common firmware, radio switches and UVC webcams.
CONFIG_USE_RFKILL=y
CONFIG_PACKAGE_kmod-rfkill=y
CONFIG_PACKAGE_kmod-btusb=y
CONFIG_PACKAGE_ibt-firmware=y
CONFIG_PACKAGE_rtl8761bu-firmware=y
CONFIG_PACKAGE_kmod-video-core=y
CONFIG_PACKAGE_kmod-video-uvc=y

# Intel wireless adapters commonly found in x86 PCs.
CONFIG_PACKAGE_kmod-iwlwifi=y
CONFIG_PACKAGE_iwlwifi-firmware-iwl7265d=y
CONFIG_PACKAGE_iwlwifi-firmware-iwl8265=y
CONFIG_PACKAGE_iwlwifi-firmware-iwl9260=y
CONFIG_PACKAGE_iwlwifi-firmware-ax200=y
CONFIG_PACKAGE_iwlwifi-firmware-ax201=y
CONFIG_PACKAGE_iwlwifi-firmware-ax210=y
CONFIG_PACKAGE_iwlwifi-firmware-ax411=y
CONFIG_PACKAGE_iwlwifi-firmware-be200=y

# Removable media, disk images, device mapper and network filesystem clients.
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-nbd=y
CONFIG_PACKAGE_kmod-dm=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_kmod-scsi-cdrom=y
CONFIG_PACKAGE_kmod-iosched-bfq=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-udf=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-nfs-v3=y
CONFIG_PACKAGE_kmod-fs-nfs-v4=y

# USB serial, printers and common Ethernet dongles.
CONFIG_PACKAGE_printer-support=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# PC and disk temperature monitoring.
CONFIG_PACKAGE_kmod-hwmon-drivetemp=y
CONFIG_PACKAGE_kmod-hwmon-nct6775=y
CONFIG_PACKAGE_kmod-hwmon-it87=y
