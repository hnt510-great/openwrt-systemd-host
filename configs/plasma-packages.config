# Build KDE Plasma 6.8.3, KF6 6.32.0, Qt 6.11.3, Dolphin, and KRdp as optional APKs
# without preinstalling Plasma into the base image rootfs.
CONFIG_PACKAGE_openwrt-desktop-plasma-core=m
CONFIG_PACKAGE_openwrt-desktop-plasma=m
CONFIG_PACKAGE_openwrt-desktop-plasma-rdp=m
CONFIG_PACKAGE_openwrt-desktop-keyring=m
CONFIG_PACKAGE_openwrt-desktop-rdp-base=m
CONFIG_PACKAGE_openwrt-desktop-ime-plasma=m
CONFIG_PACKAGE_systemsettings=m
CONFIG_PACKAGE_kscreen=m
CONFIG_PACKAGE_dolphin=m
CONFIG_PACKAGE_plasma-pa=m
CONFIG_PACKAGE_krdp=m
CONFIG_PACKAGE_ocean-sound-theme=m
CONFIG_PACKAGE_plasma-workspace-wallpapers=m
