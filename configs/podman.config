# Rootless Podman container runtime and LuCI management for x86_64/glibc native-systemd profiles.
# Merge with scripts/kconfig.pl + on top of configs/x86-64-systemd-router.config, then run make defconfig.
# Note: configure container firewall zones separately when container traffic routing is desired.
CONFIG_PACKAGE_podman=y
CONFIG_PACKAGE_openwrt-podman-rootless=y
CONFIG_PACKAGE_luci-app-podman=y
