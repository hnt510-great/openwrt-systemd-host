# Preinstall KDE Plasma 6.8.3 daily desktop and LAN KRdp into the image rootfs.
CONFIG_BUILD_qt6base-gui_OPENGL_OPENGLES2=y
# CONFIG_BUILD_qt6base-gui_OPENGL_NONE is not set
CONFIG_BUILD_qt6base_SQL=y
CONFIG_PACKAGE_openwrt-desktop-plasma=y
CONFIG_PACKAGE_openwrt-desktop-plasma-rdp=y
CONFIG_PACKAGE_luci-app-desktop=y
CONFIG_PACKAGE_ocean-sound-theme=y
CONFIG_PACKAGE_plasma-workspace-wallpapers=y
