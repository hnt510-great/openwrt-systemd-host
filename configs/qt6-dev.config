# On-device C++ development with Qt 6.
#
# Installs the Qt Base, Quick/QML, SVG, Multimedia, TextToSpeech and Wayland
# client headers, pkg-config/CMake metadata and qmake, plus the QML and
# Linguist tools. Qt SQL (with the SQLite driver) and OpenGL ES are enabled
# in the Qt build so their development files are available too.
# native-libs-dev supplies the common graphics headers that Qt applications
# and Qt itself need when built from source.

CONFIG_PACKAGE_native-libs-dev=y
CONFIG_PACKAGE_qt6base-dev=y
CONFIG_BUILD_qt6base_SQL=y
CONFIG_PACKAGE_qt6base-sql=y
CONFIG_PACKAGE_qt6base-plugin-sqldrivers-sqlite=y
CONFIG_BUILD_qt6base-gui_OPENGL_OPENGLES2=y
CONFIG_PACKAGE_qt6base-opengl=y
CONFIG_PACKAGE_qt6base-openglwidgets=y
CONFIG_PACKAGE_qt6tools=y
CONFIG_PACKAGE_qt6quick-tools=y
CONFIG_PACKAGE_qt6quick-dev=y
CONFIG_PACKAGE_qt6svg-dev=y
CONFIG_PACKAGE_qt6multimedia-dev=y
CONFIG_PACKAGE_qt6speech-dev=y
CONFIG_PACKAGE_qt6waylandclient-dev=y
CONFIG_PACKAGE_wayland-scanner=y
