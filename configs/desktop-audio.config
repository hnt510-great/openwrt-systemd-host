# Desktop sound and remote audio; merge with the existing configuration.
CONFIG_PACKAGE_openwrt-desktop-audio=y
CONFIG_PACKAGE_pipewire=y
CONFIG_PACKAGE_pipewire-pulse=y
CONFIG_PACKAGE_pipewire-alsa=y
CONFIG_PACKAGE_pipewire-tools=y
CONFIG_PACKAGE_wireplumber=y
CONFIG_PACKAGE_libpulse=y
CONFIG_PACKAGE_pulseaudio-tools=y
CONFIG_WESTON_RDP_AUDIO=y
CONFIG_PACKAGE_sunshine=y
