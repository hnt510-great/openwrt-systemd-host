+endmenu
+
+# Keep library prerequisites out of the QEMU package guard, as above.
+menu "QEMU audio configuration"
+
+config QEMU_AUDIO_PIPEWIRE
+	bool "QEMU native PipeWire audio support"
+	default n
+	depends on TARGET_x86_64 && USE_GLIBC && OPENWRT_SYSTEMD
+	help
+	  Connect guest sound devices directly to a host PipeWire server.
+	  Configure the audio backend and runtime directory per virtual machine.
+	  SPICE console audio works independently of this option.
+
 endmenu
 endef
 
