diff --git a/libs/avahi/files/avahi-daemon-package b/libs/avahi/files/avahi-daemon-package
new file mode 100644
index 000000000..955c23af0
--- /dev/null
+++ b/libs/avahi/files/avahi-daemon-package
@@ -0,0 +1,40 @@
+#!/bin/sh
+set -eu
+
+root=${IPKG_INSTROOT:-}
+case "${1:-}" in
+postinst)
+	if [ -n "$root" ]; then
+		if [ "${PKG_UPGRADE:-0}" != 1 ]; then
+			if [ "$(readlink "$root/etc/systemd/system/avahi-daemon.service" 2>/dev/null || :)" != /dev/null ]; then
+				wants=$root/etc/systemd/system/multi-user.target.wants
+				mkdir -p "$wants"
+				if [ ! -e "$wants/avahi-daemon.service" ] && [ ! -L "$wants/avahi-daemon.service" ]; then
+					ln -s /usr/lib/systemd/system/avahi-daemon.service "$wants/avahi-daemon.service"
+				fi
+			fi
+		fi
+		exit 0
+	fi
+	[ -d /run/systemd/system ] || exit 0
+	systemctl daemon-reload
+	for mask in /etc/systemd/system/avahi-daemon.service /run/systemd/system/avahi-daemon.service; do
+		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
+	done
+	if [ "${PKG_UPGRADE:-0}" != 1 ]; then
+		systemctl enable avahi-daemon.service
+		systemctl --no-block start avahi-daemon.service
+	else
+		systemctl try-restart avahi-daemon.service
+	fi
+	;;
+prerm)
+	[ -z "$root" ] && [ -d /run/systemd/system ] || exit 0
+	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
+	systemctl stop avahi-daemon.service
+	systemctl disable avahi-daemon.service
+	;;
+*)
+	exit 2
+	;;
+esac
diff --git a/libs/avahi/files/avahi-daemon-systemd b/libs/avahi/files/avahi-daemon-systemd
new file mode 100644
index 000000000..819df1851
--- /dev/null
+++ b/libs/avahi/files/avahi-daemon-systemd
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Native lifecycle adapter; systemd supervises avahi-daemon.
+
+case "$1" in
+start|stop|restart|reload|status|enable|disable)
+	exec systemctl "$1" avahi-daemon.service
+	;;
+running)
+	exec systemctl is-active --quiet avahi-daemon.service
+	;;
+enabled)
+	exec systemctl is-enabled --quiet avahi-daemon.service
+	;;
+*)
+	exit 2
+	;;
+esac
