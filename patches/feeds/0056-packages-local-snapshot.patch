diff --git a/utils/qemu/patches/0006-spice-avoid-broken-input-cleanup.patch b/utils/qemu/patches/0006-spice-avoid-broken-input-cleanup.patch
new file mode 100644
index 000000000..069782b08
--- /dev/null
+++ b/utils/qemu/patches/0006-spice-avoid-broken-input-cleanup.patch
@@ -0,0 +1,25 @@
+Subject: ui/spice: avoid freeing unsupported input interfaces on shutdown
+
+Based on Fiona Ebner's Proxmox workaround for released spice-server versions
+without upstream c3efe69e (inputs: Fix keyboard and mouse state leaks on
+interface removal). Removing mouse/keyboard returns an error but QEMU frees
+the callback structures anyway, causing use-after-free in server teardown.
+Keep those interfaces alive until process exit as QEMU before 11.1 did.
+
+Reference: https://git.proxmox.com/?p=pve-qemu.git;a=blob_plain;f=debian/patches/pve/0046-ui-spice-core-work-around-broken-input-cleanup-in-li.patch;hb=HEAD
+
+--- a/ui/spice-core.c
++++ b/ui/spice-core.c
+@@ -1016,7 +1016,11 @@
+     }
+ 
+     qemu_spice_display_cleanup();
+-    qemu_spice_input_cleanup();
++    /* Released spice-server versions cannot detach keyboard/mouse inputs.
++     * Keep their callbacks alive until spice_server_destroy() below.
++     * QEMU 11.1 added this cleanup; older QEMU also left inputs attached.
++     * See Proxmox's workaround for spice-server <= 0.16.0.
++     */
+     migration_remove_notifier(&migration_state);
+     g_clear_pointer(&spice_consoles, g_slist_free);
+     g_clear_pointer(&auth_passwd, g_free);
diff --git a/utils/qemu/patches/0007-util-fdmon-io_uring-disable-iowait.patch b/utils/qemu/patches/0007-util-fdmon-io_uring-disable-iowait.patch
new file mode 100644
index 000000000..948793e36
--- /dev/null
+++ b/utils/qemu/patches/0007-util-fdmon-io_uring-disable-iowait.patch
@@ -0,0 +1,41 @@
+Subject: util/fdmon-io_uring: disable kernel iowait accounting for event loop
+
+QEMU's fdmon-io_uring AioContext event loop submits IORING_OP_POLL_ADD
+requests that remain inflight while waiting for guest/host events. When
+io_uring_enter() is called without IORING_ENTER_NO_IOWAIT, io_cqring_wait()
+sees inflight requests and marks the sleeping iothread with in_iowait = 1,
+inflating per-CPU iowait and PSI IO pressure even when no block I/O is
+occurring.
+
+Detect liburing's io_uring_set_iowait() in meson.build and disable iowait
+accounting on fdmon_io_uring rings during setup.
+
+--- a/meson.build
++++ b/meson.build
+@@ -2713,6 +2713,8 @@ if linux_io_uring.found()
+                        cc.has_header_symbol('liburing.h', 'io_uring_prep_writev2'))
+   config_host_data.set('HAVE_IO_URING_CQ_HAS_OVERFLOW',
+                        cc.has_header_symbol('liburing.h', 'io_uring_cq_has_overflow'))
++  config_host_data.set('HAVE_IO_URING_SET_IOWAIT',
++                       cc.has_header_symbol('liburing.h', 'io_uring_set_iowait'))
+ endif
+ config_host_data.set('HAVE_TCP_KEEPCNT',
+                      cc.has_header_symbol('netinet/tcp.h', 'TCP_KEEPCNT') or
+--- a/util/fdmon-io_uring.c
++++ b/util/fdmon-io_uring.c
+@@ -476,6 +476,15 @@ bool fdmon_io_uring_setup(AioContext *ct
+         return false;
+     }
+ 
++#ifdef HAVE_IO_URING_SET_IOWAIT
++    /*
++     * Polling eventfds with IORING_OP_POLL_ADD keeps inflight io_uring
++     * requests active while idle, causing Linux to account idle CPU time
++     * and PSI IO stalls as iowait unless IORING_ENTER_NO_IOWAIT is set.
++     */
++    (void)io_uring_set_iowait(&ctx->fdmon_io_uring, false);
++#endif
++
+     QSLIST_INIT(&ctx->submit_list);
+     QSIMPLEQ_INIT(&ctx->cqe_handler_ready_list);
+     ctx->fdmon_ops = &fdmon_io_uring_ops;
