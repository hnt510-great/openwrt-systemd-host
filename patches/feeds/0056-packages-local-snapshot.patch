index 000000000..e933d8bda
--- /dev/null
+++ b/libs/avahi/files/avahi-daemon-native.init
@@ -0,0 +1,13 @@
+#!/bin/sh
+# OpenWrt native service adapter
+case "$1" in
+	boot|shutdown|depends) exit 0 ;;
+esac
+if [ -n "${IPKG_INSTROOT:-}" ]; then
+	case "$1" in
+		enabled) exec systemctl --root="$IPKG_INSTROOT" is-enabled avahi-daemon.service ;;
+		enable|disable) exec systemctl --root="$IPKG_INSTROOT" "$1" avahi-daemon.service ;;
+		*) exit 0 ;;
+	esac
+fi
+exec /usr/libexec/avahi-daemon-systemd "$@"
