index 000000000..aab86e530
--- /dev/null
+++ b/utils/ttyd/patches/200-loop-lws-service-for-lws-5.1.patch
@@ -0,0 +1,20 @@
+From: OpenWrt local fix
+Subject: [PATCH] server: loop lws_service() until force_exit for libwebsockets 5.1+
+
+libwebsockets 5.1 changed elops_run_pt_uv() from UV_RUN_DEFAULT to
+UV_RUN_ONCE so each lws_service() call runs a single event-loop turn.
+Loop lws_service() while !force_exit so ttyd stays running until
+SIGINT/SIGTERM or --once triggers force_exit.
+
+--- a/src/server.c
++++ b/src/server.c
+@@ -610,7 +610,8 @@ int main(int argc, char **argv) {
+     uv_signal_start(&signals[i], signal_cb, sig_nums[i]);
+   }
+ 
+-  lws_service(context, 0);
++  while (!force_exit && lws_service(context, 0) >= 0) {
++  }
+ 
+   for (int i = 0; i < sig_count; i++) {
+     uv_signal_stop(&signals[i]);
