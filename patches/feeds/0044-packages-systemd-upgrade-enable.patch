From 5622b544e2418a3e47d61a121322dc5e370b5996 Mon Sep 17 00:00:00 2001
From: hnt510 <hnt510@gmail.com>
Date: Wed, 18 Nov 2026 15:25:56 +0800
Subject: [PATCH] samba4, wsdd2, avahi, nlbwmon: enable systemd units on first
 procd-to-systemd upgrade

---
 libs/avahi/Makefile                   |  2 +-
 libs/avahi/files/avahi-daemon-package | 35 +++++++++++++++-----
 net/nlbwmon/Makefile                  |  2 +-
 net/nlbwmon/files/nlbwmon-package     | 39 +++++++++++++++++-----
 net/samba4/Makefile                   |  2 +-
 net/samba4/files/samba4-package       | 39 +++++++++++++++++-----
 net/wsdd2/Makefile                    |  2 +-
 net/wsdd2/files/wsdd2-package         | 47 +++++++++++++++++++--------
 8 files changed, 125 insertions(+), 43 deletions(-)

diff --git a/libs/avahi/Makefile b/libs/avahi/Makefile
index df0d99881..c0f3763e1 100644
--- a/libs/avahi/Makefile
+++ b/libs/avahi/Makefile
@@ -7,7 +7,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=avahi
 PKG_VERSION:=0.9_rc5
-PKG_RELEASE:=4
+PKG_RELEASE:=5
 
 PKG_SOURCE:=$(PKG_NAME)-0.9-rc5.tar.gz
 PKG_SOURCE_URL:=https://codeload.github.com/avahi/avahi/tar.gz/v0.9-rc5?
diff --git a/libs/avahi/files/avahi-daemon-package b/libs/avahi/files/avahi-daemon-package
index 0b0cd1208..6c2b2c5a2 100644
--- a/libs/avahi/files/avahi-daemon-package
+++ b/libs/avahi/files/avahi-daemon-package
@@ -3,15 +3,31 @@
 set -eu
 
 root=${IPKG_INSTROOT:-}
+stamp=/etc/systemd/openwrt-migrated/avahi-daemon
+
+rc_enabled() {
+	for link in "$1/etc/rc.d/S"[0-9][0-9]avahi-daemon; do
+		if [ -L "$link" ] || [ -x "$link" ]; then
+			return 0
+		fi
+	done
+	return 1
+}
+
 case "${1:-}" in
 postinst)
 	if [ -n "$root" ]; then
-		[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
-		[ "$(readlink "$root/etc/systemd/system/avahi-daemon.service" 2>/dev/null || :)" != /dev/null ] || exit 0
-		wants=$root/etc/systemd/system/multi-user.target.wants
-		mkdir -p "$wants"
-		if [ ! -e "$wants/avahi-daemon.service" ] && [ ! -L "$wants/avahi-daemon.service" ]; then
-			ln -s /usr/lib/systemd/system/avahi-daemon.service "$wants/avahi-daemon.service"
+		if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+		   { [ ! -e "$root$stamp" ] && rc_enabled "$root"; }; then
+			if [ "$(readlink "$root/etc/systemd/system/avahi-daemon.service" 2>/dev/null || :)" != /dev/null ]; then
+				wants=$root/etc/systemd/system/multi-user.target.wants
+				mkdir -p "$wants"
+				if [ ! -e "$wants/avahi-daemon.service" ] && [ ! -L "$wants/avahi-daemon.service" ]; then
+					ln -s /usr/lib/systemd/system/avahi-daemon.service "$wants/avahi-daemon.service"
+				fi
+			fi
+			mkdir -p "$root/etc/systemd/openwrt-migrated"
+			: >"$root$stamp"
 		fi
 		exit 0
 	fi
@@ -20,10 +36,12 @@ postinst)
 	for mask in /etc/systemd/system/avahi-daemon.service /run/systemd/system/avahi-daemon.service; do
 		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
 	done
-	if [ "${PKG_UPGRADE:-0}" != 1 ] &&
-	   [ "$(readlink /etc/systemd/system/avahi-daemon.service 2>/dev/null || :)" != /dev/null ]; then
+	if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+	   { [ ! -e "$stamp" ] && rc_enabled ""; }; then
 		systemctl enable avahi-daemon.service
 	fi
+	mkdir -p /etc/systemd/openwrt-migrated
+	: >"$stamp"
 	systemctl try-restart avahi-daemon.service
 	;;
 prerm)
@@ -31,6 +49,7 @@ prerm)
 	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
 	systemctl stop avahi-daemon.service
 	systemctl disable avahi-daemon.service
+	rm -f "$stamp"
 	;;
 *)
 	exit 2
diff --git a/net/nlbwmon/Makefile b/net/nlbwmon/Makefile
index 198209771..51416721c 100644
--- a/net/nlbwmon/Makefile
+++ b/net/nlbwmon/Makefile
@@ -1,7 +1,7 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=nlbwmon
-PKG_RELEASE:=6
+PKG_RELEASE:=7
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://github.com/jow-/nlbwmon.git
diff --git a/net/nlbwmon/files/nlbwmon-package b/net/nlbwmon/files/nlbwmon-package
index b566cdb72..9ba6e14ff 100644
--- a/net/nlbwmon/files/nlbwmon-package
+++ b/net/nlbwmon/files/nlbwmon-package
@@ -3,16 +3,34 @@
 set -eu
 
 root=${IPKG_INSTROOT:-}
+stamp=/etc/systemd/openwrt-migrated/nlbwmon
+
+rc_enabled() {
+	for link in "$1/etc/rc.d/S"[0-9][0-9]nlbwmon; do
+		if [ -L "$link" ] || [ -x "$link" ]; then
+			return 0
+		fi
+	done
+	return 1
+}
+
 case "${1:-}" in
 postinst)
 	if [ -n "$root" ]; then
-		[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
-		[ "$(readlink "$root/etc/systemd/system/nlbwmon.service" 2>/dev/null || :)" != /dev/null ] || exit 0
-		wants=$root/etc/systemd/system/multi-user.target.wants
-		mkdir -p "$wants"
-		if [ ! -e "$wants/nlbwmon.service" ] && [ ! -L "$wants/nlbwmon.service" ]; then
-			ln -s /usr/lib/systemd/system/nlbwmon.service "$wants/nlbwmon.service"
-			ln -s /usr/lib/systemd/system/nlbwmon-config.path "$wants/nlbwmon-config.path"
+		if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+		   { [ ! -e "$root$stamp" ] && rc_enabled "$root"; }; then
+			if [ "$(readlink "$root/etc/systemd/system/nlbwmon.service" 2>/dev/null || :)" != /dev/null ]; then
+				wants=$root/etc/systemd/system/multi-user.target.wants
+				mkdir -p "$wants"
+				if [ ! -e "$wants/nlbwmon.service" ] && [ ! -L "$wants/nlbwmon.service" ]; then
+					ln -s /usr/lib/systemd/system/nlbwmon.service "$wants/nlbwmon.service"
+				fi
+				if [ ! -e "$wants/nlbwmon-config.path" ] && [ ! -L "$wants/nlbwmon-config.path" ]; then
+					ln -s /usr/lib/systemd/system/nlbwmon-config.path "$wants/nlbwmon-config.path"
+				fi
+			fi
+			mkdir -p "$root/etc/systemd/openwrt-migrated"
+			: >"$root$stamp"
 		fi
 		exit 0
 	fi
@@ -21,10 +39,12 @@ postinst)
 	for mask in /etc/systemd/system/nlbwmon.service /run/systemd/system/nlbwmon.service; do
 		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
 	done
-	if [ "${PKG_UPGRADE:-0}" != 1 ] &&
-	   [ "$(readlink /etc/systemd/system/nlbwmon.service 2>/dev/null || :)" != /dev/null ]; then
+	if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+	   { [ ! -e "$stamp" ] && rc_enabled ""; }; then
 		systemctl enable nlbwmon.service nlbwmon-config.path
 	fi
+	mkdir -p /etc/systemd/openwrt-migrated
+	: >"$stamp"
 	systemctl try-restart nlbwmon.service
 	;;
 prerm)
@@ -32,6 +52,7 @@ prerm)
 	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
 	systemctl stop nlbwmon-config.path nlbwmon-reconfigure.service nlbwmon.service
 	systemctl disable nlbwmon.service nlbwmon-config.path
+	rm -f "$stamp"
 	;;
 *)
 	exit 2
diff --git a/net/samba4/Makefile b/net/samba4/Makefile
index 3defb8b63..c61bf0d26 100644
--- a/net/samba4/Makefile
+++ b/net/samba4/Makefile
@@ -3,7 +3,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=samba
 PKG_VERSION:=4.24.5
-PKG_RELEASE:=9
+PKG_RELEASE:=10
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:= \
diff --git a/net/samba4/files/samba4-package b/net/samba4/files/samba4-package
index 578d08419..2e0d3f28e 100644
--- a/net/samba4/files/samba4-package
+++ b/net/samba4/files/samba4-package
@@ -3,17 +3,35 @@
 set -eu
 
 root=${IPKG_INSTROOT:-}
+stamp=/etc/systemd/openwrt-migrated/samba4
+
+rc_enabled() {
+	for link in "$1/etc/rc.d/S"[0-9][0-9]samba4; do
+		if [ -L "$link" ] || [ -x "$link" ]; then
+			return 0
+		fi
+	done
+	return 1
+}
+
 case "${1:-}" in
 postinst)
 	if [ -n "$root" ]; then
 		# Offline image assembly must not contact the host's service manager.
-		[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
-		[ "$(readlink "$root/etc/systemd/system/samba4.service" 2>/dev/null || :)" != /dev/null ] || exit 0
-		wants=$root/etc/systemd/system/multi-user.target.wants
-		mkdir -p "$wants"
-		if [ ! -e "$wants/samba4.service" ] && [ ! -L "$wants/samba4.service" ]; then
-			ln -s /usr/lib/systemd/system/samba4.service "$wants/samba4.service"
-			ln -s /usr/lib/systemd/system/samba4-config.path "$wants/samba4-config.path"
+		if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+		   { [ ! -e "$root$stamp" ] && rc_enabled "$root"; }; then
+			if [ "$(readlink "$root/etc/systemd/system/samba4.service" 2>/dev/null || :)" != /dev/null ]; then
+				wants=$root/etc/systemd/system/multi-user.target.wants
+				mkdir -p "$wants"
+				if [ ! -e "$wants/samba4.service" ] && [ ! -L "$wants/samba4.service" ]; then
+					ln -s /usr/lib/systemd/system/samba4.service "$wants/samba4.service"
+				fi
+				if [ ! -e "$wants/samba4-config.path" ] && [ ! -L "$wants/samba4-config.path" ]; then
+					ln -s /usr/lib/systemd/system/samba4-config.path "$wants/samba4-config.path"
+				fi
+			fi
+			mkdir -p "$root/etc/systemd/openwrt-migrated"
+			: >"$root$stamp"
 		fi
 		exit 0
 	fi
@@ -24,10 +42,12 @@ postinst)
 	done
 	# Online upgrades stage a procd-to-systemd migration for an explicit reboot.
 	# try-restart preserves inactive/disabled units and cannot start a second owner.
-	if [ "${PKG_UPGRADE:-0}" != 1 ] &&
-	   [ "$(readlink /etc/systemd/system/samba4.service 2>/dev/null || :)" != /dev/null ]; then
+	if [ "${PKG_UPGRADE:-0}" != 1 ] ||
+	   { [ ! -e "$stamp" ] && rc_enabled ""; }; then
 		systemctl enable samba4.service samba4-config.path
 	fi
+	mkdir -p /etc/systemd/openwrt-migrated
+	: >"$stamp"
 	systemctl try-restart samba4.service
 	;;
 prerm)
@@ -35,6 +55,7 @@ prerm)
 	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
 	systemctl stop samba4-config.path samba4-reconfigure.service samba4.service
 	systemctl disable samba4.service samba4-config.path
+	rm -f "$stamp"
 	;;
 *) exit 2 ;;
 esac
diff --git a/net/wsdd2/Makefile b/net/wsdd2/Makefile
index 3ac911ca1..946418d03 100644
