new file mode 100644
index 0000000..4eeedb7
--- /dev/null
+++ b/ddns-go/files/ddns-go-config.sh
@@ -0,0 +1,63 @@
+#!/bin/sh
+# Shared configuration helper for ddns-go.
+
+DDNS_GO_CONFDIR=/etc/ddns-go
+DDNS_GO_CONF=$DDNS_GO_CONFDIR/ddns-go-config.yaml
+
+ddns_go_init_yaml() {
+	[ -d "$DDNS_GO_CONFDIR" ] || mkdir -p "$DDNS_GO_CONFDIR"
+	chown -R ddns-go:ddns-go "$DDNS_GO_CONFDIR"
+	chmod 755 "$DDNS_GO_CONFDIR"
+	[ -f "$DDNS_GO_CONF" ] && chmod 644 "$DDNS_GO_CONF" || :
+}
+
+ddns_go_build_args() {
+	local cfg="$1"
+	local args="-c $DDNS_GO_CONF"
+	local port time ctimes dns noweb skipverify
+
+	config_get port "$cfg" port '9876'
+	case "$port" in
+		*:*) args="$args -l $port" ;;
+		*) args="$args -l :$port" ;;
+	esac
+
+	config_get time "$cfg" time '300'
+	[ -n "$time" ] && args="$args -f $time"
+
+	config_get ctimes "$cfg" ctimes '5'
+	[ -n "$ctimes" ] && args="$args -cacheTimes $ctimes"
+
+	config_get dns "$cfg" dns '223.5.5.5'
+	[ -n "$dns" ] && args="$args -dns $dns"
+
+	config_get_bool noweb "$cfg" noweb 0
+	[ "$noweb" -eq 1 ] && args="$args -noweb"
+
+	config_get_bool skipverify "$cfg" skipverify 0
+	[ "$skipverify" -eq 1 ] && args="$args -skipVerify"
+
+	echo "$args"
+}
+
+ddns_go_read_section() {
+	local cfg="$1"
+	local enabled
+
+	[ -z "$DDNS_GO_SELECTED_CFG" ] || return 0
+	config_get_bool enabled "$cfg" enabled 0
+	[ "$enabled" -eq 1 ] || return 0
+	DDNS_GO_SELECTED_CFG="$cfg"
+	config_get DDNS_GO_DELAY "$cfg" delay 0
+	DDNS_GO_ARGS="$(ddns_go_build_args "$cfg")"
+}
+
+ddns_go_load() {
+	. /lib/functions.sh
+	DDNS_GO_SELECTED_CFG=""
+	DDNS_GO_DELAY=0
+	DDNS_GO_ARGS=""
+	config_load ddns-go
+	config_foreach ddns_go_read_section basic
+	[ -n "$DDNS_GO_SELECTED_CFG" ]
+}
diff --git a/ddns-go/files/ddns-go-native.init b/ddns-go/files/ddns-go-native.init
new file mode 100644
index 0000000..7df377b
--- /dev/null
+++ b/ddns-go/files/ddns-go-native.init
@@ -0,0 +1,13 @@
+#!/bin/sh
+# OpenWrt native service adapter
+case "$1" in
+	boot|shutdown|depends) exit 0 ;;
+esac
+if [ -n "${IPKG_INSTROOT:-}" ]; then
+	case "$1" in
+		enabled) exec systemctl --root="$IPKG_INSTROOT" is-enabled ddns-go.service ;;
+		enable|disable) exec systemctl --root="$IPKG_INSTROOT" "$1" ddns-go.service ;;
+		*) exit 0 ;;
+	esac
+fi
+exec /usr/libexec/ddns-go-systemd "$@"
diff --git a/ddns-go/files/ddns-go-package b/ddns-go/files/ddns-go-package
new file mode 100644
index 0000000..fd03750
--- /dev/null
+++ b/ddns-go/files/ddns-go-package
@@ -0,0 +1,43 @@
+#!/bin/sh
+set -eu
+
+root=${IPKG_INSTROOT:-}
+case "${1:-}" in
+postinst)
+	if [ -n "$root" ]; then
+		if [ "${PKG_UPGRADE:-0}" != 1 ]; then
+			if [ "$(readlink "$root/etc/systemd/system/ddns-go.service" 2>/dev/null || :)" != /dev/null ]; then
+				wants=$root/etc/systemd/system/multi-user.target.wants
+				mkdir -p "$wants"
+				if [ ! -e "$wants/ddns-go.service" ] && [ ! -L "$wants/ddns-go.service" ]; then
+					ln -s /usr/lib/systemd/system/ddns-go.service "$wants/ddns-go.service"
+				fi
+				if [ ! -e "$wants/ddns-go-config.path" ] && [ ! -L "$wants/ddns-go-config.path" ]; then
+					ln -s /usr/lib/systemd/system/ddns-go-config.path "$wants/ddns-go-config.path"
+				fi
+			fi
+		fi
+		exit 0
+	fi
+	[ -d /run/systemd/system ] || exit 0
+	systemctl daemon-reload
+	for mask in /etc/systemd/system/ddns-go.service /run/systemd/system/ddns-go.service; do
+		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
+	done
+	if [ "${PKG_UPGRADE:-0}" != 1 ]; then
+		systemctl enable ddns-go.service ddns-go-config.path
+		systemctl --no-block start ddns-go.service
+	else
+		systemctl try-restart ddns-go.service
+	fi
+	;;
+prerm)
+	[ -z "$root" ] && [ -d /run/systemd/system ] || exit 0
+	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
+	systemctl stop ddns-go-config.path ddns-go-reconfigure.service ddns-go.service
+	systemctl disable ddns-go.service ddns-go-config.path
+	;;
+*)
+	exit 2
+	;;
+esac
