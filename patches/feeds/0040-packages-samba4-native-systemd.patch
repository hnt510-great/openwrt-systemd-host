+++ b/net/samba4/files/samba4.service
@@ -0,0 +1,16 @@
+[Unit]
+Description=Samba configuration and daemon group
+After=network-online.target
+Wants=network-online.target samba4-config.path samba4@smbd.service samba4@nmbd.service samba4@winbindd.service samba4@samba.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+Slice=nas.slice
+ExecStart=/usr/libexec/samba4-systemd prepare
+ExecReload=/usr/libexec/samba4-systemd prepare
+ExecReload=/usr/libexec/samba4-systemd reconcile
+
+[Install]
+WantedBy=multi-user.target
+Also=samba4-config.path
diff --git a/net/samba4/files/samba4@.service b/net/samba4/files/samba4@.service
new file mode 100644
index 000000000..3f5a0505e
--- /dev/null
+++ b/net/samba4/files/samba4@.service
@@ -0,0 +1,18 @@
+[Unit]
+Description=Samba %i daemon
+Requires=samba4.service
+After=samba4.service
+PartOf=samba4.service
+StartLimitIntervalSec=60
+StartLimitBurst=5
+
+[Service]
+Type=simple
+Slice=nas.slice
+ExecCondition=/usr/libexec/samba4-systemd condition %i
+ExecStart=/usr/libexec/samba4-systemd run %i
+Restart=on-failure
+RestartSec=5s
+LimitNOFILE=16384
+KillMode=control-group
+TimeoutStopSec=30s
