diff --git a/net/samba4/files/samba4-package b/net/samba4/files/samba4-package
new file mode 100644
index 000000000..578d08419
--- /dev/null
+++ b/net/samba4/files/samba4-package
@@ -0,0 +1,40 @@
+#!/bin/sh
+# Package lifecycle only; never transfers a running listener out of procd.
+set -eu
+
+root=${IPKG_INSTROOT:-}
+case "${1:-}" in
+postinst)
+	if [ -n "$root" ]; then
+		# Offline image assembly must not contact the host's service manager.
+		[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
+		[ "$(readlink "$root/etc/systemd/system/samba4.service" 2>/dev/null || :)" != /dev/null ] || exit 0
+		wants=$root/etc/systemd/system/multi-user.target.wants
+		mkdir -p "$wants"
+		if [ ! -e "$wants/samba4.service" ] && [ ! -L "$wants/samba4.service" ]; then
+			ln -s /usr/lib/systemd/system/samba4.service "$wants/samba4.service"
+			ln -s /usr/lib/systemd/system/samba4-config.path "$wants/samba4-config.path"
+		fi
+		exit 0
+	fi
+	[ -d /run/systemd/system ] || exit 0
+	systemctl daemon-reload
+	for mask in /etc/systemd/system/samba4.service /run/systemd/system/samba4.service; do
+		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
+	done
+	# Online upgrades stage a procd-to-systemd migration for an explicit reboot.
+	# try-restart preserves inactive/disabled units and cannot start a second owner.
+	if [ "${PKG_UPGRADE:-0}" != 1 ] &&
+	   [ "$(readlink /etc/systemd/system/samba4.service 2>/dev/null || :)" != /dev/null ]; then
+		systemctl enable samba4.service samba4-config.path
+	fi
+	systemctl try-restart samba4.service
+	;;
+prerm)
+	[ -z "$root" ] && [ -d /run/systemd/system ] || exit 0
+	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
+	systemctl stop samba4-config.path samba4-reconfigure.service samba4.service
+	systemctl disable samba4.service samba4-config.path
+	;;
+*) exit 2 ;;
+esac
