@@ -92,6 +92,7 @@ PKG_BUILD_DEPENDS:=qt6base/host BUILD_qt6base-gui_UDEV&&PACKAGE_libudev-systemd:
 	PACKAGE_qt6base-plugin-platforms-xcb:libxcb-cursor \
