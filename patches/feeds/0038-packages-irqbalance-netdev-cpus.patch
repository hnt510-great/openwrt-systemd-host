+--- /dev/null
++++ b/netdev.c
+@@ -0,0 +1,138 @@
++// SPDX-License-Identifier: GPL-2.0-or-later
++#include <errno.h>
++#include <fnmatch.h>
++#include <stdlib.h>
++#include <string.h>
++
++#include "irqbalance.h"
++
++struct netdev_cpu_rule {
++	char *pattern;
++	cpumask_t cpus;
++};
++
++static GList *netdev_cpu_rules;
++
++static int parse_netdev_cpus(const char *text, cpumask_t *mask)
++{
++	char *end;
++	unsigned long first, last, cpu;
++
++	cpus_clear(*mask);
++	for (;;) {
++		if (!g_ascii_isdigit(*text))
++			return -EINVAL;
++		errno = 0;
++		first = strtoul(text, &end, 10);
++		if (errno || first >= NR_CPUS)
++			return -EINVAL;
++		last = first;
++		if (*end == '-') {
++			text = end + 1;
++			if (!g_ascii_isdigit(*text))
++				return -EINVAL;
++			errno = 0;
++			last = strtoul(text, &end, 10);
++			if (errno || last >= NR_CPUS || last < first)
++				return -EINVAL;
++		}
++		for (cpu = first; cpu <= last; cpu++)
++			cpu_set(cpu, *mask);
++		if (!*end)
++			return 0;
++		if (*end != ',' || !end[1])
++			return -EINVAL;
++		text = end + 1;
++	}
++}
++
++int add_netdev_cpu_rule(const char *arg)
++{
++	const char *sep = strchr(arg, ':');
++	struct netdev_cpu_rule *rule;
++
++	if (!sep || sep == arg || !sep[1] ||
++	    strspn(sep + 1, "0123456789,-") != strlen(sep + 1))
++		return -EINVAL;
++	rule = calloc(1, sizeof(*rule));
++	if (!rule)
++		return -ENOMEM;
++	rule->pattern = strndup(arg, sep - arg);
++	if (!rule->pattern) {
++		free(rule);
++		return -ENOMEM;
++	}
++	if (parse_netdev_cpus(sep + 1, &rule->cpus) ||
++	    cpus_empty(rule->cpus)) {
++		free(rule->pattern);
++		free(rule);
++		return -EINVAL;
++	}
++	netdev_cpu_rules = g_list_append(netdev_cpu_rules, rule);
++	return 0;
++}
++
++static void free_netdev_cpu_rule(gpointer data)
++{
++	struct netdev_cpu_rule *rule = data;
++
++	free(rule->pattern);
++	free(rule);
++}
++
++void free_netdev_cpu_rules(void)
++{
++	g_list_free_full(netdev_cpu_rules, free_netdev_cpu_rule);
++	netdev_cpu_rules = NULL;
++}
++
++/* Match sysfs netdevs, not /proc/interrupts labels or fixed IRQ numbers. */
++void apply_netdev_cpu_rules(struct irq_info *info, const char *devpath)
++{
++	char *path;
++	const char *name;
++	GDir *dir;
++	GList *entry;
++
++	if (!netdev_cpu_rules || !devpath || (info->flags & IRQ_FLAG_BANNED))
++		return;
++	path = g_build_filename(devpath, "net", NULL);
++	dir = g_dir_open(path, 0, NULL);
++	g_free(path);
++	if (!dir)
++		return;
++	while ((name = g_dir_read_name(dir))) {
++		for (entry = netdev_cpu_rules; entry; entry = entry->next) {
++			struct netdev_cpu_rule *rule = entry->data;
++
++			if (fnmatch(rule->pattern, name, 0))
++				continue;
++			if (!(info->flags & IRQ_FLAG_CPUSET))
++				cpus_setall(info->allowed_cpus);
++			/* Multiple matching rules/devices restrict, never expand. */
++			cpus_and(info->allowed_cpus, info->allowed_cpus, rule->cpus);
++			info->flags |= IRQ_FLAG_CPUSET;
++		}
++	}
++	g_dir_close(dir);
++}
++
++/* Apply the per-IRQ pool after online filtering, respecting global bans. */
++void restrict_irq_cpu_mask(struct irq_info *info, cpumask_t *mask)
++{
++	if (!(info->flags & IRQ_FLAG_CPUSET))
++		return;
++	cpus_and(*mask, *mask, info->allowed_cpus);
++	cpus_and(*mask, *mask, unbanned_cpus);
++}
++
++int irq_object_allowed(struct irq_info *info, cpumask_t *object_mask)
++{
++	cpumask_t mask;
++
++	if (!(info->flags & IRQ_FLAG_CPUSET))
++		return 1;
++	cpus_and(mask, *object_mask, cpu_online_map);
++	restrict_irq_cpu_mask(info, &mask);
++	return !cpus_empty(mask);
++}
+--- a/placement.c
++++ b/placement.c
+@@ -56,6 +56,9 @@ static void find_best_object(struct topo
+ 	    (!cpus_intersects(d->mask, unbanned_cpus)))
+ 		return;
+ 
++	if (!irq_object_allowed(best->info, &d->mask))
++		return;
++
+ 	if (d->powersave_mode)
+ 		return;
+ 
+@@ -126,12 +129,23 @@ static void place_irq_in_node(struct irq
+ 	if ((info->level == BALANCE_NONE) && cpus_empty(banned_cpus))
+ 		return;
+ 
++	if (!irq_object_allowed(info, &cpu_online_map)) {
++		if (!(info->flags & IRQ_FLAG_CPUSET_WARNED))
++			log(TO_ALL, LOG_WARNING,
++			    "IRQ %d: no online CPU in netdev pool after global bans; "
++			    "affinity unchanged\n", info->irq);
++		info->flags |= IRQ_FLAG_CPUSET_WARNED;
++		return;
++	}
++	info->flags &= ~IRQ_FLAG_CPUSET_WARNED;
++
+ 	if (irq_numa_node(info)->number != NUMA_NO_NODE || !numa_avail) {
+ 		/*
+ 		 * Need to make sure this node is elligible for migration
+ 		 * given the banned cpu list
+ 		 */
+-		if (!cpus_intersects(irq_numa_node(info)->mask, unbanned_cpus)) {
++		if (!cpus_intersects(irq_numa_node(info)->mask, unbanned_cpus) ||
++		    !irq_object_allowed(info, &irq_numa_node(info)->mask)) {
+ 			log(TO_CONSOLE, LOG_WARNING, "There is no suitable CPU in node:%d.\n", irq_numa_node(info)->number);
+ 			log(TO_CONSOLE, LOG_WARNING, "Irqbalance dispatch irq:%d to other node.\n", info->irq);
+ 			goto find_placement;
