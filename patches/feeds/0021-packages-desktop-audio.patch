diff --git a/libs/nlohmannjson/files/nlohmann_jsonConfig.cmake b/libs/nlohmannjson/files/nlohmann_jsonConfig.cmake
new file mode 100644
--- /dev/null
+++ b/libs/nlohmannjson/files/nlohmann_jsonConfig.cmake
@@ -0,0 +1,8 @@
+# Relocatable SDK target for the single-header Meson installation.
+if(NOT TARGET nlohmann_json::nlohmann_json)
+  get_filename_component(_nlohmann_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
+  add_library(nlohmann_json::nlohmann_json INTERFACE IMPORTED GLOBAL)
+  set_target_properties(nlohmann_json::nlohmann_json PROPERTIES
+    INTERFACE_INCLUDE_DIRECTORIES "${_nlohmann_prefix}/include")
+  unset(_nlohmann_prefix)
+endif()
diff --git a/libs/nlohmannjson/files/nlohmann_jsonConfigVersion.cmake b/libs/nlohmannjson/files/nlohmann_jsonConfigVersion.cmake
new file mode 100644
--- /dev/null
+++ b/libs/nlohmannjson/files/nlohmann_jsonConfigVersion.cmake
@@ -0,0 +1,8 @@
+set(PACKAGE_VERSION "3.11.2")
+set(PACKAGE_VERSION_COMPATIBLE FALSE)
+if(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION AND PACKAGE_FIND_VERSION_MAJOR EQUAL 3)
+  set(PACKAGE_VERSION_COMPATIBLE TRUE)
+endif()
+if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
+  set(PACKAGE_VERSION_EXACT TRUE)
+endif()
