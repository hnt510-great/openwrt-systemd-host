+	# On-device builds do not set OpenWrt's cross-build HOSTCC/HOSTCXX vars.
+	$(SED) '/^QMAKE_CC[[:space:]]*=/a\isEmpty(QMAKE_CC): QMAKE_CC = gcc' \
