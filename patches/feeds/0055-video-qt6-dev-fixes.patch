 	[ ! -d $(PKG_INSTALL_DIR)/usr/include/qt6/QtWlShellIntegration ] || \
 		$(CP) $(PKG_INSTALL_DIR)/usr/include/qt6/QtWlShellIntegration $(1)/usr/include/qt6/
 	$(CP) $(PKG_INSTALL_DIR)/usr/lib/cmake/Qt6Wayland* $(1)/usr/lib/cmake/
diff --git a/frameworks/qt6/qt6base/files/mkspecs/linux-openwrt-g++/qmake.conf b/frameworks/qt6/qt6base/files/mkspecs/linux-openwrt-g++/qmake.conf
index 6c768c3..49e3397 100644
--- a/frameworks/qt6/qt6base/files/mkspecs/linux-openwrt-g++/qmake.conf
+++ b/frameworks/qt6/qt6base/files/mkspecs/linux-openwrt-g++/qmake.conf
@@ -22,6 +22,13 @@ QMAKE_CFLAGS           += $$(TARGET_CFLAGS)
 QMAKE_CXXFLAGS         += $$(TARGET_CXXFLAGS)
 QMAKE_LFLAGS           += $$(TARGET_LDFLAGS)
 
+# OpenWrt links Qt shared libraries with -Wl,-Bsymbolic-functions, so Qt
+# applications must be position-independent to avoid PLT-stub mismatches
+# in QObject::connect(&Class::signal, ...).
+QMAKE_CFLAGS_APP       += -fPIE
+QMAKE_CXXFLAGS_APP     += -fPIE
+QMAKE_LFLAGS_APP       += -pie
+
 # modifications to g++.conf
 QMAKE_CC                = $$(TARGET_CROSS)gcc
 QMAKE_CXX               = $$(TARGET_CROSS)g++
