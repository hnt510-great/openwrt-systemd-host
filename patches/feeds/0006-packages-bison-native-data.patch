diff --git a/devel/bison/Makefile b/devel/bison/Makefile
index f68b434..c155a7d 100644
--- a/devel/bison/Makefile
+++ b/devel/bison/Makefile
@@ -6,7 +6,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=bison
 PKG_VERSION:=3.8.2
-PKG_RELEASE:=1
+PKG_RELEASE:=3
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=@GNU/$(PKG_NAME)
@@ -26,6 +26,7 @@ define Package/bison
   CATEGORY:=Development
   TITLE:=bison
   URL:=https://www.gnu.org/software/bison/
+  DEPENDS:=+m4
 endef
 
 define Package/bison/description
@@ -34,11 +35,19 @@ endef
 
 CONFIGURE_ARGS += --enable-threads=posix --disable-nls
 
+define Build/Configure
+	$(call Build/Configure/Default)
+	# Configure uses host m4 for checks; the installed binary needs target m4.
+	$(SED) 's|^#define M4 .*|#define M4 "/usr/bin/m4"|' $(PKG_BUILD_DIR)/lib/config.h
+endef
+
 define Package/bison/install
 	$(INSTALL_DIR) $(1)/usr/bin/
 	$(CP) \
 		$(PKG_INSTALL_DIR)/usr/bin/bison \
 		$(1)/usr/bin/
+	$(INSTALL_DIR) $(1)/usr/share/bison
+	$(CP) $(PKG_INSTALL_DIR)/usr/share/bison/* $(1)/usr/share/bison/
 endef
 
 $(eval $(call BuildPackage,bison))
