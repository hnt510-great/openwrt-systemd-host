From 3d86bfd736f6a2900957359336a268d3b4c331ab Mon Sep 17 00:00:00 2001
From: hnt510 <hnt510@gmail.com>
Date: Wed, 4 Nov 2026 15:09:06 +0800
Subject: [PATCH] libsoup3: bump PKG_RELEASE to 7 for shared-only GIR build

include/gobject-introspection.mk forces default_library=shared, so the
rebuilt package no longer ships the unused libsoup-3.0.a. The APK release
ledger maps r5 to the published r6, so r7 is the next free identity.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 libs/libsoup3/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libs/libsoup3/Makefile b/libs/libsoup3/Makefile
index 5c07ba253..715ff89a4 100644
--- a/libs/libsoup3/Makefile
+++ b/libs/libsoup3/Makefile
@@ -7,7 +7,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=libsoup3
 PKG_VERSION:=3.7.1
-PKG_RELEASE:=5
+PKG_RELEASE:=7
 
 PKG_SOURCE:=libsoup-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=@GNOME/libsoup/$(basename $(PKG_VERSION))
-- 
2.53.0

