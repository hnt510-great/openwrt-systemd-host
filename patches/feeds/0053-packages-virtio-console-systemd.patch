From 3d9ab43923b54a495f64d9552197705eb02ed02c Mon Sep 17 00:00:00 2001
From: hnt510 <hnt510@gmail.com>
Date: Wed, 25 Nov 2026 16:55:22 +0800
Subject: [PATCH] qemu: omit 00-virtio-ports hotplug script on native systemd

On CONFIG_OPENWRT_SYSTEMD builds, udev's 50-udev-default.rules already
creates and removes /dev/virtio-ports/$attr{name} symlinks. Keep
/etc/hotplug.d/virtio-ports and qemu-ga's 10-qemu-ga hook intact, retain
00-virtio-ports on non-systemd builds, add a postinst notice if an
admin-modified 00-virtio-ports remains, and bump PKG_RELEASE to 6 past
the reserved 11.1.3-r5 ELF rebuild.
---
 utils/qemu/Makefile | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/utils/qemu/Makefile b/utils/qemu/Makefile
index 2ea923001..54bc8cbc0 100644
--- a/utils/qemu/Makefile
+++ b/utils/qemu/Makefile
@@ -10,7 +10,7 @@ include $(TOPDIR)/rules.mk
 
 PKG_NAME:=qemu
 PKG_VERSION:=11.1.3
-PKG_RELEASE:=4
+PKG_RELEASE:=6
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=https://download.qemu.org/
 PKG_HASH:=5a8289c7940dc77d3873c81a6c29ba3afe1446fc9d36e77fa1658cdbecb84b22
@@ -48,7 +48,18 @@ endef
 
 define Package/virtio-console-helper/install
 	$(INSTALL_DIR) $(1)/etc/hotplug.d/virtio-ports
+ifeq ($(CONFIG_OPENWRT_SYSTEMD),)
 	$(INSTALL_BIN) ./files/00-virtio-ports.hotplug $(1)/etc/hotplug.d/virtio-ports/00-virtio-ports
+endif
+endef
+
+define Package/virtio-console-helper/postinst
+#!/bin/sh
+[ -n "$${IPKG_INSTROOT}" ] && exit 0
+if [ -d /run/systemd/system ] && [ -e /etc/hotplug.d/virtio-ports/00-virtio-ports ]; then
+	logger -t virtio-console-helper "Notice: locally modified /etc/hotplug.d/virtio-ports/00-virtio-ports retained; /dev/virtio-ports symlinks are managed by udev on native systemd"
+fi
+exit 0
 endef
 
 
@@ -70,7 +81,7 @@ define Package/qemu-ga/install
 	$(INSTALL_BIN) ./files/10-qemu-ga.hotplug $(1)/etc/hotplug.d/virtio-ports/10-qemu-ga
 endef
 
-PKG_CONFIG_DEPENDS += CONFIG_PACKAGE_qemu-ga
+PKG_CONFIG_DEPENDS += CONFIG_PACKAGE_qemu-ga CONFIG_OPENWRT_SYSTEMD
 
 
 define Package/qemu-bridge-helper
-- 
2.53.0

