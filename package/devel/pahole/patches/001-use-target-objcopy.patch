From: OpenWrt developers
Subject: [PATCH] btf_encoder: use the packaged GNU objcopy by default

OpenWrt provides GNU objcopy through binutils. Keep the upstream override
for users who want LLVM, but let BTF encoding work without an environment
override on the target.

--- a/btf_encoder.c
+++ b/btf_encoder.c
@@ -1807,7 +1807,7 @@ static int btf_encoder__write_elf(struct
 
 		llvm_objcopy = getenv("LLVM_OBJCOPY");
 		if (!llvm_objcopy)
-			llvm_objcopy = "llvm-objcopy";
+			llvm_objcopy = "/usr/bin/objcopy";
 
 		/* Use objcopy to add a .BTF section */
 		snprintf(tmp_fn, sizeof(tmp_fn), "%s.btf", filename);
