START=50

# The native manager owns the daemon. rc.d remains for recovery boots.
if [ -z "$IPKG_INSTROOT" ] && [ -d /run/systemd/system ] &&
   [ -f /usr/lib/systemd/system/cron.service ]; then
	case "$action" in
		boot|shutdown) exit 0 ;;
		help|depends) ;;
		*) exec /usr/libexec/cron-systemd "$action" "$@" ;;
	esac
fi

USE_PROCD=1
PROG=/usr/sbin/crond
. "$IPKG_INSTROOT/usr/libexec/cron-config.sh"

validate_cron_section() {
	uci_validate_section system system "${1}" \
		'cronloglevel:uinteger'
}

start_service() {
	cron_has_entries || return 1
	cron_resolve_loglevel || return 1
	cron_prepare_spool

	procd_open_instance
	procd_set_param command "$PROG" -f -c /etc/crontabs -l "$CRON_LOGLEVEL"
	for crontab in /etc/crontabs/*; do
		 procd_set_param file "$crontab"
	done
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_validation validate_cron_section
}
