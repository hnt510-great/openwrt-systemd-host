START=50


USE_PROCD=1
PROG=/usr/sbin/crond
. "$IPKG_INSTROOT/usr/libexec/cron-config.sh"

validate_cron_section() {
	uci_validate_section system system "${1}" \
		'cronloglevel:uinteger'
}

start_service() {
	cron_has_entries || return 1
	cron_resolve_loglevel || return 1
	cron_prepare_spool

	procd_open_instance
	procd_set_param command "$PROG" -f -c /etc/crontabs -l "$CRON_LOGLEVEL"
	for crontab in /etc/crontabs/*; do
		 procd_set_param file "$crontab"
	done
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_validation validate_cron_section
}
