[Unit]
Description=BusyBox Periodic Command Scheduler
After=openwrt-services.service
ConditionDirectoryNotEmpty=/etc/crontabs
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Slice=auxiliary.slice
ExecStart=/usr/libexec/cron-systemd run
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
Also=cron-config.path
