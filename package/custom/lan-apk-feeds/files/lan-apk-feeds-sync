#!/bin/sh
# Kernel packages carry their own modules, so userspace feeds no longer depend
# on the kernel: follow the published current userspace snapshot and the
# kernel channel, like a distribution's main and kernel repositories.
set -eu
set -f
root=
if [ "$#" -gt 0 ]; then
	[ "$#" = 2 ] && [ "$1" = --root ] || {
		echo 'Usage: lan-apk-feeds-sync [--root ROOT]' >&2; exit 1;
	}
	root=${2%/}
fi
fail() { echo "lan-apk-feeds-sync: $*" >&2; exit 1; }
base_url=
repositories=
while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
		''|'#'*) ;;
		base_url=*) base_url=${line#base_url=} ;;
		repositories=*) repositories=${line#repositories=} ;;
		*) fail 'Unknown configuration entry' ;;
	esac
done < "$root/etc/lan-apk-feeds.conf"
base_url=${base_url%/}
case "$base_url" in http://?*|https://?*) ;; *) fail 'Invalid base_url' ;; esac
case "$base_url" in *[!A-Za-z0-9.:/_~-]*) fail 'Invalid base_url characters' ;; esac
[ -n "$repositories" ] || fail 'No repositories configured'
for repo in $repositories; do
	case "$repo" in *[!A-Za-z0-9_-]*) fail 'Invalid repository name' ;; esac
done
repo_dir=$root/etc/apk/repositories.d
mkdir -p "$repo_dir"
list=$repo_dir/lan-local.list
marker='# Managed by lan-apk-feeds-sync.'
# Adopt the previous manually configured LAN list, but never overwrite an
# unrelated repository file. Subsequent runs own the marked generated file.
if [ -f "$list" ] && ! grep -qxF "$marker" "$list"; then
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			''|'#'*|"$base_url"/abi/*/packages.adb|"$base_url"/current/*/packages.adb|\
			"$base_url"/kernel-upgrades/packages.adb) ;;
			*) fail "Refusing to overwrite unmanaged $list" ;;
		esac
	done < "$list"
fi
work=$(mktemp -d "$repo_dir/.lan-apk-feeds.XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
{
	printf '%s\n' "$marker"
	printf '%s/kernel-upgrades/packages.adb\n' "$base_url"
	for repo in $repositories; do
		printf '%s/current/%s/packages.adb\n' "$base_url" "$repo"
	done
} > "$work/lan-local.list"
# Migrate only the old local custom-feed URL; retain other feeds and comments.
custom=$repo_dir/customfeeds.list
if [ -f "$custom" ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in "$base_url"/abi/*/custom/packages.adb|"$base_url"/current/custom/packages.adb) ;;
			*) printf '%s\n' "$line" ;; esac
	done < "$custom" > "$work/customfeeds.list"
	if ! cmp -s "$custom" "$work/customfeeds.list"; then
		chmod 0644 "$work/customfeeds.list"
		mv "$work/customfeeds.list" "$custom"
	fi
fi
if ! cmp -s "$list" "$work/lan-local.list"; then
	chmod 0644 "$work/lan-local.list"
	mv "$work/lan-local.list" "$list"
fi
printf 'LAN APK feeds: %s/current\n' "$base_url"
