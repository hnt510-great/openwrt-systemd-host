{
	"luci-app-daed": {
		"description": "Enable, configure and inspect daed",
		"read": {
			"file": {
				"/usr/bin/tail -n 200 /var/log/daed/daed.log": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ],
				"luci-rpc": [ "getBoardJSON", "getNetworkDevices" ],
				"network": [ "get_proto_handlers" ],
				"network.interface": [ "dump" ],
				"service": [ "list" ]
			},
			"uci": [ "daed", "network", "passwall" ]
		},
		"write": {
			"file": {
				"/etc/init.d/daed restart": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			},
			"uci": [ "daed" ]
		}
	}
}
