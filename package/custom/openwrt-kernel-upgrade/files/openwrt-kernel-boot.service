[Unit]
Description=Adopt OpenWrt kernels and assess a new default kernel
# Wants, not Requires: a counted boot must still be assessed (and fail, which
# reboots for the next GRUB attempt) when router services do not come up.
Wants=openwrt-services.service openwrt-network-wait-online.service
After=openwrt-services.service openwrt-network-wait-online.service network.target sshd.service
Before=boot-complete.target
ConditionPathExists=|/etc/openwrt-kernel/state.json
ConditionPathExists=|/usr/lib/openwrt-kernel

[Service]
Type=oneshot
ExecStartPre=-/sbin/modprobe configs
ExecStart=/usr/sbin/kernelctl boot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
