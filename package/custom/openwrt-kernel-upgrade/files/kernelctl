#!/usr/bin/python3
"""Distribution-style OpenWrt kernel packages. Never writes the original vmlinuz.

Like Debian or Fedora, every kernel build is a separately installed
``linux-image-<release>`` package carrying its own modules. Installing one
builds its initramfs and GRUB entry and makes the newest kernel the default.
GRUB counts boot attempts: three unhealthy boots of a new default fall back to
the previous kernel. The image's original kernel remains a rescue entry.
"""
import argparse
from contextlib import contextmanager
import fcntl
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time


class KernelError(RuntimeError):
    pass


DEPMOD_INDEXES = {'modules.dep', 'modules.dep.bin', 'modules.alias', 'modules.alias.bin',
                  'modules.softdep', 'modules.symbols', 'modules.symbols.bin',
                  'modules.devname', 'modules.weakdep'}
PACKAGE_RELEASE = re.compile(r'(.+)-([0-9]+)-openwrt')
LEGACY_GENERATION = re.compile(r'.+-owrt-[0-9a-f]{32}-r[0-9]+-g([0-9]+)')
BOOT_ATTEMPTS = 3
COUNTING_DROPIN = '/run/systemd/system/openwrt-kernel-boot.service.d/50-boot-counting.conf'


def sha256(path):
    with Path(path).open('rb') as stream:
        digest = hashlib.sha256()
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(block)
        return digest.hexdigest()


def identifier(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._+-]{0,126}', value):
        raise KernelError('Invalid kernel release identifier')
    return value


def atomic(path, content, mode=0o600):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(content.encode() if isinstance(content, str) else content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            try:
                os.fsync(directory)
            except OSError as exc:
                if exc.errno != 22:  # FAT kernels may reject directory fsync.
                    raise
        finally:
            os.close(directory)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def json_write(path, data):
    atomic(path, json.dumps(data, sort_keys=True, indent=2) + '\n')


def inventory(root):
    return {str(p.relative_to(root)):
            {'link': os.readlink(p)} if p.is_symlink() else {'sha256': sha256(p)}
            for p in sorted(root.rglob('*')) if p.is_file() or p.is_symlink()}


def verify_files(root, files):
    root = Path(root)
    for name, expected in files.items():
        relative = Path(name)
        if relative.is_absolute() or '..' in relative.parts:
            raise KernelError('Unsafe manifest path')
        path = root / relative
        if not path.parent.resolve().is_relative_to(root.resolve()):
            raise KernelError('Manifest escapes installation root')
        if 'link' in expected:
            valid = path.is_symlink() and os.readlink(path) == expected['link']
        else:
            valid = path.is_file() and not path.is_symlink() and sha256(path) == expected['sha256']
        if not valid:
            raise KernelError('Missing or changed kernel file: ' + name)


def cpio_archive(root):
    """Deterministic newc, with root ownership and no target cpio dependency."""
    output = bytearray()
    paths = [root] + sorted(root.rglob('*'))
    for inode, path in enumerate(paths + [None], 1):
        if path is None:
            name, mode, content, links = 'TRAILER!!!', 0, b'', 1
        else:
            name = '.' if path == root else str(path.relative_to(root))
            info = path.lstat()
            mode = info.st_mode
            links = 2 if stat.S_ISDIR(mode) else 1
            content = (os.readlink(path).encode() if path.is_symlink() else
                       path.read_bytes() if stat.S_ISREG(mode) else b'')
        encoded = name.encode() + b'\0'
        fields = [inode, mode, 0, 0, links, 0, len(content), 0, 0, 0, 0, len(encoded), 0]
        output.extend(('070701' + ''.join(f'{field:08x}' for field in fields)).encode())
        output.extend(encoded)
        output.extend(b'\0' * (-len(output) % 4))
        output.extend(content)
        output.extend(b'\0' * (-len(output) % 4))
    output.extend(b'\0' * (-len(output) % 512))
    return bytes(output)


def sequence(release):
    """Build number of a kernel release; legacy generations keep their -gN."""
    match = PACKAGE_RELEASE.fullmatch(release) or LEGACY_GENERATION.fullmatch(release)
    return int(match[2] if match and match.re is PACKAGE_RELEASE else match[1]) if match else 0


class KernelManager:

    def __init__(self, root='/', runner=None):
        self.root = Path(root).resolve()
        self.policy = self.path('/etc/openwrt-kernel')
        self.boot = self.path('/boot')
        self.runner = runner or self._run

    def path(self, name):
        return self.root / name.lstrip('/')

    @staticmethod
    def _run(args, **kwargs):
        return subprocess.check_output(args, text=True, timeout=30, **kwargs).strip()

    def command(self, *args):
        return self.runner(list(args))

    # ---- state -----------------------------------------------------------

    def state(self):
        try:
            result = json.loads((self.policy / 'state.json').read_text())
        except (OSError, ValueError) as exc:
            raise KernelError('Missing/invalid kernel state; run kernelctl migrate') from exc
        if result.get('schema') == 1:
            result = self.convert(result)
            try:
                self.save(result)
            except OSError:
                pass  # Read-only callers (status, list) convert in memory only.
        if result.get('schema') != 2:
            raise KernelError('Unsupported kernel state')
        for name in result['kernels']:
            identifier(name)
        for key in ('rescue', 'default', 'known_good'):
            if result.get(key) not in result['kernels']:
                raise KernelError('State references missing ' + key)
        if result.get('fallback') and result['fallback'] not in result['kernels']:
            raise KernelError('State references missing fallback')
        return result

    @staticmethod
    def convert(old):
        """Adopt schema-1 generation state: its kernels become legacy entries."""
        if old.get('phase', 'ready') != 'ready':
            raise KernelError('Finish kernelctl migrate before converting kernel state')
        kernels = {}
        for name, entry in old['generations'].items():
            kind = 'legacy-rescue' if entry.get('legacy') else 'legacy-generation'
            kernels[name] = {**entry, 'kind': kind, 'bad': bool(entry.get('failed')),
                             'boot': kind == 'legacy-rescue' or bool(entry.get('ready'))}
        default = old['known_good']
        # Schema 1 recorded every up interface, including DHCP/PPPoE WANs; the
        # boot assessment compares only static local interfaces.
        previous = old.get('health', {})
        health = {'interfaces': ['lan'], **{key: previous[key] for key in ('overlay', 'lan_addresses')
                                            if previous.get(key)}}
        return {'schema': 2, 'phase': 'ready', 'bootargs': old['bootargs'],
                'health': health, 'required_config': old.get('required_config', []),
                'rescue': old['rescue'], 'default': default, 'known_good': default,
                'fallback': (old.get('previous_good') if old.get('previous_good') in kernels and
                             old.get('previous_good') != default else None),
                'counting': None, 'kernels': kernels}

    def save(self, state):
        json_write(self.policy / 'state.json', state)

    @contextmanager
    def locked(self, name='.lock'):
        with (self.policy / name).open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield

    @contextmanager
    def apk_locked(self):
        # Match apk_database_open(): take APK's lock BEFORE the policy lock.
        with self.path('/lib/apk/db/lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            yield

    def installed(self):
        database = self.path('/usr/lib/apk/db/installed')
        if not database.exists():
            database = self.path('/lib/apk/db/installed')
        result = {}
        for record in database.read_text().split('\n\n'):
            fields = dict(line.split(':', 1) for line in record.splitlines()
                          if len(line) > 2 and line[1] == ':' and line[0] in 'PVCD')
            if 'P' in fields:
                result[fields['P']] = fields
        return result

    def installed_kernels(self):
        """Releases of installed linux-image-<release> kernel packages."""
        return sorted((name[len('linux-image-'):] for name in self.installed()
                       if PACKAGE_RELEASE.fullmatch(name[len('linux-image-'):])
                       and name.startswith('linux-image-')), key=sequence)

    def release(self):
        return self.command('uname', '-r')

    # ---- boot filesystem and GRUB -----------------------------------------

    def boot_mount(self):
        if self.boot.is_symlink():
            raise KernelError('/boot must be a verified mount, not a symlink')
        mounts = self.path('/proc/self/mountinfo').read_text().splitlines()
        records = [line.split() for line in mounts if line.split()[4] == '/boot']
        if not records or 'rw' not in records[-1][5].split(','):
            raise KernelError('/boot is not mounted read/write')
        record = records[-1]
        separator = record.index('-')
        if record[separator + 1] not in ('vfat', 'ext4', 'ext2') or record[3] != '/boot':
            raise KernelError('Unsupported /boot layout; expected OpenWrt boot subdirectory bind mount')
        device = record[separator + 2]
        uuid = self.command('blkid', '-s', 'UUID', '-o', 'value', device)
        if not re.fullmatch(r'[A-Za-z0-9-]+', uuid):
            raise KernelError('Invalid boot filesystem UUID')
        return uuid

    def space(self, required):
        if shutil.disk_usage(self.boot).free < required + 8 * 1024 * 1024:
            raise KernelError('Insufficient boot space; remove an old kernel with kernelctl remove')

    def bootargs(self):
        args = shlex.split(self.path('/proc/cmdline').read_text())
        args = [a for a in args if not a.startswith(('BOOT_IMAGE=', 'openwrt.init=', 'failsafe=', 'firmware_class.path='))
                and a not in ('noinitrd', 'quiet')]
        if not any(a.startswith('root=') for a in args):
            raise KernelError('No root locator in running command line')
        if any(not re.fullmatch(r'[A-Za-z0-9_./:=,@%+~-]+', a) for a in args):
            raise KernelError('Unsupported quoting in boot arguments')
        return ' '.join(args)

    def setenv(self, **values):
        self.command('grub-editenv', str(self.boot / 'grub/grubenv'), 'set',
                     *[k + '=' + str(v) for k, v in values.items()])
        os.sync()

    def unsetenv(self, *names):
        self.command('grub-editenv', str(self.boot / 'grub/grubenv'), 'unset', *names)
        os.sync()

    def getenv(self):
        output = self.command('grub-editenv', str(self.boot / 'grub/grubenv'), 'list')
        return dict(line.split('=', 1) for line in output.splitlines() if '=' in line)

    @staticmethod
    def entry_id(state, name):
        return 'owrt-rescue' if name == state['rescue'] else 'owrt-' + name

    def firmware_argument(self, state, name):
        """Legacy generations boot with their frozen firmware snapshot."""
        if not state['kernels'][name].get('kind', '').startswith('legacy-'):
            return ''
        directory = self.path('/usr/lib/openwrt-kernel') / name / 'firmware'
        return ' firmware_class.path=/usr/lib/openwrt-kernel/' + name + '/firmware' if directory.is_dir() else ''

    def dispatcher(self, state):
        uuid = self.boot_mount()
        original = (self.boot / 'grub/grub.cfg.rescue').read_text()
        terminal = '\n'.join(line for line in original.splitlines()
                             if line.startswith(('serial ', 'terminal_input ', 'terminal_output ')))
        args = state['bootargs']
        firmware = self.firmware_argument(state, state['rescue'])
        # Direct rescue entries are parsed BEFORE any mutable kernel file. The
        # counter gives a new default three attempts, then boots the fallback.
        config = terminal + '\n' + f'''search --fs-uuid --set=root {uuid}
set prefix=($root)/boot/grub
set default=owrt-rescue
set fallback=owrt-rescue
set timeout=8
menuentry 'OpenWrt original kernel (rescue)' --id=owrt-rescue {{
 linux /boot/vmlinuz {args}{firmware} openwrt.init=systemd noinitrd
}}
menuentry 'OpenWrt original kernel (procd recovery)' --id=owrt-rescue-procd {{
 linux /boot/vmlinuz {args}{firmware} openwrt.init=procd noinitrd
}}
menuentry 'OpenWrt original kernel (failsafe)' --id=owrt-rescue-failsafe {{
 linux /boot/vmlinuz {args}{firmware} failsafe=true noinitrd
}}
insmod loadenv
if load_env; then
 if [ -n "$saved_entry" ]; then set default=$saved_entry; fi
 if [ -n "$boot_left" -a -n "$fallback_entry" ]; then
  if [ "$boot_left" = 0 ]; then set default=$fallback_entry
  elif [ "$boot_left" = 1 ]; then set boot_left=0; save_env boot_left
  elif [ "$boot_left" = 2 ]; then set boot_left=1; save_env boot_left
  else set boot_left=2; save_env boot_left
  fi
 fi
 if [ -n "$next_entry" ]; then
  set trial=$next_entry
  set next_entry=
  if save_env next_entry; then set default=$trial; fi
 fi
fi
if [ -f $prefix/openwrt.cfg ]; then source $prefix/openwrt.cfg; fi
'''
        atomic(self.boot / 'grub/grub.cfg', config, 0o644)

    def grub_config(self, state):
        content = '# Generated by kernelctl, newest first. Rescue entries are in grub.cfg.\n'
        for name in sorted(state['kernels'], key=sequence, reverse=True):
            entry = state['kernels'][name]
            if name == state['rescue'] or not entry.get('boot') or entry.get('kind') == 'legacy-rescue':
                continue
            firmware = self.firmware_argument(state, name)
            label = name + (' (failed boot)' if entry.get('bad') else '')
            for suffix, flag in (('', 'openwrt.init=systemd'),
                                 ('-procd', 'openwrt.init=procd'), ('-failsafe', 'failsafe=true')):
                content += f'''menuentry 'OpenWrt {label}{suffix}' --id=owrt-{name}{suffix} {{
 linux /boot/kernels/{name}/vmlinuz {state['bootargs']}{firmware} {flag}
 initrd /boot/kernels/{name}/initramfs.gz
}}
'''
        return content

    def write_grub(self, state):
        atomic(self.boot / 'grub/openwrt.cfg', self.grub_config(state), 0o644)

    def install_grub_modules(self):
        source = self.path('/usr/share/openwrt-kernel/grub')
        if not source.is_dir():
            raise KernelError('Matching GRUB modules are not installed')
        for architecture in source.iterdir():
            for module in architecture.iterdir():
                if module.suffix not in ('.mod', '.lst'):
                    continue
                destination = self.boot / 'grub' / architecture.name / module.name
                if destination.exists() and sha256(destination) != sha256(module):
                    raise KernelError('Refusing to replace existing GRUB module: ' + str(destination))
                if not destination.exists():
                    atomic(destination, module.read_bytes(), 0o644)

    # ---- APK retention ------------------------------------------------------

    def kernel_packages(self, state, name):
        """Installed packages that make up one kernel."""
        entry = state['kernels'].get(name, {})
        records = self.installed()
        if entry.get('kind') == 'legacy-generation':
            return sorted(package for package in records
                          if package == 'linux-image-' + name or
                          (package.startswith(('kmod-', 'kernel-dev-headers-'))
                           and package.endswith('-' + name)))
        return sorted(package for package in ('linux-image-' + name, 'linux-headers-' + name)
                      if package in records)

    def required_by_meta(self):
        """Kernel packages the installed metapackages depend on (the newest)."""
        records = self.installed()
        required = set()
        for meta in ('linux-image-openwrt', 'kernel-dev-headers'):
            for dep in records.get(meta, {}).get('D', '').split():
                name = re.split(r'[<>=~]', dep, maxsplit=1)[0]
                if name.startswith(('linux-image-', 'linux-headers-')):
                    required.add(name)
        return required

    def protect(self):
        """Keep every installed kernel through APK solves, like NeverAutoRemove.

        Only kernelctl prune/remove withdraws kernels. Legacy generation
        payloads keep their checksum pins until pruned.
        """
        records = self.installed()
        lines = []
        for name, record in sorted(records.items()):
            if ((name.startswith(('linux-image-', 'linux-headers-')) and name != 'linux-image-openwrt')
                    or (name.startswith(('kmod-', 'kernel-dev-headers-')) and '-owrt-' in name)):
                if not record.get('C'):
                    raise KernelError('No installed checksum for ' + name)
                lines.append(name + '><' + record['C'])
        atomic(self.policy / 'protected', '\n'.join(lines) + '\n')

    def enroll(self):
        # The image pins an exact kernel ABI; kernel packages are versioned by
        # build instead. Follow the newest kernel; keep other world constraints.
        world = self.path('/etc/apk/world')
        lines = world.read_text().splitlines()
        updated = ['kernel' if re.fullmatch(r'kernel(?:[<>=~].*)?', line) else line
                   for line in lines]
        updated = ['linux-image-openwrt' if re.fullmatch(r'linux-image-openwrt(?:[<>=~].*)?', line)
                   else line for line in updated]
        if 'linux-image-openwrt' not in updated:
            updated.append('linux-image-openwrt')
        if updated != lines:
            atomic(world, '\n'.join(updated) + '\n', stat.S_IMODE(world.stat().st_mode))

    # ---- verification -------------------------------------------------------

    def check(self):
        state = self.state()
        self.boot_mount()
        rescue = state['kernels'][state['rescue']]
        if sha256(self.boot / 'vmlinuz') != rescue['kernel_sha256']:
            raise KernelError('Original bootable vmlinuz changed')
        for name, entry in state['kernels'].items():
            if entry.get('kind') == 'legacy-rescue':
                verify_files(self.path('/usr/lib/modules') / entry['release'],
                             {p: value for p, value in entry['modules'].items() if p not in DEPMOD_INDEXES})
                verify_files(self.root, entry.get('firmware_files', {}))
            elif entry.get('boot') and name != state['rescue']:
                directory = self.boot / 'kernels' / name
                verify_files(directory, entry['boot_files'])
        return state

    def image(self, name):
        metadata = self.path('/usr/lib/openwrt-kernel') / identifier(name)
        image = json.loads((metadata / 'image.json').read_text())
        if image.get('schema') != 2 or image.get('release') != name:
            raise KernelError('Kernel package metadata mismatch: ' + name)
        if sha256(metadata / 'vmlinuz') != image['kernel_sha256']:
            raise KernelError('Kernel image checksum mismatch: ' + name)
        verify_files(self.root, {p: v for p, v in image['files'].items()
                                 if not p.endswith('/image.json')})
        return image

    # ---- boot preparation ---------------------------------------------------

    def prepare(self):
        """Runs before systemd: per-release autoload rules and counting units."""
        if not (self.policy / 'state.json').exists():
            return
        state = self.state()
        release = self.release()
        entry = state['kernels'].get(release) or next(
            (e for e in state['kernels'].values() if e.get('release') == release), {})
        runtime = self.path('/run/openwrt-kernel')
        legacy = entry.get('kind', '').startswith('legacy-')
        for directory in ('modules.d', 'modules-boot.d', 'modprobe.d'):
            target = runtime / directory
            if not legacy:
                # Kernel packages use the standard /etc rules of the kmod packages.
                if target.is_dir() and not target.is_symlink():
                    shutil.rmtree(target)
                continue
            if entry['kind'] == 'legacy-rescue':
                base = self.path('/usr/lib/openwrt-kernel') / state['rescue']
            else:
                base = self.path('/usr/lib/modules') / identifier(release) / 'openwrt'
            target.mkdir(parents=True, exist_ok=True)
            for old in target.iterdir():
                if old.is_symlink():
                    old.unlink()
            for source in (base / directory, self.path('/etc') / directory):
                if source.is_dir():
                    for item in sorted(source.iterdir()):
                        link = target / item.name
                        if not link.exists() and not link.is_symlink():
                            link.symlink_to(item.resolve())
        modprobe = self.path('/run/modprobe.d')
        if legacy:
            modprobe.mkdir(parents=True, exist_ok=True)
            for item in (runtime / 'modprobe.d').iterdir():
                link = modprobe / item.name
                if link.is_symlink():
                    link.unlink()
                if not link.exists():
                    link.symlink_to(item.resolve())
            firmware = self.path('/usr/lib/openwrt-kernel') / (
                state['rescue'] if entry['kind'] == 'legacy-rescue' else release) / 'firmware'
            parameter = self.path('/sys/module/firmware_class/parameters/path')
            if parameter.exists() and firmware.is_dir():
                parameter.write_text(str(firmware))
        dropin = self.path(COUNTING_DROPIN)
        if state.get('counting') == release:
            # An unhealthy counted boot must end in a reboot so GRUB can count
            # it; the boot assessment below fails if health is not reached.
            atomic(dropin, '[Unit]\nFailureAction=reboot\nJobTimeoutSec=15min\n'
                           'JobTimeoutAction=reboot\n', 0o644)
        else:
            dropin.unlink(missing_ok=True)

    # ---- health and boot assessment -----------------------------------------

    def health(self):
        if self.path('/proc/1/comm').read_text().strip() != 'systemd':
            raise KernelError('Native systemd is not PID 1')
        for unit in ('openwrt-ubusd', 'openwrt-procd', 'openwrt-services'):
            self.command('systemctl', 'is-active', unit)
        interfaces = json.loads(self.command('ubus', 'call', 'network.interface', 'dump'))['interface']
        # Like openwrt-network-wait-online: only statically configured local
        # interfaces count. WAN, PPPoE or VPN outages are not kernel failures.
        up = sorted(i['interface'] for i in interfaces if i.get('up') and i['interface'] != 'loopback'
                    and i.get('proto') == 'static')
        if 'lan' not in up:
            raise KernelError('LAN is not healthy in ubus')
        lan = next(i for i in interfaces if i['interface'] == 'lan')
        device = lan.get('l3_device')
        if not device or not re.fullmatch(r'[A-Za-z0-9_.:-]+', device):
            raise KernelError('LAN has no usable layer-3 device')
        if self.path('/sys/class/net/' + device + '/carrier').read_text().strip() != '1':
            raise KernelError('LAN lost its carrier')
        addresses = sorted(a['address'] for a in lan.get('ipv4-address', []))
        if not addresses:
            raise KernelError('LAN has no IPv4 address')
        if self.path('/usr/lib/systemd/system/sshd.service').is_file():
            self.command('systemctl', 'is-active', 'sshd.service')
        else:
            self.command('/etc/init.d/sshd', 'status')
        mounts = [line.split() for line in self.path('/proc/mounts').read_text().splitlines()
                  if line.split()[1] == '/overlay']
        if not mounts or mounts[-1][2] not in ('ext4', 'f2fs', 'btrfs', 'xfs'):
            raise KernelError('Persistent overlay is missing')
        return {'interfaces': up, 'overlay': [mounts[-1][0]], 'lan_device': device,
                'lan_addresses': addresses}

    @staticmethod
    def matches_baseline(actual, expected):
        return (set(expected.get('interfaces', [])).issubset(actual['interfaces']) and
                actual['overlay'] == expected.get('overlay', actual['overlay']) and
                (not expected.get('lan_addresses') or expected['lan_addresses'] == actual['lan_addresses']))

    def wait_healthy(self, expected, timeout=180):
        deadline = time.monotonic() + timeout
        while True:
            try:
                actual = self.health()
                if expected and not self.matches_baseline(actual, expected):
                    raise KernelError('Waiting for the known-good interfaces, addresses and overlay')
                return actual
            except (KernelError, OSError, subprocess.SubprocessError):
                if time.monotonic() >= deadline:
                    raise
                time.sleep(3)

    def assess(self, timeout=180):
        """Boot assessment: bless a healthy new default or record a fallback."""
        state = self.state()
        release = self.release()
        counting = state.get('counting')
        environment = self.getenv()
        if counting and counting != release:
            if environment.get('boot_left') == '0' and release == state.get('fallback'):
                # GRUB exhausted the attempts and booted the fallback kernel.
                state['kernels'][counting]['bad'] = True
                state['default'], state['counting'] = release, None
                self.setenv(saved_entry=self.entry_id(state, release))
                self.unsetenv('boot_left', 'fallback_entry')
                self.save(state)
                self.write_grub(state)
                print(f'kernelctl: kernel {counting} failed {BOOT_ATTEMPTS} boots; '
                      f'restored {release} as the default', file=sys.stderr)
            return state
        if release != state['default'] or counting != release:
            # An entry chosen from the GRUB menu, or an ordinary boot of the
            # already-good default: nothing to assess.
            if release == state['default']:
                # An uncounted default (the adopted kernel, or one chosen with
                # set-default) that boots is the known-good kernel.
                if state['known_good'] != release:
                    state['known_good'] = release
                    self.save(state)
                self.retain(state)
            return state
        # A failure here fails the unit; the counting drop-in then reboots so
        # GRUB can use the next attempt or the fallback.
        actual = self.wait_healthy(state.get('health'), timeout)
        state['known_good'] = release
        state['kernels'][release]['bad'] = False
        state['counting'] = None
        self.unsetenv('boot_left', 'fallback_entry')
        state['health'] = actual
        self.save(state)
        self.path(COUNTING_DROPIN).unlink(missing_ok=True)
        self.retain(state)
        return state

    # ---- adoption -----------------------------------------------------------

    def migrate(self):
        if (self.policy / 'state.json').exists():
            state = self.state()
            if state.get('phase') == 'adopting':
                return self.finish_migrate(state)
            self.install_grub_modules()
            self.dispatcher(state)
            self.write_grub(state)
            self.enroll()
            self.protect()
            self.save(state)
            return state
        self.boot_mount()
        for capability in ('apk-policy', 'kmodloader-policy'):
            if self.path('/usr/share/openwrt-kernel/' + capability).read_text().strip() != '1':
                raise KernelError('Required kernel transaction support is missing: ' + capability)
        release = identifier(self.release())
        if 'linux-image-' + release not in self.installed():
            raise KernelError('The running kernel is not an installed kernel package')
        snapshot = self.boot / 'grub/grub.cfg.rescue'
        grub = (self.boot / 'grub/grub.cfg').read_bytes()
        if snapshot.exists() and snapshot.read_bytes() != grub:
            if (self.policy / 'protected').exists() or b'--id=owrt-rescue' in grub:
                raise KernelError('Incomplete adoption exists; inspect before retrying')
        atomic(snapshot, grub, 0o644)
        args = self.bootargs()
        config_path = self.path('/proc/config.gz')
        config = gzip.decompress(config_path.read_bytes()).decode() if config_path.exists() else ''
        required = ('CONFIG_BLK_DEV_INITRD', 'CONFIG_DEVTMPFS', 'CONFIG_CGROUPS',
                    'CONFIG_OVERLAY_FS', 'CONFIG_SQUASHFS', 'CONFIG_EXT4_FS', 'CONFIG_F2FS_FS')
        state = {'schema': 2, 'phase': 'adopting', 'bootargs': args, 'health': self.health(),
                 'required_config': [s for s in required if s + '=y' in config.splitlines()],
                 'rescue': release, 'default': release, 'known_good': release,
                 'fallback': None, 'counting': None,
                 'kernels': {release: {'kind': 'package', 'release': release, 'boot': True,
                                       'bad': False, 'kernel_sha256': sha256(self.boot / 'vmlinuz')}}}
        self.save(state)
        return self.finish_migrate(state)

    def finish_migrate(self, state):
        # Resumable: every step below is idempotent.
        self.protect()
        self.install_grub_modules()
        environment = self.boot / 'grub/grubenv'
        if not environment.exists():
            self.command('grub-editenv', str(environment), 'create')
        self.setenv(saved_entry='owrt-rescue')
        self.dispatcher(state)
        self.write_grub(state)
        self.enroll()
        state['phase'] = 'ready'
        self.save(state)
        return state

    # ---- kernel installation (kernel-install / update-grub) -----------------

    def bootstrap(self, release, destination):
        """Freeze target tools/libraries and matching early modules into a cpio."""
        with tempfile.TemporaryDirectory(prefix='kernel-initramfs-', dir=self.path('/tmp')) as temp:
            root = Path(temp)
            for directory in ('dev', 'proc', 'sys', 'run', 'newroot', 'usr/bin', 'usr/sbin', 'usr/lib', 'etc'):
                (root / directory).mkdir(parents=True, exist_ok=True)
            for link, target in (('bin', 'usr/bin'), ('sbin', 'usr/sbin'), ('lib', 'usr/lib')):
                (root / link).symlink_to(target)
            copied = set()

            def copy_binary(binary):
                source = self.path(binary).resolve()
                if source in copied:
                    return '/' + source.relative_to(self.root).as_posix()
                if not source.is_file() or not source.is_relative_to(self.root):
                    raise KernelError('Bootstrap binary escapes root: ' + binary)
                copied.add(source)
                relative = source.relative_to(self.root)
                target = root / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target)
                # ldd only inspects the trusted installed target tools, on target.
                for library in re.findall(r'(?:=>\s*)?(/[^\s()]+)', self.command('ldd', str(source))):
                    library_source = self.path(library)
                    library_target = root / library.lstrip('/')
                    library_target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(library_source.resolve(), library_target)
                return '/' + relative.as_posix()

            kmodloader = copy_binary('/usr/sbin/kmodloader')
            blkid = copy_binary('/usr/sbin/blkid')
            for applet in ('sh', 'mount', 'umount', 'mkdir', 'cat', 'head', 'ln', 'sleep', 'switch_root'):
                executable = shutil.which(applet, path='/usr/sbin:/usr/bin:/sbin:/bin')
                if not executable:
                    raise KernelError('Missing bootstrap tool: ' + applet)
                binary = copy_binary(executable)
                link = root / 'usr/bin' / applet
                if not link.exists():
                    link.symlink_to(binary)
            if kmodloader != '/usr/sbin/kmodloader':
                (root / 'usr/sbin/kmodloader').symlink_to(kmodloader)
            if blkid != '/usr/sbin/blkid':
                (root / 'usr/sbin/blkid').symlink_to(blkid)
            modules = self.path('/usr/lib/modules') / release
            shutil.copytree(modules, root / 'usr/lib/modules' / release,
                            symlinks=True, ignore=shutil.ignore_patterns('build', 'source'))
            # The kmod packages' standard early-boot rules select the modules.
            early = root / 'etc/modules-boot.d'
            early.mkdir()
            source = self.path('/etc/modules-boot.d')
            if source.exists():
                for entry in source.iterdir():
                    if entry.resolve().is_file():
                        shutil.copy2(entry.resolve(), early / entry.name)
            shutil.copy2(self.path('/usr/libexec/openwrt-kernel-init'), root / 'init')
            early_modules = set()
            # Generic OpenWrt autoload rules may name drivers for several
            # platforms. kmodloader skips absent names; do the same, while
            # still resolving dependencies strictly for installed modules.
            available = {p.name.split('.ko', 1)[0].replace('-', '_')
                         for p in modules.rglob('*.ko*') if p.is_file()}
            available.update(Path(line).name.removesuffix('.ko').replace('-', '_')
                             for line in (modules / 'modules.builtin').read_text().splitlines())
            for rule in early.iterdir():
                for line in rule.read_text().splitlines():
                    words = shlex.split(line, comments=True)
                    if not words:
                        continue
                    if words[0].replace('-', '_') not in available:
                        continue
                    dependencies = self.command('modprobe', '-S', release, '--show-depends', words[0])
                    for dependency in dependencies.splitlines():
                        if dependency.startswith('insmod '):
                            early_modules.add(dependency.split()[1])
            firmware_root = self.path('/usr/lib/firmware')
            for module in sorted(early_modules):
                for pattern in self.command('modinfo', '-F', 'firmware', module).splitlines():
                    relative = Path(pattern)
                    if relative.is_absolute() or '..' in relative.parts:
                        raise KernelError('Unsafe firmware requirement')
                    for suffix in ('', '.xz', '.zst'):
                        for source in firmware_root.glob(pattern + suffix):
                            target = root / 'usr/lib/firmware' / source.relative_to(firmware_root)
                            target.parent.mkdir(parents=True, exist_ok=True)
                            shutil.copy2(source, target)
            archive = cpio_archive(root)
            atomic(destination, gzip.compress(archive, mtime=0), 0o644)

    def install(self, name, state=None):
        """Install boot files for an installed kernel package; return state."""
        state = state or self.check()
        identifier(name)
        image = self.image(name)
        config = (self.path('/usr/lib/openwrt-kernel') / name / 'config').read_text().splitlines()
        for symbol in state.get('required_config', []):
            if symbol + '=y' not in config:
                raise KernelError(f'Kernel {name} removed required built-in feature: {symbol}')
        entry = state['kernels'].get(name)
        if name == state['rescue']:
            return state
        self.command('depmod', '-a', name)
        directory = self.boot / 'kernels' / name
        if not (entry and entry.get('boot') and directory.is_dir() and
                (directory / 'boot.json').exists() and
                json.loads((directory / 'boot.json').read_text()).get('kernel_sha256') == image['kernel_sha256']):
            # Make room first: only kernels outside the retention set lose entries.
            self.retain(state, candidate=name)
            metadata = self.path('/usr/lib/openwrt-kernel') / name
            self.space((metadata / 'vmlinuz').stat().st_size + 32 * 1024 * 1024)
            staging = Path(tempfile.mkdtemp(prefix='.' + name + '.', dir=self.boot))
            try:
                atomic(staging / 'vmlinuz', (metadata / 'vmlinuz').read_bytes(), 0o644)
                self.bootstrap(name, staging / 'initramfs.gz')
                boot = {'release': name, 'kernel_sha256': image['kernel_sha256'],
                        'boot_files': inventory(staging)}
                json_write(staging / 'boot.json', boot)
                os.sync()
                if directory.exists():
                    shutil.rmtree(directory)
                directory.parent.mkdir(exist_ok=True)
                staging.rename(directory)
                os.sync()
            finally:
                if staging.exists():
                    shutil.rmtree(staging)
            entry = {'kind': 'package', 'release': name, 'version': image['version'],
                     'kernel_sha256': image['kernel_sha256'], 'boot': True, 'bad': False,
                     'boot_files': boot['boot_files']}
            state['kernels'][name] = entry
        return state

    def make_default(self, state, name, counted=True):
        """Boot this kernel next; a counted default falls back after 3 failures."""
        previous = state['known_good'] if state['known_good'] != name else state.get('fallback')
        state['default'] = name
        if counted and previous and previous != name:
            state['fallback'], state['counting'] = previous, name
            self.setenv(saved_entry=self.entry_id(state, name), boot_left=BOOT_ATTEMPTS,
                        fallback_entry=self.entry_id(state, previous))
        else:
            state['counting'] = None
            self.setenv(saved_entry=self.entry_id(state, name))
            self.unsetenv('boot_left', 'fallback_entry')
        return state

    def forget(self, state, name):
        if name in (state['rescue'], state['default'], state['known_good']):
            raise KernelError('Refusing to forget the rescue, default or known-good kernel')
        directory = self.boot / 'kernels' / identifier(name)
        if directory.exists():
            shutil.rmtree(directory)
        if 'linux-image-' + name not in self.installed():
            # APK removed the package files; only depmod indexes remain.
            for base in ('/usr/lib/modules', '/usr/lib/openwrt-kernel'):
                leftover = self.path(base) / name
                if leftover.is_dir() and not any(leftover.rglob('*.ko*')) and \
                        not (leftover / 'image.json').exists():
                    shutil.rmtree(leftover)
        state['kernels'].pop(name, None)
        if state.get('fallback') == name:
            state['fallback'] = None
        if state.get('counting') == name:
            state['counting'] = None
        return state

    # ---- retention and pruning ----------------------------------------------

    def retention(self, state, candidate=None):
        """Kernels kept besides the rescue kernel: the active or pending default
        and its fallback. The running kernel is also kept while it differs (it
        cannot be removed); every other kernel is pruned."""
        keep = []
        for name in (candidate, state['default'], state.get('counting'),
                     state.get('fallback'), self.release()):
            if name and name != state['rescue'] and name not in keep and (
                    name in state['kernels'] or name == candidate):
                keep.append(name)
        return keep

    def prunable(self, state):
        keep = set(self.retention(state)) | {state['rescue']}
        return [name for name, entry in state['kernels'].items()
                if name not in keep and entry.get('kind') != 'legacy-rescue']

    def retain(self, state, candidate=None):
        """Withdraw boot entries outside the retention set and queue pruning."""
        self.boot_mount()
        keep = set(self.retention(state, candidate)) | {state['rescue']}
        changed = False
        for name, entry in state['kernels'].items():
            if name not in keep and entry.get('boot') and entry.get('kind') != 'legacy-rescue':
                entry['boot'] = False
                changed = True
                directory = self.boot / 'kernels' / name
                if directory.exists():
                    shutil.rmtree(directory)
        if changed:
            self.save(state)
            self.write_grub(state)
        if self.prunable(state):
            atomic(self.path('/run/openwrt-kernel-prune'), '')
        return keep

    def prune(self):
        """Remove kernels outside the retention set with APK, outside any hook."""
        with self.locked('.prune.lock'):
            self.path('/run/openwrt-kernel-prune').unlink(missing_ok=True)
            plan_path = self.policy / 'pruning.json'
            with self.apk_locked(), self.locked():
                self.protect()
                plan_path.unlink(missing_ok=True)
                state = self.check()
                candidates = self.prunable(state)
            for name in candidates:
                with self.apk_locked(), self.locked():
                    state = self.check()
                    if name not in self.prunable(state):
                        continue
                    packages = self.kernel_packages(state, name)
                    json_write(plan_path, {'kernel': name, 'packages': packages})
                    self.unprotect(packages)
                success = False
                try:
                    if packages:
                        self.command('apk', '--wait', '10', '--no-network', 'del', *packages)
                    success = not self.kernel_packages(state, name)
                    if not success:
                        raise KernelError('APK retained withdrawn kernel: ' + name)
                finally:
                    with self.locked():
                        state = self.state()
                        if success:
                            self.forget(state, name)
                            self.save(state)
                            self.write_grub(state)
                        self.protect()
                        plan_path.unlink(missing_ok=True)

    def unprotect(self, packages):
        lines = (self.policy / 'protected').read_text().splitlines()
        atomic(self.policy / 'protected', '\n'.join(
            line for line in lines if line.split('><', 1)[0].split('=', 1)[0] not in packages) + '\n')

    # ---- APK transaction contract -------------------------------------------

    def transaction(self, phase, path, errors, simulation, disabled):
        state = self.state()
        changes = [line.split('\t') for line in Path(path).read_text().splitlines()]
        if any(len(change) != 5 for change in changes):
            raise KernelError('Malformed APK transaction')
        effective = [c for c in changes if c[0] != c[2] or c[1] != c[3] or c[4] == '1']

        def kernel(name):
            return (name.startswith(('linux-image-', 'linux-headers-')) and name != 'linux-image-openwrt'
                    or (name.startswith(('kmod-', 'kernel-dev-headers-')) and '-owrt-' in name))

        kernel_changes = [c for c in effective if kernel(c[0]) or kernel(c[2])]
        if not kernel_changes:
            return
        if state.get('phase', 'ready') != 'ready':
            raise KernelError('Finish kernelctl migrate before changing kernels')
        if disabled == '1':
            raise KernelError('Kernel transaction requires scripts and commit hooks')
        removed = sorted({c[0] for c in kernel_changes if c[0] != '-' and c[2] != c[0]})
        added = sorted({c[2][len('linux-image-'):] for c in kernel_changes
                        if c[2].startswith('linux-image-') and c[0] != c[2]
                        and PACKAGE_RELEASE.fullmatch(c[2][len('linux-image-'):])}, key=sequence)
        plan_path = self.policy / 'pruning.json'
        plan = json.loads(plan_path.read_text()) if plan_path.exists() else None
        held = {self.release(), state['default'], state['known_good'], state['rescue']}
        if state.get('fallback'):
            held.add(state['fallback'])
        for package in removed:
            owner = next((name for name in state['kernels']
                          if package in ('linux-image-' + name, 'linux-headers-' + name) or
                          ('-owrt-' in package and package.endswith('-' + name))), None)
            if owner in held and not package.startswith('linux-headers-'):
                raise KernelError('Refusing to remove a running, default, fallback or rescue kernel: ' + package)
            if owner and not (plan and package in plan['packages']) and not package.startswith('linux-headers-'):
                raise KernelError('Remove kernels with kernelctl remove: ' + package)
        if phase == 'apk-pre':
            if simulation != 'simulate' and added:
                self.boot_mount()
            return
        if errors != '0':
            raise KernelError('APK transaction failed; kernel boot entries were not changed')
        if simulation == 'simulate':
            return
        state = self.check()
        for name in added:
            state = self.install(name, state)
        newest = max([state['default'], *added], key=sequence)
        if added and newest != state['default'] and newest in added:
            self.make_default(state, newest)
            self.save(state)
            # The previous kernel is now the fallback; withdraw the older one.
            self.retain(state)
        for package in removed:
            if package.startswith('linux-image-'):
                name = package[len('linux-image-'):]
                if name in state['kernels'] and state['kernels'][name].get('kind') == 'package':
                    self.forget(state, name)
        self.save(state)
        self.write_grub(state)
        self.protect()

    # ---- user commands --------------------------------------------------------

    def listing(self):
        state = self.state()
        running = self.release()
        rows = []
        for name in sorted(state['kernels'], key=sequence, reverse=True):
            entry = state['kernels'][name]
            flags = [flag for flag, active in (
                ('running', name == running), ('default', name == state['default']),
                ('fallback', name == state.get('fallback')), ('known-good', name == state['known_good']),
                ('rescue', name == state['rescue']), ('counting', name == state.get('counting')),
                ('failed', entry.get('bad')), ('legacy', entry.get('kind', '').startswith('legacy-'))) if active]
            rows.append({'release': name, 'flags': flags})
        return rows

    def set_default(self, name, counted=False):
        state = self.check()
        if name not in state['kernels']:
            raise KernelError('Unknown kernel: ' + name)
        if name != state['rescue'] and not state['kernels'][name].get('boot'):
            raise KernelError('Kernel has no boot entry: ' + name)
        state['kernels'][name]['bad'] = False
        self.make_default(state, name, counted=counted)
        self.save(state)
        self.write_grub(state)
        return state

    def rollback(self):
        """Make the previous kernel the default again, like choosing it in GRUB."""
        state = self.check()
        target = (state.get('fallback') if state.get('counting') or state['default'] == state['known_good']
                  else state['known_good']) or state['rescue']
        if state.get('counting'):
            state['kernels'][state['counting']]['bad'] = True
        state['default'], state['counting'] = target, None
        self.setenv(saved_entry=self.entry_id(state, target))
        self.unsetenv('boot_left', 'fallback_entry')
        self.save(state)
        self.write_grub(state)
        return state

    def remove(self, name):
        state = self.check()
        identifier(name)
        if name not in state['kernels']:
            raise KernelError('Unknown kernel: ' + name)
        if name in (state['rescue'], state['default'], state['known_good'], state.get('fallback'),
                    self.release()):
            raise KernelError('Refusing to remove a running, default, fallback or rescue kernel')
        packages = self.kernel_packages(state, name)
        if set(packages) & self.required_by_meta():
            raise KernelError('Refusing to remove the newest kernel, which linux-image-openwrt '
                              'requires; install a newer kernel first')
        json_write(self.policy / 'pruning.json', {'kernel': name, 'packages': packages})
        self.unprotect(packages)
        return packages

    def finish_remove(self, name, success):
        state = self.state()
        # apk del can exit 0 while keeping a package another one requires.
        success = success and name in state['kernels'] and not self.kernel_packages(state, name)
        if success:
            self.forget(state, name)
            self.save(state)
            self.write_grub(state)
        self.protect()
        (self.policy / 'pruning.json').unlink(missing_ok=True)


def exit_on_sigterm():
    """systemd stops a starting unit with SIGTERM, e.g. on reboot. Unwind like
    an exception so staging directories and temporary files are removed."""
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))


def main():
    exit_on_sigterm()
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['status', 'list', 'check', 'migrate', 'prepare', 'boot',
                                         'install', 'set-default', 'rollback', 'remove', 'retain',
                                         'prune', 'apk-pre', 'apk-post'])
    parser.add_argument('arguments', nargs='*')
    args = parser.parse_args()
    manager = KernelManager()
    if args.command == 'status':
        print(json.dumps(manager.state(), indent=2))
        return
    if args.command == 'list':
        for row in manager.listing():
            print(row['release'] + ('  ' + ' '.join(row['flags']) if row['flags'] else ''))
        return
    if os.geteuid() != 0:
        raise KernelError('Run as root')
    manager.policy.mkdir(parents=True, exist_ok=True)
    if args.command == 'prune':
        manager.prune()
        return
    remove_packages = None
    # APK calls occur under its database lock; never recursively invoke APK.
    with (manager.policy / '.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.command in ('apk-pre', 'apk-post'):
            if len(args.arguments) != 4:
                raise KernelError('Invalid transaction contract')
            manager.transaction(args.command, *args.arguments)
        elif args.command == 'boot':
            if not (manager.policy / 'state.json').exists() or manager.state().get('phase') == 'adopting':
                manager.wait_healthy(None, 90)
                manager.migrate()
            manager.prepare()
            manager.assess()
        elif args.command == 'retain':
            if (manager.policy / 'state.json').exists():
                manager.retain(manager.state())
        elif args.command == 'install':
            # Re-register an installed kernel package (like kernel-install add).
            if len(args.arguments) != 1:
                raise KernelError('Specify a kernel release')
            if 'linux-image-' + identifier(args.arguments[0]) not in manager.installed():
                raise KernelError('Kernel package is not installed: ' + args.arguments[0])
            state = manager.install(args.arguments[0])
            manager.save(state)
            manager.write_grub(state)
            manager.protect()
        elif args.command == 'set-default':
            if len(args.arguments) != 1:
                raise KernelError('Specify a kernel release')
            manager.set_default(args.arguments[0])
        elif args.command == 'remove':
            if len(args.arguments) != 1:
                raise KernelError('Specify a kernel release')
            remove_packages = manager.remove(args.arguments[0])
        else:
            getattr(manager, args.command)()
    if remove_packages is not None:
        success = False
        try:
            if remove_packages:
                manager.command('apk', 'del', *remove_packages)
            success = True  # finish_remove() checks the packages are really gone
        finally:
            with (manager.policy / '.lock').open('a') as lock:
                fcntl.flock(lock, fcntl.LOCK_EX)
                manager.finish_remove(args.arguments[0], success)


if __name__ == '__main__':
    try:
        main()
    except (KernelError, OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print('kernelctl: ' + str(exc), file=sys.stderr)
        sys.exit(1)
