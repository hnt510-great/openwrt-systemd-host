#!/bin/sh /etc/rc.common
# daed: dae eBPF transparent proxy with its web dashboard.
# Opt-in alternative to Passwall; see docs/daed.md.

USE_PROCD=1
START=99
STOP=10

CONF="daed"
PROG="/usr/bin/daed"
CONFIG_DIR="/etc/daed"
LOG_DIR="/var/log/daed"

passwall_enabled() {
	[ -f /etc/config/passwall ] || return 1
	[ "$(uci -q get passwall.@global[0].enabled)" = "1" ]
}

start_service() {
	config_load "$CONF"

	local enabled listen_addr log_maxbackups log_maxsize lan_interface
	config_get_bool enabled "config" "enabled" "0"
	[ "$enabled" -eq 1 ] || return 0

	# dae and Passwall both intercept forwarded traffic (tc eBPF versus
	# nftables TPROXY). Running both breaks routing, so refuse instead.
	if passwall_enabled; then
		logger -p daemon.err -t daed \
			"Passwall is enabled; disable it (uci set passwall.@global[0].enabled=0) before starting daed"
		return 1
	fi

	config_get listen_addr "config" "listen_addr" "0.0.0.0:2023"
	config_get log_maxbackups "config" "log_maxbackups" "1"
	config_get log_maxsize "config" "log_maxsize" "5"
	# LAN interfaces given to configs created from now on (dae-wing patch
	# 004); an option or a list. Unset or empty means br-lan.
	config_get lan_interface "config" "default_lan_interface" "br-lan"

	mkdir -p "$CONFIG_DIR" "$LOG_DIR"
	chmod 0750 "$CONFIG_DIR"

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" run
	procd_append_param command --config "$CONFIG_DIR"
	procd_append_param command --listen "$listen_addr"
	procd_append_param command --disable-timestamp
	procd_append_param command --logfile "$LOG_DIR/daed.log"
	procd_append_param command --logfile-maxbackups "$log_maxbackups"
	procd_append_param command --logfile-maxsize "$log_maxsize"
	procd_set_param env DAED_DEFAULT_LAN_INTERFACE="$lan_interface"
	[ ! -x /usr/libexec/router-audit ] || procd_append_param env ROUTER_AUDIT_DNS=1
	procd_set_param limits core="unlimited" nofile="1048576 1048576"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF" "passwall"
}
