 			}
Index: daed-2.1.1/third_party/outbound/protocol/vless/vision/packet_full_buffer_test.go
===================================================================
--- /dev/null	1970-01-01 00:00:00.000000000 +0000
+++ daed-2.1.1/third_party/outbound/protocol/vless/vision/packet_full_buffer_test.go	2026-11-01 22:22:09.427395340 +0800
@@ -0,0 +1,42 @@
+package vision
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net/netip"
+	"testing"
+)
+
+// dae's DNS forwarder reads UDP replies into a 65536-byte buffer. Comparing the
+// payload length with uint16(len(p)) wrapped that size to 0 and rejected every
+// reply as io.ErrShortBuffer.
+func TestReadFromAcceptsBuffersOf64KiBAndMore(t *testing.T) {
+	addr := netip.MustParseAddrPort("8.8.8.8:53")
+	payload := bytes.Repeat([]byte{0xab}, 120)
+	packetAddrLen := IPAddrToPacketAddrLength(addr)
+	for _, size := range []int{120, 512, 65535, 65536, 131072} {
+		var framed bytes.Buffer
+		var fl [2]byte
+		binary.BigEndian.PutUint16(fl[:], uint16(4+1+packetAddrLen))
+		framed.Write(fl[:])
+		framed.Write([]byte{0, 0, 0x02, 0x01})
+		framed.WriteByte(2)
+		addrBytes := make([]byte, packetAddrLen)
+		if err := PutPacketAddr(addrBytes, addr); err != nil {
+			t.Fatal(err)
+		}
+		framed.Write(addrBytes)
+		var ll [2]byte
+		binary.BigEndian.PutUint16(ll[:], uint16(len(payload)))
+		framed.Write(ll[:])
+		framed.Write(payload)
+
+		vc := &Conn{Conn: &bufferConn{Buffer: &framed}, toReadDirect: true}
+		vc.reader = &readWrapper{directRead: true, vision: vc}
+		pc := &PacketConn{Conn: vc}
+		n, from, err := pc.ReadFrom(make([]byte, size))
+		if err != nil || n != len(payload) || from != addr {
+			t.Errorf("buffer %d: n=%d from=%v err=%v, want %d bytes from %v", size, n, from, err, len(payload), addr)
+		}
+	}
+}
