 		length := binary.BigEndian.Uint16(lengthBytes[:])
 
-		if length > uint16(len(p)) {
+		if int(length) > len(p) {
 			if _, discardErr := io.CopyN(io.Discard, c.Conn, int64(length)); discardErr != nil {
