 	}
 	return nil, false
 }
+
+// relayDirectHandoverCandidate reports whether an end of a relay direction
+// can switch to its raw socket while the relay runs (XTLS Vision direct
+// mode, see netproxy.DirectTCPConnProvider). Only then does relayCopyLoop
+// look for a handover, so other flows pay nothing per chunk.
+func relayDirectHandoverCandidate(dst netproxy.Conn, src netproxy.Conn) bool {
+	_, dstOk := dst.(netproxy.DirectTCPConnProvider)
+	_, srcOk := src.(netproxy.DirectTCPConnProvider)
+	return dstOk || srcOk
+}
+
+// relayDirectReadTCPConn resolves the socket a relay direction may read from
+// in place of src: the provider's switched socket, or a transparent wrapper's
+// socket as for the splice fast path.
+func relayDirectReadTCPConn(src netproxy.Conn) (*net.TCPConn, bool) {
+	if p, ok := src.(netproxy.DirectTCPConnProvider); ok {
+		return p.DirectReadTCPConn()
+	}
+	return unwrapRelayTCPConn(src)
+}
+
+// relayDirectWriteTCPConn is relayDirectReadTCPConn for the writing end.
+func relayDirectWriteTCPConn(dst netproxy.Conn) (*net.TCPConn, bool) {
+	if p, ok := dst.(netproxy.DirectTCPConnProvider); ok {
+		return p.DirectWriteTCPConn()
+	}
+	return unwrapRelayTCPConn(dst)
+}
