+ */
+
+package control
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/daeuniverse/outbound/netproxy"
+)
+
+// directSwitchConn imitates XTLS Vision for the relay: Read and Write pass
+// through to the socket (standing in for the outer TLS phase) until the
+// configured number of calls has happened, then the matching direction
+// offers the socket through netproxy.DirectTCPConnProvider.
+type directSwitchConn struct {
+	*net.TCPConn
+	readsBeforeDirect  int64
+	writesBeforeDirect int64
+	reads              atomic.Int64
+	writes             atomic.Int64
+}
+
+var _ netproxy.DirectTCPConnProvider = (*directSwitchConn)(nil)
+
+func (c *directSwitchConn) Read(b []byte) (int, error) {
+	c.reads.Add(1)
+	return c.TCPConn.Read(b)
+}
+
+func (c *directSwitchConn) Write(b []byte) (int, error) {
+	c.writes.Add(1)
+	return c.TCPConn.Write(b)
+}
+
+func (c *directSwitchConn) DirectReadTCPConn() (*net.TCPConn, bool) {
+	if c.readsBeforeDirect < 0 || c.reads.Load() < c.readsBeforeDirect {
+		return nil, false
+	}
+	return c.TCPConn, true
+}
+
+func (c *directSwitchConn) DirectWriteTCPConn() (*net.TCPConn, bool) {
+	if c.writesBeforeDirect < 0 || c.writes.Load() < c.writesBeforeDirect {
+		return nil, false
+	}
+	return c.TCPConn, true
+}
+
+func newHandoverTCPPair(t *testing.T) (*net.TCPConn, *net.TCPConn) {
+	t.Helper()
+	ln, err := net.ListenTCP("tcp", &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer ln.Close()
+	type acceptResult struct {
+		conn *net.TCPConn
+		err  error
+	}
+	accepted := make(chan acceptResult, 1)
+	go func() {
+		c, err := ln.AcceptTCP()
+		accepted <- acceptResult{c, err}
+	}()
+	client, err := net.DialTCP("tcp", nil, ln.Addr().(*net.TCPAddr))
+	if err != nil {
+		t.Fatalf("dial: %v", err)
+	}
+	res := <-accepted
+	if res.err != nil {
+		t.Fatalf("accept: %v", res.err)
+	}
+	t.Cleanup(func() {
+		_ = client.Close()
+		_ = res.conn.Close()
+	})
+	return client, res.conn
+}
+
+type handoverResult struct {
+	written  int64
+	recorded int64
+	err      error
+}
+
+// runHandoverCopy relays src -> dst through relayCopyLoop while feeder
+// writes payload into the far end of src, and returns what the far end of
+// dst received.
+func runHandoverCopy(t *testing.T, dst, src netproxy.Conn, feed io.WriteCloser, sink io.Reader, payload []byte) (handoverResult, []byte) {
+	t.Helper()
+	var recorded atomic.Int64
+	done := make(chan handoverResult, 1)
+	go func() {
+		buf := make([]byte, relayCopyBufferSize)
+		n, err := relayCopyLoop(context.Background(), dst, src, buf,
+			func(n int64) { recorded.Add(n) }, nil)
+		// relayCore half-closes the destination when a direction ends.
+		closeWriteRelayConn(dst)
+		done <- handoverResult{written: n, err: err}
+	}()
+
+	var wg sync.WaitGroup
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		// Small writes first so the relay sees several chunks before the
+		// switch, then the bulk.
+		for i := 0; i < 4 && len(payload) > 0; i++ {
+			k := min(1024, len(payload))
+			_, _ = feed.Write(payload[:k])
+			payload = payload[k:]
+			time.Sleep(5 * time.Millisecond)
+		}
+		_, _ = feed.Write(payload)
+		_ = feed.(interface{ CloseWrite() error }).CloseWrite()
+	}()
+
+	got, err := io.ReadAll(sink)
+	if err != nil {
+		t.Fatalf("read relayed bytes: %v", err)
+	}
+	wg.Wait()
+	select {
+	case res := <-done:
+		res.recorded = recorded.Load()
+		return res, got
+	case <-time.After(5 * time.Second):
+		t.Fatal("relayCopyLoop did not return")
+	}
+	return handoverResult{}, nil
+}
+
+func handoverPayload(t *testing.T) []byte {
+	t.Helper()
+	payload := make([]byte, 8<<20)
+	if _, err := rand.Read(payload); err != nil {
+		t.Fatal(err)
+	}
+	return payload
+}
+
+// Download direction: the proxy conn is the source and switches its reads to
+// the raw socket after the first chunk; the rest must move to splice, in
+// order and fully accounted.
+func TestRelayCopyLoopHandsSwitchedReadsToSplice(t *testing.T) {
+	upFar, upNear := newHandoverTCPPair(t)
+	lanNear, lanFar := newHandoverTCPPair(t)
+	src := &directSwitchConn{TCPConn: upNear, readsBeforeDirect: 1, writesBeforeDirect: -1}
+
+	payload := handoverPayload(t)
+	res, got := runHandoverCopy(t, lanNear, src, upFar, lanFar, payload)
+
+	if res.err != nil {
+		t.Fatalf("relayCopyLoop: %v", res.err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("relayed %d bytes, want %d identical bytes", len(got), len(payload))
+	}
+	if res.written != int64(len(payload)) || res.recorded != int64(len(payload)) {
+		t.Fatalf("written=%d recorded=%d, want %d", res.written, res.recorded, len(payload))
+	}
+	if n := src.reads.Load(); n != 1 {
+		t.Fatalf("proxy conn Read called %d times; want 1 before the splice handover", n)
+	}
+}
+
+// Upload direction: the proxy conn is the destination and switches its
+// writes after the first chunk.
+func TestRelayCopyLoopHandsSwitchedWritesToSplice(t *testing.T) {
+	lanFar, lanNear := newHandoverTCPPair(t)
+	upNear, upFar := newHandoverTCPPair(t)
+	dst := &directSwitchConn{TCPConn: upNear, readsBeforeDirect: -1, writesBeforeDirect: 1}
+
+	payload := handoverPayload(t)
+	res, got := runHandoverCopy(t, dst, lanNear, lanFar, upFar, payload)
+
+	if res.err != nil {
+		t.Fatalf("relayCopyLoop: %v", res.err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("relayed %d bytes, want %d identical bytes", len(got), len(payload))
+	}
+	if res.written != int64(len(payload)) || res.recorded != int64(len(payload)) {
+		t.Fatalf("written=%d recorded=%d, want %d", res.written, res.recorded, len(payload))
+	}
+	if n := dst.writes.Load(); n != 1 {
+		t.Fatalf("proxy conn Write called %d times; want 1 before the splice handover", n)
+	}
+}
+
+// A conn that never switches (inner traffic not TLS 1.3) stays on the copy
+// loop for its whole life.
+func TestRelayCopyLoopKeepsUnswitchedProxyConn(t *testing.T) {
+	lanFar, lanNear := newHandoverTCPPair(t)
+	upNear, upFar := newHandoverTCPPair(t)
+	dst := &directSwitchConn{TCPConn: upNear, readsBeforeDirect: -1, writesBeforeDirect: -1}
+
+	payload := handoverPayload(t)
+	res, got := runHandoverCopy(t, dst, lanNear, lanFar, upFar, payload)
+
+	if res.err != nil {
+		t.Fatalf("relayCopyLoop: %v", res.err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatalf("relayed %d bytes, want %d identical bytes", len(got), len(payload))
+	}
+	if n := dst.writes.Load(); n < int64(len(payload)/relayCopyBufferSize) {
+		t.Fatalf("proxy conn Write called %d times; the copy loop should have carried every chunk", n)
+	}
+}
+
+// Bytes a LAN-side wrapper still buffers (sniffed prefix) must reach the
+// proxy socket before anything spliced from the LAN socket.
+func TestRelayDirectHandoverFlushesSourcePrefixFirst(t *testing.T) {
+	lanFar, lanNear := newHandoverTCPPair(t)
+	upNear, upFar := newHandoverTCPPair(t)
+	dst := &directSwitchConn{TCPConn: upNear, readsBeforeDirect: -1, writesBeforeDirect: 0}
+	prefix := []byte("sniffed-client-hello|")
+	src := &prefixedConn{Conn: lanNear, prefix: append([]byte(nil), prefix...)}
+
+	payload := handoverPayload(t)
+	res, got := runHandoverCopy(t, dst, src, lanFar, upFar, payload)
+
+	if res.err != nil {
+		t.Fatalf("relayCopyLoop: %v", res.err)
+	}
+	want := append(append([]byte(nil), prefix...), payload...)
+	if !bytes.Equal(got, want) {
+		t.Fatalf("relayed %d bytes, want prefix then payload (%d bytes)", len(got), len(want))
+	}
+	if res.written != int64(len(want)) || res.recorded != int64(len(want)) {
+		t.Fatalf("written=%d recorded=%d, want %d", res.written, res.recorded, len(want))
+	}
+	if n := dst.writes.Load(); n != 0 {
+		t.Fatalf("proxy conn Write called %d times; want an immediate handover", n)
+	}
+}
+
+// Flows without a DirectTCPConnProvider never look for a handover.
+func TestRelayDirectHandoverCandidateOnlyForProviders(t *testing.T) {
+	a, b := newHandoverTCPPair(t)
+	if relayDirectHandoverCandidate(a, b) {
+		t.Fatal("plain TCP pair reported as handover candidate")
+	}
+	p := &directSwitchConn{TCPConn: a}
+	if !relayDirectHandoverCandidate(p, b) || !relayDirectHandoverCandidate(b, p) {
+		t.Fatal("provider not reported as handover candidate")
+	}
+}
