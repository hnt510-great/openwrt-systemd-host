--- /dev/null
+++ b/dae-core/control/router_audit.go
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package control
+
+import (
+	"encoding/json"
+	dnsmessage "github.com/miekg/dns"
+	"golang.org/x/sys/unix"
+	"os"
+	"strconv"
+	"sync/atomic"
+	"time"
+)
+
+var routerAuditEnabled = os.Getenv("ROUTER_AUDIT_DNS") == "1"
+var routerAuditFD = func() int {
+	if !routerAuditEnabled {
+		return -1
+	}
+	f, e := unix.Socket(unix.AF_UNIX, unix.SOCK_DGRAM|unix.SOCK_NONBLOCK|unix.SOCK_CLOEXEC, 0)
+	if e != nil {
+		return -1
+	}
+	return f
+}()
+var routerAuditSeq atomic.Uint64
+var routerAuditDropped atomic.Uint64
+var routerAuditEpoch = strconv.Itoa(os.Getpid()) + "-" + strconv.FormatInt(time.Now().UnixNano(), 10)
+
+type routerAuditEvent struct {
+	Source   string  `json:"source"`
+	Epoch    string  `json:"source_epoch"`
+	Seq      uint64  `json:"source_seq"`
+	Time     string  `json:"event_time"`
+	Client   string  `json:"client"`
+	QName    string  `json:"qname"`
+	QType    uint16  `json:"qtype"`
+	Rcode    *int    `json:"rcode"`
+	Cache    bool    `json:"cache"`
+	Duration float64 `json:"duration_ms"`
+	Failed   bool    `json:"failed"`
+	Dropped  uint64  `json:"producer_dropped"`
+	start    time.Time
+}
+
+func newRouterAuditEvent(m *dnsmessage.Msg, r *udpRequest, w dnsmessage.ResponseWriter) *routerAuditEvent {
+	t := time.Now()
+	client := r.realSrc.String()
+	if w != nil && w.RemoteAddr() != nil {
+		client = w.RemoteAddr().String()
+	}
+	return &routerAuditEvent{Source: "daed", Epoch: routerAuditEpoch, Seq: routerAuditSeq.Add(1), Time: t.UTC().Format(time.RFC3339Nano), Client: client, QName: m.Question[0].Name, QType: m.Question[0].Qtype, start: t}
+}
+func routerAuditReply(r *udpRequest, data []byte) {
+	if r != nil && r.audit != nil && len(data) >= 4 {
+		code := int(data[3] & 15)
+		r.audit.Rcode = &code
+	}
+}
+func (e *routerAuditEvent) finish(err error) {
+	e.Duration = float64(time.Since(e.start).Microseconds()) / 1000
+	e.Failed = err != nil
+	e.Dropped = routerAuditDropped.Load()
+	b, er := json.Marshal(e)
+	if er != nil {
+		return
+	}
+	if routerAuditFD < 0 || unix.Sendto(routerAuditFD, b, unix.MSG_DONTWAIT, &unix.SockaddrUnix{Name: "/run/router-audit/dns.sock"}) != nil {
+		routerAuditDropped.Add(1)
+	}
+}
+
+type routerAuditWriter struct {
+	dnsmessage.ResponseWriter
+	event *routerAuditEvent
+}
+
+func (w *routerAuditWriter) WriteMsg(m *dnsmessage.Msg) error {
+	code := m.Rcode
+	w.event.Rcode = &code
+	return w.ResponseWriter.WriteMsg(m)
+}
+func (w *routerAuditWriter) Write(b []byte) (int, error) {
+	if len(b) >= 4 {
+		code := int(b[3] & 15)
+		w.event.Rcode = &code
+	}
+	return w.ResponseWriter.Write(b)
+}
