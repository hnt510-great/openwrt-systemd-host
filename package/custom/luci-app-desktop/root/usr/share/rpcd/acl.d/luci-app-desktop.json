{
	"luci-app-desktop": {
		"description": "Inspect, configure and control the OpenWrt desktop session",
		"read": {
			"ubus": {
				"luci.desktop": [ "status", "logs" ]
			},
			"uci": [ "desktop" ]
		},
		"write": {
			"ubus": {
				"luci.desktop": [ "action", "switch", "sync_boot" ]
			},
			"uci": [ "desktop" ]
		}
	}
}
