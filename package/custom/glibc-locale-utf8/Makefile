include $(TOPDIR)/rules.mk

PKG_NAME:=glibc-locale-utf8
# Keep the integration revision independent of libc's runtime release and
# previously allocated ELF metadata rebuild identities.
GLIBC_LOCALE_RELEASE:=2

ifeq ($(DUMP),1)
  GLIBC_VERSION:=<LIBC_VERSION>
  GLIBC_RUNTIME_VERSION:=<LIBC_VERSION>-r<LIBC_RELEASE>
  GLIBC_RUNTIME_RELEASE:=<LIBC_RELEASE>
else
  GLIBC_VERSION:=$(LIBC_VERSION)
  GLIBC_RUNTIME_VERSION:=$(strip $(shell cat $(STAGING_DIR)/libc.version 2>/dev/null))
  ifeq ($(GLIBC_RUNTIME_VERSION),)
    $(error Missing $(STAGING_DIR)/libc.version; build the target libc package first)
  endif
  GLIBC_RUNTIME_RELEASE:=$(patsubst $(GLIBC_VERSION)-r%,%,$(GLIBC_RUNTIME_VERSION))
  ifeq ($(GLIBC_RUNTIME_RELEASE),$(GLIBC_RUNTIME_VERSION))
    $(error Unexpected target libc version: $(GLIBC_RUNTIME_VERSION))
  endif
endif

PKG_VERSION:=$(GLIBC_VERSION)_p$(GLIBC_LOCALE_RELEASE)
PKG_RELEASE:=$(GLIBC_RUNTIME_RELEASE)
PKG_LICENSE:=LGPL-2.1-or-later

include $(INCLUDE_DIR)/package.mk

PKG_FILE_DEPENDS += $(TOOLCHAIN_DIR)/bin/localedef $(TOOLCHAIN_DIR)/share/i18n

define Package/glibc-locale-utf8
  SECTION:=libs
  CATEGORY:=Libraries
  TITLE:=UTF-8 locale data for C, English and Simplified Chinese
  URL:=https://www.gnu.org/software/libc/
  DEPENDS:=@TARGET_x86_64 @USE_GLIBC @!EXTERNAL_TOOLCHAIN +libc
  EXTRA_DEPENDS:=libc (=$(GLIBC_RUNTIME_VERSION))
endef

define Package/glibc-locale-utf8/description
  C.UTF-8, en_US.UTF-8 and zh_CN.UTF-8 data generated by the matching target
  glibc localedef, without copying locale archives from the build host.
  Also accepts the lowercase en_us.utf-8 spelling.
endef

define Build/Compile
	$(INSTALL_DIR) $(PKG_BUILD_DIR)/locale
	for spec in C:C.utf8 en_US:en_US.utf8 zh_CN:zh_CN.utf8; do \
		I18NPATH=$(TOOLCHAIN_DIR)/share/i18n $(TOPDIR)/scripts/gi-target-runner \
			$(TOOLCHAIN_DIR)/bin/localedef --no-archive -i $$$${spec%:*} -f UTF-8 \
			$(PKG_BUILD_DIR)/locale/$$$${spec#*:} || exit 1; \
	done
endef

define Package/glibc-locale-utf8/install
	$(INSTALL_DIR) $(1)/usr/lib/locale
	$(CP) $(PKG_BUILD_DIR)/locale/. $(1)/usr/lib/locale/
	# glibc normalizes the codeset, but preserves language/territory case.
	$(LN) en_US.utf8 $(1)/usr/lib/locale/en_us.utf8
endef

$(eval $(call BuildPackage,glibc-locale-utf8))
