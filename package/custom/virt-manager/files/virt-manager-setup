#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run virt-manager-setup as root' >&2; exit 1; }
revoke=0
if [ "${1:-}" = --revoke ]; then revoke=1; shift; fi
[ "$#" = 1 ] || { echo 'Usage: virt-manager-setup [--revoke] USER' >&2; exit 1; }
virt_manager_error() {
	logger -t virt-manager-setup "$*" 2>/dev/null || :
	printf '%s\n' "$*" >&2
	return 1
}
virt_manager_validate_user() {
	local name record hash uid gid home shell
	name="$1"
	case "$name" in
		''|-*|*[!a-zA-Z0-9_-]*) virt_manager_error 'Invalid username'; return 1 ;;
	esac
	record="$(awk -F: -v name="$name" '$1 == name { print; exit }' /etc/passwd)"
	[ -n "$record" ] || { virt_manager_error "Account $name does not exist"; return 1; }
	IFS=: read -r _ _ uid gid _ home shell <<EOF
$record
EOF
	case "$uid" in
		''|*[!0-9]*) virt_manager_error 'Invalid UID'; return 1 ;;
	esac
	[ "$uid" -ge 1000 ] || {
		virt_manager_error 'An ordinary user with UID >= 1000 is required'; return 1;
	}
	case "$gid" in
		''|*[!0-9]*) virt_manager_error 'Invalid primary group'; return 1 ;;
	esac
	[ "$gid" -gt 0 ] || {
		virt_manager_error 'The account must have a non-root primary group'; return 1;
	}
	case "$home" in
		/*) ;;
		*) virt_manager_error 'The account requires an absolute home directory'; return 1 ;;
	esac
	[ -d "$home" ] && [ -x "$shell" ] || {
		virt_manager_error 'Create the home directory and configure a valid login shell first'; return 1;
	}
	case "$shell" in
		*/false|*/nologin) virt_manager_error 'The account requires a login shell'; return 1 ;;
	esac
	hash="$(awk -F: -v name="$name" '$1 == name { print $2; exit }' /etc/shadow)"
	case "$hash" in
		''|'!'*|'*'*) virt_manager_error 'Set an unlocked, nonempty account password first'; return 1 ;;
	esac
}
user=$1
if [ "$revoke" = 0 ]; then
	virt_manager_validate_user "$user"
else
	case "$user" in ''|-*|*[!a-zA-Z0-9_-]*) echo 'Invalid username' >&2; exit 1 ;; esac
	awk -F: -v name="$user" '$1 == name && $3 >= 1000 && $4 > 0 { found=1 } END { exit !found }' /etc/passwd || {
		echo 'An existing ordinary account is required' >&2; exit 1;
	}
fi
if ! awk -F: '$1 == "libvirt-admin" { found=1 } END { exit !found }' /etc/group; then
	[ "$revoke" = 0 ] || { echo 'User is not authorized'; exit 0; }
	groupadd -r libvirt-admin
fi
render_grant="/etc/libvirt/render-access/$user"
if [ "$revoke" = 1 ]; then
	if [ -f "$render_grant" ]; then
		if id -nG "$user" | tr ' ' '\n' | grep -qx render; then gpasswd -d "$user" render; fi
		rm -f "$render_grant"
	fi
	if id -nG "$user" | tr ' ' '\n' | grep -qx libvirt-admin; then gpasswd -d "$user" libvirt-admin; fi
else
	usermod -a -G libvirt-admin "$user"
	if ! id -nG "$user" | tr ' ' '\n' | grep -qx render; then
		mkdir -p /etc/libvirt/render-access
		chmod 0700 /etc/libvirt/render-access
		: > "$render_grant"
		chmod 0600 "$render_grant"
		usermod -a -G render "$user"
	fi
	for daemon in virtqemud virtstoraged virtsecretd virtnodedevd virtnwfilterd; do
		for suffix in '' '-ro'; do
			unit="$daemon$suffix.socket"
			dir="/etc/systemd/system/$unit.d"
			mkdir -p "$dir"
			cat > "$dir/zz-desktop-access.conf" <<EOF
[Socket]
SocketUser=root
SocketGroup=libvirt-admin
SocketMode=0660
EOF
			chmod 0644 "$dir/zz-desktop-access.conf"
			socket="/run/libvirt/$daemon-sock$suffix"
			if [ -S "$socket" ]; then chgrp libvirt-admin "$socket"; chmod 0660 "$socket"; fi
		done
	done
	systemctl daemon-reload
	mkdir -p /etc/libvirt
	printf 'group=libvirt-admin\n' > /etc/libvirt/desktop-access
	echo 'libvirt-admin grants full local VM management with privileges comparable to root.'
fi
printf 'Restart the desktop and any login sessions of %s to apply the group change.\n' "$user"
[ "$revoke" = 0 ] || echo 'Existing libvirt connections remain authorized until those applications exit.'
