+    @staticmethod
+    def local_rendernodes(conn):
+        # OpenWrt has no udev-backed libvirt node-device daemon.
+        if not conn.is_qemu() or conn.is_remote():
+            return []
+        nodes = []
+        for path in sorted(glob.glob("/dev/dri/renderD[0-9]*")):
+            try:
+                if stat.S_ISCHR(os.stat(path).st_mode):
+                    nodes.append(path)
+            except OSError:
+                continue
+        return nodes
