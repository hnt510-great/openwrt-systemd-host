Subject: Make libgee optional when gcalc is disabled and skip help and tests

--- a/meson.build
+++ b/meson.build
@@ -37,7 +37,7 @@ gobject = dependency('gobject-2.0', version: '>= ' + glib_min_version)
 libxml = dependency('libxml-2.0')
 libsoup = dependency('libsoup-3.0', version: '>= ' + libsoup_min_version)
-gee = dependency('gee-0.8', version: '>= 0.20.0')
+gee = dependency('gee-0.8', version: '>= 0.20.0', required: get_option('gcalc'))
 gobject_introspection = dependency('gobject-introspection-1.0', required: false)
 
 introspection = not get_option('disable-introspection')
 if not gobject_introspection.found()
@@ -129,12 +129,9 @@ subdir('data')
 subdir('lib')
 subdir('src')
 subdir('search-provider')
-subdir('help')
 endif
 endif
 
