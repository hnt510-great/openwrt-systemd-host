[Unit]
Description=OpenWrt KDE Plasma settings and LAN remote access helper
PartOf=plasma-workspace.target
After=plasma-workspace.target

[Service]
Type=simple
ExecStart=/usr/libexec/desktop-plasma-remotes
Restart=on-failure
RestartSec=3s
TimeoutStopSec=5s

[Install]
WantedBy=plasma-workspace.target
