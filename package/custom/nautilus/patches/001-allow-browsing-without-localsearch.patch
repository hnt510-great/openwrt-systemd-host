From: OpenWrt desktop maintainers
Subject: [PATCH] Allow file browsing without LocalSearch settings

LocalSearch is not installed in the minimal desktop profile. Avoid the
fatal GSettings lookup and report no indexed locations when its schema is
absent.
Nautilus retains its filesystem search provider and handles an unavailable
LocalSearch D-Bus connection through its existing fallback paths.

---
--- a/src/nautilus-global-preferences.c
+++ b/src/nautilus-global-preferences.c
@@ -109,7 +109,11 @@
     gnome_lockdown_preferences = g_settings_new ("org.gnome.desktop.lockdown");
     gnome_interface_preferences = g_settings_new ("org.gnome.desktop.interface");
     gnome_privacy_preferences = g_settings_new ("org.gnome.desktop.privacy");
-    localsearch_preferences = g_settings_new ("org.freedesktop.Tracker3.Miner.Files");
+    /* LocalSearch is optional; ordinary file browsing does not need it. */
+    if (check_schema_available ("org.freedesktop.Tracker3.Miner.Files"))
+    {
+        localsearch_preferences = g_settings_new ("org.freedesktop.Tracker3.Miner.Files");
+    }
 
     if (check_schema_available (FILE_SHARING_SCHEMA_ID) &&
         check_schema_available (FILE_SHARING_SERVICE_SCHEMA_ID))
--- a/src/nautilus-localsearch-utilities.c
+++ b/src/nautilus-localsearch-utilities.c
@@ -225,6 +225,11 @@
     gint idx;
     GFile *location;
 
+    if (localsearch_preferences == NULL)
+    {
+        return NULL;
+    }
+
     locations = g_settings_get_strv (localsearch_preferences, key);
 
     for (idx = 0; locations[idx] != NULL; idx++)
