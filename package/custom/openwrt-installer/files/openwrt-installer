#!/usr/bin/python3
import argparse
import json
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, '/usr/lib/openwrt-installer')
import apply
import core
import tui

parser = argparse.ArgumentParser(description='Install OpenWrt on an entire disk (erases all existing data)')
parser.add_argument('--answers', type=Path)
parser.add_argument('--dry-run', action='store_true')
args = parser.parse_args()
try:
    # Driver coldplug is needed even though the regular OpenWrt service target is inactive.
    if Path('/sbin/kmodloader').exists() and not core.nics():
        # Missing optional hardware (for example hwmon chips) is normal.
        subprocess.run(['/sbin/kmodloader'])
    _, disk = apply.live_media()
    payload = Path('/run/openwrt-installer/media')
    payload.mkdir(parents=True, exist_ok=True)
    if not subprocess.run(['mountpoint', '-q', str(payload)]).returncode == 0:
        device = disk if apply.optical_media(disk) else core.partition(disk, 1)
        apply.run('mount', '-t', 'iso9660', '-o', 'ro', device, str(payload))
    payload = payload / 'install'
    manifest = json.loads((payload / 'manifest.json').read_text())
    if args.answers:
        result = apply.install(json.loads(args.answers.read_text()), manifest, payload, dry_run=args.dry_run)
        print(json.dumps(result, indent=2))
    elif args.dry_run:
        parser.error('--dry-run requires --answers')
    else:
        tui.main(manifest, payload)
except Exception as exc:
    with open('/tmp/openwrt-installer.log', 'a') as log:
        log.write(str(exc) + '\n')
    print(str(exc), file=sys.stderr)
    if not args.answers:
        subprocess.run(['/bin/sh'])
    sys.exit(1)
