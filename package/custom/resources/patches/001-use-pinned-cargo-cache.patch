Subject: Use the Cargo cache populated from the locked source manifest

--- a/src/meson.build
+++ b/src/meson.build
@@ -27,7 +27,12 @@ else
   message('Building in debug mode')
 endif
 
-cargo_env = ['CARGO_HOME=' + meson.project_build_root() / 'cargo']
+cargo_env = ['CARGO_HOME=' + run_command('sh', '-c', 'printf %s "$CARGO_HOME"', check: true).stdout()]
+if meson.is_cross_build()
+  rust_artifact_dir = 'src' / meson.get_external_property('rust_target') / rust_target
+else
+  rust_artifact_dir = 'src' / rust_target
+endif
 
 test(
   'Cargo tests (main application)',
@@ -62,7 +67,7 @@ copy_binary = custom_target(
   output: meson.project_name(),
   command: [
     'cp',
-    'src' / rust_target / meson.project_name(),
+    rust_artifact_dir / meson.project_name(),
     '@OUTPUT@',
   ],
 )
@@ -77,7 +82,7 @@ copy_kill_binary = custom_target(
   output: meson.project_name() + '-kill',
   command: [
     'cp',
-    'src' / rust_target / meson.project_name() + '-kill',
+    rust_artifact_dir / meson.project_name() + '-kill',
     '@OUTPUT@',
   ],
 )
@@ -92,7 +97,7 @@ copy_processes_binary = custom_target(
   output: meson.project_name() + '-processes',
   command: [
     'cp',
-    'src' / rust_target / meson.project_name() + '-processes',
+    rust_artifact_dir / meson.project_name() + '-processes',
     '@OUTPUT@',
   ],
 )
@@ -107,7 +112,7 @@ copy_adjust_binary = custom_target(
   output: meson.project_name() + '-adjust',
   command: [
     'cp',
-    'src' / rust_target / meson.project_name() + '-adjust',
+    rust_artifact_dir / meson.project_name() + '-adjust',
     '@OUTPUT@',
   ],
 )
