#!/bin/sh
set -eu
. /usr/libexec/desktop-common.sh
[ "$(id -u)" = 0 ] || { echo 'Run sunshine-setup as root' >&2; exit 1; }
[ "$#" = 2 ] && [ "$2" = --enable-kms ] || {
	echo 'Usage: sunshine-setup USER --enable-kms' >&2; exit 1;
}
user=$1
desktop_validate_user "$user"
[ -d /run/systemd/system ] && [ "$(uci -q get desktop.main.user || :)" = "$user" ] || {
	echo 'Configure this ordinary user with desktop-setup first' >&2; exit 1;
}
/usr/sbin/desktop-audio-setup "$user"
grep -q '^sunshine:' /etc/group || groupadd -r sunshine
usermod -a -G sunshine,video,render "$user"
# Explicit enrollment grants broad KMS capture capability and virtual input access.
[ ! -L /etc/desktop/sunshine-users ] || { echo 'Unsafe Sunshine enrollment file' >&2; exit 1; }
umask 077
tmp=$(mktemp /etc/desktop/.sunshine-users.XXXXXX)
trap 'rm -f "$tmp"' EXIT HUP INT TERM
printf '%s\n' "$user" > "$tmp"
mv "$tmp" /etc/desktop/sunshine-users
/usr/libexec/sunshine-permissions
runtime=/run/user/$DESKTOP_USER_UID
su -s /bin/sh -c "XDG_RUNTIME_DIR=$runtime DBUS_SESSION_BUS_ADDRESS=unix:path=$runtime/bus systemctl --user --no-reload enable sunshine.service" "$user"
printf 'Sunshine enrolled for %s: CAP_SYS_ADMIN permits KMS capture; /dev/uinput permits virtual input.\n' "$user"
printf 'Start a new desktop session to apply group membership. Set Web UI credentials and pair Moonlight at https://LAN-IP:47990.\n'
