#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || exit 1
state=/etc/desktop/sunshine-users
[ -s "$state" ] || exit 0
[ -f "$state" ] && [ ! -L "$state" ] && [ "$(stat -c %u:%a "$state")" = 0:600 ] || {
	echo 'Unsafe Sunshine enrollment state' >&2; exit 1;
}
. /usr/libexec/desktop-common.sh
user=$(cat "$state")
desktop_validate_user "$user"
[ "$(uci -q get desktop.main.user || :)" = "$user" ] || exit 1
id -Gn "$user" | tr ' ' '\n' | grep -qx sunshine || exit 1
# The root-owned executable is only runnable by the enrolled capture group.
[ -f /usr/bin/sunshine ] && [ ! -L /usr/bin/sunshine ] || exit 1
if [ "$(stat -c %U:%G:%a /usr/bin/sunshine)" != root:sunshine:750 ]; then
	chown root:sunshine /usr/bin/sunshine
	chmod 0750 /usr/bin/sunshine
fi
setfacl -m "u:$DESKTOP_USER_UID:rx" /usr/bin/sunshine
if [ "$(uci -q get desktop.main.sunshine_capture || :)" = kms ]; then
	if [ "$(getcap /usr/bin/sunshine)" != '/usr/bin/sunshine cap_sys_admin=p' ]; then
		setcap cap_sys_admin+p /usr/bin/sunshine
	fi
elif [ -n "$(getcap /usr/bin/sunshine)" ]; then
	setcap -r /usr/bin/sunshine
fi
if [ -c /dev/uinput ]; then
	setfacl -m "u:$DESKTOP_USER_UID:rw" /dev/uinput
fi
