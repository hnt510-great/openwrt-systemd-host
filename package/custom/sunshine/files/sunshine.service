[Unit]
Description=Sunshine Moonlight host for the GNOME desktop
PartOf=gnome-session.target
ConditionPathExists=/run/openwrt-desktop/%U.env
Requires=pipewire-pulse.service wireplumber.service
After=pipewire-pulse.service wireplumber.service

[Service]
EnvironmentFile=/run/openwrt-desktop/%U.env
Type=simple
ExecStart=/usr/libexec/sunshine-session
Restart=on-failure
RestartSec=5
# KMS uses the explicitly enrolled executable's permitted file capability.
NoNewPrivileges=false
UMask=0077

[Install]
WantedBy=gnome-session.target
