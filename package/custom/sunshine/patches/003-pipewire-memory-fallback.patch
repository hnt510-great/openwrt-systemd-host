Subject: [PATCH] pipewire: support mapped MemFd capture without EGL DMA-BUF

--- a/src/platform/linux/pipewire.cpp
+++ b/src/platform/linux/pipewire.cpp
@@ -595,7 +595,7 @@
             std::scoped_lock lock(d->frame_mutex);
             d->shared->current_state = state;
             d->shared->previous_state = old;
-            d->shared->err_msg = std::string(err_msg);
+            d->shared->err_msg = err_msg ? err_msg : "";
           }
           [[fallthrough]];
         case PW_STREAM_STATE_UNCONNECTED:
@@ -725,7 +725,7 @@
         buffer_types |= 1 << SPA_DATA_DmaBuf;
       } else {
         BOOST_LOG(info) << "[pipewire] using memory buffers"sv;
-        buffer_types |= 1 << SPA_DATA_MemPtr;
+        buffer_types |= (1 << SPA_DATA_MemPtr) | (1 << SPA_DATA_MemFd);
       }
 
       // Ack the buffer type and metadata
@@ -867,7 +867,10 @@
       mem_type = hwdevice_type;
 
       if (get_dmabuf_modifiers() < 0) {
-        return -1;
+        if (hwdevice_type != platf::mem_type_e::system) {
+          return -1;
+        }
+        BOOST_LOG(info) << "[pipewire] DMA-BUF unavailable; using mapped memory for software encoding"sv;
       }
 
       int pipewire_fd = -1;
