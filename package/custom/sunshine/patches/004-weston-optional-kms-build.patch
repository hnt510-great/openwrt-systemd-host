Subject: [PATCH] weston: guard optional KMS worker privilege cleanup

--- a/src/platform/linux/misc.cpp
+++ b/src/platform/linux/misc.cpp
@@ -1305,7 +1305,9 @@
   std::shared_ptr<display_t> display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config) {
 #ifdef SUNSHINE_BUILD_WESTON
     if (sources[source::WESTON]) {
+#ifdef SUNSHINE_BUILD_DRM
       platf::kms::drop_drm_worker_privileges();
+#endif
       BOOST_LOG(info) << "Screencasting with Weston PipeWire"sv;
       return weston_display(hwdevice_type, display_name, config);
     }
