Subject: [PATCH] capture: consume the selected Weston PipeWire mirror

--- a/cmake/prep/options.cmake
+++ b/cmake/prep/options.cmake
@@ -59,6 +59,8 @@
     option(SUNSHINE_CONFIGURE_FLATPAK_MAN
             "Configure manifest file required for Flatpak build. Recommended to use with SUNSHINE_CONFIGURE_ONLY" OFF)
 
+    option(SUNSHINE_ENABLE_WESTON "Enable direct Weston PipeWire capture" OFF)
+
     # Linux capture methods
     option(SUNSHINE_ENABLE_CUDA
             "Enable cuda specific code." ON)
--- a/cmake/compile_definitions/linux.cmake
+++ b/cmake/compile_definitions/linux.cmake
@@ -252,7 +252,7 @@
 endif()
 
 # Pipewire
-if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL})
+if(${SUNSHINE_ENABLE_KWIN} OR ${SUNSHINE_ENABLE_PORTAL} OR ${SUNSHINE_ENABLE_WESTON})
     pkg_check_modules(PIPEWIRE libpipewire-0.3 REQUIRED)
 else()
     set(PIPEWIRE_FOUND OFF)
@@ -262,6 +262,15 @@
     list(APPEND PLATFORM_LIBRARIES ${PIPEWIRE_LIBRARIES})
     list(APPEND PLATFORM_TARGET_FILES
             "${CMAKE_SOURCE_DIR}/src/platform/linux/pipewire.cpp")
+endif()
+
+# Weston shares the PipeWire transport, with explicit stream discovery instead of a portal.
+if(${SUNSHINE_ENABLE_WESTON})
+    if(NOT PIPEWIRE_FOUND OR NOT WAYLAND_FOUND)
+        message(FATAL_ERROR "Weston capture requires PipeWire and Wayland")
+    endif()
+    add_compile_definitions(SUNSHINE_BUILD_WESTON)
+    list(APPEND PLATFORM_TARGET_FILES "${CMAKE_SOURCE_DIR}/src/platform/linux/westongrab.cpp")
 endif()
 
 # XDG portal
--- a/src/platform/linux/misc.cpp
+++ b/src/platform/linux/misc.cpp
@@ -1153,6 +1153,9 @@
 #ifdef SUNSHINE_BUILD_PORTAL
       PORTAL,  ///< XDG PORTAL
 #endif
+#ifdef SUNSHINE_BUILD_WESTON
+      WESTON,
+#endif
       MAX_FLAGS  ///< The maximum number of flags
     };
   }  // namespace source
@@ -1233,10 +1236,20 @@
   }
 #endif
 
+#ifdef SUNSHINE_BUILD_WESTON
+  std::vector<std::string> weston_display_names();
+  std::shared_ptr<display_t> weston_display(mem_type_e type, const std::string &name, const video::config_t &config);
+#endif
+
   /**
    * @brief List display names accepted by the selected capture backend.
    */
   std::vector<std::string> display_names(mem_type_e hwdevice_type) {
+#ifdef SUNSHINE_BUILD_WESTON
+    if (sources[source::WESTON]) {
+      return weston_display_names();
+    }
+#endif
 #ifdef SUNSHINE_BUILD_CUDA
     // display using NvFBC only supports mem_type_e::cuda
     if (sources[source::NVFBC] && hwdevice_type == mem_type_e::cuda) {
@@ -1290,6 +1303,14 @@
   }
 
   std::shared_ptr<display_t> display(mem_type_e hwdevice_type, const std::string &display_name, const video::config_t &config) {
+#ifdef SUNSHINE_BUILD_WESTON
+    if (sources[source::WESTON]) {
+      platf::kms::drop_drm_worker_privileges();
+      BOOST_LOG(info) << "Screencasting with Weston PipeWire"sv;
+      return weston_display(hwdevice_type, display_name, config);
+    }
+#endif
+
     // Please ensure that KMS followed by CUDA remains at the top so that we can
     // drop DRM worker privileges once neither backend requires it.
 
@@ -1405,6 +1426,12 @@
     }
 #endif
 
+#ifdef SUNSHINE_BUILD_WESTON
+    // Never select this custom backend implicitly or silently fall back from it.
+    if (config::video.capture == "weston" && !weston_display_names().empty()) {
+      sources[source::WESTON] = true;
+    }
+#endif
     if (sources.none()) {
       BOOST_LOG(error) << "Unable to initialize capture method"sv;
       return nullptr;
