Subject: Respect Wayland-only GTK when probing X11 and VA-X11

--- a/meson.build
+++ b/meson.build
@@ -149,14 +149,17 @@
   spice_gtk_deps += d
   spice_gtk_deps += dependency('epoxy', required: spice_gtk_has_egl)
   if host_machine.system() != 'windows'
-    d = dependency('x11', required: false)
-    if d.found()
-      spice_gtk_deps += d
-    endif
-    d = dependency('libva-x11', required: false)
-    if d.found()
-      spice_gtk_deps += d
-      spice_gtk_config_data.set('HAVE_LIBVA', '1')
+    # Honor the GTK build's backend selection even when X11 is staged.
+    if compiler.has_header('gtk-3.0/gdk/gdkx.h')
+      d = dependency('x11', required: false)
+      if d.found()
+        spice_gtk_deps += d
+      endif
+      d = dependency('libva-x11', required: false)
+      if d.found()
+        spice_gtk_deps += d
+        spice_gtk_config_data.set('HAVE_LIBVA', '1')
+      endif
     endif
   endif
   spice_gtk_has_gtk = true
