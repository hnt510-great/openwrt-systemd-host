Subject: Honor explicit cpio option and skip Yelp help pages

--- a/meson.build
+++ b/meson.build
@@ -52,6 +52,8 @@ if get_option('cpio') == 'auto'
   if cpio.found()
     cpio_path = cpio.full_path()
   endif
+else
+  cpio_path = get_option('cpio')
 endif
 
 gi_docgen = find_program(
@@ -126,7 +128,6 @@ c_args += c_comp.get_supported_arguments
 # Subdirectories
 
 subdir('data')
-subdir('help')
 if build_nautilus_actions
   subdir('nautilus')
 endif
