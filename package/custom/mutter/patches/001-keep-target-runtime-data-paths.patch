Subject: Keep installed runtime data paths separate from staging paths

OpenWrt pkg-config rewrites prefix for build-time headers and libraries.
Queries compiled into runtime data paths must use the installed prefix.

--- a/meson.build
+++ b/meson.build
@@ -565,7 +565,7 @@
 cdata.set('HAVE_ASAN_TESTS', have_asan_tests)
 
 if have_xwayland
-  xkb_base = xkeyboard_config_dep.get_variable('xkb_base')
+  xkb_base = xkeyboard_config_dep.get_variable('xkb_base', pkgconfig_define: ['prefix', get_option('prefix')])
   cdata.set_quoted('XKB_BASE', xkb_base)
 endif
 
