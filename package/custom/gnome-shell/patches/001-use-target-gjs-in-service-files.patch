Subject: Separate installed runtime paths from build-host tools and staging

Service files name the target GJS. Mutter runtime typelibs and RUNPATH use
the installed prefix, while build executables retain the staging RUNPATH.

--- a/meson.build
+++ b/meson.build
@@ -160,10 +160,11 @@
 
 have_asan_tests = get_option('b_sanitize') == 'address'
 
-mutter_typelibdir = mutter_dep.get_variable('typelibdir')
+mutter_build_typelibdir = mutter_dep.get_variable('typelibdir')
+mutter_typelibdir = mutter_dep.get_variable('typelibdir', pkgconfig_define: ['prefix', prefix])
 mutter_pkglibdir = mutter_dep.get_variable('pkglibdir')
 python = find_program('python3')
-gjs = find_program('gjs')
+gjs_runtime = get_option('prefix') / get_option('bindir') / 'gjs'
 generate_app_list = find_program('build-aux/generate-app-list.py')
 
 cc = meson.get_compiler('c')
--- a/js/dbusServices/meson.build
+++ b/js/dbusServices/meson.build
@@ -22,7 +22,7 @@
 
   serviceconf = configuration_data()
   serviceconf.set('service', service)
-  serviceconf.set('gjs', gjs.full_path())
+  serviceconf.set('gjs', gjs_runtime)
   serviceconf.set('pkgdatadir', pkgdatadir)
 
   configure_file(
--- a/src/meson.build
+++ b/src/meson.build
@@ -99,7 +99,7 @@
   sources: libshell_menu_sources,
   dependencies: [gio_dep, clutter_dep, mtk_dep],
   include_directories: conf_inc,
-  build_rpath: mutter_typelibdir,
+  build_rpath: mutter_build_typelibdir,
   install_rpath: mutter_typelibdir,
   install_dir: pkglibdir,
   install: true
@@ -240,7 +240,7 @@
   include_directories: [conf_inc, include_directories('tray')],
   c_args: gnome_shell_cflags,
   link_with: libshell_link_with,
-  build_rpath: mutter_typelibdir,
+  build_rpath: mutter_build_typelibdir,
   install_rpath: install_rpath,
   install_dir: pkglibdir,
   install: true
@@ -283,7 +283,7 @@
   c_args: gnome_shell_cflags + typelib_cflags,
   dependencies: gnome_shell_deps + [libshell_dep, libst_dep, mutter_dep],
   include_directories: [conf_inc],
-  build_rpath: mutter_typelibdir,
+  build_rpath: mutter_build_typelibdir,
   install_rpath: install_rpath,
   install: true
 )
