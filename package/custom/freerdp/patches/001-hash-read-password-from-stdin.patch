Subject: [PATCH] winpr-hash: read a password from standard input

Allow desktop setup to generate credentials without exposing a password
in process arguments.

---
diff --git a/winpr/tools/hash-cli/hash.c b/winpr/tools/hash-cli/hash.c
--- a/winpr/tools/hash-cli/hash.c
+++ b/winpr/tools/hash-cli/hash.c
@@ -22,6 +22,7 @@
 #include <stdlib.h>
 #include <errno.h>
 
+#include <winpr/crt.h>
 #include <winpr/ntlm.h>
 #include <winpr/ssl.h>
 #include <winpr/assert.h>
@@ -50,7 +51,7 @@
 static int usage_and_exit(void)
 {
 	printf("winpr-hash: NTLM hashing tool\n");
-	printf("Usage: winpr-hash -u <username> -p <password> [-d <domain>] [-f <_default_,sam>] [-v "
+	printf("Usage: winpr-hash -u <username> (-p <password> | --password-stdin) [-d <domain>] [-f <_default_,sam>] [-v "
 	       "<_1_,2>]\n");
 	return 1;
 }
@@ -67,6 +68,8 @@
 	size_t DomainLength = 0;
 	char* Password = nullptr;
 	size_t PasswordLength = 0;
+	BOOL passwordStdin = FALSE;
+	char passwordBuffer[1024] = { 0 };
 	errno = 0;
 
 	while (index < argc)
@@ -94,6 +97,10 @@
 			}
 
 			User = argv[index];
+		}
+		else if (strcmp("--password-stdin", argv[index]) == 0)
+		{
+			passwordStdin = TRUE;
 		}
 		else if (strcmp("-p", argv[index]) == 0)
 		{
@@ -148,6 +155,21 @@
 		index++;
 	}
 
+	if (passwordStdin)
+	{
+		if (Password || !fgets(passwordBuffer, sizeof(passwordBuffer), stdin))
+			return usage_and_exit();
+		char* newline = strchr(passwordBuffer, '\n');
+		if (!newline || newline == passwordBuffer)
+		{
+			SecureZeroMemory(passwordBuffer, sizeof(passwordBuffer));
+			fprintf(stderr, "Password must be a nonempty line shorter than 1023 bytes\n");
+			return 1;
+		}
+		*newline = '\0';
+		Password = passwordBuffer;
+	}
+
 	if ((!User) || (!Password))
 	{
 		printf("missing username or password\n\n");
@@ -190,6 +212,8 @@
 			return 1;
 		}
 	}
+
+	SecureZeroMemory(passwordBuffer, sizeof(passwordBuffer));
 
 	if (format == 0)
 	{
@@ -216,5 +240,6 @@
 		printf("\n");
 	}
 
+	SecureZeroMemory(NtHash, sizeof(NtHash));
 	return 0;
 }
