def conn_event(raw):
    """Validate one daed connection datagram; return the cleaned event or None."""
    event=json.loads(raw)
    if not isinstance(event,dict) or event.get('source')!='daed' or event.get('network') not in ('tcp','udp'):return None
    clean={}
    for key,kind in CONN_FIELDS.items():
        value=event.get(key)
        if value is None or value=='':continue
        if not isinstance(value,kind) or (kind is str and len(value)>300):return None
        clean[key]=value
    for key in ('client','dst'):
        try:ip=ipaddress.ip_address(clean.get(key,''))
        except ValueError:return None
        clean[key]=str(ip.ipv4_mapped or ip) if ip.version==6 else str(ip)
    if clean.get('event_time'):clean['event_time']=N.iso_text(clean['event_time']) or clean['event_time']
    return clean
