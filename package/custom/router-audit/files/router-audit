        t=time.monotonic()
        try:
            with socket.create_connection((address,443),timeout=2):pass
            ok=True
        except OSError:ok=False
        results.append({'target':address,'kind':'tcp443','ok':ok,'elapsed_ms':round((time.monotonic()-t)*1000,1),'path':'system_default'})
    t=time.monotonic();ident=int.from_bytes(os.urandom(2),'big')
    packet=struct.pack('!HHHHHH',ident,256,1,0,0,0)+b'\x07example\x03com\x00'+struct.pack('!HH',1,1)
