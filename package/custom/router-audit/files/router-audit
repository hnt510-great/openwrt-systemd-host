def parse_since(v):
    m=re.fullmatch(r'([1-9][0-9]{0,4})([mhd])',v)
    if not m:raise argparse.ArgumentTypeError('expected duration, e.g. 15m')
    seconds=int(m[1])*{'m':60,'h':3600,'d':86400}[m[2]]
    if seconds>30*86400:raise argparse.ArgumentTypeError('maximum 30d')
    return seconds

