def changes(since):
    # Fixed repository; read-only plumbing, no History constructor or index writes.
    raw=command(['git','--git-dir=/etc/uci-history/repo','log','refs/heads/history','--since=@'+str(int(since)),'-100','--format=%H%x00%ct%x00%B%x00']) or ''
    a=raw.split('\0');rows=[]
    for i in range(0,len(a)-2,3):
        meta=dict(l.split(': ',1) for l in a[i+2].splitlines() if ': ' in l)
        rows.append({'event_id':a[i].strip(),'event_time':N.iso(int(a[i+1])),'revision':meta.get('Revision'),'source':meta.get('Source'),'configs':meta.get('Configs','').split(),'diff_available':True})
    parser=runpy.run_path('/usr/sbin/uci-history')['parse_uci']
    allowed={'network':{'proto','device','ifname','ipaddr','netmask','gateway','mtu','metric','ip6assign','ip6hint'},'dhcp':{'port','cachesize','logqueries','noresolv','interface','ra','dhcpv6'},'firewall':{'enabled','input','output','forward','masq','flow_offloading'}}
    for row in rows:
        oid=row['event_id'];row['changes']=[]
        if not re.fullmatch('[0-9a-f]{40}',oid):continue
        for config in row['configs']:
            if not re.fullmatch('[a-zA-Z0-9_-]+',config):continue
            new=command(['git','--git-dir=/etc/uci-history/repo','show',oid+':etc/config/'+config])
            # A first revision or deleted file has no previous/current content.
            old=S.run(['git','--git-dir=/etc/uci-history/repo','show',oid+'^:etc/config/'+config],capture_output=True,text=True,timeout=3).stdout
            try:left=parser(old);right=parser(new or '')
            except Exception:continue
            for section in set(left)|set(right):
                a=left.get(section,{}).get('options',{});b=right.get(section,{}).get('options',{})
                for key in set(a)|set(b):
                    if a.get(key)==b.get(key):continue
                    item={'config':config,'section':section,'option':key}
                    if key in allowed.get(config,set()):item.update(old=a.get(key),new=b.get(key))
                    else:item['values']='redacted'
                    row['changes'].append(item)
    return {'revisions':rows,'coverage':'Existing UCI history with allowlisted semantic diff; non-UCI changes not tracked.'}
PATTERNS=[('oom',r'Out of memory|Killed process'),('wan_down',r'Connection terminated|LCP terminated|link is down|has lost the connection'),('wan_up',r'PPP session is|local  IP address|is now up'),('auth_failure',r'Failed password|Invalid user|authentication failure'),('auth_success',r'Accepted (publickey|password)'),('service_failure',r'Failed with result|Main process exited|Scheduled restart job'),('kernel_warning',r'NETDEV WATCHDOG|Call Trace|Hardware Error')]
def journal(since,limit):
    # Export typed events, never arbitrary MESSAGE contents or command lines.
    raw=command(['journalctl','--since=@'+str(int(since)),'--no-pager','-o','json','-n',str(limit),'--output-fields=__CURSOR,__REALTIME_TIMESTAMP,_BOOT_ID,_SYSTEMD_UNIT,SYSLOG_IDENTIFIER,MESSAGE']) or ''
    rows=[]
    for line in raw.splitlines():
        try:d=json.loads(line)
        except ValueError:continue
        msg=d.get('MESSAGE','')
        if not isinstance(msg,str):continue
        for kind,pat in PATTERNS:
            match=re.search(pat,msg,re.I)
            if match:
                ip=re.search(r'\bfrom ([0-9a-fA-F:.]+)',msg)
                # detail is only the matched signature text, never the surrounding MESSAGE.
                rows.append({'event_id':eventid('journal',d.get('__CURSOR')),'event_time':N.iso_us(d.get('__REALTIME_TIMESTAMP')),'time_quality':'journal_ingest','kind':kind,'detail':match.group(0)[:120],'unit':d.get('_SYSTEMD_UNIT'),'source':d.get('SYSLOG_IDENTIFIER'),'source_address':ip.group(1) if ip else None});break
    return {'events':rows,'coverage':'Bounded journal scan of typed signatures; raw logs not exported.','scan_limit':limit,'possible_truncation':len(raw.splitlines())>=limit}
def capabilities():return {'implemented':['system','services','network','firewall','changes','incidents','events','snapshot','samples','inventory','virtualization','identity'],'dns':{'global_metrics':True,'query_events':'ROUTER_AUDIT_DNS' in (read('/etc/init.d/daed') or ''),'reason':'Partial resolver coverage; see DNS data and source fields'},'missing':['per-client active connection count','container runtime health'],'baselines':'computed off-router by analyze.py','schema_version':SCHEMA}
MODULES={'system':system,'network':network,'services':services,'firewall':firewall,'capabilities':capabilities,'inventory':inventory,'virtualization':virtualization,'identity':identity}
def envelope(module,since,limit):
    ERR.clear()
    try:
        if module in MODULES:data=MODULES[module]()
        elif module=='dns':data={'metrics':command(['ubus','call','dnsmasq','metrics'],structured=True),'query_events':None,'coverage':'dnsmasq global counters; query history is in dns_queries/dns_minute records'}
        elif module=='changes':data=changes(since)
        elif module in ['incidents','events']:data=journal(since,limit)
        else:raise ValueError('unsupported module')
        return {'schema_version':SCHEMA,'host_id':host(),'boot_id':boot(),'collected_at':now(),'module':module,'status':'partial' if ERR or module in ['dns','changes','events','incidents'] else 'ok','window':{'start':N.iso(since),'end':now()},'data':data,'errors':list(ERR),'next_cursor':None}
    except Exception as e:return {'schema_version':SCHEMA,'host_id':host(),'boot_id':boot(),'collected_at':now(),'module':module,'status':'error','data':{},'errors':[{'code':type(e).__name__}]}
def parse_since(v):
    m=re.fullmatch(r'([1-9][0-9]{0,4})([mhd])',v)
    if not m:raise argparse.ArgumentTypeError('expected duration, e.g. 15m')
    seconds=int(m[1])*{'m':60,'h':3600,'d':86400}[m[2]]
    if seconds>30*86400:raise argparse.ArgumentTypeError('maximum 30d')
    return seconds

DNS_QUEUE=collections.deque(maxlen=10000)
DNS_LOCK=threading.Lock()
DNS_STATS={'received':0,'dropped':0}
def dns_receive():
    path='/run/router-audit/dns.sock'
    try:os.unlink(path)
    except FileNotFoundError:pass
    with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET,socket.SO_PASSCRED,1)
        sock.bind(path);os.chmod(path,0o666)
        allowed_uids={0}
        try:allowed_uids.add(pwd.getpwnam('dnsmasq').pw_uid)
        except KeyError:pass
        while True:
            try:
                raw,ancillary,flags,addr=sock.recvmsg(4096,socket.CMSG_SPACE(12))
                credentials=[struct.unpack('3i',v) for level,kind,v in ancillary if level==socket.SOL_SOCKET and kind==socket.SCM_CREDENTIALS]
                if not credentials or credentials[0][1] not in allowed_uids:continue
                event=json.loads(raw)
                if 'event_time_epoch' in event:event['event_time']=N.iso(event['event_time_epoch'])
                if event.get('source') not in ['daed','dnsmasq'] or not isinstance(event.get('qname'),str) or len(event['qname'])>255:continue
                allowed=['source','source_epoch','source_seq','event_time','client','client_port','qname','qtype','rcode','cache','duration_ms','failed','producer_dropped']
                # daed reports IP:port; the per-query source port must not identify a client.
                event=N.normalize_dns_event({k:event.get(k) for k in allowed})
                with DNS_LOCK:
                    DNS_STATS['received']+=1
                    if len(DNS_QUEUE)==DNS_QUEUE.maxlen:DNS_STATS['dropped']+=1
                    DNS_QUEUE.append(event)
            except (ValueError,TypeError,KeyError,AttributeError):continue
            except OSError:time.sleep(1)

def dns_summary(events):
    groups={}
    for e in events:
        client=N.client_addr(e.get('client'))[0];internal=N.is_internal(client)
        key=(e['source'],client)
        if key not in groups:groups[key]={'source':key[0],'client':key[1],'internal':internal,'queries':0,'rcodes':collections.Counter(),'qtypes':collections.Counter(),'domains':set(),'length_max':0}
        g=groups[key];g['queries']+=1;g['rcodes'][str(e.get('rcode'))]+=1;g['qtypes'][str(e.get('qtype'))]+=1;g['domains'].add(e['qname'].lower().rstrip('.'));g['length_max']=max(g['length_max'],len(e['qname']))
    for g in groups.values():g['unique_domains']=len(g.pop('domains'))
    return {'clients':list(groups.values()),'coverage':'Observed resolver events; exclude internal=true when counting client requests'}

def dns_data(since,view,limit):
    rows=[];truncated=False
    for f in sorted(STORE.glob('*.jsonl')):
        if f.stat().st_mtime<since:continue
        for line in f.read_text().splitlines():
            r=json.loads(line)
            if view=='summary' and r.get('module')=='dns_minute':
                rows.append({'collected_at':r['collected_at'],**r['data']})
                if len(rows)>=limit:truncated=True;break
            if view=='events' and r.get('module')=='dns_queries':
                for event in r['data']['events']:
                    if len(rows)>=limit:truncated=True;break
                    rows.append(event)
            if truncated:break
        if truncated:break
    if view=='events':return {'events':rows,'truncated':truncated,'coverage':'instrumented resolvers only; client encrypted DNS unobserved'}
    return {'minutes':rows,'truncated':truncated,'metrics':command(['ubus','call','dnsmasq','metrics'],structured=True),'coverage':'Instrumented resolver samples only; source/receiver drops are explicit'}

def collect():
    STORE.mkdir(mode=0o700,parents=True,exist_ok=True)
    threading.Thread(target=dns_receive,daemon=True).start()
    last_inventory=0
    last_virtualization=0
    while True:
        start=time.monotonic();out=[]
        for m in ['system','network','services','firewall','dns','events','changes','identity']:
            out.append(envelope(m,time.time()-120,1000))
        if time.monotonic()-last_virtualization>900:
            out.append(envelope('virtualization',time.time()-900,1000));last_virtualization=time.monotonic()
        if time.monotonic()-last_inventory>3600:
            out.append(envelope('inventory',time.time()-3600,1000));last_inventory=time.monotonic()
        with DNS_LOCK:
            events=list(DNS_QUEUE);DNS_QUEUE.clear();stats=dict(DNS_STATS)
        out.append({'schema_version':SCHEMA,'host_id':host(),'boot_id':boot(),'collected_at':now(),'module':'dns_minute','status':'partial','data':{**dns_summary(events),'receiver':stats},'errors':[]})
        for offset in range(0,len(events),500):
            out.append({'schema_version':SCHEMA,'host_id':host(),'boot_id':boot(),'collected_at':now(),'module':'dns_queries','status':'partial','data':{'events':events[offset:offset+500],'receiver':stats,'coverage':'instrumented resolver events; loopback dnsmasq events are internal' },'errors':[]})
        name=str(time.time_ns())+'.jsonl';tmp=STORE/(name+'.tmp')
        tmp.write_text(''.join(json.dumps(x,separators=(',',':'))+'\n' for x in out));tmp.chmod(0o600);tmp.replace(STORE/name)
        files=sorted(STORE.glob('*.jsonl'));total=sum(p.stat().st_size for p in files)
        for f in files:
            size=f.stat().st_size
            if total>256*1024*1024 or time.time()-f.stat().st_mtime>24*3600:f.unlink();total-=size
        time.sleep(max(1,60-(time.monotonic()-start)))

def main():
    if sys.argv[1:]==['--collect']:collect();return
    p=argparse.ArgumentParser();p.add_argument('module',choices=[*MODULES,'dns','changes','incidents','events','snapshot','samples']);p.add_argument('--since',type=parse_since,default=900);p.add_argument('--view',choices=['summary','events'],default='summary');p.add_argument('--cursor');p.add_argument('--limit',type=int,default=500);p.add_argument('--format',choices=['json','jsonl'],default='json')
    a=p.parse_args()
    if a.cursor and a.module!='samples':p.error('cursor is supported on samples only')
    if not 1<=a.limit<=1000:p.error('limit must be 1..1000')
    if a.module=='samples':
        records=[];size=0;truncated=False;cursor=a.cursor or '0:0'
        if not re.fullmatch(r'[0-9]{1,24}:[0-9]{1,6}',cursor):p.error('invalid cursor')
        stamp,offset=map(int,cursor.split(':'));next_cursor=cursor
        files=sorted(STORE.glob('*.jsonl'))
        expired=bool(stamp and files and stamp<int(files[0].stem))
        for f in files:
            fid=int(f.stem)
            if fid<stamp or (not stamp and f.stat().st_mtime<time.time()-a.since):continue
            for idx,line in enumerate(f.read_text().splitlines()):
                if fid==stamp and idx<offset:continue
                if len(records)>=a.limit or size+len(line)>900000:truncated=True;break
                records.append(json.loads(line));size+=len(line);next_cursor=str(fid)+':'+str(idx+1)
            if truncated:break
        result={'schema_version':SCHEMA,'host_id':host(),'collected_at':now(),'module':'samples','status':'partial' if truncated or expired else 'ok','data':{'records':records,'truncated':truncated,'cursor_expired':expired},'next_cursor':next_cursor,'errors':[]}
    elif a.module=='dns' and P.Path('/run/router-audit/dns.sock').exists():
        result=envelope('dns',time.time()-a.since,a.limit);result['data']=dns_data(time.time()-a.since,a.view,a.limit)
    elif a.module=='snapshot':result={'schema_version':SCHEMA,'host_id':host(),'collected_at':now(),'module':'snapshot','status':'ok','data':{m:envelope(m,time.time()-a.since,a.limit) for m in ['system','network','services','firewall','dns','changes','incidents','identity','virtualization']},'errors':[]}
    else:result=envelope(a.module,time.time()-a.since,a.limit)
    if a.module=='snapshot' and any(x['status']!='ok' for x in result['data'].values()):result['status']='partial'
    encoded=json.dumps(result,separators=(',',':'))
    if len(encoded)>1048576:encoded=json.dumps({'schema_version':SCHEMA,'status':'error','errors':[{'code':'output_limit'}]})
    print(encoded)
if __name__=='__main__':main()
