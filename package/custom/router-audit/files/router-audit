    return {'interfaces':[{k:i[k] for k in fields if k in i} for i in state.get('interface',[])], 'links':N.trim_links(command(['ip','-j','-s','link','show'],structured=True)),'routes':{f:command(['ip','-j',f,'route','show','table','all'],structured=True) for f in ['-4','-6']},'probes':probes(),'rules':{f:command(['ip','-j',f,'rule','show'],structured=True) for f in ['-4','-6']}}
def firewall():
