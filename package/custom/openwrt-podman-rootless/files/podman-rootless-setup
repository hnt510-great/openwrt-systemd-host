#!/bin/sh
# Allocate subordinate IDs without changing existing mappings or user data.
set -eu
fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail 'Run podman-rootless-setup as root'
[ "$#" = 1 ] || fail 'Usage: podman-rootless-setup USER'
user=$1
case "$user" in ''|-*|*[!a-zA-Z0-9_-]*) fail 'Invalid username' ;; esac
uid=$(id -u "$user")
[ "$uid" -ge 1000 ] && [ "$(id -g "$user")" -gt 0 ] || fail 'An ordinary account is required'
for helper in /usr/bin/newuidmap /usr/bin/newgidmap; do
	[ -u "$helper" ] && [ "$(stat -c %u "$helper")" = 0 ] || fail "Missing root-owned setuid helper: $helper"
done
mkdir -p /var/lock
lock=/var/lock/podman-rootless-setup
mkdir "$lock" 2>/dev/null || fail 'Another rootless setup is running'
trap 'rmdir "$lock"' EXIT HUP INT TERM
for file in /etc/subuid /etc/subgid; do
	[ -e "$file" ] || touch "$file"
	chown root:root "$file"
	chmod 0644 "$file"
done

allocate() {
	file=$1
	kind=$2
	# Existing assignments, including assignments keyed by UID, are retained.
	if awk -F: -v user="$user" -v uid="$uid" '$1 == user || $1 == uid { found=1 } END { exit !found }' "$file"; then
		awk -F: -v user="$user" -v uid="$uid" '
			($1 == user || $1 == uid) && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && $3 >= 65536 { ok=1 }
			END { exit !ok }' "$file" || fail "Review existing mapping in $file: at least 65536 IDs are required"
		return
	fi
	# Avoid every allocated UID/GID range and real account ID in either namespace.
	start=$(awk -F: '
		FILENAME == "/etc/subuid" || FILENAME == "/etc/subgid" {
			if (NF != 3 || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ || $3 < 1 || $2 + $3 > 4294967295) { bad=1; next }
			lo[++n]=$2; hi[n]=$2+$3-1; next
		}
		{ lo[++n]=$3; hi[n]=$3 }
		END {
			if (bad) exit 1
			start=100000; count=65536
			do {
				moved=0
				for (i=1; i<=n; i++) if (start<=hi[i] && start+count-1>=lo[i]) { start=hi[i]+1; moved=1 }
			} while (moved)
			if (start+count-1>600100000) exit 1
			printf "%.0f", start
		}' /etc/subuid /etc/subgid /etc/passwd /etc/group) || fail 'Invalid subordinate-ID file or no available range'
	end=$((start + 65535))
	/usr/sbin/usermod "--add-sub${kind}s" "$start-$end" "$user"
}
allocate /etc/subuid uid
allocate /etc/subgid gid
grep -q '^podman:' /etc/group || /usr/sbin/groupadd -r podman
/usr/sbin/usermod -aG podman "$user"
/usr/libexec/podman-tun-permissions
# OpenWrt's merged root is itself overlayfs. Use the underlying ext4 mount
# for new native-systemd stores; never modify a populated user's storage.
if [ -f /usr/lib/systemd/user/podman.service ] &&
   awk '$2 == "/overlay" && $3 == "ext4" { ok=1 } END { exit !ok }' /proc/mounts; then
	parent=/overlay/containers
	if [ ! -e "$parent" ] && [ ! -L "$parent" ]; then
		mkdir -m 0711 "$parent"
	fi
	if [ ! -L "$parent" ] && [ "$(stat -c %u:%a "$parent")" = 0:711 ]; then
		base=$parent/$uid
		if [ ! -e "$base" ] && [ ! -L "$base" ]; then
			mkdir -m 0700 "$base"
			chown "$uid:$(id -g "$user")" "$base"
		fi
		su -s /bin/sh -c 'unset XDG_CONFIG_HOME XDG_DATA_HOME; exec /usr/libexec/podman-native-storage' "$user"
	else
		printf '%s\n' 'Warning: unsafe /overlay/containers; existing Podman storage retained.' >&2
	fi
fi
# Rootless Podman user units (socket, restart, auto-update, healthcheck timers)
# need the user manager at boot. Enrollment is an explicit administrator action,
# so opt this account in here; loginctl disable-linger still opts it back out.
if [ -d /run/systemd/system ] && command -v loginctl >/dev/null 2>&1; then
	if loginctl enable-linger "$user"; then
		printf 'Enabled systemd linger for %s (user units start at boot).\n' "$user"
	else
		printf 'Warning: could not enable linger for %s; run: loginctl enable-linger %s\n' \
			"$user" "$user" >&2
	fi
fi
printf 'Configured %s. Log in again, then run: podman system migrate\n' "$user"
