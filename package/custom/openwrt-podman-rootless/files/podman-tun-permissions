#!/bin/sh
set -eu
case "${1:-}" in
	'') strict=0 ;;
	--require-device) strict=1 ;;
	*) echo 'Usage: podman-tun-permissions [--require-device]' >&2; exit 1 ;;
esac
if [ ! -c /dev/net/tun ]; then
	[ "$strict" = 0 ] && exit 0
	echo 'Podman TUN preparation failed: /dev/net/tun is not a character device' >&2
	exit 1
fi
grep -q '^podman:' /etc/group || exit 0
# The legacy boot hook and account enrollment may run concurrently with the
# native preparation unit. Serialize ACL changes and the managed-UID ledger.
if [ -f /usr/lib/systemd/user/podman.service ]; then
	umask 077
	exec 9>/run/podman-tun-permissions.lock
	flock -w 20 9 || {
		echo 'Podman TUN preparation failed: permission update lock timed out' >&2
		exit 1
	}
fi
chgrp podman /dev/net/tun
chmod 0660 /dev/net/tun
# pasta drops supplementary groups during isolation. Keep the device restricted
# to enrolled users, granting their UID access without weakening its sandbox.
[ -f /usr/lib/systemd/user/podman.service ] || exit 0
umask 077
state=/run/podman-tun-acl-uids
next=$state.$$
trap 'rm -f "$next"' EXIT HUP INT TERM
: > "$next"
members=$(awk -F: '$1 == "podman" { gsub(/,/, " ", $4); print $4 }' /etc/group)
for user in $members; do
	uid=$(id -u "$user" 2>/dev/null) || continue
	[ "$uid" -ge 1000 ] || continue
	setfacl -m "u:$uid:rw" /dev/net/tun
	printf '%s\n' "$uid" >> "$next"
done
if [ -f "$state" ]; then
	while IFS= read -r uid; do
		case "$uid" in ''|*[!0-9]*) continue ;; esac
		grep -qx "$uid" "$next" || setfacl -x "u:$uid" /dev/net/tun
	done < "$state"
fi
mv "$next" "$state"
