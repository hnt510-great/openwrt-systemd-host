+/*
+ * Returns the delay accumulated on top of the baseline. A constant delay,
+ * however large, means the client keeps up; a growing one means a backlog.
+ */
+static uint32_t
+get_queueing_delay (DelayBaseline *baseline,
+                    uint32_t       delay_ms)
+{
+  uint32_t baseline_ms;
+
+  if (!delay_baseline_get (baseline, &baseline_ms) || delay_ms <= baseline_ms)
+    return 0;
+
+  return delay_ms - baseline_ms;
+}
