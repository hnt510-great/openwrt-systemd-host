 static void
+delay_baseline_add_sample (DelayBaseline *baseline,
+                           uint32_t       delay_ms,
+                           int64_t        current_time_us)
+{
+  if (!baseline->valid ||
+      current_time_us - baseline->bucket_start_us >= 2 * BASELINE_BUCKET_US)
+    {
+      baseline->valid = TRUE;
+      baseline->bucket_start_us = current_time_us;
+      baseline->current_min_ms = delay_ms;
+      baseline->previous_min_ms = delay_ms;
+    }
+  else if (current_time_us - baseline->bucket_start_us >= BASELINE_BUCKET_US)
+    {
+      baseline->bucket_start_us = current_time_us;
+      baseline->previous_min_ms = baseline->current_min_ms;
+      baseline->current_min_ms = delay_ms;
+    }
+  else
+    {
+      baseline->current_min_ms = MIN (baseline->current_min_ms, delay_ms);
+    }
+}
+
+static gboolean
+delay_baseline_get (DelayBaseline *baseline,
+                    uint32_t      *delay_ms)
+{
+  if (!baseline->valid)
+    return FALSE;
+
+  *delay_ms = MIN (baseline->current_min_ms, baseline->previous_min_ms);
+  return TRUE;
+}
