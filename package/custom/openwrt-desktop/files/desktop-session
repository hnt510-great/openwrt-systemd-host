#!/bin/sh
set -eu
[ "$#" = 5 ] || [ "$#" = 6 ] || exit 1
output="$1"
address="$2"
port="$3"
key="$4"
cert="$5"
renderer="${6:-pixman}"
case "$renderer" in pixman|gl) ;; *) exit 1 ;; esac
cd "$HOME"
if [ -x /usr/bin/flatpak ]; then
	export XDG_CURRENT_DESKTOP=Weston
	case ":${XDG_DATA_DIRS:-}:" in
		*":$HOME/.local/share/flatpak/exports/share:"*) ;;
		*) export XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" ;;
	esac
fi
umask 077
# This script runs as the desktop user, including all runtime file writes.
cat > "$XDG_RUNTIME_DIR/weston.ini" <<EOF
[core]
shell=desktop-shell.so
idle-time=0

[shell]
locking=false
panel-position=top
background-color=0xff203040

[launcher]
icon=/usr/share/weston/terminal.png
path=/usr/bin/weston-terminal

EOF
if [ -x /usr/libexec/virt-manager-launch ]; then
	cat >> "$XDG_RUNTIME_DIR/weston.ini" <<EOF
[launcher]
icon=/usr/share/icons/hicolor/48x48/apps/virt-manager.png
path=/usr/libexec/virt-manager-launch

EOF
fi
if [ -x /usr/bin/firefox-esr ]; then
	cat >> "$XDG_RUNTIME_DIR/weston.ini" <<EOF
[launcher]
icon=/usr/share/icons/hicolor/32x32/apps/firefox-esr.png
path=/usr/bin/firefox-esr

EOF
fi
if [ -x /usr/libexec/desktop-flatpak-session ]; then
	cat >> "$XDG_RUNTIME_DIR/weston.ini" <<EOF
[autolaunch]
path=/usr/libexec/desktop-flatpak-session
watch=false

EOF
fi
cat >> "$XDG_RUNTIME_DIR/weston.ini" <<EOF
[output]
name=$output
mode=preferred

[output]
name=vnc
mirror-of=$output
resizeable=false

[vnc]
refresh-rate=30
tls-key=$key
tls-cert=$cert
EOF
set -- /usr/libexec/desktop-dbus-session /usr/bin/weston --backends=drm,vnc --renderer="$renderer" \
	--continue-without-input --address="$address" --port="$port" \
	--config="$XDG_RUNTIME_DIR/weston.ini"
if [ -x /usr/libexec/desktop-no-caps ]; then
	set -- /usr/libexec/desktop-no-caps "$@"
fi
exec "$@"
