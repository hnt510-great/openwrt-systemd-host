#!/bin/sh
set -eu
[ "$(id -u)" -ge 1000 ] || exit 1
umask 077
config_home=${XDG_CONFIG_HOME:-$HOME/.config}

ensure_xdg_user_dirs() {
	[ ! -e "$config_home/user-dirs.dirs" ] || return 0
	[ -n "${HOME:-}" ] && [ -d "$HOME" ] || return 0
	mkdir -p "$config_home" \
		"$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads" \
		"$HOME/Music" "$HOME/Pictures" "$HOME/Public" \
		"$HOME/Templates" "$HOME/Videos"
	tmp="$(mktemp "$config_home/.user-dirs.XXXXXX")"
	cat > "$tmp" <<'EOF' || { rm -f "$tmp"; return 1; }
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_TEMPLATES_DIR="$HOME/Templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_MUSIC_DIR="$HOME/Music"
XDG_PICTURES_DIR="$HOME/Pictures"
XDG_VIDEOS_DIR="$HOME/Videos"
EOF
	mv "$tmp" "$config_home/user-dirs.dirs"
}

case "${1:-}" in
	--xdg-dirs)
		ensure_xdg_user_dirs
		exit 0
		;;
	'')
		session=
		;;
	-*)
		printf 'Usage: desktop-user-setup [--xdg-dirs | SESSION]\n' >&2
		exit 1
		;;
	*)
		session=$1
		;;
esac

ensure_xdg_user_dirs
wants="$config_home/systemd/user/graphical-session.target.wants"
mkdir -p "$wants"
if [ -f /usr/lib/systemd/user/openwrt-desktop-services.service ]; then
	ln -sfn /usr/lib/systemd/user/openwrt-desktop-services.service "$wants/openwrt-desktop-services.service"
fi
if [ -n "$session" ]; then
	. /usr/libexec/desktop-common.sh
	if desktop_load_session "$session" 2>/dev/null; then
		desktop_session_user_setup
	fi
fi
