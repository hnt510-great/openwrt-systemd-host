#!/bin/sh
set -eu
set +x
. /usr/libexec/desktop-common.sh
[ "$(id -u)" = 0 ] || { desktop_error 'Run desktop-setup as root'; exit 1; }
[ "$#" -ge 1 ] || {
	printf 'Usage: desktop-setup USER [--refresh-keyring] [--keyring-password-stdin]\n' >&2; exit 1;
}
user=$1
shift
refresh_keyring=0
keyring_stdin=0
for option in "$@"; do
	case "$option" in
		--refresh-keyring) refresh_keyring=1 ;;
		--keyring-password-stdin) keyring_stdin=1 ;;
		*) desktop_error 'Invalid desktop-setup option'; exit 1 ;;
	esac
done
[ -d /run/systemd/system ] && [ -x /usr/bin/gnome-session ] || {
	desktop_error 'The GNOME desktop requires a native-systemd image'; exit 1;
}
desktop_validate_user "$user"
usermod -a -G video,render "$user"
desktop_setup_tls
secret_dir=/etc/desktop/gnome
[ ! -L "$secret_dir" ] || { desktop_error 'Unsafe desktop credential directory'; exit 1; }
mkdir -p "$secret_dir"
chown 0:0 "$secret_dir"
chmod 0700 "$secret_dir"
secret="$secret_dir/$DESKTOP_USER_UID.keyring-passphrase"
if [ ! -e "$secret" ] || [ "$refresh_keyring" = 1 ]; then
	umask 077
	tmp="$(mktemp "$secret_dir/.keyring.XXXXXX")"
	tty_state=
	cleanup() {
		[ -z "$tty_state" ] || stty "$tty_state" <&3
		rm -f "$tmp"
		unset passphrase
	}
	trap cleanup EXIT
	trap 'exit 1' HUP INT TERM
	if [ -e "$DESKTOP_USER_HOME/.local/share/keyrings/login.keyring" ]; then
		if [ "$keyring_stdin" = 1 ]; then
			IFS= read -r passphrase
		else
			exec 3</dev/tty 4>/dev/tty
			tty_state="$(stty -g <&3)"
			stty -echo <&3
			printf 'Existing login-keyring passphrase: ' >&4
			IFS= read -r passphrase <&3
			printf '\n' >&4
			stty "$tty_state" <&3
			tty_state=
		fi
		[ -n "$passphrase" ] || { desktop_error 'An empty bootstrap passphrase is not accepted'; exit 1; }
		printf '%s' "$passphrase" > "$tmp"
		unset passphrase
	else
		openssl rand -hex 48 | tr -d '\n' > "$tmp"
	fi
	# A separate PAM session supplies a user manager/bus for first-time setup.
	# The system manager reads the root-only file into the user's credential mount.
	systemd-run --quiet --collect --wait --pipe --unit="openwrt-keyring-setup-$DESKTOP_USER_UID" \
		--uid="$user" --property=PAMName=openwrt-desktop \
		--property="LoadCredential=keyring-passphrase:$tmp" \
		--setenv=HOME="$DESKTOP_USER_HOME" --setenv=USER="$user" \
		--setenv=LOGNAME="$user" /usr/libexec/desktop-keyring-unlock
	mv "$tmp" "$secret"
	trap - EXIT HUP INT TERM
fi
[ -f "$secret" ] && [ ! -L "$secret" ] && [ -s "$secret" ] && 	[ "$(stat -c %u:%a "$secret")" = 0:600 ] || {
	desktop_error 'Invalid unattended-keyring credential'; exit 1;
}
su -s /bin/sh -c /usr/libexec/desktop-user-setup "$user"
uci set desktop.main.user="$user"
uci set desktop.main.enabled=1
case "$(uci -q get desktop.main.sunshine_capture || :)" in
	''|weston) uci set desktop.main.sunshine_capture=portal ;;
esac
uci commit desktop
/etc/init.d/desktop enable
/etc/init.d/desktop restart
printf 'GNOME configured for %s. Run desktop-rdp-setup %s to provision RDP credentials.\n' "$user" "$user"
printf 'Use sunshine-setup %s --capture=portal for Moonlight.\n' "$user"
