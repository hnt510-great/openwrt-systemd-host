#!/bin/sh
set -eu
set +x
. /usr/libexec/desktop-common.sh
[ "$(id -u)" = 0 ] || { desktop_error 'Run desktop-setup as root'; exit 1; }
[ "$#" -ge 1 ] || {
	printf 'Usage: desktop-setup USER [--refresh-keyring] [--keyring-password-stdin] [--no-autostart]\n' >&2; exit 1;
}
user=$1
shift
refresh_keyring=0
keyring_stdin=0
autostart=1
for option in "$@"; do
	case "$option" in
		--refresh-keyring) refresh_keyring=1 ;;
		--keyring-password-stdin) keyring_stdin=1 ;;
		--no-autostart) autostart=0 ;;
		*) desktop_error 'Invalid desktop-setup option'; exit 1 ;;
	esac
done
[ -d /run/systemd/system ] || {
	desktop_error 'The desktop requires a native-systemd image'; exit 1;
}
configured_session="$(uci -q get desktop.main.session || :)"
session="$(desktop_resolve_session "$configured_session")" || exit 1
desktop_load_session "$session" || exit 1
desktop_validate_user "$user"
if [ "$refresh_keyring" = 1 ] && [ -z "${SESSION_CREDENTIAL_BACKEND:-}" ]; then
	desktop_error "Desktop session '$session' does not use a keyring credential backend"
	exit 1
fi
usermod -a -G video,render "$user"
DESKTOP_REFRESH_KEYRING="$refresh_keyring" DESKTOP_KEYRING_STDIN="$keyring_stdin" desktop_session_setup
su -s /bin/sh -c "/usr/libexec/desktop-user-setup '$session'" "$user"
uci set desktop.main.user="$user"
uci set desktop.main.enabled="$autostart"
[ -n "$configured_session" ] || uci set desktop.main.session="$session"
case "$(uci -q get desktop.main.sunshine_capture || :)" in
	''|weston) uci set desktop.main.sunshine_capture=portal ;;
esac
uci commit desktop
if [ "$autostart" = 1 ]; then
	/etc/init.d/desktop enable
	/etc/init.d/desktop restart
else
	/etc/init.d/desktop disable
fi
session_label="${SESSION_TITLE:-$session}"
if [ "${SESSION_SUPPORTS_RDP:-0}" = 1 ] && [ -x /usr/sbin/desktop-rdp-setup ]; then
	printf '%s configured for %s. Run desktop-rdp-setup %s to provision RDP credentials.\n' "$session_label" "$user" "$user"
else
	printf '%s configured for %s.\n' "$session_label" "$user"
fi
if [ -x /usr/sbin/sunshine-setup ]; then
	printf 'Use sunshine-setup %s --capture=portal for Moonlight.\n' "$user"
fi
