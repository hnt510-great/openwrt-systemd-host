#!/bin/sh
set -eu
. /usr/libexec/desktop-common.sh

[ "$(id -u)" = 0 ] || { desktop_error 'Run desktop-setup as root'; exit 1; }
[ "$#" = 1 ] || { printf 'Usage: desktop-setup USER\n' >&2; exit 1; }
user="$1"
desktop_validate_user "$user"
usermod -a -G video "$user"

mkdir -p /etc/desktop/tls
chmod 0755 /etc/desktop /etc/desktop/tls
key="/etc/desktop/tls/$user.key"
cert="/etc/desktop/tls/$user.crt"
if [ ! -e "$key" ] && [ ! -e "$cert" ]; then
	tmp="$(mktemp -d /etc/desktop/.tls.XXXXXX)"
	trap 'rm -rf "$tmp"' EXIT HUP INT TERM
	address="$(desktop_lan_address)" || address=
	if [ -n "$address" ]; then
		openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 3650 \
			-subj '/CN=OpenWrt desktop' -addext "subjectAltName=IP:$address" \
			-keyout "$tmp/key" -out "$tmp/cert" >/dev/null 2>&1
	else
		desktop_error 'Bring up the LAN interface before desktop-setup'
		exit 1
	fi
	chmod 0600 "$tmp/key"
	chmod 0644 "$tmp/cert"
	chown "$DESKTOP_USER_UID:$DESKTOP_USER_GID" "$tmp/key" "$tmp/cert"
	mv "$tmp/key" "$key"
	mv "$tmp/cert" "$cert"
	rm -rf "$tmp"
	trap - EXIT HUP INT TERM
fi
[ -f "$key" ] && [ ! -L "$key" ] && [ -f "$cert" ] && [ ! -L "$cert" ] || {
	desktop_error 'TLS credentials are incomplete or unsafe; repair them before setup'; exit 1;
}
openssl x509 -in "$cert" -noout -checkend 0 >/dev/null
[ "$(openssl pkey -in "$key" -pubout 2>/dev/null)" = \
	"$(openssl x509 -in "$cert" -pubkey -noout 2>/dev/null)" ] || {
	desktop_error 'The TLS certificate and private key do not match'; exit 1;
}
chown "$DESKTOP_USER_UID:$DESKTOP_USER_GID" "$key" "$cert"
chmod 0600 "$key"
chmod 0644 "$cert"
uci set desktop.main.user="$user"
uci set desktop.main.enabled='1'
uci commit desktop
/etc/init.d/desktop enable
/etc/init.d/desktop restart
printf 'Desktop configured for %s. Connect with a TLS-capable VNC client to the LAN address on port %s.\n' \
	"$user" "$(uci -q get desktop.main.port)"
printf 'Certificate SHA256 fingerprint:\n'
openssl x509 -in "$cert" -noout -fingerprint -sha256
