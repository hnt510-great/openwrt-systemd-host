#!/bin/sh /etc/rc.common

START=95
STOP=5
USE_PROCD=1

start_service() {
	local enabled user output port address runtime key cert attempt
	. /usr/libexec/desktop-common.sh
	config_load desktop
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get user main user
	desktop_validate_user "$user" || return 1
	config_get output main output auto
	output="$(desktop_select_output "$output")" || return 1
	config_get port main port 5900
	case "$port" in ''|*[!0-9]*) desktop_error 'Invalid VNC port'; return 1 ;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || {
		desktop_error 'The ordinary-user VNC port must be between 1024 and 65535'; return 1;
	}
	address="$(desktop_lan_address)"
	[ -n "$address" ] || { desktop_error 'LAN IPv4 address is not ready'; return 1; }
	for attempt in 1 2 3 4 5; do
		[ -S /tmp/run/seatd.sock ] && break
		sleep 1
	done
	[ -S /tmp/run/seatd.sock ] || { desktop_error 'seatd is not ready'; return 1; }
	key="/etc/desktop/tls/$user.key"
	cert="/etc/desktop/tls/$user.crt"
	[ -f "$key" ] && [ -f "$cert" ] || {
		desktop_error 'Run desktop-setup to generate TLS credentials'; return 1;
	}
	runtime="/tmp/run/desktop-$DESKTOP_USER_UID"
	[ ! -L "$runtime" ] || { desktop_error 'Unsafe desktop runtime directory'; return 1; }
	mkdir -p "$runtime" || return 1
	chown "$DESKTOP_USER_UID:$DESKTOP_USER_GID" "$runtime"
	chmod 0700 "$runtime"
	procd_open_instance
	procd_set_param command /usr/libexec/desktop-session "$output" "$address" "$port" "$key" "$cert"
	procd_set_param user "$user"
	procd_set_param env HOME="$DESKTOP_USER_HOME" USER="$user" LOGNAME="$user" \
		SHELL="$DESKTOP_USER_SHELL" XDG_RUNTIME_DIR="$runtime" LIBSEAT_BACKEND=seatd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger desktop
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/desktop restart
}
