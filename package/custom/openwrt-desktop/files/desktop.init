#!/bin/sh /etc/rc.common
START=95
STOP=5
USE_PROCD=1

write_lan_environment() {
	local address path rdp tmp
	path=/run/openwrt-desktop
	[ ! -L "$path" ] || return 1
	mkdir -p "$path" || return 1
	chown 0:0 "$path"
	chmod 0755 "$path"
	address="$(desktop_lan_address)"
	case "$address" in
		''|0.0.0.0|*[!0-9.]*) rm -f "$path/$DESKTOP_USER_UID.env"; return 0 ;;
	esac
	rdp=0
	[ "$(uci -q get desktop.main.rdp_enabled || :)" != 1 ] || rdp=1
	tmp="$(mktemp "$path/.lan.XXXXXX")" || return 1
	printf 'OPENWRT_DESKTOP_LAN_ADDRESS=%s\nOPENWRT_RDP_ADDRESS=%s\nOPENWRT_DESKTOP_RDP_ENABLED=%s\n' \
		"$address" "$address" "$rdp" > "$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$path/$DESKTOP_USER_UID.env"
}

start_service() {
	local enabled user secret
	. /usr/libexec/desktop-common.sh
	[ -d /run/systemd/system ] || { logger -t openwrt-desktop 'GNOME is disabled in procd recovery'; return 0; }
	config_load desktop
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get user main user
	desktop_validate_user "$user" || return 1
	write_lan_environment || return 1
	systemctl is-active --quiet openwrt-desktop.service && return 0
	[ -x /usr/bin/gnome-session ] || { desktop_error 'GNOME is not installed'; return 1; }
	secret="/etc/desktop/gnome/$DESKTOP_USER_UID.keyring-passphrase"
	[ -f "$secret" ] && [ ! -L "$secret" ] && [ "$(stat -c %u:%a "$secret")" = 0:600 ] || {
		desktop_error 'Run desktop-setup to provision unattended keyring access'; return 1;
	}
	desktop_select_output "$(uci -q get desktop.main.output || printf auto)" >/dev/null || return 1
	set -- systemd-run --quiet --collect --unit=openwrt-desktop.service \
		--uid="$user" --property=PAMName=openwrt-desktop --property=Type=exec \
		--property=Restart=on-failure --property=RestartSec=5s \
		--property=StandardOutput=journal --property=StandardError=journal \
		--property=Requires='systemd-logind.service openwrt-desktop-coldplug.service' \
		--property=After='systemd-logind.service openwrt-desktop-coldplug.service' \
		--property="LoadCredential=keyring-passphrase:$secret" \
		--setenv=HOME="$DESKTOP_USER_HOME" --setenv=USER="$user" --setenv=LOGNAME="$user" \
		--setenv=SHELL="$DESKTOP_USER_SHELL" --setenv=XDG_SESSION_TYPE=wayland --setenv=XDG_SESSION_CLASS=user
	if [ -e /dev/tty0 ]; then
		/bin/busybox chvt 7 || return 1
		set -- "$@" --property=StandardInput=tty --property=TTYPath=/dev/tty7 			--setenv=XDG_SEAT=seat0 --setenv=XDG_VTNR=7
	fi
	"$@" /usr/libexec/desktop-session
}

reload_service() {
	local user
	. /usr/libexec/desktop-common.sh
	user="$(uci -q get desktop.main.user || :)"
	desktop_validate_user "$user" || return 1
	write_lan_environment
}

stop_service() {
	local session user
	[ -d /run/systemd/system ] || return 0
	user="$(uci -q get desktop.main.user || :)"
	if [ -n "$user" ]; then
		su -s /bin/sh -c /usr/libexec/desktop-user-stop "$user" 2>/dev/null || :
	fi
	systemctl stop openwrt-desktop.service 2>/dev/null || :
	for session in $(loginctl list-sessions --no-legend --no-pager | awk '{print $1}'); do
		[ "$(loginctl show-session "$session" -p Service --value 2>/dev/null)" = openwrt-desktop ] || continue
		loginctl terminate-session "$session" 2>/dev/null || :
	done
}

service_triggers() {
	procd_add_reload_trigger desktop
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/desktop reload
}
