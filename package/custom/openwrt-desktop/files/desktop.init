#!/bin/sh /etc/rc.common

START=95
STOP=5
USE_PROCD=1

start_service() {
	local enabled user output port address runtime key cert attempt renderer mode
	local rdp_enabled rdp_port rdp_refresh_rate sam force_composition
	. /usr/libexec/desktop-common.sh
	config_load desktop
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get user main user
	desktop_validate_user "$user" || return 1
	config_get output main output auto
	output="$(desktop_select_output "$output")" || return 1
	config_get mode main mode preferred
	desktop_validate_mode "$mode" || return 1
	config_get renderer main renderer gl
	case "$renderer" in pixman|gl) ;; *) desktop_error 'Invalid desktop renderer'; return 1 ;; esac
	config_get_bool force_composition main force_composition 1
	config_get sunshine_capture main sunshine_capture kms
	case "$sunshine_capture" in kms|weston) ;; *) desktop_error 'Invalid Sunshine capture mode'; return 1 ;; esac
	config_get port main port 5900
	case "$port" in ''|*[!0-9]*) desktop_error 'Invalid VNC port'; return 1 ;; esac
	[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || {
		desktop_error 'The ordinary-user VNC port must be between 1024 and 65535'; return 1;
	}
	config_get_bool rdp_enabled main rdp_enabled 0
	config_get rdp_port main rdp_port 3389
	config_get rdp_refresh_rate main rdp_refresh_rate 30
	if [ "$rdp_enabled" = 1 ]; then
		desktop_validate_rdp "$rdp_port" "$rdp_refresh_rate" "$port" || return 1
		sam="/etc/desktop/rdp/$user.sam"
		[ -f "$sam" ] && [ ! -L "$sam" ] &&
			[ "$(stat -c %u "$sam")" = "$DESKTOP_USER_UID" ] &&
			[ "$(stat -c %a "$sam")" = 600 ] || {
			desktop_error 'Run desktop-rdp-setup to create private RDP credentials'; return 1;
		}
	fi
	address="$(desktop_lan_address)"
	[ -n "$address" ] || { desktop_error 'LAN IPv4 address is not ready'; return 1; }
	for attempt in 1 2 3 4 5; do
		[ -S /tmp/run/seatd.sock ] && break
		sleep 1
	done
	[ -S /tmp/run/seatd.sock ] || { desktop_error 'seatd is not ready'; return 1; }
	key="/etc/desktop/tls/$user.key"
	cert="/etc/desktop/tls/$user.crt"
	[ -f "$key" ] && [ -f "$cert" ] || {
		desktop_error 'Run desktop-setup to generate TLS credentials'; return 1;
	}
	if [ -x /usr/bin/Xwayland ]; then
		# procd recovery does not run systemd-tmpfiles. Weston reserves the
		# X11 socket as the desktop user, so root must create its directory.
		[ ! -L /tmp/.X11-unix ] && { [ ! -e /tmp/.X11-unix ] || [ -d /tmp/.X11-unix ]; } || {
			desktop_error 'Unsafe X11 socket directory'; return 1;
		}
		mkdir -p /tmp/.X11-unix || return 1
		chown 0:0 /tmp/.X11-unix
		chmod 1777 /tmp/.X11-unix
	fi
	if [ -d /run/systemd/system ]; then
		# PAM registers the desktop separately from SSH sessions. seatd keeps
		# owning display/input devices; logind only tracks this session.
		systemctl is-active --quiet openwrt-desktop.service && return 0
		set -- systemd-run --quiet --collect --unit=openwrt-desktop.service \
			--uid="$user" --property=PAMName=openwrt-desktop \
			--property=Type=exec --property=Restart=on-failure --property=RestartSec=5s \
			--property=StandardOutput=journal --property=StandardError=journal \
			--property=Requires=systemd-logind.service --property=After=systemd-logind.service \
			--setenv=HOME="$DESKTOP_USER_HOME" --setenv=USER="$user" --setenv=LOGNAME="$user" \
			--setenv=SHELL="$DESKTOP_USER_SHELL" --setenv=LIBSEAT_BACKEND=seatd \
			--setenv=XDG_SESSION_TYPE=wayland --setenv=XDG_SESSION_CLASS=user
		if [ -e /dev/tty0 ]; then
			/bin/busybox chvt 7 || { desktop_error 'Cannot activate desktop VT 7'; return 1; }
			set -- "$@" --property=StandardInput=tty --property=TTYPath=/dev/tty7 \
				--setenv=XDG_SEAT=seat0 --setenv=XDG_VTNR=7
		fi
		"$@" /usr/libexec/desktop-session "$output" "$address" "$port" "$key" "$cert" "$renderer" \
			"$rdp_enabled" "$rdp_port" "$rdp_refresh_rate" "$mode" "$force_composition"
		return
	fi
	runtime="/tmp/run/desktop-$DESKTOP_USER_UID"
	[ ! -L "$runtime" ] || { desktop_error 'Unsafe desktop runtime directory'; return 1; }
	mkdir -p "$runtime" || return 1
	chown "$DESKTOP_USER_UID:$DESKTOP_USER_GID" "$runtime"
	chmod 0700 "$runtime"
	procd_open_instance
	procd_set_param command /usr/libexec/desktop-session "$output" "$address" "$port" "$key" "$cert" "$renderer" \
		"$rdp_enabled" "$rdp_port" "$rdp_refresh_rate" "$mode" "$force_composition"
	procd_set_param user "$user"
	procd_set_param env HOME="$DESKTOP_USER_HOME" USER="$user" LOGNAME="$user" \
		SHELL="$DESKTOP_USER_SHELL" XDG_RUNTIME_DIR="$runtime" LIBSEAT_BACKEND=seatd
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	local sessions session
	[ -d /run/systemd/system ] || return 0
	sessions=
	for session in $(loginctl list-sessions --no-legend --no-pager | awk '{print $1}'); do
		[ "$(loginctl show-session "$session" -p Service --value 2>/dev/null)" = openwrt-desktop ] || continue
		sessions="$sessions $session"
	done
	systemctl stop openwrt-desktop.service 2>/dev/null || :
	# Kill this desktop's applications without touching the user's other
	# login sessions or shared user manager/message bus.
	for session in $sessions; do loginctl terminate-session "$session" 2>/dev/null || :; done
}

service_triggers() {
	procd_add_reload_trigger desktop
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/desktop restart
}
