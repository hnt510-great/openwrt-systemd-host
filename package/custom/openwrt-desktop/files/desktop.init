#!/bin/sh /etc/rc.common
START=95
STOP=5
USE_PROCD=1

write_lan_environment() {
	local address path rdp tmp
	path=/run/openwrt-desktop
	[ ! -L "$path" ] || return 1
	mkdir -p "$path" || return 1
	chown 0:0 "$path"
	chmod 0755 "$path"
	address="$(desktop_lan_address)"
	case "$address" in
		''|0.0.0.0|*[!0-9.]*) rm -f "$path/$DESKTOP_USER_UID.env"; return 0 ;;
	esac
	rdp=0
	[ "$(uci -q get desktop.main.rdp_enabled || :)" != 1 ] || rdp=1
	tmp="$(mktemp "$path/.lan.XXXXXX")" || return 1
	printf 'OPENWRT_DESKTOP_LAN_ADDRESS=%s\nOPENWRT_RDP_ADDRESS=%s\nOPENWRT_DESKTOP_RDP_ENABLED=%s\n' \
		"$address" "$address" "$rdp" > "$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$path/$DESKTOP_USER_UID.env"
}

write_active_state() {
	local path tmp
	path=/run/openwrt-desktop
	[ ! -L "$path" ] || return 1
	mkdir -p "$path" || return 1
	chown 0:0 "$path"
	chmod 0755 "$path"
	tmp="$(mktemp "$path/.active.XXXXXX")" || return 1
	printf 'ACTIVE_SESSION=%s\nACTIVE_USER=%s\nACTIVE_KMS_SCHEDULING=%s\nACTIVE_OUTPUT=%s\nACTIVE_MODE=%s\n' \
		"$1" "$2" "$3" "$4" "$5" > "$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$path/active.env"
}

start_service() {
	local enabled user configured_session session kms_scheduling output mode credential_prop
	. /usr/libexec/desktop-common.sh
	config_load desktop
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get user main user
	config_get configured_session main session ''
	config_get kms_scheduling main kms_scheduling high-priority
	config_get output main output auto
	config_get mode main mode preferred
	case "$kms_scheduling" in
		high-priority|realtime|normal) ;;
		*) desktop_error "Invalid kms_scheduling '$kms_scheduling' (expected high-priority, realtime or normal)"; return 1 ;;
	esac
	desktop_validate_user "$user" || return 1
	session="$(desktop_resolve_session "$configured_session")" || return 1
	desktop_load_session "$session" || return 1
	desktop_session_check || {
		desktop_error "Desktop session '$session' is not installed or unavailable"
		return 1
	}
	credential_prop="$(desktop_session_credential_prop)" || return 1
	write_lan_environment || return 1
	systemctl is-active --quiet openwrt-desktop.service && return 0
	if [ -e /run/systemd/transient/openwrt-desktop.service ]; then
		rm -f /run/systemd/transient/openwrt-desktop.service
		systemctl daemon-reload 2>/dev/null || :
	fi
	systemctl reset-failed openwrt-desktop.service 2>/dev/null || :
	desktop_select_output "$output" >/dev/null || return 1
	set -- systemd-run --quiet --collect --unit=openwrt-desktop.service \
		--uid="$user" --property=PAMName=openwrt-desktop --property=Type=exec \
		--property=Restart=on-failure --property=RestartSec=5s \
		--property=StandardOutput=journal --property=StandardError=journal \
		--property=Requires='systemd-logind.service openwrt-desktop-coldplug.service' \
		--property=After='systemd-logind.service openwrt-desktop-coldplug.service' \
		--setenv=HOME="$DESKTOP_USER_HOME" --setenv=USER="$user" --setenv=LOGNAME="$user" \
		--setenv=SHELL="$DESKTOP_USER_SHELL" --setenv=XDG_SESSION_TYPE=wayland --setenv=XDG_SESSION_CLASS=user \
		--setenv=OPENWRT_DESKTOP_SESSION="$session" \
		--setenv=OPENWRT_DESKTOP_KMS_SCHEDULING="$kms_scheduling"
	if [ -n "$credential_prop" ]; then
		set -- "$@" --property="$credential_prop"
	fi
	if [ -e /dev/tty0 ]; then
		/bin/busybox chvt 7 || return 1
		set -- "$@" --property=StandardInput=tty --property=TTYPath=/dev/tty7 --setenv=XDG_SEAT=seat0 --setenv=XDG_VTNR=7
	fi
	"$@" /usr/libexec/desktop-session || return 1
	rm -f /run/openwrt-desktop/manual-stop
	write_active_state "$session" "$user" "$kms_scheduling" "$output" "$mode"
}

reload_service() {
	local user
	. /usr/libexec/desktop-common.sh
	user="$(uci -q get desktop.main.user || :)"
	desktop_validate_user "$user" || return 1
	write_lan_environment
}

stop_service() {
	local session user active_file active_session active_user line
	. /usr/libexec/desktop-common.sh
	if [ ! -L /run/openwrt-desktop ]; then
		mkdir -p /run/openwrt-desktop
		chown 0:0 /run/openwrt-desktop
		chmod 0755 /run/openwrt-desktop
		: > /run/openwrt-desktop/manual-stop
	fi
	active_file=/run/openwrt-desktop/active.env
	active_session=
	active_user=
	if [ -f "$active_file" ] && [ ! -L "$active_file" ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			case "$line" in
				ACTIVE_SESSION=*) active_session="${line#*=}" ;;
				ACTIVE_USER=*) active_user="${line#*=}" ;;
			esac
		done < "$active_file"
	fi
	user="${active_user:-$(uci -q get desktop.main.user || :)}"
	session="${active_session:-$(uci -q get desktop.main.session || :)}"
	if [ -z "$session" ]; then
		session="$(desktop_resolve_session '' 2>/dev/null || :)"
	fi
	if [ -n "$user" ] && [ -n "$session" ] && desktop_validate_session_id "$session" 2>/dev/null; then
		su -s /bin/sh -c "/usr/libexec/desktop-user-stop '$session'" "$user" 2>/dev/null || :
	fi
	systemctl stop openwrt-desktop.service 2>/dev/null || :
	for session in $(loginctl list-sessions --no-legend --no-pager | awk '{print $1}'); do
		[ "$(loginctl show-session "$session" -p Service --value 2>/dev/null)" = openwrt-desktop ] || continue
		loginctl terminate-session "$session" 2>/dev/null || :
	done
	if [ -e /run/systemd/transient/openwrt-desktop.service ]; then
		rm -f /run/systemd/transient/openwrt-desktop.service
		systemctl daemon-reload 2>/dev/null || :
	fi
	rm -f "$active_file"
}

service_triggers() {
	procd_add_reload_trigger desktop
	procd_add_interface_trigger 'interface.*' lan /etc/init.d/desktop reload
}
