#!/bin/sh
set -eu
if [ ! -x /usr/bin/dbus-daemon ]; then exec "$@"; fi
# procd signals the session's main process. Keep that process here so that
# stopping/restarting the desktop also terminates its private D-Bus daemon.
bus_pid=
desktop_pid=
cleanup() {
	[ -z "$desktop_pid" ] || kill -TERM "$desktop_pid" 2>/dev/null || :
	[ -z "$bus_pid" ] || kill -TERM "$bus_pid" 2>/dev/null || :
}
trap cleanup EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT
bus_info=$(dbus-daemon --session --fork --print-address=1 --print-pid=1)
newline='
'
export DBUS_SESSION_BUS_ADDRESS="${bus_info%%"$newline"*}"
bus_pid=${bus_info##*"$newline"}
case "$bus_pid" in ''|*[!0-9]*) echo 'Invalid D-Bus session PID' >&2; exit 1 ;; esac
unset DBUS_SESSION_BUS_PID DBUS_SESSION_BUS_WINDOWID DBUS_STARTER_ADDRESS DBUS_STARTER_BUS_TYPE
"$@" &
desktop_pid=$!
status=0
wait "$desktop_pid" || status=$?
exit "$status"
