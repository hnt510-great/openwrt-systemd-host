#!/bin/sh
set -eu
set +x
umask 077
. /usr/libexec/desktop-common.sh
[ "$(id -u)" = 0 ] || { desktop_error 'Run desktop-rdp-setup as root'; exit 1; }
[ "$#" = 1 ] || { [ "$#" = 2 ] && [ "$2" = --password-stdin ]; } || {
	printf 'Usage: desktop-rdp-setup USER [--password-stdin]\n' >&2; exit 1;
}
user=$1
desktop_validate_user "$user"
[ "$(uci -q get desktop.main.user || :)" = "$user" ] && 	[ "$(uci -q get desktop.main.enabled || :)" = 1 ] || {
	desktop_error 'Run desktop-setup for this user first'; exit 1;
}
[ -x /usr/bin/grdctl ] || { desktop_error 'GNOME Remote Desktop is not installed'; exit 1; }
port="$(uci -q get desktop.main.rdp_port || printf 3389)"
desktop_validate_rdp "$port"
tty_state=
cleanup() {
	[ -z "$tty_state" ] || stty "$tty_state" <&3
	unset password confirm
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
if [ "${2:-}" = --password-stdin ]; then
	IFS= read -r password
else
	exec 3</dev/tty 4>/dev/tty
	tty_state="$(stty -g <&3)"
	stty -echo <&3
	printf 'New RDP password: ' >&4
	IFS= read -r password <&3
	printf '\nConfirm RDP password: ' >&4
	IFS= read -r confirm <&3
	printf '\n' >&4
	stty "$tty_state" <&3
	tty_state=
	[ "$password" = "$confirm" ] || { desktop_error 'Passwords do not match'; exit 1; }
fi
[ -n "$password" ] || { desktop_error 'The RDP password must be nonempty'; exit 1; }
printf '%s\n' "$password" | su -s /bin/sh -c /usr/libexec/desktop-rdp-configure "$user"
unset password confirm
uci set desktop.main.rdp_enabled=1
uci commit desktop
/etc/init.d/desktop reload
printf 'RDP configured for %s on LAN port %s. The local GNOME session remains running.\n' "$user" "$port"
openssl x509 -in "/etc/desktop/tls/$user.crt" -noout -fingerprint -sha256
