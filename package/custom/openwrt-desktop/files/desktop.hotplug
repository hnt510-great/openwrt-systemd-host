#!/bin/sh
case "${ACTION:-}" in
	add|change)
		# udev already notified openwrt-desktop-drm.path; avoid duplicating the
		# request or waiting across openwrt-desktop-coldplug -> openwrt-desktop.
		[ "${OPENWRT_UDEV_HANDLED_DESKTOP:-0}" = 1 ] && exit 0
		# Direct hotplug-call / ubus hotplug.drm.call compatibility path:
		# check config and manual-stop inside the desktop init lock.
		/etc/init.d/desktop autostart
		;;
esac
