#!/usr/bin/python3
"""Set up GNOME integration without replacing the user's application settings."""
import os
from pathlib import Path
import re
import subprocess
import sys
import time

import gi
gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib


def enable_input_panel():
    if not Path('/usr/bin/fcitx5').exists():
        return
    shell = Gio.Settings.new('org.gnome.shell')
    extensions = shell.get_strv('enabled-extensions')
    if 'kimpanel@kde.org' not in extensions:
        shell.set_strv('enabled-extensions', [*extensions, 'kimpanel@kde.org'])
    # Native GTK clients use Mutter's text-input/IBus bridge. The GTK module
    # remains available for Xwayland clients, without forcing it on Flatpaks.
    settings = Gio.Settings.new('org.gnome.settings-daemon.plugins.xsettings')
    value = settings.get_value('overrides')
    overrides = {}
    for index in range(value.n_children()):
        item = value.get_child_value(index)
        overrides[item.get_child_value(0).get_string()] = item.get_child_value(1).get_variant()
    overrides['Gtk/IMModule'] = GLib.Variant('s', 'fcitx')
    settings.set_value('overrides', GLib.Variant('a{sv}', overrides))


def migrate_monitor():
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    marker = config / 'openwrt-desktop/monitor-migrated'
    # GNOME Settings owns an explicitly saved layout. Until then, the legacy
    # UCI mode remains the persistent preference, including on later boots.
    if (config / 'monitors.xml').exists():
        return
    def uci(key, default):
        result = subprocess.run(['uci', '-q', 'get', 'desktop.main.' + key],
                                capture_output=True, text=True, check=False)
        return result.stdout.strip() if result.returncode == 0 else default
    mode = uci('mode', 'preferred')
    output = uci('output', 'auto')
    if mode != 'preferred':
        match = re.fullmatch(r'(\d+)x(\d+)(?:@(\d+))?', mode)
        if not match:
            raise ValueError('Invalid legacy desktop mode')
        proxy = Gio.DBusProxy.new_for_bus_sync(
            Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
            'org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
            'org.gnome.Mutter.DisplayConfig', None)
        for attempt in range(20):
            serial, monitors, logical, _ = proxy.call_sync(
                'GetCurrentState', None, Gio.DBusCallFlags.NONE, 10000, None).unpack()
            if logical:
                break
            if attempt == 19:
                raise ValueError('Desktop monitors are not ready')
            time.sleep(0.5)
        # Multi-monitor layouts belong to GNOME Settings; never guess positions.
        if len(logical) == 1 and len(logical[0][5]) == 1:
            current = logical[0]
            connector = current[5][0][0]
            if output in ('auto', connector):
                monitor = next(m for m in monitors if m[0][0] == connector)
                candidates = [m for m in monitor[1]
                              if m[1:3] == (int(match[1]), int(match[2])) or
                              list(m[1:3]) == [int(match[1]), int(match[2])]]
                if match[3]:
                    candidates = [m for m in candidates if abs(m[3] - int(match[3])) < 1]
                if not candidates:
                    raise ValueError('Configured desktop mode is not offered by the monitor')
                selected = max(candidates, key=lambda m: m[3])
                scale = current[2] if current[2] in selected[5] else selected[4]
                layout = [(current[0], current[1], scale, current[3], True,
                           [(connector, selected[0], {})])]
                # Persistent mode asks Shell for confirmation and otherwise
                # reverts after its timeout. UCI already persists this choice;
                # apply it without a confirmation dialog on unattended startup.
                proxy.call_sync('ApplyMonitorsConfig', GLib.Variant(
                    '(uua(iiduba(ssa{sv}))a{sv})', (serial, 1, layout, {})),
                    Gio.DBusCallFlags.NONE, 10000, None)
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.touch(mode=0o600)


if __name__ == '__main__':
    if os.getuid() < 1000:
        raise SystemExit('Run as the ordinary desktop user')
    enable_input_panel()
    try:
        migrate_monitor()
    except (ValueError, GLib.Error) as error:
        print(f'Monitor migration deferred: {error}', file=sys.stderr)
    Gio.Settings.sync()
