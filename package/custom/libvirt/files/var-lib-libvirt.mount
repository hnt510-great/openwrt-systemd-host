[Unit]
Description=Persistent libvirt state
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Requires=libvirt-openwrt-prepare.service
After=libvirt-openwrt-prepare.service
Before=virtqemud.service virtstoraged.service virtsecretd.service virtlogd.service virtlockd.service

[Mount]
What=/srv/libvirt/state
Where=/var/lib/libvirt
Type=none
Options=bind
