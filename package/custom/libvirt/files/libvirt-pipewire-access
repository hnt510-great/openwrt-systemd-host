#!/bin/sh
# Opt-in access for qemu:///system; never run user-path operations as root.
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root' >&2; exit 1; }
[ "$#" = 1 ] || [ "$#" = 2 ] || exit 1
uid=$1
case "$uid" in ''|0|0*|*[!0-9]*) echo 'Expected a non-root numeric UID' >&2; exit 1 ;; esac
action=${2:-grant}
case "$action" in grant|revoke) ;; *) exit 1 ;; esac
user=$(awk -F: -v uid="$uid" '$3 == uid { print $1; exit }' /etc/passwd)
[ -n "$user" ] || { echo 'Unknown UID' >&2; exit 1; }
# su drops credentials before resolving the user-controlled runtime paths.
# A malicious symlink can therefore only affect files owned by that user.
exec su -s /bin/sh -c '
set -eu
runtime=/run/user/$(id -u)
[ -d "$runtime" ] && [ ! -L "$runtime" ] || exit 0
[ "$(stat -c %u "$runtime")" = "$(id -u)" ] || exit 1
qemu_uid=$(id -u libvirt-qemu)
# Avoid directory attribute changes retriggering the path unit indefinitely.
grant_acl() {
    if ! getfacl -cpn "$1" | grep -qx "user:$qemu_uid:$2"; then
        setfacl -m "u:$qemu_uid:$2" "$1"
    fi
}
if [ "$0" = revoke ]; then
    if [ -S "$runtime/pipewire-0" ] && [ ! -L "$runtime/pipewire-0" ]; then
        setfacl -x u:libvirt-qemu "$runtime/pipewire-0"
    fi
    setfacl -x u:libvirt-qemu "$runtime"
else
    grant_acl "$runtime" --x
    if [ -S "$runtime/pipewire-0" ] && [ ! -L "$runtime/pipewire-0" ]; then
        grant_acl "$runtime/pipewire-0" rw-
    fi
fi
' -- "$user" "$action"
