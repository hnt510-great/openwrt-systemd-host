[Unit]
Description=Graceful shutdown of OpenWrt libvirt guests
Requires=virtqemud.service
After=virtqemud.service virtstoraged.service virtsecretd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/libexec/libvirt-openwrt-guests
TimeoutStopSec=100

[Install]
WantedBy=multi-user.target
