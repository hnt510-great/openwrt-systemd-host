From: OpenWrt developers <openwrt-devel@lists.openwrt.org>
Subject: [PATCH] remote: report unsupported disabled secondary drivers

Modular hypervisor daemons forward secondary driver requests even when
those drivers were excluded from the build. Return VIR_ERR_NO_SUPPORT
instead of attempting absent sockets so clients can detect capabilities.
OpenWrt retains ownership of networking, firewall and device events.

---
--- a/src/remote/remote_daemon_dispatch.c
+++ b/src/remote/remote_daemon_dispatch.c
@@ -1957,6 +1957,11 @@
 static virConnectPtr
 remoteGetInterfaceConn(virNetServerClient *client)
 {
+#ifndef WITH_INTERFACE
+    virReportError(VIR_ERR_NO_SUPPORT, "%s",
+                   _("Host interface management is not available in this build"));
+    return NULL;
+#else
     struct daemonClientPrivate *priv =
         virNetServerClientGetPrivateData(client);
 
@@ -1967,12 +1972,18 @@
         return NULL;
 
     return priv->interfaceConn;
+#endif
 }
 
 
 static virConnectPtr
 remoteGetNetworkConn(virNetServerClient *client)
 {
+#ifndef WITH_NETWORK
+    virReportError(VIR_ERR_NO_SUPPORT, "%s",
+                   _("Virtual network management is not available in this build"));
+    return NULL;
+#else
     struct daemonClientPrivate *priv =
         virNetServerClientGetPrivateData(client);
 
@@ -1983,12 +1994,18 @@
         return NULL;
 
     return priv->networkConn;
+#endif
 }
 
 
 static virConnectPtr
 remoteGetNodeDevConn(virNetServerClient *client)
 {
+#ifndef WITH_NODE_DEVICES
+    virReportError(VIR_ERR_NO_SUPPORT, "%s",
+                   _("Host device management is not available in this build"));
+    return NULL;
+#else
     struct daemonClientPrivate *priv =
         virNetServerClientGetPrivateData(client);
 
@@ -1999,12 +2016,18 @@
         return NULL;
 
     return priv->nodedevConn;
+#endif
 }
 
 
 static virConnectPtr
 remoteGetNWFilterConn(virNetServerClient *client)
 {
+#ifndef WITH_NWFILTER
+    virReportError(VIR_ERR_NO_SUPPORT, "%s",
+                   _("Network filter management is not available in this build"));
+    return NULL;
+#else
     struct daemonClientPrivate *priv =
         virNetServerClientGetPrivateData(client);
 
@@ -2015,6 +2038,7 @@
         return NULL;
 
     return priv->nwfilterConn;
+#endif
 }
 
 
