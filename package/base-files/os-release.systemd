NAME="OpenWrt Systemd Host"
VERSION="%V"
ID="openwrt-systemd"
ID_LIKE="openwrt lede"
PRETTY_NAME="OpenWrt Systemd Host %V"
VARIANT="Router and general-purpose Linux host with native systemd"
VARIANT_ID="native-systemd"
VERSION_ID="%v"
HOME_URL="%u"
BUG_URL="%b"
SUPPORT_URL="%s"
FIRMWARE_URL="%f"
BUILD_ID="%R"
OPENWRT_BOARD="%S"
OPENWRT_ARCH="%A"
OPENWRT_TAINTS="%t"
OPENWRT_DEVICE_MANUFACTURER="%M"
OPENWRT_DEVICE_MANUFACTURER_URL="%m"
OPENWRT_DEVICE_PRODUCT="%P"
OPENWRT_DEVICE_REVISION="%h"
OPENWRT_RELEASE="OpenWrt Systemd Host %V %C"
OPENWRT_BUILD_DATE="%B"
OPENWRT_BASE_DISTRIBUTION="%D"
OPENWRT_OS_DESCRIPTION="Custom OpenWrt router and general-purpose Linux host; native systemd, glibc and APK, with optional desktop, virtualization, application, container and development capabilities. UCI, netifd and procd retain router service ownership."
OPENWRT_SYSTEM_DESCRIPTION_FILE="/usr/share/doc/openwrt/system-description.md"
OPENWRT_FEATURES="@OPENWRT_FEATURES@"
OPENWRT_FEATURES_SCOPE="image-build"
OPENWRT_DEFAULT_INIT="systemd"
OPENWRT_ROUTER_SERVICE_MANAGER="procd"
OPENWRT_ROUTER_CONFIG_SYSTEM="uci"
OPENWRT_NETWORK_MANAGER="netifd"
OPENWRT_RECOVERY_INIT="procd"
OPENWRT_LIBC="glibc"
OPENWRT_PACKAGE_MANAGER="apk"
OPENWRT_PACKAGE_REPOSITORY_FLAVOR="native-systemd"
OPENWRT_FIRMWARE_UPGRADE_MODE="procd-recovery"
