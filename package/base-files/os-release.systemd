NAME="OpenWrt Systemd Host"
VERSION="%V"
ID="openwrt-systemd"
ID_LIKE="openwrt lede"
PRETTY_NAME="OpenWrt Systemd Host %V"
VARIANT="Native systemd with OpenWrt router services"
VARIANT_ID="native-systemd"
VERSION_ID="%v"
HOME_URL="%u"
BUG_URL="%b"
SUPPORT_URL="%s"
FIRMWARE_URL="%f"
BUILD_ID="%R"
OPENWRT_BOARD="%S"
OPENWRT_ARCH="%A"
OPENWRT_TAINTS="%t"
OPENWRT_DEVICE_MANUFACTURER="%M"
OPENWRT_DEVICE_MANUFACTURER_URL="%m"
OPENWRT_DEVICE_PRODUCT="%P"
OPENWRT_DEVICE_REVISION="%h"
OPENWRT_RELEASE="%D %V %C"
OPENWRT_BUILD_DATE="%B"
OPENWRT_OS_DESCRIPTION="OpenWrt-based Linux host with native systemd, glibc and APK; UCI, netifd and procd manage router services."
OPENWRT_FEATURES="@OPENWRT_FEATURES@"
OPENWRT_DEFAULT_INIT="systemd"
OPENWRT_ROUTER_SERVICE_MANAGER="procd"
OPENWRT_RECOVERY_INIT="procd"
OPENWRT_LIBC="glibc"
OPENWRT_PACKAGE_MANAGER="apk"
OPENWRT_PACKAGE_REPOSITORY_FLAVOR="native-systemd"
OPENWRT_FIRMWARE_UPGRADE_MODE="procd-recovery"
