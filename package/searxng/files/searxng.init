#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

CONF_FILE="/etc/searxng/uwsgi.ini"
LOG_FILE="/var/log/searxng.log"

start_service() {
	# Ensure logs and settings directories exist
	mkdir -p /etc/searxng
	touch "$LOG_FILE"
	chown nobody:nogroup "$LOG_FILE"

	procd_open_instance
	procd_set_param command /usr/sbin/uwsgi --ini "$CONF_FILE"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
