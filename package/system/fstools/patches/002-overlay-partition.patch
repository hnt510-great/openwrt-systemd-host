--- a/libfstools/partname.c
+++ b/libfstools/partname.c
@@ -1,6 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
 #include "common.h"
+#include <limits.h>
+#include <sys/sysmacros.h>
 
 #define BUFLEN 64
 
@@ -76,12 +78,42 @@ static char *rootdevname(char *devpath)
 	return basename(devpath);
 }
 
+/* Resolve the mounted root to its own disk; never scan unrelated disks. */
+static char *mounted_root_disk(char *buf, size_t len)
+{
+	struct stat st;
+	char link[64], path[PATH_MAX], partition[PATH_MAX + 16];
+	static const char * const roots[] = { "/", "/rom" };
+	size_t i;
+	char *slash;
+
+	for (i = 0; i < ARRAY_SIZE(roots); i++) {
+		if (stat(roots[i], &st))
+			continue;
+		snprintf(link, sizeof(link), "/sys/dev/block/%u:%u",
+			 major(st.st_dev), minor(st.st_dev));
+		if (!realpath(link, path))
+			continue;
+		snprintf(partition, sizeof(partition), "%s/partition", path);
+		if (!access(partition, F_OK)) {
+			slash = strrchr(path, '/');
+			if (!slash)
+				continue;
+			*slash = '\0';
+		}
+		snprintf(buf, len, "%s", basename(path));
+		return buf;
+	}
+	return NULL;
+}
