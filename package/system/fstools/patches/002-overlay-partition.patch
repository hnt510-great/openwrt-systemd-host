Subject: [PATCH] Mount separate overlay partitions and support ephemeral installer roots

Resolve PARTUUID roots to their own disk, recognize btrfs and xfs before
formatting, and honor an explicit tmpfs overlay for live USB installation.

---
--- a/libfstools/common.c
+++ b/libfstools/common.c
@@ -90,12 +90,17 @@ char *get_var_from_file(const char *file
 int block_file_identify(FILE *f, uint64_t offset)
 {
 	uint32_t magic = 0;
+	char btrfs_magic[8];
 	size_t n;
 
 	if (fseeko(f, offset, SEEK_SET) < 0)
 		return -1;
 
 	n = fread(&magic, sizeof(magic), 1, f);
+	if (n != 1)
+		return -1;
+	if (magic == cpu_to_be32(0x58465342))
+		return FS_XFS;
 	if (magic == cpu_to_le32(0x88b1f))
 		return FS_TARGZ;
 
@@ -123,6 +128,11 @@ int block_file_identify(FILE *f, uint64_
 	if ((le32_to_cpu(magic) & 0xffff) == 0xef53)
 		return FS_EXT4;
 
+	if (!fseeko(f, offset + 0x10040, SEEK_SET) &&
+	    fread(btrfs_magic, sizeof(btrfs_magic), 1, f) == 1 &&
+	    !memcmp(btrfs_magic, "_BHRfS_M", sizeof(btrfs_magic)))
+		return FS_BTRFS;
+
 	return FS_NONE;
 }
 
--- a/libfstools/libfstools.h
+++ b/libfstools/libfstools.h
@@ -30,6 +30,8 @@ enum {
 	FS_F2FS,
 	FS_EXT4,
 	FS_TARGZ,
+	FS_BTRFS,
+	FS_XFS,
 };
 
