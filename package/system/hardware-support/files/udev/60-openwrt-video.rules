# Native systemd: udev applies the device policy of 30-video.json.
SUBSYSTEM=="drm", KERNEL!="renderD*", GROUP="video", MODE="0660"
SUBSYSTEM=="media", GROUP="video", MODE="0660"
# v4l-id moves a node into video or video-capture by its capabilities.
SUBSYSTEM=="video4linux", GROUP="root", MODE="0660", RUN+="/usr/libexec/v4l-id $env{DEVNAME} video_capture,video_capture_mplane:video-capture;*:video"
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660"
