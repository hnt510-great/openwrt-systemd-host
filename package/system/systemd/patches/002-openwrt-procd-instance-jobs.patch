+/* procd escapes service/instance bytes with \\xNN rather than systemd's path escaping. */
+static int unit_openwrt_procd_names(Unit *u, char **ret_service, char **ret_instance) {
+        _cleanup_free_ char *escaped = NULL, *service = NULL, *instance = NULL;
+        const char *at;
+        int r;
+
+        if (!MANAGER_IS_SYSTEM(u->manager) || u->type != UNIT_SERVICE || !u->id ||
+            !unit_name_is_valid(u->id, UNIT_NAME_INSTANCE) || !startswith(u->id, "openwrt-"))
+                return 0;
+        at = strchr(u->id, '@');
+        escaped = strndup(u->id + STRLEN("openwrt-"), at - u->id - STRLEN("openwrt-"));
+        if (!escaped)
+                return -ENOMEM;
+        r = cunescape(escaped, 0, &service);
+        if (r < 0)
+                return r;
+        escaped = mfree(escaped);
+        escaped = strndup(at + 1, strlen(at + 1) - STRLEN(".service"));
+        if (!escaped)
+                return -ENOMEM;
+        r = cunescape(escaped, 0, &instance);
+        if (r < 0)
+                return r;
+        /* The decoded service is used as an init-script path, never as a shell command. */
+        if (!filename_is_valid(service) || isempty(instance))
+                return 0;
+        if (!u->transient) {
+                _cleanup_free_ char *script = NULL;
+
+                if (u->load_state != UNIT_NOT_FOUND)
+                        return 0;
+                script = strjoin("/etc/init.d/", service);
+                if (!script)
+                        return -ENOMEM;
+                if (access(script, X_OK) < 0)
+                        return 0;
+        }
+        if (ret_service)
+                *ret_service = TAKE_PTR(service);
+        if (ret_instance)
+                *ret_instance = TAKE_PTR(instance);
+        return 1;
+}
+
+bool unit_is_openwrt_procd_instance(Unit *u) {
+        return unit_openwrt_procd_names(u, NULL, NULL) > 0;
+}
+
+int unit_check_openwrt_procd_job(Unit *u, JobType type, sd_bus_message *message, sd_varlink *link,
+                               sd_bus_error *reterr_error) {
+        _cleanup_(pidref_done) PidRef peer = PIDREF_NULL;
+        _cleanup_free_ char *service = NULL, *instance = NULL, *comm = NULL, *bridge = NULL;
+        const char *verb;
+        Unit *procd;
+        int r;
+
+        r = unit_openwrt_procd_names(u, &service, &instance);
+        if (r <= 0)
+                return r;
+
+        /* Only the main process is trusted, not other processes in procd's cgroup. */
+        r = message ? bus_query_sender_pidref(message, &peer) :
+                link ? varlink_get_peer_pidref(link, &peer) : -ESRCH;
+        procd = manager_get_unit(u->manager, "openwrt-procd.service");
+        if (r >= 0 && procd && procd->type == UNIT_SERVICE &&
+            pidref_is_set(&SERVICE(procd)->main_pid) && pidref_equal(&peer, &SERVICE(procd)->main_pid))
+                return 0;
+
+        verb = IN_SET(type, JOB_RELOAD, JOB_TRY_RELOAD, JOB_RELOAD_OR_START) ? "reload" :
+                IN_SET(type, JOB_RESTART, JOB_TRY_RESTART) ? "restart" :
+                type == JOB_STOP ? "stop" : "start";
+        if (access("/usr/libexec/openwrt-service-bridge", X_OK) >= 0) {
+                bridge = strjoin("'systemctl ", verb, " openwrt@", service, "' or ");
+                if (!bridge)
+                        return -ENOMEM;
+        }
+        (void) pidref_get_comm(&peer, &comm);
+        log_unit_info(u, "Refused direct %s from PID "PID_FMT" (%s); use /etc/init.d/%s %s.",
+                      verb, peer.pid, strna(comm), service, verb);
+        if (u->load_state == UNIT_NOT_FOUND)
+                return sd_bus_error_setf(reterr_error, BUS_ERROR_ONLY_BY_DEPENDENCY,
+                                        "%s is not running; procd creates the instances of OpenWrt service '%s'. "
+                                        "Use %s'/etc/init.d/%s %s'.",
+                                        u->id, service, strempty(bridge), service, verb);
+        return sd_bus_error_setf(reterr_error, BUS_ERROR_ONLY_BY_DEPENDENCY,
+                                "%s is procd instance '%s' of OpenWrt service '%s'; a direct %s would skip /etc/init.d/%s. "
+                                "Use %s'/etc/init.d/%s %s'.",
+                                u->id, instance, service, verb, service, strempty(bridge), service, verb);
+}
