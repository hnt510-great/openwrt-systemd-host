#!/bin/sh
case "$1" in
	boot) prefix=S; action=boot ;;
	shutdown) prefix=K; action=shutdown ;;
	*) exit 2 ;;
esac
for script in /etc/rc.d/"$prefix"[0-9][0-9]*; do
	[ -x "$script" ] || continue
	# D-Bus and SSH are owned by native units in this boot mode.
	case "${script##*/}" in
		[SK][0-9][0-9]dbus|K[0-9][0-9]umount) continue ;;
		[SK][0-9][0-9]sshd)
			[ ! -f /usr/lib/systemd/system/sshd.service ] || continue
			;;
	esac
	# rc.common supplies its own hook, including for direct invocations.
	IFS= read -r interpreter < "$script"
	if [ "${interpreter#* /etc/rc.common}" = "$interpreter" ]; then
		canonical="$(readlink -f "$script")"
		set -- /usr/libexec/openwrt-cgroup exec "${canonical##*/}" "$script" "$action"
	else
		set -- "$script" "$action"
	fi
	if [ "$action" = shutdown ]; then
		/usr/bin/timeout -s TERM 25 "$@"
	else
		"$@"
	fi
	status=$?
	[ "$status" -eq 0 ] || echo "OpenWrt rc script $script $action exited $status" >&2
done
# Like procd's rc queue, finish the sequence even when an optional script fails.
exit 0
