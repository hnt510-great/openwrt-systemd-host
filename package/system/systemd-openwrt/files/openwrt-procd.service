[Unit]
Description=OpenWrt procd service API and hotplug handlers
Requires=openwrt-ubusd.service
Wants=openwrt-services.service systemd-udevd.service
After=openwrt-ubusd.service systemd-udevd.service systemd-udev-trigger.service
Before=openwrt-services.service

[Service]
Type=notify
NotifyAccess=main
# Instances run as transient openwrt-SERVICE@INSTANCE.service units.
ExecStart=/sbin/procd --systemd=units -S
TimeoutStartSec=90
TimeoutStopSec=30
KillMode=control-group
Restart=on-failure

[Install]
WantedBy=multi-user.target
