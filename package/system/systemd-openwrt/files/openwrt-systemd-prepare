#!/bin/sh
# Executed by early init after the OpenWrt overlay has been mounted.
[ -f /etc/openwrt-systemd ] || exit 1
mkdir -p /run || exit 1
if grep -q ' /rom/run ' /proc/mounts; then
	mount --move /rom/run /run || exit 1
elif ! grep -q ' /run ' /proc/mounts; then
	mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run || exit 1
fi
[ -e /tmp/run ] || ln -s /run /tmp/run
[ "$1" = --runtime-only ] && exit 0
[ "$(readlink /bin)" = usr/bin ] || exit 1
[ "$(readlink /sbin)" = usr/sbin ] || exit 1
[ "$(readlink /lib)" = usr/lib ] || exit 1
[ -d /run ] && [ ! -L /run ] || exit 1
[ -L /var/run ] && [ "$(readlink /var/run)" = /run ] || exit 1
/usr/lib/systemd/systemd --version >/dev/null || exit 1
# Refuse a partial logging upgrade instead of letting an old logd unlink
# journald's socket, or booting with the legacy package mask still installed.
if [ "$(readlink /etc/systemd/system/systemd-journald-dev-log.socket)" = /dev/null ] ||
   [ "$(cat /usr/share/logd/journal-reader 2>/dev/null)" != journal-reader-v1 ]; then
	echo 'Native logging requires journal-capable logd and an unmasked systemd-journald-dev-log.socket; booting procd recovery' >&2
	exit 1
fi
if [ -f /etc/openwrt-kernel/state.json ] || [ -f /usr/share/openwrt-kernel/selected.json ]; then
	/usr/sbin/kernelctl prepare || exit 1
fi
# Full kmod/libkmod needs indexes before systemd can request modules.
# Run on the target after mounting the overlay, never on the build host.
if [ -x /usr/sbin/depmod ]; then
	/usr/sbin/depmod -a || exit 1
fi
touch /run/openwrt-journald-primary || exit 1
exit 0
