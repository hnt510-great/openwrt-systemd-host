+++ b/log/journal.c
@@ -0,0 +1,447 @@
+// SPDX-License-Identifier: LGPL-2.1-only
+/* Journal-backed logd compatibility buffer. Journald owns all input sockets. */
+#include <errno.h>
+#include <limits.h>
+#include <poll.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <syslog.h>
+#include <unistd.h>
+#include <systemd/sd-id128.h>
+#include <systemd/sd-journal.h>
+#include <libubox/uloop.h>
+#include <libubox/utils.h>
+#include "syslog.h"
+
+#define JOURNAL_BATCH 128
+
+struct journal_record {
+	struct journal_record *next;
+	struct timespec ts;
+	int priority;
+	int source;
+	size_t size;
+	char msg[LOG_LINE_SIZE];
+};
+
+static sd_journal *journal;
+static struct uloop_fd journal_fd = { .fd = -1 };
+static struct uloop_timeout journal_timer, drain_timer, path_timer;
+static char *last_cursor;
+static struct journal_path {
+	const char *name;
+	dev_t device;
+	ino_t inode;
+	bool exists;
+} journal_paths[] = {
+	{ .name = "/run/log/journal" },
+	{ .name = "/var/log/journal" },
+};
+
+static bool journal_paths_changed(void)
+{
+	struct stat st;
+	bool changed = false;
+
+	for (size_t i = 0; i < ARRAY_SIZE(journal_paths); i++) {
+		struct journal_path *path = &journal_paths[i];
+		bool exists = stat(path->name, &st) == 0;
+
+		if (exists != path->exists ||
+		    (exists && (st.st_dev != path->device || st.st_ino != path->inode)))
+			changed = true;
+		path->exists = exists;
+		if (exists) {
+			path->device = st.st_dev;
+			path->inode = st.st_ino;
+		}
+	}
+	return changed;
+}
+
+static int journal_open_reader(sd_journal **result)
+{
+	sd_journal *reader = NULL;
+	sd_id128_t boot;
+	char match[sizeof("_BOOT_ID=") + SD_ID128_STRING_MAX];
+	int ret;
+
+	ret = sd_journal_open(&reader, SD_JOURNAL_LOCAL_ONLY | SD_JOURNAL_SYSTEM);
+	if (ret < 0)
+		return ret;
+	ret = sd_id128_get_boot(&boot);
+	if (ret < 0)
+		goto out;
+	snprintf(match, sizeof(match), "_BOOT_ID=" SD_ID128_FORMAT_STR, SD_ID128_FORMAT_VAL(boot));
+	ret = sd_journal_add_match(reader, match, 0);
+	if (ret < 0)
+		goto out;
+	ret = sd_journal_set_data_threshold(reader, LOG_LINE_SIZE);
+	if (ret < 0)
+		goto out;
+	*result = reader;
+	return 0;
+out:
+	sd_journal_close(reader);
+	return ret;
+}
+
+static int journal_seek_after(sd_journal *reader, const char *cursor)
+{
+	int ret;
+
+	if (!cursor)
+		return sd_journal_seek_head(reader);
+	ret = sd_journal_seek_cursor(reader, cursor);
+	if (ret < 0)
+		return ret;
+	ret = sd_journal_next(reader);
+	if (ret <= 0)
+		return ret;
+	ret = sd_journal_test_cursor(reader, cursor);
+	if (ret < 0)
+		return ret;
+	/* If the saved record was vacuumed, include its successor. */
+	if (!ret) {
+		ret = sd_journal_previous(reader);
+		if (ret < 0)
+			return ret;
+	}
+	return 0;
+}
+
+static void journal_error(int error)
+{
+	fprintf(stderr, "logd: journal reader failed: %s\n", strerror(-error));
+	exit(1); /* procd respawns the reader; never fall back to owning /dev/log. */
+}
+
+static int journal_field(const char *name, const char **data, size_t *size)
+{
+	const void *field;
+	size_t len, prefix = strlen(name) + 1;
+	int ret = sd_journal_get_data(journal, name, &field, &len);
+
+	if (ret < 0)
+		return ret;
+	if (len < prefix)
+		return -EINVAL;
+	*data = (const char *)field + prefix;
+	*size = len - prefix;
+	return 0;
+}
+
+static int journal_number(const char *name, int fallback, int maximum)
+{
+	const char *data;
+	size_t size;
+	unsigned int value = 0;
+
+	if (journal_field(name, &data, &size) < 0 || !size || size > 10)
+		return fallback;
+	for (size_t i = 0; i < size; i++) {
+		if (data[i] < '0' || data[i] > '9' ||
+		    value > ((unsigned int)maximum - (data[i] - '0')) / 10)
+			return fallback;
+		value = value * 10 + data[i] - '0';
+		if (value > (unsigned int)maximum)
+			return fallback;
+	}
+	return value;
+}
+
+static void journal_append(struct journal_record *record, const char *data, size_t size)
+{
+	/* Keep the legacy string/line boundary without changing the journal itself. */
+	while (size-- && record->size < sizeof(record->msg) - 1) {
+		unsigned char c = *data++;
+
+		record->msg[record->size++] = (c < ' ' || c == 127) ? ' ' : c;
+	}
+	record->msg[record->size] = 0;
+}
+
+static int journal_record_read(struct journal_record *record)
+{
+	const char *data;
+	size_t size;
+	uint64_t timestamp;
+	int ret;
+
+	memset(record, 0, sizeof(*record));
+	ret = journal_field("MESSAGE", &data, &size);
+	if (ret == -ENOENT)
+		return 0;
+	if (ret < 0)
+		return ret;
+	ret = sd_journal_get_realtime_usec(journal, &timestamp);
+	if (ret < 0)
+		return ret;
+	record->ts.tv_sec = timestamp / 1000000;
+	record->ts.tv_nsec = (timestamp % 1000000) * 1000;
+	record->source = SOURCE_SYSLOG;
+	if (!journal_field("_TRANSPORT", &data, &size) &&
+	    size == 6 && !memcmp(data, "kernel", 6))
+		record->source = SOURCE_KLOG;
+	record->priority = LOG_MAKEPRI(journal_number("SYSLOG_FACILITY",
+			record->source == SOURCE_KLOG ? LOG_KERN : LOG_DAEMON >> 3, 23) << 3,
+			journal_number("PRIORITY", LOG_INFO, 7));
+
+	if (record->source != SOURCE_KLOG) {
+		if (journal_field("SYSLOG_IDENTIFIER", &data, &size) < 0 &&
+		    journal_field("_COMM", &data, &size) < 0) {
+			data = "journal";
+			size = 7;
+		}
+		/* Leave room for the PID and message even for a very long identifier. */
+		journal_append(record, data, size < 128 ? size : 128);
+		if ((journal_field("SYSLOG_PID", &data, &size) == 0 ||
+		     journal_field("_PID", &data, &size) == 0) && size && size <= 10) {
+			bool numeric = true;
+
+			for (size_t i = 0; i < size; i++)
+				if (data[i] < '0' || data[i] > '9')
+					numeric = false;
+			if (numeric) {
+				journal_append(record, "[", 1);
+				journal_append(record, data, size);
+				journal_append(record, "]", 1);
+			}
+		}
+		journal_append(record, ": ", 2);
+	}
+	ret = journal_field("MESSAGE", &data, &size);
+	if (ret < 0)
+		return ret;
+	journal_append(record, data, size);
+	record->size++; /* log_store() includes the terminating NUL. */
+	return 1;
+}
+
+static void journal_record_store(struct journal_record *record)
+{
+	log_store(record->msg, record->size, record->priority, record->source, &record->ts);
+}
+
+static void journal_watches(void);
+
+static void journal_drain(struct uloop_timeout *timeout)
+{
+	struct journal_record record;
+	char *cursor;
+	int ret, count = 0;
+
+	while (count++ < JOURNAL_BATCH) {
+		ret = sd_journal_next(journal);
+		if (ret < 0)
+			journal_error(ret);
+		if (!ret)
+			break;
+		ret = journal_record_read(&record);
+		if (ret < 0)
+			journal_error(ret);
+		if (ret)
+			journal_record_store(&record);
+		ret = sd_journal_get_cursor(journal, &cursor);
+		if (ret < 0)
+			journal_error(ret);
+		free(last_cursor);
+		last_cursor = cursor;
+	}
+	if (count > JOURNAL_BATCH)
+		uloop_timeout_set(&drain_timer, 0);
+	journal_watches();
+}
+
+static void journal_process(struct uloop_timeout *timeout)
+{
+	int ret = sd_journal_process(journal);
+
+	if (ret < 0)
+		journal_error(ret);
+	/* INVALIDATE also covers rotation, vacuum and the runtime journal flush. */
+	journal_drain(NULL);
+}
+
+static void journal_ready(struct uloop_fd *fd, unsigned int events)
+{
+	journal_process(NULL);
+}
+
+static void journal_watches(void)
+{
+	struct timespec now;
+	uint64_t deadline, usec;
+	int fd = sd_journal_get_fd(journal);
+	int events, ret;
+
+	if (fd < 0)
+		journal_error(fd);
+	if (fd != journal_fd.fd) {
+		if (journal_fd.registered)
+			uloop_fd_delete(&journal_fd);
+		journal_fd.fd = fd;
+	}
+	events = sd_journal_get_events(journal);
+	if (events < 0)
+		journal_error(events);
+	ret = uloop_fd_add(&journal_fd,
+		((events & POLLIN) ? ULOOP_READ : 0) |
+		((events & POLLOUT) ? ULOOP_WRITE : 0));
+	if (ret < 0)
+		journal_error(-errno);
+	ret = sd_journal_get_timeout(journal, &deadline);
+	if (ret < 0)
+		journal_error(ret);
+	uloop_timeout_cancel(&journal_timer);
+	if (deadline == UINT64_MAX)
+		return;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+		journal_error(-errno);
+	usec = (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+	usec = deadline > usec ? (deadline - usec + 999) / 1000 : 0;
+	uloop_timeout_set(&journal_timer, usec > INT_MAX ? INT_MAX : (int)usec);
+}
+
+static void journal_check_paths(struct uloop_timeout *timeout)
+{
+	sd_journal *reader = NULL;
+	int ret;
+
+	/* Inotify cannot see a bind mount covering an already-watched directory. */
+	if (journal_paths_changed()) {
+		ret = journal_open_reader(&reader);
+		if (ret >= 0)
+			ret = journal_seek_after(reader, last_cursor);
+		if (ret < 0) {
+			sd_journal_close(reader);
+			journal_error(ret);
+		}
+		uloop_timeout_cancel(&drain_timer);
+		if (journal_fd.registered)
+			uloop_fd_delete(&journal_fd);
+		sd_journal_close(journal);
+		journal = reader;
+		journal_fd.fd = -1;
+		journal_watches();
+		uloop_timeout_set(&drain_timer, 0);
+	}
+	uloop_timeout_set(&path_timer, 1000);
+}
+
+int log_journal_init(int buffer_size)
+{
+	struct journal_record record, *records = NULL, *next;
+	char *cursor = NULL;
+	size_t bytes = 0;
+	int ret;
+
+	ret = journal_open_reader(&journal);
+	if (ret < 0)
+		return ret;
+	journal_fd.fd = sd_journal_get_fd(journal);
+	if (journal_fd.fd < 0) {
+		ret = journal_fd.fd;
+		goto out;
+	}
+	ret = sd_journal_seek_tail(journal);
+	if (ret < 0)
+		goto out;
+
+	/* Seed only the newest ringful, before registering the ubus object. */
+	while ((ret = sd_journal_previous(journal)) > 0) {
+		if (!cursor) {
+			ret = sd_journal_get_cursor(journal, &cursor);
+			if (ret < 0)
+				goto out;
+		}
+		ret = journal_record_read(&record);
+		if (ret < 0)
+			goto out;
+		if (!ret)
+			continue;
+		/* A very small legacy ring may not fit a maximum-sized message. */
+		if (record.size + 2 * sizeof(struct log_head) >= (size_t)buffer_size)
+			continue;
+		bytes += sizeof(struct log_head) + ((record.size + 3) & ~3U);
+		if (bytes + sizeof(struct log_head) >= (size_t)buffer_size)
+			break;
+		next = malloc(sizeof(*next));
+		if (!next) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		*next = record;
+		next->next = records;
+		records = next;
+	}
+	if (ret < 0)
+		goto out;
+	for (next = records; next; next = next->next)
+		journal_record_store(next);
+
+	if (cursor) {
+		ret = journal_seek_after(journal, cursor);
+		if (ret < 0)
+			goto out;
+		last_cursor = cursor;
+		cursor = NULL;
+	}
+	journal_fd.cb = journal_ready;
+	journal_timer.cb = journal_process;
+	drain_timer.cb = journal_drain;
+	path_timer.cb = journal_check_paths;
+	journal_paths_changed();
+	uloop_timeout_set(&path_timer, 1000);
+	journal_watches();
+	uloop_timeout_set(&drain_timer, 0);
+	ret = 0;
+out:
+	free(cursor);
+	while (records) {
+		next = records->next;
+		free(records);
+		records = next;
+	}
+	if (ret < 0)
+		log_journal_shutdown();
+	return ret;
+}
+
+int log_journal_write(const char *event)
+{
+	const struct sockaddr_un address = {
+		.sun_family = AF_UNIX,
+		.sun_path = "/run/systemd/journal/dev-log",
+	};
+	size_t size = strlen(event);
+	int fd, ret;
+
+	fd = socket(AF_UNIX, SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if (fd < 0)
+		return -errno;
+	ret = sendto(fd, event, size, MSG_NOSIGNAL,
+		     (const struct sockaddr *)&address, sizeof(address));
+	ret = ret < 0 ? -errno : ((size_t)ret == size ? 0 : -EIO);
+	close(fd);
+	return ret;
+}
+
+void log_journal_shutdown(void)
+{
+	uloop_timeout_cancel(&path_timer);
+	uloop_timeout_cancel(&drain_timer);
+	uloop_timeout_cancel(&journal_timer);
+	if (journal_fd.registered)
+		uloop_fd_delete(&journal_fd);
+	/* The descriptor belongs to libsystemd. */
+	sd_journal_close(journal);
+	journal = NULL;
+	journal_fd.fd = -1;
+	free(last_cursor);
+	last_cursor = NULL;
+}
