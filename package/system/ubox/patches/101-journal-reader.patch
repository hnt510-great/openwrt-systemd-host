+++ b/CMakeLists.txt
@@ -58,6 +58,12 @@
 
 ADD_EXECUTABLE(logd log/logd.c log/syslog.c)
 TARGET_LINK_LIBRARIES(logd ubox ubus udebug)
+IF(OPENWRT_SYSTEMD)
+  FIND_LIBRARY(systemd NAMES systemd REQUIRED)
+  TARGET_SOURCES(logd PRIVATE log/journal.c)
+  TARGET_COMPILE_DEFINITIONS(logd PRIVATE OPENWRT_SYSTEMD)
+  TARGET_LINK_LIBRARIES(logd ${systemd})
+ENDIF()
 INSTALL(TARGETS logd
 	RUNTIME DESTINATION sbin
 )
