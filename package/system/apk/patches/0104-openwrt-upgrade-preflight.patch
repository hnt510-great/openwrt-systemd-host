-int apk_solver_commit(struct apk_database *db,
-		      unsigned short solver_flags,
+/* A userspace-only transaction keeps every installed ABI-bound package by
+ * identity. These constraints are solver-local and never written to world.
+ */
+static bool openwrt_kernel_bound(const struct apk_package *pkg)
+{
+	if (!pkg)
+		return false;
+	const char *name = pkg->name->name;
+
+	if (!strcmp(name, "kernel") || !strncmp(name, "kmod-", 5) ||
+	    !strncmp(name, "linux-image-", 12) || !strncmp(name, "kernel-dev-headers", 18))
+		return true;
+	apk_array_foreach(dep, pkg->depends)
+	{
+		if (!apk_dep_conflict(dep) && !strcmp(dep->name->name, "kernel"))
+			return true;
+	}
+	return false;
+}
+
+static void plan_json_string(FILE *file, apk_blob_t value)
+{
+	fputc('"', file);
+	for (long i = 0; i < value.len; i++) {
+		unsigned char c = value.ptr[i];
+
+		if (c == '"' || c == '\\') {
+			fputc('\\', file);
+			fputc(c, file);
+		} else if (c < 0x20)
+			fprintf(file, "\\u%04x", c);
+		else
+			fputc(c, file);
+	}
+	fputc('"', file);
+}
+
+static void plan_json_hex(FILE *file, apk_blob_t value)
+{
+	fputc('"', file);
+	for (long i = 0; i < value.len; i++)
+		fprintf(file, "%02x", (unsigned char)value.ptr[i]);
+	fputc('"', file);
+}
+
+static void plan_json_file_hash(FILE *file, int dirfd, const char *path)
+{
+	struct apk_digest_ctx ctx;
+	struct apk_digest hash;
+	char buffer[16384];
+	ssize_t length;
+	int fd = openat(dirfd, path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+
+	if (fd < 0 || apk_digest_ctx_init(&ctx, APK_DIGEST_SHA256) < 0) {
+		if (fd >= 0)
+			close(fd);
+		fputs("null", file);
+		return;
+	}
+	int error = 0;
+
+	while ((length = read(fd, buffer, sizeof(buffer))) > 0)
+		if (apk_digest_ctx_update(&ctx, buffer, length) < 0) {
+			error = 1;
+			break;
+		}
+	if (length < 0 || apk_digest_ctx_final(&ctx, &hash) < 0)
+		error = 1;
+	close(fd);
+	apk_digest_ctx_free(&ctx);
+	if (error)
+		fputs("null", file);
+	else
+		plan_json_hex(file, APK_DIGEST_BLOB(hash));
+}
+
+static struct apk_package *plan_selected(struct apk_database *db, struct apk_changeset *set,
+					 const char *name)
+{
+	apk_array_foreach(change, set->changes)
+	{
+		if (change->new_pkg && !strcmp(change->new_pkg->name->name, name))
+			return change->new_pkg;
+
+		if (change->old_pkg && !strcmp(change->old_pkg->name->name, name))
+			return NULL;
+	}
+	return apk_pkg_get_installed(apk_db_get_name(db, APK_BLOB_STR(name)));
+}
+
+static void plan_json_kernel(FILE *file, const struct apk_package *kernel,
+			     const struct apk_package *tracker)
+{
+	fputs("{\"abi\":", file);
+
+	if (kernel)
+		plan_json_string(file, *kernel->version);
+	else
+		fputs("null", file);
+	fputs(",\"image\":", file);
+	const struct apk_dependency *image = kernel_image_dep(tracker);
+
+	if (image)
+		plan_json_string(file, APK_BLOB_STR(image->name->name));
+	else
+		fputs("null", file);
+	fputc('}', file);
+}
+
+static int openwrt_plan_json(struct apk_database *db, struct apk_changeset *set,
+			     const char *blocker)
+{
+	const char *path = db->ctx->openwrt_plan_json;
+
+	if (!path)
+		return 0;
+	int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+
+	if (fd < 0)
+		return -errno;
+	if (fchmod(fd, 0600)) {
+		close(fd);
+		return -errno;
+	}
+	FILE *file = fdopen(fd, "w");
+
+	if (!file) {
+		close(fd);
+		return -errno;
+	}
+	fprintf(file, "{\"schema\":1,\"mode\":\"%s\",\"status\":\"%s\",\"blockers\":[",
+		db->ctx->openwrt_userspace_only ? "userspace-only" : "full",
+		blocker ? "blocked" : "passed");
+	if (blocker)
+		plan_json_string(file, APK_BLOB_STR(blocker));
+	fputs("],\"inputs\":{\"world_sha256\":", file);
+	plan_json_file_hash(file, db->root_fd, "etc/apk/world");
+	fputs(",\"installed_sha256\":", file);
+	plan_json_file_hash(file, db->root_fd, "lib/apk/db/installed");
+	fputs("},\"indexes\":[", file);
+	for (int i = 0; i < db->num_repos; i++) {
+		struct apk_repository *repo = &db->repos[i];
+		char url[PATH_MAX], cache[PATH_MAX];
+		int cachefd;
+
+		if (i)
+			fputc(',', file);
+		fputs("{\"url\":", file);
+		plan_json_string(file, repo->url_index_printable);
+		fputs(",\"sha256\":", file);
+		apk_fmt(url, sizeof(url), BLOB_FMT, BLOB_PRINTF(repo->url_index));
+		const char *local = apk_url_local_file(url, sizeof(url));
+
+		if (local)
+			plan_json_file_hash(file, AT_FDCWD, local);
+		else if (apk_repo_index_cache_url(db, repo, &cachefd, cache, sizeof(cache)) >= 0)
+			plan_json_file_hash(file, cachefd, cache);
+		else
+			fputs("null", file);
+		fputc('}', file);
+	}
+	fputs("],\"kernel\":{\"before\":", file);
+	plan_json_kernel(
+	    file, apk_pkg_get_installed(apk_db_get_name(db, APK_BLOB_STRLIT("kernel"))),
+	    apk_pkg_get_installed(apk_db_get_name(db, APK_BLOB_STRLIT("linux-image-openwrt"))));
+	fputs(",\"after\":", file);
+	plan_json_kernel(file, plan_selected(db, set, "kernel"),
+			 plan_selected(db, set, "linux-image-openwrt"));
+	fputs("},\"changes\":[", file);
+	int first = 1;
+
+	apk_array_foreach(change, set->changes)
+	{
+		struct apk_package *old = change->old_pkg, *new = change->new_pkg;
+
+		if (old == new && !change->reinstall)
+			continue;
+		if (!first)
+			fputc(',', file);
+		first = 0;
+		fputs("{\"name\":", file);
+		plan_json_string(file, APK_BLOB_STR((new ? new : old)->name->name));
+		fputs(",\"before\":", file);
+		if (old)
+			plan_json_string(file, *old->version);
+		else
+			fputs("null", file);
+		fputs(",\"after\":", file);
+		if (new)
+			plan_json_string(file, *new->version);
+		else
+			fputs("null", file);
+		fputs(",\"origin\":", file);
+		if (new && new->origin)
+			plan_json_string(file, *new->origin);
+		else
+			fputs("null", file);
+		fputs(",\"package_digest\":", file);
+		if (new)
+			plan_json_hex(file, apk_pkg_digest_blob(new));
+		else
+			fputs("null", file);
+		fprintf(file, ",\"reinstall\":%s}", change->reinstall ? "true" : "false");
+	}
+	fputs("]}\n", file);
+	int error = ferror(file);
+
+	if (fflush(file) || fsync(fd))
+		error = 1;
+	if (fclose(file))
+		error = 1;
+	return error ? -EIO : 0;
+}
+
+/* A full managed upgrade must not quietly downgrade its intent to userspace
+ * when an unported installed module makes the newer kernel unsatisfiable.
+ * Honor explicit world version/tag constraints while selecting that intent.
+ */
+static void kernel_full_upgrade_target(struct apk_database *db, struct apk_dependency_array **world)
+{
+	if (!db->ctx->openwrt_full_upgrade || db->ctx->openwrt_userspace_only ||
+	    faccessat(db->root_fd, "etc/openwrt-kernel/protected", F_OK, 0))
+		return;
+	struct apk_name *name = apk_db_get_name(db, APK_BLOB_STRLIT("linux-image-openwrt"));
+	struct apk_package *installed = apk_pkg_get_installed(name), *best = NULL;
+	const struct apk_dependency *before = kernel_image_dep(installed);
+
+	if (!before)
+		return;
+	unsigned int allowed = db->repo_tags[APK_DEFAULT_REPOSITORY_TAG].allowed_repos;
+
+	apk_array_foreach(dep, *world)
+	{
+		if (dep->name == name)
+			allowed |= db->repo_tags[dep->repository_tag].allowed_repos;
+	}
+	apk_array_foreach(provider, name->providers)
+	{
+		struct apk_package *pkg = provider->pkg;
+		const struct apk_dependency *image = kernel_image_dep(pkg);
+
+		if (pkg->name != name || !image || !(pkg->repos & allowed & db->available_repos))
+			continue;
+		bool valid = true;
+
+		apk_array_foreach(dep, *world)
+		{
+			if (dep->name == name && !apk_dep_is_materialized(dep, pkg))
+				valid = false;
+			if (dep->name == image->name) {
+				bool image_allowed = false;
+
+				apk_array_foreach(ip, image->name->providers)
+				{
+					if (!apk_blob_compare(*ip->pkg->version, *image->version) &&
+					    apk_dep_is_materialized(dep, ip->pkg))
+						image_allowed = true;
+				}
+				if (!image_allowed)
+					valid = false;
+			}
+			if (!strcmp(dep->name->name, "kernel") && dep->op != APK_DEPMASK_ANY) {
+				bool kernel_allowed = false;
+
+				apk_array_foreach(kp, dep->name->providers)
+				{
+					if (!apk_blob_compare(*kp->pkg->version, *image->version) &&
+					    apk_dep_is_materialized(dep, kp->pkg))
+						kernel_allowed = true;
+				}
+				if (!kernel_allowed)
+					valid = false;
+			}
+		}
+		if (valid && (!best || apk_pkg_version_compare(best, pkg) == APK_VERSION_LESS))
+			best = pkg;
+	}
+	const struct apk_dependency *after = kernel_image_dep(best);
+
+	if (!best || apk_pkg_version_compare(installed, best) != APK_VERSION_LESS ||
+	    !apk_blob_compare(*before->version, *after->version))
+		return;
+	struct apk_dependency target;
+
+	apk_dep_from_pkg(&target, db, best);
+	apk_dependency_array_add(world, target);
+}
+
+int apk_solver_plan(struct apk_database *db, unsigned short flags,
+		    struct apk_dependency_array *world, struct apk_changeset *set)
+{
+	struct apk_dependency_array *protected_world, *solver_world;
+	const char *blocker = NULL;
+	int r;
+
+	apk_dependency_array_init(&protected_world);
+	apk_dependency_array_init(&solver_world);
+	apk_dependency_array_copy(&protected_world, world);
+	if (apk_db_check_world(db, world) != 0 || kernel_retain(db, &protected_world) < 0) {
+		blocker = "invalid-world-or-protected-dependencies";
+		r = -1;
+		goto out;
+	}
+	if (db->ctx->openwrt_userspace_only) {
+		apk_array_foreach_item(pkg, apk_db_sorted_installed_packages(db))
+		{
+			if (!openwrt_kernel_bound(pkg))
+				continue;
+			struct apk_dependency pin;
+
+			apk_dep_from_pkg(&pin, db, pkg);
+			apk_dependency_array_add(&protected_world, pin);
+		}
+	}
+	kernel_full_upgrade_target(db, &protected_world);
+	apk_change_array_init(&set->changes);
+	r = apk_solver_solve(db, flags, protected_world, set);
+	while (r == 0 && kernel_keep_abi(db, set, protected_world, &solver_world)) {
+		apk_change_array_free(&set->changes);
+		memset(set, 0, sizeof(*set));
+		apk_change_array_init(&set->changes);
+		r = apk_solver_solve(db, flags, solver_world, set);
+	}
+	if (r) {
+		blocker = "unsatisfied-package-migration-or-dependency";
+		apk_solver_print_errors(
+		    db, set, apk_array_len(solver_world) ? solver_world : protected_world);
+		goto out;
+	}
+	if (db->ctx->openwrt_userspace_only) {
+		apk_array_foreach(change, set->changes)
+		{
+			if ((change->old_pkg != change->new_pkg || change->reinstall) &&
+			    (openwrt_kernel_bound(change->old_pkg) ||
+			     openwrt_kernel_bound(change->new_pkg))) {
+				blocker = "userspace-only-would-change-kernel-bound-package";
+				r = -1;
+				goto out;
+			}
+		}
+	}
+	unsigned int saved = db->ctx->flags;
+
+	db->ctx->flags |= APK_SIMULATE;
+	r = kernel_policy(db, set, "apk-pre", 0);
+	db->ctx->flags = saved;
+	if (r < 0)
+		blocker = "kernel-policy-rejected-upgrade";
+out:
+	if (blocker)
+		apk_err(&db->ctx->out, "Upgrade preflight: %s", blocker);
+	if (openwrt_plan_json(db, set, blocker) < 0) {
+		apk_err(&db->ctx->out, "Unable to write upgrade plan JSON");
+		r = -1;
+	}
+	apk_dependency_array_free(&solver_world);
+	apk_dependency_array_free(&protected_world);
+	return r;
+}
+
+int apk_solver_commit(struct apk_database *db, unsigned short flags,
 		      struct apk_dependency_array *world)
 {
-	struct apk_out *out = &db->ctx->out;
-	struct apk_changeset changeset = {};
-	struct apk_dependency_array *retained_world, *solver_world;
-	int r;
-
-	if (apk_db_check_world(db, world) != 0) {
-		apk_err(out, "Not committing changes due to missing repository tags.");
-		return -1;
-	}
-
-	apk_dependency_array_init(&retained_world);
-	apk_dependency_array_copy(&retained_world, world);
-	world = retained_world;
-	if (kernel_retain(db, &world) < 0) {
-		apk_err(out, "Invalid protected kernel dependencies; refusing transaction.");
-		apk_dependency_array_free(&world);
-		return -1;
-	}
-	apk_change_array_init(&changeset.changes);
-	apk_dependency_array_init(&solver_world);
-	r = apk_solver_solve(db, solver_flags, world, &changeset);
-	while (r == 0 && kernel_keep_abi(db, &changeset, world, &solver_world)) {
-		apk_change_array_free(&changeset.changes);
-		memset(&changeset, 0, sizeof(changeset));
-		apk_change_array_init(&changeset.changes);
-		r = apk_solver_solve(db, solver_flags, solver_world, &changeset);
-	}
+	struct apk_changeset set = {};
+	int r = apk_solver_plan(db, flags, world, &set);
+
 	if (r == 0)
-		r = apk_solver_commit_changeset(db, &changeset, world);
-	else
-		apk_solver_print_errors(db, &changeset,
-					apk_array_len(solver_world) ? solver_world : world);
-	apk_change_array_free(&changeset.changes);
-	apk_dependency_array_free(&solver_world);
-	apk_dependency_array_free(&world);
+		r = apk_solver_commit_changeset(db, &set, world);
+	apk_change_array_free(&set.changes);
 	return r;
 }
