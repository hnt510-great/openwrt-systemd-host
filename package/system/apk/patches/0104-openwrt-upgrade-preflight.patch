+/* Download and authenticate every payload before the first managed write,
+ * including local repositories and already-cached packages.
+ */
+int apk_solver_verify_changeset(struct apk_database *db, struct apk_changeset *set)
+{
+	if ((db->ctx->flags & APK_SIMULATE) ||
+	    faccessat(db->root_fd, "etc/openwrt-kernel/protected", F_OK, 0))
+		return 0;
+	apk_array_foreach(change, set->changes)
+	{
+		struct apk_package *pkg = change->new_pkg;
+
+		if (!pkg || pkg == change->old_pkg || pkg->cached || !pkg->installed_size ||
+		    (pkg->repos & db->local_repos))
+			continue;
+		if (!apk_db_cache_active(db)) {
+			apk_err(&db->ctx->out,
+				"Managed upgrades require an active cache; use --cache-dir.");
+			openwrt_plan_json(db, set, "payload-cache-unavailable");
+			return -1;
+		}
+	}
+	if (apk_db_cache_active(db) && apk_solver_precache_changeset(db, set, true) < 0) {
+		openwrt_plan_json(db, set, "payload-download-failed");
+		return -1;
+	}
+	apk_array_foreach(change, set->changes)
+	{
+		struct apk_package *pkg = change->new_pkg;
+
+		if (!pkg || (pkg == change->old_pkg && !change->reinstall) || !pkg->installed_size)
+			continue;
+		struct apk_repository *repo =
+		    pkg->cached ? &db->cache_repository : apk_db_select_repo(db, pkg);
+		struct apk_extract_ctx extract;
+		char url[PATH_MAX];
+		int fd, r = -1;
+
+		if (repo && apk_repo_package_url(db, repo, pkg, &fd, url, sizeof(url)) >= 0) {
+			const char *local = apk_url_local_file(url, sizeof(url));
+
+			if (local) {
+				apk_extract_init(&extract, db->ctx, NULL);
+				apk_extract_verify_identity(&extract, pkg->digest_alg,
+							    apk_pkg_digest_blob(pkg));
+				r = apk_extract(&extract, apk_istream_from_file(fd, local));
+			}
+		}
+		if (r < 0) {
+			apk_err(&db->ctx->out, "Payload preflight failed: " PKG_VER_FMT,
+				PKG_VER_PRINTF(pkg));
+			openwrt_plan_json(db, set, "payload-verification-failed");
+			return -1;
+		}
+	}
+	return 0;
+}
 int apk_solver_commit_changeset(struct apk_database *db,
 				struct apk_changeset *changeset,
 				struct apk_dependency_array *world)
@@ -641,6 +701,9 @@
