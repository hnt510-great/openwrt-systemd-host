Subject: [PATCH] apk: retain kernel generations and gate activation on transaction outcome

--- a/src/commit.c
+++ b/src/commit.c
@@ -10,6 +10,7 @@
+#include <sys/stat.h>
 #include <unistd.h>
 #include "apk_defines.h"
 #include "apk_database.h"
 #include "apk_package.h"
 #include "apk_solver.h"
 #include "apk_print.h"
@@ -33,6 +34,80 @@
 #else
 static bool running_on_host(void) { return false; }
 #endif
+
+
+/* Distribution policy is deliberately independent of optional APK scripts.
+ * The protected dependency file is root-owned and only created by kernelctl.
+ * Script arguments, rather than ambient environment, carry transaction state.
+ */
+static int kernel_retain(struct apk_database *db, struct apk_dependency_array **world)
+{
+	char line[4096];
+	int fd = openat(db->root_fd, "etc/openwrt-kernel/protected", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) return errno == ENOENT ? 0 : -1;
+	FILE *file = fdopen(fd, "r");
+	if (!file) { close(fd); return -1; }
+	int result = 0;
+	while (fgets(line, sizeof line, file)) {
+		struct apk_dependency dep;
+		line[strcspn(line, "\r\n")] = 0;
+		if (!line[0]) continue;
+		apk_blob_t value = APK_BLOB_STR(line);
+		apk_blob_pull_dep(&value, db, &dep, false);
+		if (!dep.name || dep.broken || APK_BLOB_IS_NULL(value) || value.len ||
+		    (dep.op != APK_DEPMASK_CHECKSUM && dep.op != APK_VERSION_EQUAL)) {
+			result = -1;
+			break;
+		}
+		apk_deps_add(world, &dep);
+	}
+	if (ferror(file)) result = -1;
+	fclose(file);
+	return result;
+}
+
+static int kernel_policy(struct apk_database *db, struct apk_changeset *changeset,
+			 const char *phase, int errors)
+{
+	const char *path = "run/openwrt-kernel-apk.txn";
+	char status[32], flags[32];
+	if (faccessat(db->root_fd, "etc/openwrt-kernel/protected", F_OK, 0) != 0) {
+		/* Offline image construction is allowed. A live adoption must happen
+		 * BEFORE any tracker can retire the original module ownership. */
+		struct stat target, live;
+		bool offline = db->ctx->root_set && !fstat(db->root_fd, &target) && !stat("/", &live) &&
+			(target.st_dev != live.st_dev || target.st_ino != live.st_ino);
+		if (!strcmp(phase, "apk-pre") && !offline) {
+			apk_array_foreach(change, changeset->changes) {
+				if (change->new_pkg && !strncmp(change->new_pkg->name->name, "linux-image-", 12)) {
+					apk_err(&db->ctx->out, "Run kernelctl migrate before installing versioned kernels.");
+					return -1;
+				}
+			}
+		}
+		return 0;
+	}
+	if (!strcmp(phase, "apk-pre")) {
+		int fd = openat(db->root_fd, path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC | O_NOFOLLOW, 0600);
+		if (fd < 0) return -1;
+		int failed = 0;
+		apk_array_foreach(change, changeset->changes) {
+			struct apk_package *old = change->old_pkg, *new = change->new_pkg;
+			if (dprintf(fd, "%s\t%.*s\t%s\t%.*s\t%d\n",
+				old ? old->name->name : "-", old ? (int)old->version->len : 1, old ? old->version->ptr : "-",
+				new ? new->name->name : "-", new ? (int)new->version->len : 1, new ? new->version->ptr : "-",
+				change->reinstall) < 0) failed = 1;
+		}
+		if (close(fd)) failed = 1;
+		if (failed) return -1;
+	}
+	snprintf(status, sizeof status, "%d", errors);
+	snprintf(flags, sizeof flags, "%d", !!(db->ctx->flags & (APK_NO_SCRIPTS | APK_NO_COMMIT_HOOKS)));
+	char *argv[] = { "/usr/sbin/kernelctl", (char *)phase,
+		"/run/openwrt-kernel-apk.txn", status,
+		(db->ctx->flags & APK_SIMULATE) ? "simulate" : "live", flags, NULL };
+	return apk_db_run_script(db, phase, NULL, -1, argv, "kernel policy: ");
+}
 
