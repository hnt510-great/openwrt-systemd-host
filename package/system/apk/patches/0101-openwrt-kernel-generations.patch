+/* During adoption, old kmods become trackers. Retire their database ownership
+ * without unlinking the protected legacy module tree still used by uname -r.
+ * No new generation ever installs into this directory.
+ */
+static bool kernel_legacy_directory(struct apk_database *db, apk_blob_t dirname)
+{
+	char release[128], path[180];
+	int fd = openat(db->root_fd, "etc/openwrt-kernel/legacy-release", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0) return false;
+	ssize_t n = read(fd, release, sizeof release - 1);
+	close(fd);
+	if (n <= 0 || n >= sizeof release - 1) return false;
+	release[n] = 0;
+	release[strcspn(release, "\r\n")] = 0;
+	if (!release[0] || strspn(release, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._+-") != strlen(release))
+		return false;
+	int len = snprintf(path, sizeof path, "usr/lib/modules/%s", release);
+	if (dirname.len >= len && !memcmp(dirname.ptr, path, len) &&
+	    (dirname.len == len || dirname.ptr[len] == '/'))
+		return true;
+	len = snprintf(path, sizeof path, "usr/src/linux-headers-%s", release);
+	return dirname.len >= len && !memcmp(dirname.ptr, path, len) &&
+		(dirname.len == len || dirname.ptr[len] == '/');
+}
+
