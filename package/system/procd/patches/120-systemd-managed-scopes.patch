 #ifdef OPENWRT_SYSTEMD
+static void systemd_drained(struct uloop_timeout *t)
+{
+	struct service *s;
+
+	avl_for_each_element(&services, s, avl)
+		if (!avl_is_empty(&s->instances.avl))
+			goto wait;
+	avl_for_each_element(&containers, s, avl)
+		if (!avl_is_empty(&s->instances.avl))
+			goto wait;
+	uloop_end();
+	return;
+wait:
+	uloop_timeout_set(t, 50);
+}
+
+static struct uloop_timeout systemd_drain = { .cb = systemd_drained };
+
 static void systemd_stop(struct uloop_signal *signal)
 {
+	if (procd_systemd_stopping)
+		return;
+	procd_systemd_stopping = true;
 	sd_notify(0, "STOPPING=1");
 	service_stop_all();
 	hotplug_shutdown();
 	watchdog_set_magicclose(true);
 	watchdog_set_stopped(true);
-	uloop_end();
+	uloop_timeout_set(&systemd_drain, 0);
 }
 
 static struct uloop_signal systemd_term = { .signo = SIGTERM, .cb = systemd_stop };
