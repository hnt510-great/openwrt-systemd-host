--- /dev/null
+++ b/systemd-cgroup.c
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#define _GNU_SOURCE
+#include <sys/socket.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <stdint.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <systemd/sd-bus.h>
+#include <systemd/sd-daemon.h>
+#include <systemd/sd-id128.h>
+#include "systemd-cgroup.h"
+
+#define DEST "org.freedesktop.systemd1"
+#define MANAGER "/org/freedesktop/systemd1"
+#define MIFACE DEST ".Manager"
+#define UIFACE DEST ".Unit"
+#define SIFACE DEST ".Scope"
+#define CALL_TIMEOUT 2000000
+
+static int manager(sd_bus **bus)
+{
+	struct ucred peer;
+	socklen_t len = sizeof(peer);
+	int r = sd_bus_new(bus);
+
+	if (r >= 0)
+		r = sd_bus_set_address(*bus, "unix:path=/run/systemd/private");
+	if (r >= 0)
+		r = sd_bus_set_method_call_timeout(*bus, CALL_TIMEOUT);
+	if (r >= 0)
+		r = sd_bus_start(*bus);
+	if (r >= 0 && (getsockopt(sd_bus_get_fd(*bus), SOL_SOCKET, SO_PEERCRED, &peer, &len) ||
+		      peer.uid != 0 || peer.pid != 1))
+		r = -EPERM;
+	return r;
+}
+
+bool owrt_systemd_active(void)
+{
+	return sd_booted() > 0;
+}
+
+int owrt_scope_name(char *name, size_t len)
+{
+	sd_id128_t id;
+	char text[SD_ID128_STRING_MAX];
+	int r = sd_id128_randomize(&id);
+
+	if (r < 0)
+		return r;
+	return snprintf(name, len, "openwrt-%s.scope", sd_id128_to_string(id, text)) >= len ?
+		-ENAMETOOLONG : 0;
+}
+
+/* Escape a component, including dashes: they delimit slice hierarchy. */
+static int service_slice(const char *service, char slice[256])
+{
+	const unsigned char *p = (const unsigned char *)service;
+	size_t n = strlen("openwrt-");
+
+	strcpy(slice, "openwrt-");
+	if (!*p)
+		return -EINVAL;
+	for (; *p; p++) {
+		bool literal = (*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z') ||
+			       (*p >= '0' && *p <= '9') || *p == '_' || *p == '.' || *p == ':';
+		if (n + (literal ? 1 : 4) + sizeof(".slice") > 256)
+			return -ENAMETOOLONG;
+		if (literal)
+			slice[n++] = *p;
+		else
+			n += sprintf(slice + n, "\\x%02x", *p);
+	}
+	strcpy(slice + n, ".slice");
+	return 0;
+}
+
+static int prop(sd_bus_message *m, const char *key, const char *type, const void *value)
+{
+	int r = sd_bus_message_open_container(m, 'r', "sv");
+
+	if (r >= 0)
+		r = sd_bus_message_append(m, "s", key);
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'v', type);
+	if (r >= 0) {
+		if (!strcmp(type, "as"))
+			r = sd_bus_message_append(m, "as", 1, (const char *)value);
+		else if (!strcmp(type, "ah"))
+			r = sd_bus_message_append(m, "ah", 1, *(const int *)value);
+		else
+			r = sd_bus_message_append_basic(m, *type, value);
+	}
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	return r;
+}
+
+static int unit_object(sd_bus *bus, const char *name, char **object)
+{
+	sd_bus_message *reply = NULL;
+	const char *s;
+	int r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "GetUnit", NULL, &reply, "s", name);
+
+	if (r >= 0)
+		r = sd_bus_message_read(reply, "o", &s);
+	if (r >= 0) {
+		*object = strdup(s);
+		if (!*object)
+			r = -ENOMEM;
+	}
+	sd_bus_message_unref(reply);
+	return r;
+}
+
+int owrt_scope_enter(const char *name, const char *service, pid_t pid, bool delegate)
+{
+	sd_bus *bus = NULL;
+	sd_bus_message *m = NULL, *reply = NULL;
+	char slice[256], description[512], *object = NULL, *state = NULL;
+	const char *job;
+	uint64_t unlimited = UINT64_MAX, stop_timeout = 5000000;
+	int delegated = delegate, pidfd = -1, r, i;
+	uint32_t job_id = 0;
+	struct timespec deadline, now;
+
+	r = service_slice(service, slice);
+	if (r < 0)
+		return r;
+	pidfd = syscall(SYS_pidfd_open, pid, 0);
+	if (pidfd < 0)
+		return -errno;
+	r = manager(&bus);
+	if (r < 0)
+		goto out;
+	r = sd_bus_message_new_method_call(bus, &m, DEST, MANAGER, MIFACE, "StartTransientUnit");
+	if (r >= 0)
+		r = sd_bus_message_append(m, "ss", name, "fail");
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'a', "(sv)");
+	snprintf(description, sizeof(description), "OpenWrt processes: %s", service);
+#define PROPERTY(key, type, value) do { if (r >= 0) r = prop(m, key, type, value); } while (0)
+	PROPERTY("Description", "s", description);
+	PROPERTY("Slice", "s", slice);
+	PROPERTY("CollectMode", "s", "inactive-or-failed");
+	PROPERTY("BindsTo", "as", "openwrt-procd.service");
+	PROPERTY("Before", "as", "openwrt-procd.service");
+	PROPERTY("Delegate", "b", &delegated);
+	PROPERTY("TasksMax", "t", &unlimited);
+	PROPERTY("TimeoutStopUSec", "t", &stop_timeout);
+	PROPERTY("OOMPolicy", "s", "continue");
+	PROPERTY("PIDFDs", "ah", &pidfd);
+#undef PROPERTY
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	if (r >= 0)
+		r = sd_bus_message_append(m, "a(sa(sv))", 0);
+	if (r >= 0)
+		r = sd_bus_call(bus, m, CALL_TIMEOUT, NULL, &reply);
+	if (r >= 0)
+		r = sd_bus_message_read(reply, "o", &job);
+	if (r < 0)
+		goto out;
+	if (sscanf(job, MANAGER "/job/%u", &job_id) != 1)
+		job_id = 0;
+	clock_gettime(CLOCK_MONOTONIC, &deadline);
+	deadline.tv_sec += 2;
+	r = unit_object(bus, name, &object);
+	for (i = 0; r >= 0 && i < 100; i++) {
+		free(state);
+		state = NULL;
+		r = sd_bus_get_property_string(bus, DEST, object, UIFACE,
+					       "ActiveState", NULL, &state);
+		if (r < 0 || !strcmp(state, "active"))
+			break;
+		if (!strcmp(state, "failed") || !strcmp(state, "deactivating")) {
+			r = -EIO;
+			break;
+		}
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		if (now.tv_sec > deadline.tv_sec ||
+		    (now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec))
+			break;
+		usleep(10000);
+	}
+	if (r >= 0 && (!state || strcmp(state, "active")))
+		r = -ETIMEDOUT;
+	if (r < 0 && job_id)
+		sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "CancelJob",
+				   NULL, NULL, "u", job_id);
+out:
+	free(state);
+	free(object);
+	if (pidfd >= 0)
+		close(pidfd);
+	sd_bus_message_unref(m);
+	sd_bus_message_unref(reply);
+	sd_bus_flush_close_unref(bus);
+	return r < 0 ? r : 0;
+}
+
+int owrt_scope_path(const char *name, char *path, size_t len)
+{
+	sd_bus *bus = NULL;
+	char *object = NULL, *group = NULL;
+	int r = manager(&bus);
+
+	if (r >= 0)
+		r = unit_object(bus, name, &object);
+	if (r >= 0)
+		r = sd_bus_get_property_string(bus, DEST, object, SIFACE,
+					       "ControlGroup", NULL, &group);
+	if (r >= 0 && (!*group || snprintf(path, len, "/sys/fs/cgroup%s", group) >= len))
+		r = -ENAMETOOLONG;
+	free(object);
+	free(group);
+	sd_bus_flush_close_unref(bus);
+	return r < 0 ? r : 0;
+}
+
+int owrt_scope_stop(const char *name)
+{
+	sd_bus *bus = NULL;
+	sd_bus_error error = SD_BUS_ERROR_NULL;
+	int r;
+
+	if (!*name)
+		return 0;
+	r = manager(&bus);
+	if (r >= 0)
+		r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "KillUnit", &error, NULL,
+				       "ssi", name, "all", SIGKILL);
+	if (sd_bus_error_has_name(&error, DEST ".NoSuchUnit"))
+		r = 0;
+	if (r >= 0)
+		sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "StopUnit",
+				   NULL, NULL, "ss", name, "fail");
+	sd_bus_error_free(&error);
+	sd_bus_flush_close_unref(bus);
+	return r < 0 ? r : 0;
+}
+
+/* Only an explicitly delegated scope may serve as a direct-write boundary. */
+int owrt_scope_delegation(char *path, size_t len)
+{
+	sd_bus *bus = NULL;
+	sd_bus_message *reply = NULL;
+	char *object = NULL, *id = NULL, *group = NULL;
+	const char *p;
+	int r = manager(&bus), delegated = 0;
+
+	if (r >= 0)
+		r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "GetUnitByPID",
+				       NULL, &reply, "u", (uint32_t)getpid());
+	if (r >= 0)
+		r = sd_bus_message_read(reply, "o", &p);
+	if (r >= 0) {
+		object = strdup(p);
+		if (!object)
+			r = -ENOMEM;
+	}
+	if (r >= 0)
+		r = sd_bus_get_property_string(bus, DEST, object, UIFACE, "Id", NULL, &id);
+	if (r >= 0 && (strncmp(id, "openwrt-", 8) || !strstr(id, ".scope")))
+		r = -EPERM;
+	if (r >= 0)
+		r = sd_bus_get_property_trivial(bus, DEST, object, SIFACE,
+					       "Delegate", NULL, 'b', &delegated);
+	if (r >= 0 && !delegated)
+		r = -EPERM;
+	if (r >= 0)
+		r = sd_bus_get_property_string(bus, DEST, object, SIFACE,
+					       "ControlGroup", NULL, &group);
+	if (r >= 0 && (!*group || snprintf(path, len, "/sys/fs/cgroup%s", group) >= len))
+		r = -ENAMETOOLONG;
+	free(object);
+	free(id);
+	free(group);
+	sd_bus_message_unref(reply);
+	sd_bus_flush_close_unref(bus);
+	return r < 0 ? r : 0;
+}
