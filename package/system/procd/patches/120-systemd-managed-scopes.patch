+static int native_jail_cgroup(char *path, size_t len, const char *requested)
+{
+	char boundary[PATH_MAX], supervisor[PATH_MAX], procs[PATH_MAX], scope[64];
+	const char *relative = requested;
+	int fd, r;
+
+	r = owrt_scope_delegation(boundary, sizeof(boundary));
+	if (r < 0) {
+		r = owrt_scope_name(scope, sizeof(scope));
+		if (!r)
+			r = owrt_scope_enter(scope, opts.name ? opts.name : "jail", getpid(), true);
+		if (!r)
+			r = owrt_scope_delegation(boundary, sizeof(boundary));
+		if (r < 0)
+			return r;
+	}
+	if (snprintf(supervisor, sizeof(supervisor), "%s/supervisor", boundary) >=
+	    sizeof(supervisor) ||
+	    snprintf(procs, sizeof(procs), "%s/cgroup.procs", supervisor) >= sizeof(procs))
+		return -ENAMETOOLONG;
+	if (mkdir(supervisor, 0700) && errno != EEXIST)
+		return -errno;
+	fd = open(procs, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	r = dprintf(fd, "%d", getpid());
+	close(fd);
+	if (r < 0)
+		return -errno;
+
+	/* OCI labels are local to this delegated execution, never host paths. */
+	if (relative && opts.systemd_cgroup) {
+		relative = strrchr(relative, ':');
+		if (!relative || !relative[1])
+			return -EINVAL;
+		relative++;
+	}
+	if (relative && (*relative == '/' || strstr(relative, "..")))
+		return -EPERM;
+	if (snprintf(path, len, "%s/payload%s%s", boundary,
+		     relative && *relative ? "/" : "", relative ? relative : "") >= len)
+		return -ENAMETOOLONG;
+	cgroups_set_delegation(boundary);
+	return 0;
+}
