+// SPDX-License-Identifier: GPL-2.0-only
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include "systemd-cgroup.h"
+
+int main(int argc, char **argv)
+{
+	char scope[64];
+	int r;
+	bool parent = argc == 3 && !strcmp(argv[1], "enter-parent");
+	bool execute = argc >= 4 && !strcmp(argv[1], "exec");
+
+	if (!parent && !execute)
+		return 2;
+	if (owrt_systemd_active()) {
+		r = owrt_scope_name(scope, sizeof(scope));
+		if (!r)
+			r = owrt_scope_enter(scope, argv[2], parent ? getppid() : getpid(), false);
+		if (r < 0)
+			fprintf(stderr, "OpenWrt %s: inherited cgroup placement: %s\n",
+				argv[2], strerror(-r));
+	}
+	if (execute) {
+		execv(argv[3], argv + 3);
+		perror(argv[3]);
+		return 127;
+	}
+	return 0;
+}
