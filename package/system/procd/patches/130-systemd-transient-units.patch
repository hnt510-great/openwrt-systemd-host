+/*
+ * Command line of a transient unit, with the wrappers instance_run() adds.
+ * The strings stay valid until the next call; free() the returned array.
+ */
+char **
+instance_unit_argv(struct service_instance *in, bool *seccomp)
+{
+	struct blob_attr *cur;
+	char **argv;
+	int argc = 0, rem;
+
+	*seccomp = !in->has_jail && in->seccomp;
+	blobmsg_for_each_attr(cur, in->command, rem)
+		argc++;
+	argv = calloc(argc + in->jail.argc + 8, sizeof(char *));
+	if (!argv)
+		return NULL;
+
+	argc = 0;
+	if (*seccomp) {
+#ifdef SECCOMP_SUPPORT
+		argv[argc++] = "/sbin/seccomp-trace";
+#else
+		ULOG_WARN("Seccomp support for %s::%s not available\n", in->srv->name, in->name);
+		*seccomp = false;
+#endif
+	}
+
+	if (in->has_jail)
+		argc = jail_run(in, argv);
+
+	blobmsg_for_each_attr(cur, in->command, rem)
+		argv[argc++] = blobmsg_data(cur);
+	argv[argc] = NULL;
+
+	return argv;
+}
