--- a/plug/coldplug.c
+++ b/plug/coldplug.c
@@ -17,6 +17,7 @@
 #include <sys/mount.h>
 #include <sys/sysmacros.h>
 
+#include <fcntl.h>
 #include <stdlib.h>
 #include <unistd.h>
 
@@ -44,10 +45,93 @@
