+bool
+instance_running(struct service_instance *in)
+{
+	if (in->unit)
+		return in->unit_loaded && in->unit_running;
+	return in->proc.pending;
+}
+
+static bool
+instance_unit_state_running(struct service_instance *in)
+{
+	const char *a = in->unit_active;
+
+	if (!in->unit_loaded)
+		return false;
+	/* Started, but no state has been reported yet. */
+	if (!*a)
+		return true;
+	if (!strncmp(in->unit_sub, "auto-restart", strlen("auto-restart")))
+		return false;
+	return !strcmp(a, "active") || !strcmp(a, "activating") ||
+	       !strcmp(a, "reloading") || !strcmp(a, "refreshing") ||
+	       !strcmp(a, "deactivating");
+}
+
+static int
+instance_unit_exit_code(struct service_instance *in)
+{
+	switch (in->unit_exec_code) {
+	case CLD_EXITED:
+		return in->unit_exec_status;
+	case CLD_KILLED:
+	case CLD_DUMPED:
+		return SIGNALLED_OFFSET + in->unit_exec_status;
+	default:
+		return in->exit_code;
+	}
+}
+
+static void
+instance_unit_changed(struct service_instance *in)
+{
+	bool running = instance_unit_state_running(in);
+	bool ended = !strcmp(in->unit_active, "inactive") || !strcmp(in->unit_active, "failed");
+
+	if (in->unit_pid && (pid_t)in->unit_pid != in->proc.pid) {
+		in->proc.pid = in->unit_pid;
+		instance_writepid(in);
+	}
+
+	if (in->unit_restarts > (uint32_t)in->respawn_count) {
+		in->respawn_count = in->unit_restarts;
+		in->respawn_last = uptime_get();
+		in->exit_code = instance_unit_exit_code(in);
+		service_event_instance_exit("instance.respawn", in);
+	}
+
+	if (running != in->unit_running) {
+		in->unit_running = running;
+		if (running) {
+			clock_gettime(CLOCK_MONOTONIC, &in->start);
+			service_event("instance.start", in->srv->name, in->name);
+		} else {
+			clock_gettime(CLOCK_MONOTONIC, &in->stop);
+			in->exit_code = instance_unit_exit_code(in);
+			P_DEBUG(2, "Instance %s::%s exit with error code %d\n",
+				in->srv->name, in->name, in->exit_code);
+			uloop_timeout_cancel(&in->watchdog.timeout);
+			if (in->halt)
+				instance_removepid(in);
+			service_event("instance.stop", in->srv->name, in->name);
+		}
+	}
+
+	if (!in->unit_failed && in->respawn && !in->halt &&
+	    !strcmp(in->unit_result, "start-limit-hit")) {
+		in->unit_failed = true;
+		LOG("Instance %s::%s s in a crash loop %d crashes\n",
+		    in->srv->name, in->name, in->respawn_count);
+		service_event_instance_exit("instance.fail", in);
+	}
+
+	/* Normally UnitRemoved follows; confirm it if the signal is missed. */
+	if (ended && !in->unit_stopping)
+		uloop_timeout_set(&in->unit_check, 2000);
+}
+
+static void
+instance_unit_removed(struct service_instance *in)
+{
+	bool restart = false;
+
+	if (in->unit_running) {
+		in->unit_running = false;
+		clock_gettime(CLOCK_MONOTONIC, &in->stop);
+		in->exit_code = instance_unit_exit_code(in);
+		if (in->halt)
+			instance_removepid(in);
+		service_event("instance.stop", in->srv->name, in->name);
+	}
+	uloop_timeout_cancel(&in->unit_check);
+	uloop_timeout_cancel(&in->watchdog.timeout);
+	in->unit_loaded = false;
+	in->unit_stopping = false;
