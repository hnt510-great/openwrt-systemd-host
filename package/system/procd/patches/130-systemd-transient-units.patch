+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Native-systemd units mode: run procd service instances as transient
+ * systemd services. procd keeps its ubus API, triggers, validation and
+ * configuration comparison; systemd executes, restarts, logs, contains and
+ * stops the processes. Unit state reaches procd through D-Bus signals on
+ * systemd's private socket and is applied from the instance state machine.
+ */
+#define _GNU_SOURCE
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <ctype.h>
+#include <errno.h>
+#include <limits.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <systemd/sd-bus.h>
+
+#include <libubox/blobmsg.h>
+
+#include "../procd.h"
+#include "../systemd-cgroup.h"
+#include "service.h"
+#include "instance.h"
+#include "unit.h"
+
+#define DEST "org.freedesktop.systemd1"
+#define MANAGER "/org/freedesktop/systemd1"
+#define MIFACE DEST ".Manager"
+#define UIFACE DEST ".Unit"
+#define SVCIFACE DEST ".Service"
+#define PIFACE "org.freedesktop.DBus.Properties"
+#define UNIT_ROOT MANAGER "/unit"
+/* sd_bus_path_encode() escapes the dash of "openwrt-" as _2d. */
+#define UNIT_PATH_PREFIX UNIT_ROOT "/openwrt_2d"
+#define BOUND_UNIT "openwrt-procd.service"
+#define RC_UNIT "openwrt-services.service"
+#define CALL_TIMEOUT (5 * 1000000ULL)
+#define RECONNECT_MSEC 1000
+#define CHECK_SLACK_MSEC 10000
+#define EXISTS_RETRIES 5
+#define USEC 1000000ULL
+/* A respawn policy without a reset period never forgets earlier crashes. */
+#define NO_RESET_PERIOD (30U * 24 * 3600)
+
+static sd_bus *bus;
+static struct uloop_fd bus_fd;
+static struct uloop_timeout bus_timer;
+static struct uloop_timeout bus_retry;
+
+static const struct {
+	const char *procd;
+	const char *systemd;
+	int resource;
+} unit_limits[] = {
+	{ "as", "AS", RLIMIT_AS },
+	{ "core", "CORE", RLIMIT_CORE },
+	{ "cpu", "CPU", RLIMIT_CPU },
+	{ "data", "DATA", RLIMIT_DATA },
+	{ "fsize", "FSIZE", RLIMIT_FSIZE },
+	{ "memlock", "MEMLOCK", RLIMIT_MEMLOCK },
+	{ "nofile", "NOFILE", RLIMIT_NOFILE },
+	{ "nproc", "NPROC", RLIMIT_NPROC },
+	{ "rss", "RSS", RLIMIT_RSS },
+	{ "stack", "STACK", RLIMIT_STACK },
+	{ "nice", "NICE", RLIMIT_NICE },
+	{ "rtprio", "RTPRIO", RLIMIT_RTPRIO },
+	{ "msgqueue", "MSGQUEUE", RLIMIT_MSGQUEUE },
+	{ "sigpending", "SIGPENDING", RLIMIT_SIGPENDING },
+};
+
+static void bus_connect(struct uloop_timeout *t);
+static void unit_refresh(struct service_instance *in);
+static void unit_check_cb(struct uloop_timeout *t);
+
+static uint64_t now_usec(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * USEC + ts.tv_nsec / 1000;
+}
+
+/* Call fn for every units-mode instance; stop early when it returns true. */
+static struct service_instance *
+unit_instances(bool (*fn)(struct service_instance *in, const void *arg), const void *arg)
+{
+	struct avl_tree *trees[] = { &services, &containers };
+	struct service_instance *in;
+	struct service *s;
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(trees); i++)
+		avl_for_each_element(trees[i], s, avl)
+			vlist_for_each_element(&s->instances, in, node)
+				if (in->unit && fn(in, arg))
+					return in;
+	return NULL;
+}
+
+static bool unit_drop_calls(struct service_instance *in, const void *arg)
+{
+	in->unit_call = sd_bus_slot_unref(in->unit_call);
+	in->unit_stop_call = sd_bus_slot_unref(in->unit_stop_call);
+	return false;
+}
+
+static void bus_lost(int r)
+{
+	ERROR("lost systemd manager connection: %s\n", strerror(-r));
+	uloop_fd_delete(&bus_fd);
+	uloop_timeout_cancel(&bus_timer);
+	unit_instances(unit_drop_calls, NULL);
+	bus = sd_bus_close_unref(bus);
+	bus_retry.cb = bus_connect;
+	uloop_timeout_set(&bus_retry, RECONNECT_MSEC);
+}
+
+static void bus_arm(void)
+{
+	uint64_t until, now;
+	int events;
+
+	if (!bus)
+		return;
+	events = sd_bus_get_events(bus);
+	if (events < 0) {
+		bus_lost(events);
+		return;
+	}
+	uloop_fd_add(&bus_fd, ULOOP_READ | ((events & POLLOUT) ? ULOOP_WRITE : 0));
+	if (sd_bus_get_timeout(bus, &until) < 0 || until == UINT64_MAX) {
+		uloop_timeout_cancel(&bus_timer);
+		return;
+	}
+	now = now_usec();
+	until = until > now ? (until - now + 999) / 1000 : 0;
+	uloop_timeout_set(&bus_timer, until > INT_MAX ? INT_MAX : (int)until);
+}
+
+static void bus_process(void)
+{
+	int r;
+
+	if (!bus)
+		return;
+	do {
+		r = sd_bus_process(bus, NULL);
+	} while (r > 0 && bus);
+	if (!bus)
+		return;
+	if (r < 0) {
+		bus_lost(r);
+		return;
+	}
+	bus_arm();
+}
+
+/* Flush queued calls and parse messages a synchronous call has buffered. */
+static void bus_kick(void)
+{
+	if (bus)
+		uloop_timeout_set(&bus_timer, 0);
+}
+
+static void bus_fd_cb(struct uloop_fd *fd, unsigned int events)
+{
+	bus_process();
+}
+
+static void bus_timer_cb(struct uloop_timeout *t)
+{
+	bus_process();
+}
+
+static bool unit_has_path(struct service_instance *in, const void *path)
+{
+	return in->unit_path && !strcmp(in->unit_path, path);
+}
+
+static struct service_instance *unit_lookup(const char *path)
+{
+	if (!path || strncmp(path, UNIT_PATH_PREFIX, strlen(UNIT_PATH_PREFIX)))
+		return NULL;
+	return unit_instances(unit_has_path, path);
+}
+
+static void copy_string(char *dst, size_t len, const char *src)
+{
+	snprintf(dst, len, "%s", src ? src : "");
+}
+
+/* Read the a{sv} part of a GetAll reply or a PropertiesChanged signal. */
+static int unit_parse_props(struct service_instance *in, sd_bus_message *m)
+{
+	int r = sd_bus_message_enter_container(m, 'a', "{sv}");
+
+	while (r >= 0 && (r = sd_bus_message_enter_container(m, 'e', "sv")) > 0) {
+		const char *key, *s;
+		uint32_t u;
+		int32_t i;
+
+		r = sd_bus_message_read(m, "s", &key);
+		if (r < 0)
+			break;
+		if (!strcmp(key, "ActiveState")) {
+			r = sd_bus_message_read(m, "v", "s", &s);
+			if (r >= 0)
+				copy_string(in->unit_active, sizeof(in->unit_active), s);
+		} else if (!strcmp(key, "SubState")) {
+			r = sd_bus_message_read(m, "v", "s", &s);
+			if (r >= 0)
+				copy_string(in->unit_sub, sizeof(in->unit_sub), s);
+		} else if (!strcmp(key, "Result")) {
+			r = sd_bus_message_read(m, "v", "s", &s);
+			if (r >= 0)
+				copy_string(in->unit_result, sizeof(in->unit_result), s);
+		} else if (!strcmp(key, "MainPID")) {
+			r = sd_bus_message_read(m, "v", "u", &u);
+			if (r >= 0)
+				in->unit_pid = u;
+		} else if (!strcmp(key, "NRestarts")) {
+			r = sd_bus_message_read(m, "v", "u", &u);
+			if (r >= 0)
+				in->unit_restarts = u;
+		} else if (!strcmp(key, "ExecMainCode")) {
+			r = sd_bus_message_read(m, "v", "i", &i);
+			if (r >= 0)
+				in->unit_exec_code = i;
+		} else if (!strcmp(key, "ExecMainStatus")) {
+			r = sd_bus_message_read(m, "v", "i", &i);
+			if (r >= 0)
+				in->unit_exec_status = i;
+		} else {
+			r = sd_bus_message_skip(m, "v");
+		}
+		if (r >= 0)
+			r = sd_bus_message_exit_container(m);
+	}
+	if (r >= 0)
+		r = sd_bus_message_exit_container(m);
+	return r;
+}
+
+static int unit_props_changed(sd_bus_message *m, void *userdata, sd_bus_error *error)
+{
+	struct service_instance *in = unit_lookup(sd_bus_message_get_path(m));
+	const char *iface;
+
+	if (!in || sd_bus_message_read(m, "s", &iface) < 0 ||
+	    (strcmp(iface, UIFACE) && strcmp(iface, SVCIFACE)))
+		return 0;
+	if (unit_parse_props(in, m) < 0)
+		ULOG_WARN("cannot parse state of %s\n", in->unit_name);
+	instance_unit_notify(in, false);
+	return 0;
+}
+
+static int unit_removed(sd_bus_message *m, void *userdata, sd_bus_error *error)
+{
+	struct service_instance *in;
+	const char *id, *path;
+
+	if (sd_bus_message_read(m, "so", &id, &path) < 0)
+		return 0;
+	in = unit_lookup(path);
+	if (in && !strcmp(in->unit_name, id))
+		instance_unit_notify(in, true);
+	return 0;
+}
+
+static bool unit_reconcile(struct service_instance *in, const void *arg)
+{
+	if (!in->unit_loaded)
+		return false;
+	unit_refresh(in);
+	if (in->unit_stopping && in->unit_loaded && !in->unit_stop_call)
+		unit_stop(in);
+	return false;
+}
+
+static void bus_connect(struct uloop_timeout *t)
+{
+	struct ucred peer;
+	socklen_t len = sizeof(peer);
+	int r = sd_bus_new(&bus);
+
+	if (r >= 0)
+		r = sd_bus_set_address(bus, "unix:path=/run/systemd/private");
+	if (r >= 0)
+		r = sd_bus_set_method_call_timeout(bus, CALL_TIMEOUT);
+	if (r >= 0)
+		r = sd_bus_start(bus);
+	if (r >= 0 && (getsockopt(sd_bus_get_fd(bus), SOL_SOCKET, SO_PEERCRED, &peer, &len) ||
+		      peer.uid != 0 || peer.pid != 1))
+		r = -EPERM;
+	if (r >= 0)
+		r = sd_bus_match_signal(bus, NULL, NULL, NULL, PIFACE, "PropertiesChanged",
+					unit_props_changed, NULL);
+	if (r >= 0)
+		r = sd_bus_match_signal(bus, NULL, NULL, MANAGER, MIFACE, "UnitRemoved",
+					unit_removed, NULL);
+	if (r >= 0)
+		r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "Subscribe", NULL, NULL, "");
+	if (r < 0) {
+		ERROR("cannot connect to the systemd manager: %s\n", strerror(-r));
+		bus = sd_bus_close_unref(bus);
+		bus_retry.cb = bus_connect;
+		uloop_timeout_set(&bus_retry, RECONNECT_MSEC);
+		return;
+	}
+	bus_fd.fd = sd_bus_get_fd(bus);
+	bus_fd.cb = bus_fd_cb;
+	bus_timer.cb = bus_timer_cb;
+	DEBUG(2, "Connected to the systemd manager\n");
+	unit_instances(unit_reconcile, NULL);
+	bus_arm();
+	bus_kick();
+}
+
+void unit_init(void)
+{
+	bus_connect(&bus_retry);
+}
+
+bool unit_capable(struct service_instance *in, const char **why)
+{
+	*why = NULL;
+	if (!in->command)
+		*why = "no command";
+	else if (in->bundle)
+		*why = "OCI bundle";
+	else if (in->trace)
+		*why = "trace";
+	else if (in->vrf)
+		*why = "vrf";
+	else if (in->stdio_fd[0] > -1 || in->stdio_fd[1] > -1 || in->stdio_fd[2] > -1)
+		*why = "passed stdio descriptors";
+	else if (in->notify_fd > -1)
+		*why = "notify descriptor";
+	else if (in->has_jail && (in->jail.console || !avl_is_empty(&in->jail.setns.avl)))
+		*why = "jail console or setns";
+	return !*why;
+}
+
+/* Escape a name component: \xNN outside [A-Za-z0-9:_.-], and a leading dot. */
+static int unit_escape(char *dst, size_t len, const char *src)
+{
+	const unsigned char *p = (const unsigned char *)src;
+	size_t n = 0;
+
+	if (!*p)
+		return -EINVAL;
+	for (; *p; p++) {
+		bool literal = isalnum(*p) || *p == '_' || *p == ':' || *p == '-' ||
+			       (*p == '.' && p != (const unsigned char *)src);
+
+		if (n + (literal ? 1 : 4) >= len)
+			return -ENAMETOOLONG;
+		if (literal)
+			dst[n++] = *p;
+		else
+			n += sprintf(dst + n, "\\x%02x", *p);
+	}
+	dst[n] = '\0';
+	return 0;
+}
+
+static int unit_name(struct service_instance *in, char *name, size_t len)
+{
+	char service[128], instance[128];
+
+	if (unit_escape(service, sizeof(service), in->srv->name) ||
+	    unit_escape(instance, sizeof(instance), in->name) ||
+	    snprintf(name, len, "openwrt-%s@%s.service", service, instance) >= (int)len)
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+/* Like execvp(), resolve a bare command name against the procd PATH. */
+static const char *unit_exec_path(const char *cmd, char *buf, size_t len)
+{
+	const char *path = getenv("PATH");
+	const char *p, *end;
+
+	if (strchr(cmd, '/'))
+		return cmd;
+	if (!path)
+		path = "/usr/sbin:/usr/bin:/sbin:/bin";
+	for (p = path; *p; p = *end ? end + 1 : end) {
+		end = strchrnul(p, ':');
+		if (end == p)
+			continue;
+		if (snprintf(buf, len, "%.*s/%s", (int)(end - p), p, cmd) < (int)len &&
+		    !access(buf, X_OK))
+			return buf;
+	}
+	return cmd;
+}
+
+static int prop_open(sd_bus_message *m, const char *key, const char *type)
+{
+	int r = sd_bus_message_open_container(m, 'r', "sv");
+
+	if (r >= 0)
+		r = sd_bus_message_append(m, "s", key);
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'v', type);
+	return r;
+}
+
+static int prop_close(sd_bus_message *m)
+{
+	int r = sd_bus_message_close_container(m);
+
+	return r < 0 ? r : sd_bus_message_close_container(m);
+}
+
+static int append_exec(sd_bus_message *m, struct service_instance *in, bool *seccomp)
+{
+	char **argv = instance_unit_argv(in, seccomp);
+	char path[PATH_MAX];
+	int r;
+
+	if (!argv)
+		return -ENOMEM;
+	r = prop_open(m, "ExecStart", "a(sasb)");
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'a', "(sasb)");
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'r', "sasb");
+	if (r >= 0)
+		r = sd_bus_message_append(m, "s", unit_exec_path(argv[0], path, sizeof(path)));
+	if (r >= 0)
+		r = sd_bus_message_append_strv(m, argv);
+	if (r >= 0)
+		r = sd_bus_message_append(m, "b", 0);
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	if (r >= 0)
+		r = prop_close(m);
+	free(argv);
+	return r;
+}
+
+static int append_env(sd_bus_message *m, struct service_instance *in, bool seccomp)
+{
+	struct blobmsg_list_node *var;
+	char *entry;
+	int r = prop_open(m, "Environment", "as");
+
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'a', "s");
+	blobmsg_list_for_each(&in->env, var) {
+		if (r < 0)
+			break;
+		if (asprintf(&entry, "%s=%s", blobmsg_name(var->data),
+			     (char *)blobmsg_data(var->data)) < 0)
+			return -ENOMEM;
+		r = sd_bus_message_append(m, "s", entry);
+		free(entry);
+	}
+	if (r >= 0 && seccomp) {
+		if (asprintf(&entry, "SECCOMP_FILE=%s", in->seccomp) < 0)
+			return -ENOMEM;
+		r = sd_bus_message_append(m, "s", entry);
+		free(entry);
+	}
+	/* procd line-buffers captured stdout the same way. */
+	if (r >= 0 && in->_stdout.fd.fd > -2)
+		r = sd_bus_message_append(m, "s", "LD_PRELOAD=/lib/libsetlbf.so");
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	return r < 0 ? r : prop_close(m);
+}
+
+/* procd semantics: an omitted half keeps procd's own current limit. */
+static int append_limits(sd_bus_message *m, struct service_instance *in)
+{
+	struct blobmsg_list_node *var;
+	char key[32];
+	size_t i;
+	int r = 0;
+
+	blobmsg_list_for_each(&in->limits, var) {
+		const char *name = blobmsg_name(var->data);
+		const char *value = blobmsg_data(var->data);
+		unsigned long cur, max;
+		struct rlimit rlim;
+
+		for (i = 0; i < ARRAY_SIZE(unit_limits); i++)
+			if (!strcmp(unit_limits[i].procd, name))
+				break;
+		if (i == ARRAY_SIZE(unit_limits))
+			continue;
+		if (!strcmp(value, "unlimited")) {
+			cur = max = (unsigned long)RLIM_INFINITY;
+		} else {
+			if (getrlimit(unit_limits[i].resource, &rlim))
+				continue;
+			cur = rlim.rlim_cur;
+			max = rlim.rlim_max;
+			if (sscanf(value, "%lu %lu", &cur, &max) < 1)
+				continue;
+		}
+		if (cur > max) {
+			ULOG_WARN("%s::%s: ignoring limit %s %s, soft above hard\n",
+				  in->srv->name, in->name, name, value);
+			continue;
+		}
+		snprintf(key, sizeof(key), "Limit%s", unit_limits[i].systemd);
+		r = sd_bus_message_append(m, "(sv)", key, "t",
+				(uint64_t)(max == (unsigned long)RLIM_INFINITY ? UINT64_MAX : max));
+		snprintf(key, sizeof(key), "Limit%sSoft", unit_limits[i].systemd);
+		if (r >= 0)
+			r = sd_bus_message_append(m, "(sv)", key, "t",
+				(uint64_t)(cur == (unsigned long)RLIM_INFINITY ? UINT64_MAX : cur));
+		if (r < 0)
+			break;
+	}
+	return r;
+}
+
+/*
+ * procd respawn [threshold timeout retry]: give up after retry+1 consecutive
+ * runs shorter than threshold. systemd counts starts in a sliding window, so
+ * allow retry+1 starts per threshold*(retry+1).
+ */
+static int append_restart(sd_bus_message *m, struct service_instance *in)
+{
+	uint64_t window, delay, max;
+	uint32_t steps = 0;
+	int r;
+
+	if (!in->respawn) {
+		r = sd_bus_message_append(m, "(sv)", "Restart", "s", "no");
+		/* A one-shot command may leave workers; it ends with its cgroup. */
+		if (r >= 0)
+			r = sd_bus_message_append(m, "(sv)", "ExitType", "s", "cgroup");
+		if (r >= 0)
+			r = sd_bus_message_append(m, "(sv)", "StartLimitIntervalUSec", "t",
+						  (uint64_t)0);
+		return r;
+	}
+
+	r = sd_bus_message_append(m, "(sv)", "Restart", "s",
+				  in->respawn_on_failure ? "on-failure" : "always");
+	if (r >= 0)
+		r = sd_bus_message_append(m, "(sv)", "RestartUSec", "t",
+					  (uint64_t)in->respawn_timeout * USEC);
+	if (r >= 0 && in->respawn_on_failure && in->respawn_timeout &&
+	    in->respawn_max > in->respawn_timeout && in->respawn_multiplier > 1000) {
+		delay = in->respawn_timeout * 1000ULL;
+		max = in->respawn_max * 1000ULL;
+		while (delay < max && steps < 1000) {
+			delay = delay * in->respawn_multiplier / 1000;
+			steps++;
+		}
+		r = sd_bus_message_append(m, "(sv)", "RestartSteps", "u", steps);
+		if (r >= 0)
+			r = sd_bus_message_append(m, "(sv)", "RestartMaxDelayUSec", "t",
+						  (uint64_t)in->respawn_max * USEC);
+	}
+	if (r < 0)
+		return r;
+	if (!in->respawn_retry)
+		return sd_bus_message_append(m, "(sv)", "StartLimitIntervalUSec", "t",
+					     (uint64_t)0);
+	window = (uint64_t)(in->respawn_threshold ? in->respawn_threshold : NO_RESET_PERIOD) *
+		 (in->respawn_retry + 1ULL) * USEC;
+	r = sd_bus_message_append(m, "(sv)", "StartLimitBurst", "u", in->respawn_retry + 1);
+	if (r >= 0)
+		r = sd_bus_message_append(m, "(sv)", "StartLimitIntervalUSec", "t", window);
+	return r;
+}
+
+static void unit_reset_state(struct service_instance *in)
+{
+	*in->unit_active = '\0';
+	*in->unit_sub = '\0';
+	*in->unit_result = '\0';
+	in->unit_pid = 0;
+	in->unit_restarts = 0;
+	in->unit_exec_code = 0;
+	in->unit_exec_status = 0;
+}
+
+static int unit_start_reply(sd_bus_message *m, void *userdata, sd_bus_error *error)
+{
+	struct service_instance *in = userdata;
+	const sd_bus_error *e;
+
+	in->unit_call = sd_bus_slot_unref(in->unit_call);
+	if (!sd_bus_message_is_method_error(m, NULL)) {
+		in->unit_exists = 0;
+		return 0;
+	}
+	e = sd_bus_message_get_error(m);
+	if (sd_bus_error_has_name(e, DEST ".UnitExists") && in->unit_exists++ < EXISTS_RETRIES) {
+		/* An earlier execution still holds the name: replace it. */
+		ULOG_WARN("%s is still loaded, restarting it\n", in->unit_name);
+		in->halt = true;
+		in->restart = true;
+		unit_stop(in);
+		return 0;
+	}
+	ERROR("cannot start %s: %s\n", in->unit_name, e && e->message ? e->message : "error");
+	in->unit_exists = 0;
+	in->unit_exec_code = CLD_EXITED;
+	in->unit_exec_status = 127;
+	instance_unit_notify(in, true);
+	return 0;
+}
+
+int unit_start(struct service_instance *in)
+{
+	char slice[256], description[512], *path = NULL;
+	const char *ident;
+	sd_bus_message *m = NULL;
+	bool seccomp = false;
+	uint32_t timeout = in->has_jail ? in->term_timeout * 2 : in->term_timeout;
+	int r;
+
+	if (!bus)
+		return -ENOTCONN;
+	r = unit_name(in, in->unit_name, sizeof(in->unit_name));
+	if (r >= 0)
+		r = sd_bus_path_encode(UNIT_ROOT, in->unit_name, &path);
+	if (r >= 0) {
+		free(in->unit_path);
+		in->unit_path = path;
+		r = owrt_service_slice(in->srv->name, slice);
+	}
+	if (r < 0)
+		return r;
+
+	ident = basename(blobmsg_data(blobmsg_data(in->command)));
+	snprintf(description, sizeof(description), "OpenWrt %s::%s", in->srv->name, in->name);
+	r = sd_bus_message_new_method_call(bus, &m, DEST, MANAGER, MIFACE, "StartTransientUnit");
+	if (r >= 0)
+		r = sd_bus_message_append(m, "ss", in->unit_name, "fail");
+	if (r >= 0)
+		r = sd_bus_message_open_container(m, 'a', "(sv)");
+#define PROP(...) do { if (r >= 0) r = sd_bus_message_append(m, "(sv)", __VA_ARGS__); } while (0)
+	PROP("Description", "s", description);
+	PROP("Slice", "s", slice);
+	PROP("CollectMode", "s", "inactive-or-failed");
+	PROP("BindsTo", "as", 1, BOUND_UNIT);
+	/* Shutdown runs the rc stop scripts while the daemons are still up. */
+	PROP("Before", "as", 1, RC_UNIT);
+	PROP("Type", "s", "exec");
+	PROP("KillMode", "s", in->respawn ? "mixed" : "control-group");
+	PROP("TimeoutStopUSec", "t", (uint64_t)timeout * USEC);
+	PROP("TasksMax", "t", UINT64_MAX);
+	PROP("OOMPolicy", "s", "continue");
+	PROP("IgnoreSIGPIPE", "b", 0);
+	PROP("Delegate", "b", (int)in->has_jail);
+	PROP("StandardInput", "s", "null");
+	PROP("StandardOutput", "s", in->_stdout.fd.fd > -2 ? "journal" : "null");
+	PROP("StandardError", "s", in->_stderr.fd.fd > -2 ? "journal" : "null");
+	PROP("SyslogIdentifier", "s", ident);
+	PROP("SyslogFacility", "i", (int32_t)(in->syslog_facility >> 3));
+	if (in->nice)
+		PROP("Nice", "i", (int32_t)in->nice);
+	/* ujail switches credentials itself, as with procd. */
+	if (!in->has_jail && in->user)
+		PROP("User", "s", in->user);
+	if (!in->has_jail && in->group)
+		PROP("Group", "s", in->group);
+#undef PROP
+	if (r >= 0)
+		r = append_limits(m, in);
+	if (r >= 0)
+		r = append_restart(m, in);
+	if (r >= 0)
+		r = append_exec(m, in, &seccomp);
+	if (r >= 0)
+		r = append_env(m, in, seccomp);
+	if (r >= 0)
+		r = sd_bus_message_close_container(m);
+	if (r >= 0)
+		r = sd_bus_message_append(m, "a(sa(sv))", 0);
+	if (r >= 0) {
+		in->unit_call = sd_bus_slot_unref(in->unit_call);
+		r = sd_bus_call_async(bus, (sd_bus_slot **)&in->unit_call, m,
+				      unit_start_reply, in, CALL_TIMEOUT);
+	}
+	sd_bus_message_unref(m);
+	if (r < 0)
+		return r;
+
+	unit_reset_state(in);
+	in->unit_check.cb = unit_check_cb;
+	in->unit_loaded = true;
+	in->unit_stopping = false;
+	bus_kick();
+	return 0;
+}
+
+static void unit_check_cb(struct uloop_timeout *t)
+{
+	struct service_instance *in = container_of(t, struct service_instance, unit_check);
+
+	if (!bus || !in->unit_loaded)
+		return;
+	unit_refresh(in);
+	if (in->unit_loaded && in->unit_stopping)
+		uloop_timeout_set(t, CHECK_SLACK_MSEC);
+}
+
+static int unit_stop_reply(sd_bus_message *m, void *userdata, sd_bus_error *error)
+{
+	struct service_instance *in = userdata;
+	const sd_bus_error *e;
+
+	in->unit_stop_call = sd_bus_slot_unref(in->unit_stop_call);
+	if (!sd_bus_message_is_method_error(m, NULL))
+		return 0;
+	e = sd_bus_message_get_error(m);
+	if (sd_bus_error_has_name(e, DEST ".NoSuchUnit")) {
+		instance_unit_notify(in, true);
+		return 0;
+	}
+	ERROR("cannot stop %s: %s\n", in->unit_name, e && e->message ? e->message : "error");
+	return 0;
+}
+
+void unit_stop(struct service_instance *in)
+{
+	uint32_t timeout = in->has_jail ? in->term_timeout * 2 : in->term_timeout;
+	int r;
+
+	in->unit_stopping = true;
+	in->unit_check.cb = unit_check_cb;
+	uloop_timeout_set(&in->unit_check, timeout * 1000 + CHECK_SLACK_MSEC);
+	if (!bus)
+		return;
+	in->unit_stop_call = sd_bus_slot_unref(in->unit_stop_call);
+	r = sd_bus_call_method_async(bus, (sd_bus_slot **)&in->unit_stop_call, DEST, MANAGER,
+				     MIFACE, "StopUnit", unit_stop_reply, in, "ss",
+				     in->unit_name, "replace");
+	if (r < 0)
+		ERROR("cannot stop %s: %s\n", in->unit_name, strerror(-r));
+	bus_kick();
+}
+
+int unit_signal(struct service_instance *in, int sig)
+{
+	sd_bus_error error = SD_BUS_ERROR_NULL;
+	int r;
+
+	if (!in->unit_loaded)
+		return -ESRCH;
+	if (!bus)
+		return -ENOTCONN;
+	r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "KillUnit", &error, NULL,
+			       "ssi", in->unit_name, "main", sig);
+	if (sd_bus_error_has_name(&error, DEST ".NoSuchUnit") ||
+	    sd_bus_error_has_name(&error, DEST ".NoSuchProcess"))
+		r = -ESRCH;
+	else if (sd_bus_error_has_name(&error, SD_BUS_ERROR_INVALID_ARGS))
+		r = -EINVAL;
+	sd_bus_error_free(&error);
+	bus_kick();
+	return r < 0 ? r : 0;
+}
+
+static int unit_get_all(struct service_instance *in, const char *iface)
+{
+	sd_bus_message *reply = NULL;
+	int r = sd_bus_call_method(bus, DEST, in->unit_path, PIFACE, "GetAll", NULL, &reply,
+				   "s", iface);
+
+	if (r >= 0)
+		r = unit_parse_props(in, reply);
+	sd_bus_message_unref(reply);
+	return r;
+}
+
+/* Synchronously compare procd's view with the manager, e.g. after reconnecting. */
+static void unit_refresh(struct service_instance *in)
+{
+	sd_bus_error error = SD_BUS_ERROR_NULL;
+	int r;
+
+	if (!bus || !in->unit_path)
+		return;
+	r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "GetUnit", &error, NULL,
+			       "s", in->unit_name);
+	if (sd_bus_error_has_name(&error, DEST ".NoSuchUnit")) {
+		sd_bus_error_free(&error);
+		instance_unit_notify(in, true);
+		bus_kick();
+		return;
+	}
+	sd_bus_error_free(&error);
+	if (r >= 0)
+		r = unit_get_all(in, UIFACE);
+	if (r >= 0)
+		r = unit_get_all(in, SVCIFACE);
+	if (r < 0)
+		ULOG_WARN("cannot refresh %s: %s\n", in->unit_name, strerror(-r));
+	else
+		instance_unit_notify(in, false);
+	bus_kick();
+}
+
+/* A removal hint is applied only if the manager no longer knows the name. */
+bool unit_confirm_gone(struct service_instance *in)
+{
+	sd_bus_error error = SD_BUS_ERROR_NULL;
+	bool gone;
+	int r;
+
+	if (!bus)
+		return true;
+	r = sd_bus_call_method(bus, DEST, MANAGER, MIFACE, "GetUnit", &error, NULL,
+			       "s", in->unit_name);
+	if (r < 0 && !sd_bus_error_has_name(&error, DEST ".NoSuchUnit"))
+		ULOG_WARN("cannot look up %s: %s\n", in->unit_name, strerror(-r));
+	/* On a lookup failure, a reused name is caught as UnitExists later. */
+	gone = r < 0;
+	sd_bus_error_free(&error);
+	bus_kick();
+	return gone;
+}
+
+void unit_forget(struct service_instance *in)
+{
+	uloop_timeout_cancel(&in->unit_check);
+	uloop_timeout_cancel(&in->unit_work);
+	in->unit_call = sd_bus_slot_unref(in->unit_call);
+	in->unit_stop_call = sd_bus_slot_unref(in->unit_stop_call);
+	if (bus && in->unit_loaded && !in->unit_stopping) {
+		/* Never leave an untracked execution behind. */
+		sd_bus_call_method_async(bus, NULL, DEST, MANAGER, MIFACE, "StopUnit",
+					 NULL, NULL, "ss", in->unit_name, "replace");
+		bus_kick();
+	}
+	in->unit_loaded = false;
+	free(in->unit_path);
+	in->unit_path = NULL;
+}
+
+int unit_watchdog_timeout(unsigned int *seconds)
+{
+	uint64_t usec;
+	int r;
+
+	if (!bus)
+		return -ENOTCONN;
+	r = sd_bus_get_property_trivial(bus, DEST, MANAGER, MIFACE, "RuntimeWatchdogUSec",
+					NULL, 't', &usec);
+	bus_kick();
+	if (r < 0)
+		return r;
+	*seconds = usec == UINT64_MAX ? UINT_MAX : usec / USEC;
+	return 0;
+}
