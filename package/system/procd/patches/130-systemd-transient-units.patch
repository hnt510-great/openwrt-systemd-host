+	UDEV_EVENT_ENV,
+	__UDEV_EVENT_MAX
+};
+
+static const struct blobmsg_policy udev_event_policy[__UDEV_EVENT_MAX] = {
+	[UDEV_EVENT_ENV] = { .name = "env", .type = BLOBMSG_TYPE_TABLE },
+};
+
+/* Units mode: udev hands over each processed device event (root only). */
+static int udev_event(struct ubus_context *ctx, struct ubus_object *obj,
+		      struct ubus_request_data *req, const char *method,
+		      struct blob_attr *msg)
+{
+	struct blob_attr *tb[__UDEV_EVENT_MAX];
+
+	blobmsg_parse(udev_event_policy, __UDEV_EVENT_MAX, tb, blobmsg_data(msg),
+		      blobmsg_data_len(msg));
+	if (!tb[UDEV_EVENT_ENV])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	hotplug_inject(tb[UDEV_EVENT_ENV]);
+	return UBUS_STATUS_OK;
+}
+
+static const struct ubus_method udev_methods[] = {
+	UBUS_METHOD("event", udev_event, udev_event_policy),
+};
+
+static struct ubus_object_type udev_object_type =
+	UBUS_OBJECT_TYPE("procd-udev", udev_methods);
+
+static struct ubus_object udev_object = {
+	.name = "procd.udev",
+	.type = &udev_object_type,
+	.methods = udev_methods,
+	.n_methods = ARRAY_SIZE(udev_methods),
+};
