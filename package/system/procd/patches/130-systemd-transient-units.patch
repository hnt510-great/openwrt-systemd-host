+
+/* Run the rules for an event udev has finished processing. */
+void hotplug_inject(struct blob_attr *env)
+{
+	struct blob_attr *cur;
+	const char *value;
+	int rem;
+
+	if (!hotplug_external || !rule_file)
+		return;
+
+	blob_buf_init(&b, 0);
+	blobmsg_for_each_attr(cur, env, rem) {
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING || !*blobmsg_name(cur))
+			continue;
+		value = blobmsg_get_string(cur);
+		/* udev reports the node path; kernel events and rules use the name. */
+		if (!strcmp(blobmsg_name(cur), "DEVNAME") && !strncmp(value, "/dev/", 5))
+			value += 5;
+		blobmsg_add_string(&b, blobmsg_name(cur), value);
+	}
+	hotplug_ubus_event(b.head);
+	hotplug_handler_debug(b.head);
+	json_script_run(&jctx, rule_file, b.head);
+}
+
 int hotplug_run(char *rules)
 {
 	uloop_init();
