--- /dev/null
+++ b/udev-forward.c
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * udev RUN helper: hand a processed device event to procd, which runs the
+ * OpenWrt /etc/hotplug.d handlers in its own serial queue. Long-lived
+ * helpers therefore survive the udev worker. Without ubus or a procd in
+ * units mode there is nothing to notify, which is not an error.
+ */
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <libubox/blobmsg.h>
+#include <libubus.h>
+
+#define FORWARD_TIMEOUT 5000
+
+int main(int argc, char **argv)
+{
+	static struct blob_buf b;
+	struct ubus_context *ctx;
+	uint32_t id;
+	char **e;
+	void *t;
+	int ret;
+
+	ctx = ubus_connect(NULL);
+	if (!ctx)
+		return 0;
+	if (ubus_lookup_id(ctx, "procd.udev", &id)) {
+		ubus_free(ctx);
+		return 0;
+	}
+
+	blob_buf_init(&b, 0);
+	t = blobmsg_open_table(&b, "env");
+	for (e = environ; *e; e++) {
+		char *sep = strchr(*e, '=');
+
+		if (!sep || sep == *e)
+			continue;
+		*sep = '\0';
+		blobmsg_add_string(&b, *e, sep + 1);
+		*sep = '=';
+	}
+	blobmsg_close_table(&b, t);
+
+	ret = ubus_invoke(ctx, id, "event", b.head, NULL, NULL, FORWARD_TIMEOUT);
+	if (ret)
+		fprintf(stderr, "openwrt-udev-forward: %s\n", ubus_strerror(ret));
+	blob_buf_free(&b);
+	ubus_free(ctx);
+	return 0;
+}
