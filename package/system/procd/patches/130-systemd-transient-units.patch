 }
 
+#define UDEV_COLDPLUG_MARKER "/run/procd-udev-coldplug"
+#define UDEV_COLDPLUG_TIMEOUT (45 * 1000)
+
+static struct uloop_process udev_replay;
+static struct uloop_timeout udev_replay_timeout;
+static bool udev_replay_finished;
+
+static void udev_replay_done(void)
+{
+	int fd;
+
+	if (udev_replay_finished)
+		return;
+	udev_replay_finished = true;
+	fd = open(UDEV_COLDPLUG_MARKER, O_WRONLY | O_CREAT | O_CLOEXEC, 0600);
+	if (fd >= 0)
+		close(fd);
+	uloop_timeout_cancel(&udev_replay_timeout);
+	procd_systemd_coldplug_ready();
+}
+
+static void udev_replay_complete(struct uloop_process *proc, int ret)
+{
+	if (ret)
+		ERROR("udev coldplug exited with %d\n", ret);
+	P_DEBUG(4, "Finished udev coldplug\n");
+	udev_replay_done();
+}
+
+static void udev_replay_expired(struct uloop_timeout *t)
+{
+	ERROR("udev coldplug is still running; continuing\n");
+	udev_replay_done();
+}
+
+/*
+ * As udevtrigger does without systemd, request "add" for every device once
+ * per boot, after procd can receive udev's forwarded events. udev applies
+ * its rules and procd runs the OpenWrt handlers. A procd restart must not
+ * repeat it: device consumers such as the desktop are already running.
+ */
+static void udev_coldplug(void)
+{
+	static char * const argv[] = { "/usr/bin/udevadm", "trigger", "--type=devices",
+				       "--action=add", "--settle", NULL };
+
+	if (!access(UDEV_COLDPLUG_MARKER, F_OK)) {
+		procd_systemd_coldplug_ready();
+		return;
+	}
+
+	udev_replay.cb = udev_replay_complete;
+	udev_replay_timeout.cb = udev_replay_expired;
+	udev_replay.pid = fork();
+	if (!udev_replay.pid) {
+		int fd = open("/dev/null", O_RDWR);
+
+		if (fd >= 0) {
+			dup2(fd, STDIN_FILENO);
+			if (fd > STDERR_FILENO)
+				close(fd);
+		}
+		execv(argv[0], argv);
+		ERROR("Failed to start udev coldplug: %m\n");
+		_exit(EXIT_FAILURE);
+	}
+	if (udev_replay.pid < 0) {
+		ERROR("Failed to start udev coldplug: %m\n");
+		udev_replay_done();
+		return;
+	}
+	uloop_process_add(&udev_replay);
+	uloop_timeout_set(&udev_replay_timeout, UDEV_COLDPLUG_TIMEOUT);
+	P_DEBUG(4, "Launched udev coldplug, pid=%d\n", (int) udev_replay.pid);
+}
+
 void procd_coldplug(void)
 {
 	char *argv[] = { "udevtrigger", NULL };
-	unsigned int oldumask = umask(0);
+	unsigned int oldumask;
+
+	if (procd_units) {
+		udev_coldplug();
+		return;
+	}
+
+	oldumask = umask(0);
 
 	if (!is_container() && !procd_systemd) {
 		umount2("/dev/pts", MNT_DETACH);
