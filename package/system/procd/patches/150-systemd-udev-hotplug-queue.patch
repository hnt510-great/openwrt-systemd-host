+static bool is_json_entry(const char *name)
+{
+	size_t len = strlen(name);
+
+	return name[0] != '.' && len > 5 && strcmp(name + len - 5, ".json") == 0;
+}
+
+static int filter_json(const struct dirent *de)
+{
+	return is_json_entry(de->d_name);
+}
+
+static int write_json_atomic_locked(const char *dest_path, struct json_object *obj)
+{
+	static unsigned int tmp_seq;
+	const char *str = json_object_to_json_string_ext(obj, JSON_C_TO_STRING_PLAIN);
+	char tmp_path[PATH_MAX];
+	int fd;
+	size_t len, off = 0;
+
+	if (!str)
+		return -1;
+	len = strlen(str);
+	if (snprintf(tmp_path, sizeof(tmp_path), "%s/tmp/.c-%ld-%" PRIu64 "-%u.tmp",
+		     HOTPLUG_QUEUE_DIR, (long)getpid(), hotplug_queue_mono_ms(), ++tmp_seq) >= (int)sizeof(tmp_path))
+		return -1;
+	fd = open(tmp_path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return -1;
+	while (off < len) {
+		ssize_t n = write(fd, str + off, len - off);
+
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			close(fd);
+			unlink(tmp_path);
+			return -1;
+		}
+		off += (size_t)n;
+	}
+	if (close(fd) < 0 || rename(tmp_path, dest_path) < 0) {
+		unlink(tmp_path);
+		return -1;
+	}
+	return 0;
+}
+
+static struct json_object *load_record_file(const char *path)
+{
+	struct stat st;
+	struct json_object *obj, *env;
+
+	if (lstat(path, &st) < 0 || !S_ISREG(st.st_mode) || st.st_size <= 0 ||
+	    st.st_size > HOTPLUG_RECORD_MAX_BYTES)
+		return NULL;
+	obj = json_object_from_file(path);
+	if (!obj || !json_object_is_type(obj, json_type_object)) {
+		if (obj)
+			json_object_put(obj);
+		return NULL;
+	}
+	if (!json_object_object_get_ex(obj, "env", &env) ||
+	    !json_object_is_type(env, json_type_object)) {
+		json_object_put(obj);
+		return NULL;
+	}
+	return obj;
+}
+
+static const char *json_get_str(struct json_object *obj, const char *key)
+{
+	struct json_object *v = NULL;
+
+	if (!json_object_object_get_ex(obj, key, &v) || !json_object_is_type(v, json_type_string))
+		return NULL;
+	return json_object_get_string(v);
+}
+
+static uint64_t json_get_u64(struct json_object *obj, const char *key)
+{
+	struct json_object *v = NULL;
+	int64_t val;
+
+	if (!json_object_object_get_ex(obj, key, &v))
+		return 0;
+	val = json_object_get_int64(v);
+	return val > 0 ? (uint64_t)val : 0;
+}
+
+static int read_sysfs_str(const char *path, char *buf, size_t len)
+{
+	int fd;
+	ssize_t n;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, len - 1);
+	close(fd);
+	if (n <= 0)
+		return -1;
+	buf[n] = '\0';
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' '))
+		buf[--n] = '\0';
+	return n > 0 ? 0 : -1;
+}
+
+static void move_to_corrupt_locked(const char *src_path, const char *name, const char *reason)
+{
+	char corrupt_dir[PATH_MAX], dst_path[PATH_MAX];
+	struct hotplug_queue_stats st;
+
+	snprintf(corrupt_dir, sizeof(corrupt_dir), "%s/corrupt", HOTPLUG_QUEUE_DIR);
+	snprintf(dst_path, sizeof(dst_path), "%s/%s", corrupt_dir, name);
+	if (rename(src_path, dst_path) < 0)
+		unlink(src_path);
+	hotplug_queue_prune_dir(corrupt_dir, HOTPLUG_CORRUPT_MAX_ITEMS, HOTPLUG_CORRUPT_MAX_BYTES);
+	if (hotplug_queue_read_stats(HOTPLUG_QUEUE_DIR, &st) == 0) {
+		st.corrupt++;
+		hotplug_queue_write_stats(HOTPLUG_QUEUE_DIR, &st);
+	}
+	ERROR("hotplug-queue: moved corrupt record %s to corrupt/ (%s)\n", name, reason);
+}
+
+static void recover_inflight_on_start(void)
+{
+	char inflight_dir[PATH_MAX], quarantine_dir[PATH_MAX];
+	struct dirent **list = NULL;
+	int n, i, lock_fd;
+
+	snprintf(inflight_dir, sizeof(inflight_dir), "%s/inflight", HOTPLUG_QUEUE_DIR);
+	snprintf(quarantine_dir, sizeof(quarantine_dir), "%s/quarantine", HOTPLUG_QUEUE_DIR);
+
+	lock_fd = hotplug_queue_lock(HOTPLUG_QUEUE_DIR);
+	if (lock_fd < 0)
+		return;
+
+	n = scandir(inflight_dir, &list, filter_json, alphasort);
+	for (i = 0; i < n; i++) {
+		char src[PATH_MAX], dst[PATH_MAX];
+		struct json_object *rec;
+		struct hotplug_queue_stats st;
+		const char *stage, *devkey;
+
+		snprintf(src, sizeof(src), "%s/%s", inflight_dir, list[i]->d_name);
+		snprintf(dst, sizeof(dst), "%s/%s", quarantine_dir, list[i]->d_name);
+
+		rec = load_record_file(src);
+		if (!rec) {
+			move_to_corrupt_locked(src, list[i]->d_name, "unreadable_inflight");
+			free(list[i]);
+			continue;
+		}
+
+		stage = json_get_str(rec, "stage");
+		devkey = json_get_str(rec, "device_key");
+		json_object_object_add(rec, "last_stage",
+				       json_object_new_string(stage ? stage : "inflight"));
+		json_object_object_add(rec, "stage", json_object_new_string("quarantined"));
+		json_object_object_add(rec, "reason", json_object_new_string("procd_crash_inflight"));
+		json_object_object_add(rec, "quarantined_mono_ms",
+				       json_object_new_int64((int64_t)hotplug_queue_mono_ms()));
+
+		if (rename(src, dst) == 0)
+			write_json_atomic_locked(dst, rec);
+		else if (write_json_atomic_locked(dst, rec) == 0)
+			unlink(src);
+
+		hotplug_queue_prune_dir(quarantine_dir, HOTPLUG_QUARANTINE_MAX_ITEMS,
+					HOTPLUG_QUARANTINE_MAX_BYTES);
+
+		if (hotplug_queue_read_stats(HOTPLUG_QUEUE_DIR, &st) == 0) {
+			st.quarantined_total++;
+			hotplug_queue_write_stats(HOTPLUG_QUEUE_DIR, &st);
+		}
+
+		ERROR("hotplug-queue: quarantined interrupted record %s (device=%s last_stage=%s); manual resolution required\n",
+		      list[i]->d_name, devkey ? devkey : "unknown", stage ? stage : "inflight");
+
+		json_object_put(rec);
+		free(list[i]);
+	}
+	free(list);
+	hotplug_queue_unlock(lock_fd);
+}
+
+static size_t collect_quarantine_keys(struct hq_quarantine_key **out)
+{
+	char qdir[PATH_MAX];
+	struct dirent **list = NULL;
+	struct hq_quarantine_key *keys = NULL;
+	size_t count = 0;
+	int n, i;
+
+	*out = NULL;
+	snprintf(qdir, sizeof(qdir), "%s/quarantine", HOTPLUG_QUEUE_DIR);
+	n = scandir(qdir, &list, filter_json, alphasort);
+	if (n <= 0) {
+		free(list);
+		return 0;
+	}
+
+	keys = calloc((size_t)n, sizeof(*keys));
+	if (!keys) {
+		for (i = 0; i < n; i++)
+			free(list[i]);
+		free(list);
+		return 0;
+	}
+
+	for (i = 0; i < n; i++) {
+		char path[PATH_MAX];
+		struct json_object *rec;
+		const char *dk;
+
+		snprintf(path, sizeof(path), "%s/%s", qdir, list[i]->d_name);
+		rec = load_record_file(path);
+		if (rec) {
+			dk = json_get_str(rec, "device_key");
+			if (dk && *dk)
+				keys[count++].device_key = strdup(dk);
+			json_object_put(rec);
+		}
+		free(list[i]);
+	}
+	free(list);
+	*out = keys;
+	return count;
+}
+
+static void free_quarantine_keys(struct hq_quarantine_key *keys, size_t count)
+{
+	size_t i;
+
+	for (i = 0; i < count; i++)
+		free(keys[i].device_key);
+	free(keys);
+}
+
+static bool device_is_quarantined(const char *devkey, struct hq_quarantine_key *keys, size_t count)
+{
+	size_t i;
+
+	if (!devkey || !*devkey)
+		return false;
+	for (i = 0; i < count; i++) {
+		if (keys[i].device_key && strcmp(keys[i].device_key, devkey) == 0)
+			return true;
+	}
+	return false;
+}
+
+static bool record_is_stale_or_expired(struct json_object *rec, struct json_object *env,
+				       char *reason_out, size_t reason_len)
+{
+	const char *subsys = json_get_str(env, "SUBSYSTEM");
+	const char *action = json_get_str(env, "ACTION");
+	const char *devpath = json_get_str(env, "DEVPATH");
+	const char *firmware = json_get_str(env, "FIRMWARE");
+	const char *diskseq = json_get_str(rec, "diskseq");
+	uint64_t now_ms = hotplug_queue_mono_ms();
+
+	/* Block device reuse check: never expire remove events for vanished devices. */
+	if (subsys && strcmp(subsys, "block") == 0 &&
+	    (!action || strcmp(action, "remove") != 0) &&
+	    devpath && *devpath && strstr(devpath, "..") == NULL &&
+	    diskseq && *diskseq) {
+		char sys_ds[PATH_MAX], cur_ds[64];
+
+		if (snprintf(sys_ds, sizeof(sys_ds), "/sys/%s/diskseq", devpath) < (int)sizeof(sys_ds)) {
+			if (read_sysfs_str(sys_ds, cur_ds, sizeof(cur_ds)) < 0) {
+				snprintf(reason_out, reason_len,
+					 "block device vanished before dispatch (devpath=%s diskseq=%s)",
+					 devpath, diskseq);
+				return true;
+			}
+			if (strcmp(cur_ds, diskseq) != 0) {
+				snprintf(reason_out, reason_len,
+					 "block diskseq changed (devpath=%s recorded=%s current=%s)",
+					 devpath, diskseq, cur_ds);
+				return true;
+			}
+		}
+	}
+
+	/* Firmware check: verify TTL and sysfs instance identity before loading data. */
+	if (firmware && *firmware) {
+		uint64_t enq_ms = json_get_u64(rec, "enqueued_mono_ms");
+		uint64_t ttl_s = json_get_u64(rec, "fw_ttl_s");
+		uint64_t rec_dev = json_get_u64(rec, "fw_sysfs_dev");
+		uint64_t rec_ino = json_get_u64(rec, "fw_sysfs_ino");
+
+		if (ttl_s == 0)
+			ttl_s = HOTPLUG_FW_DEFAULT_TTL_S;
+		if (enq_ms > 0 && now_ms > enq_ms && (now_ms - enq_ms) > ttl_s * 1000ULL) {
+			snprintf(reason_out, reason_len,
+				 "firmware request expired (fw=%s age_ms=%" PRIu64 " ttl_s=%" PRIu64 ")",
+				 firmware, now_ms - enq_ms, ttl_s);
+			return true;
+		}
+		if (!devpath || !*devpath || strstr(devpath, "..") != NULL) {
+			snprintf(reason_out, reason_len,
+				 "firmware request missing valid devpath (fw=%s)", firmware);
+			return true;
+		}
+		if (rec_ino != 0) {
+			char sys_fw[PATH_MAX];
+			struct stat st;
+			bool matched = false;
+
+			if (snprintf(sys_fw, sizeof(sys_fw), "/sys/%s/loading", devpath) < (int)sizeof(sys_fw) &&
+			    stat(sys_fw, &st) == 0 &&
+			    (uint64_t)st.st_dev == rec_dev && (uint64_t)st.st_ino == rec_ino) {
+				matched = true;
+			} else if (snprintf(sys_fw, sizeof(sys_fw), "/sys/%s", devpath) < (int)sizeof(sys_fw) &&
+				   stat(sys_fw, &st) == 0 &&
+				   (uint64_t)st.st_dev == rec_dev && (uint64_t)st.st_ino == rec_ino) {
+				matched = true;
+			}
+			if (!matched) {
+				snprintf(reason_out, reason_len,
+					 "firmware sysfs instance gone or replaced (fw=%s devpath=%s)",
+					 firmware, devpath);
+				return true;
+			}
+		} else {
+			char sys_fw[PATH_MAX];
+			struct stat st;
+
+			if (snprintf(sys_fw, sizeof(sys_fw), "/sys/%s/loading", devpath) >= (int)sizeof(sys_fw) ||
+			    stat(sys_fw, &st) < 0) {
+				snprintf(reason_out, reason_len,
+					 "firmware sysfs loading node absent (fw=%s devpath=%s)",
+					 firmware, devpath);
+				return true;
+			}
+		}
+	}
+
+	return false;
+}
+
+static void on_record_complete(int failed)
+{
+	int lock_fd;
+	struct hotplug_queue_stats st;
+
+	if (!active_id[0])
+		return;
+
+	if (failed)
+		ERROR("hotplug-queue: record %s completed with helper/fork failure\n", active_id);
+
+	lock_fd = hotplug_queue_lock(HOTPLUG_QUEUE_DIR);
+	if (active_inflight_path[0])
+		unlink(active_inflight_path);
+	if (lock_fd >= 0) {
+		if (hotplug_queue_read_stats(HOTPLUG_QUEUE_DIR, &st) == 0) {
+			st.dispatched++;
+			hotplug_queue_write_stats(HOTPLUG_QUEUE_DIR, &st);
+		}
+		hotplug_queue_unlock(lock_fd);
+	}
+
+	active_id[0] = '\0';
+	active_inflight_path[0] = '\0';
+	hotplug_queue_kick();
+}
+
+static void scan_and_dispatch(struct uloop_timeout *t)
+{
+	char pending_dir[PATH_MAX];
+	struct dirent **list = NULL;
+	struct hq_quarantine_key *qkeys = NULL;
+	size_t qcount;
+	int n, i;
+
+	if (!queue_initialized || !queue_ubus_online || queue_stopping)
+		return;
+	if (active_id[0] != '\0' || hotplug_exec_busy())
+		return;
+
+	snprintf(pending_dir, sizeof(pending_dir), "%s/pending", HOTPLUG_QUEUE_DIR);
+	n = scandir(pending_dir, &list, filter_json, alphasort);
+	if (n <= 0) {
+		free(list);
+		return;
+	}
+
+	qcount = collect_quarantine_keys(&qkeys);
+
+	for (i = 0; i < n; i++) {
+		char src[PATH_MAX], dst[PATH_MAX], reason[256];
+		struct json_object *rec = NULL, *env = NULL;
+		const char *devkey, *id;
+		int lock_fd;
+
+		snprintf(src, sizeof(src), "%s/%s", pending_dir, list[i]->d_name);
+
+		lock_fd = hotplug_queue_lock(HOTPLUG_QUEUE_DIR);
+		if (lock_fd < 0)
+			continue;
+
+		rec = load_record_file(src);
+		if (!rec) {
+			move_to_corrupt_locked(src, list[i]->d_name, "invalid_pending_json");
+			hotplug_queue_unlock(lock_fd);
+			continue;
+		}
+
+		json_object_object_get_ex(rec, "env", &env);
+		devkey = json_get_str(rec, "device_key");
+		if (device_is_quarantined(devkey, qkeys, qcount)) {
+			json_object_put(rec);
+			hotplug_queue_unlock(lock_fd);
+			continue;
+		}
+
+		if (record_is_stale_or_expired(rec, env, reason, sizeof(reason))) {
+			struct hotplug_queue_stats st;
+
+			unlink(src);
+			if (hotplug_queue_read_stats(HOTPLUG_QUEUE_DIR, &st) == 0) {
+				st.expired++;
+				hotplug_queue_write_stats(HOTPLUG_QUEUE_DIR, &st);
+			}
+			ERROR("hotplug-queue: skipping expired record %s: %s\n",
+			      list[i]->d_name, reason);
+			json_object_put(rec);
+			hotplug_queue_unlock(lock_fd);
+			continue;
+		}
+
+		/* Atomically claim to inflight/ BEFORE any side-effecting notify or exec. */
+		snprintf(dst, sizeof(dst), "%s/inflight/%s", HOTPLUG_QUEUE_DIR, list[i]->d_name);
+		if (rename(src, dst) < 0) {
+			json_object_put(rec);
+			hotplug_queue_unlock(lock_fd);
+			continue;
+		}
+
+		json_object_object_add(rec, "stage", json_object_new_string("executing"));
+		json_object_object_add(rec, "started_mono_ms",
+				       json_object_new_int64((int64_t)hotplug_queue_mono_ms()));
+		write_json_atomic_locked(dst, rec);
+		hotplug_queue_unlock(lock_fd);
+
+		id = json_get_str(rec, "id");
+		snprintf(active_id, sizeof(active_id), "%s", id ? id : list[i]->d_name);
+		snprintf(active_inflight_path, sizeof(active_inflight_path), "%s", dst);
+
+		blob_buf_init(&dispatch_buf, 0);
+		{
+			json_object_object_foreach(env, k, v) {
+				if (k && *k && v && json_object_is_type(v, json_type_string))
+					blobmsg_add_string(&dispatch_buf, k, json_object_get_string(v));
+			}
+		}
+
+		json_object_put(rec);
+		hotplug_inject_with_done(dispatch_buf.head, on_record_complete);
+		break;
+	}
+
+	free_quarantine_keys(qkeys, qcount);
+	for (i = 0; i < n; i++)
+		free(list[i]);
+	free(list);
+}
+
+static void pending_dir_event(struct inotify_watch *w, struct inotify_event *ev)
+{
+	if (ev->mask & IN_IGNORED) {
+		pending_wd = -1;
+		return;
+	}
+	hotplug_queue_kick();
+}
+
+void hotplug_queue_kick(void)
+{
+	if (!queue_initialized || !queue_ubus_online || queue_stopping)
+		return;
+	uloop_timeout_set(&scan_timer, 0);
+}
+
+void hotplug_queue_init(void)
+{
+	if (hotplug_queue_init_dirs(HOTPLUG_QUEUE_DIR) < 0) {
+		ERROR("hotplug-queue: failed to initialize %s: %m\n", HOTPLUG_QUEUE_DIR);
+		return;
+	}
+	if (hotplug_queue_write_cap(HOTPLUG_QUEUE_DIR, getpid()) < 0) {
+		ERROR("hotplug-queue: failed to write receiver capability: %m\n");
+		return;
+	}
+
+	scan_timer.cb = scan_and_dispatch;
+	queue_initialized = true;
+	queue_stopping = false;
+	recover_inflight_on_start();
+}
+
+void hotplug_queue_ubus_ready(void)
+{
+	char pending_dir[PATH_MAX];
+
+	if (!queue_initialized)
+		return;
+
+	/* Attach watch BEFORE scanning backlog to cover the write-before-wakeup window. */
+	snprintf(pending_dir, sizeof(pending_dir), "%s/pending", HOTPLUG_QUEUE_DIR);
+	if (pending_wd == -1) {
+		if (inotify_watch_open(&pending_watch, pending_dir_event) == 0) {
+			pending_wd = inotify_watch_add(&pending_watch, pending_dir,
+						       IN_MOVED_TO | IN_CREATE | IN_ONLYDIR);
+		}
+		if (pending_wd == -1)
+			ERROR("hotplug-queue: failed to watch %s: %m\n", pending_dir);
+	}
+
+	queue_ubus_online = true;
+	hotplug_queue_kick();
+}
+
+void hotplug_queue_ubus_disconnected(void)
+{
+	queue_ubus_online = false;
+}
+
+void hotplug_queue_shutdown(void)
+{
+	queue_stopping = true;
+	uloop_timeout_cancel(&scan_timer);
+}
+
+int hotplug_queue_enqueue_legacy(struct blob_attr *env_table)
+{
+	enum hotplug_enqueue_rc rc;
+
+	if (!queue_initialized)
+		return -1;
+	rc = hotplug_queue_enqueue_blob(HOTPLUG_QUEUE_DIR, env_table, NULL, 0);
+	if (rc == HQ_ENQ_OK)
+		hotplug_queue_kick();
+	return (rc == HQ_ENQ_OK || rc == HQ_ENQ_DEDUP) ? 0 : -1;
+}
+
+int hotplug_queue_ubus_status(struct ubus_context *ctx, struct ubus_object *obj,
+			      struct ubus_request_data *req, const char *method,
+			      struct blob_attr *msg)
+{
+	char pending_dir[PATH_MAX], inflight_dir[PATH_MAX];
+	char quarantine_dir[PATH_MAX], corrupt_dir[PATH_MAX];
+	struct hotplug_queue_stats st;
+	struct hq_quarantine_key *qkeys = NULL;
+	size_t qkey_count = 0;
+	size_t pending_items = 0, pending_bytes = 0;
+	size_t inflight_items = 0, quarantine_items = 0, quarantine_bytes = 0;
+	size_t corrupt_items = 0, corrupt_bytes = 0;
+	size_t deferred_items = 0;
+	uint64_t oldest_age_ms = 0, now_ms = hotplug_queue_mono_ms();
+	struct dirent **list = NULL;
+	int n, i;
+	void *arr;
+
+	snprintf(pending_dir, sizeof(pending_dir), "%s/pending", HOTPLUG_QUEUE_DIR);
+	snprintf(inflight_dir, sizeof(inflight_dir), "%s/inflight", HOTPLUG_QUEUE_DIR);
+	snprintf(quarantine_dir, sizeof(quarantine_dir), "%s/quarantine", HOTPLUG_QUEUE_DIR);
+	snprintf(corrupt_dir, sizeof(corrupt_dir), "%s/corrupt", HOTPLUG_QUEUE_DIR);
+
+	hotplug_queue_read_stats(HOTPLUG_QUEUE_DIR, &st);
+	hotplug_queue_count_dir(pending_dir, &pending_items, &pending_bytes);
+	hotplug_queue_count_dir(inflight_dir, &inflight_items, NULL);
+	hotplug_queue_count_dir(quarantine_dir, &quarantine_items, &quarantine_bytes);
+	hotplug_queue_count_dir(corrupt_dir, &corrupt_items, &corrupt_bytes);
+
+	qkey_count = collect_quarantine_keys(&qkeys);
+
+	/* Compute oldest pending age and deferred count. */
+	n = scandir(pending_dir, &list, filter_json, alphasort);
+	for (i = 0; i < n; i++) {
+		char path[PATH_MAX];
+		struct json_object *rec;
+
+		snprintf(path, sizeof(path), "%s/%s", pending_dir, list[i]->d_name);
+		rec = load_record_file(path);
+		if (rec) {
+			uint64_t enq_ms = json_get_u64(rec, "enqueued_mono_ms");
+			const char *dk = json_get_str(rec, "device_key");
+
+			if (enq_ms > 0 && now_ms >= enq_ms) {
+				uint64_t age = now_ms - enq_ms;
+
+				if (age > oldest_age_ms)
+					oldest_age_ms = age;
+			}
+			if (device_is_quarantined(dk, qkeys, qkey_count))
+				deferred_items++;
+			json_object_put(rec);
+		}
+		free(list[i]);
+	}
+	free(list);
+
+	blob_buf_init(&status_buf, 0);
+	blobmsg_add_u32(&status_buf, "protocol_version", 1);
+	blobmsg_add_string(&status_buf, "mode", queue_initialized ? "queued" : "legacy");
+	blobmsg_add_u32(&status_buf, "pending", (uint32_t)pending_items);
+	blobmsg_add_u64(&status_buf, "pending_bytes", (uint64_t)pending_bytes);
+	blobmsg_add_u64(&status_buf, "oldest_pending_ms", oldest_age_ms);
+	blobmsg_add_u32(&status_buf, "inflight", (uint32_t)inflight_items);
+	blobmsg_add_u32(&status_buf, "deferred", (uint32_t)deferred_items);
+	blobmsg_add_u64(&status_buf, "dispatched", st.dispatched);
+	blobmsg_add_u32(&status_buf, "quarantined", (uint32_t)quarantine_items);
+	blobmsg_add_u64(&status_buf, "quarantined_bytes", (uint64_t)quarantine_bytes);
+	blobmsg_add_u64(&status_buf, "quarantined_total", st.quarantined_total);
+	blobmsg_add_u64(&status_buf, "expired", st.expired);
+	blobmsg_add_u64(&status_buf, "overflow", st.overflow);
+	blobmsg_add_u32(&status_buf, "corrupt", (uint32_t)corrupt_items);
+	blobmsg_add_u64(&status_buf, "corrupt_bytes", (uint64_t)corrupt_bytes);
+	blobmsg_add_u64(&status_buf, "corrupt_total", st.corrupt);
+	blobmsg_add_u64(&status_buf, "deduped", st.deduped);
+	blobmsg_add_u32(&status_buf, "max_items", HOTPLUG_QUEUE_MAX_ITEMS);
+	blobmsg_add_u64(&status_buf, "max_bytes", HOTPLUG_QUEUE_MAX_BYTES);
+
+	arr = blobmsg_open_array(&status_buf, "quarantine_records");
+	n = scandir(quarantine_dir, &list, filter_json, alphasort);
+	for (i = 0; i < n; i++) {
+		char path[PATH_MAX];
+		struct json_object *rec;
+
+		snprintf(path, sizeof(path), "%s/%s", quarantine_dir, list[i]->d_name);
+		rec = load_record_file(path);
+		if (rec) {
+			void *tbl = blobmsg_open_table(&status_buf, NULL);
+			const char *id = json_get_str(rec, "id");
+			const char *dk = json_get_str(rec, "device_key");
+			const char *stage = json_get_str(rec, "last_stage");
+			const char *reason = json_get_str(rec, "reason");
+			struct json_object *env = NULL;
+
+			blobmsg_add_string(&status_buf, "id", id ? id : list[i]->d_name);
+			if (dk)
+				blobmsg_add_string(&status_buf, "device_key", dk);
+			if (stage)
+				blobmsg_add_string(&status_buf, "last_stage", stage);
+			if (reason)
+				blobmsg_add_string(&status_buf, "reason", reason);
+			if (json_object_object_get_ex(rec, "env", &env)) {
+				const char *sub = json_get_str(env, "SUBSYSTEM");
+				const char *act = json_get_str(env, "ACTION");
+
+				if (sub)
+					blobmsg_add_string(&status_buf, "subsystem", sub);
+				if (act)
+					blobmsg_add_string(&status_buf, "action", act);
+			}
+			blobmsg_close_table(&status_buf, tbl);
+			json_object_put(rec);
+		}
+		free(list[i]);
+	}
+	free(list);
+	blobmsg_close_array(&status_buf, arr);
+
+	free_quarantine_keys(qkeys, qkey_count);
+	ubus_send_reply(ctx, req, status_buf.head);
+	return UBUS_STATUS_OK;
+}
+
+enum {
+	RESOLVE_ID,
+	RESOLVE_ACTION,
+	__RESOLVE_MAX
+};
+
+const struct blobmsg_policy hotplug_queue_resolve_policy[__RESOLVE_MAX] = {
+	[RESOLVE_ID] = { .name = "id", .type = BLOBMSG_TYPE_STRING },
+	[RESOLVE_ACTION] = { .name = "action", .type = BLOBMSG_TYPE_STRING },
+};
+
+int hotplug_queue_ubus_resolve(struct ubus_context *ctx, struct ubus_object *obj,
+			       struct ubus_request_data *req, const char *method,
+			       struct blob_attr *msg)
+{
+	struct blob_attr *tb[__RESOLVE_MAX];
+	const char *id, *action;
+	char qpath[PATH_MAX], ppath[PATH_MAX];
+	struct stat st;
+	int lock_fd, rc = UBUS_STATUS_OK;
+
+	blobmsg_parse(hotplug_queue_resolve_policy, __RESOLVE_MAX, tb,
+		      blobmsg_data(msg), blobmsg_data_len(msg));
+	if (!tb[RESOLVE_ID] || !tb[RESOLVE_ACTION])
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	id = blobmsg_get_string(tb[RESOLVE_ID]);
+	action = blobmsg_get_string(tb[RESOLVE_ACTION]);
+	if (!hotplug_queue_valid_id(id))
+		return UBUS_STATUS_INVALID_ARGUMENT;
+	if (strcmp(action, "discard") != 0 && strcmp(action, "retry") != 0)
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
+	snprintf(qpath, sizeof(qpath), "%s/quarantine/%s.json", HOTPLUG_QUEUE_DIR, id);
+	snprintf(ppath, sizeof(ppath), "%s/pending/%s.json", HOTPLUG_QUEUE_DIR, id);
+
+	lock_fd = hotplug_queue_lock(HOTPLUG_QUEUE_DIR);
+	if (lock_fd < 0)
+		return UBUS_STATUS_UNKNOWN_ERROR;
+
+	if (lstat(qpath, &st) < 0 || !S_ISREG(st.st_mode)) {
+		rc = UBUS_STATUS_NOT_FOUND;
+		goto out;
+	}
+
+	if (strcmp(action, "discard") == 0) {
+		if (unlink(qpath) < 0)
+			rc = UBUS_STATUS_UNKNOWN_ERROR;
+	} else {
+		struct json_object *rec = load_record_file(qpath);
+
+		if (!rec) {
+			rc = UBUS_STATUS_PARSE_ERROR;
+			goto out;
+		}
+		json_object_object_add(rec, "stage", json_object_new_string("pending"));
+		json_object_object_del(rec, "reason");
+		json_object_object_del(rec, "last_stage");
+		if (write_json_atomic_locked(ppath, rec) == 0)
+			unlink(qpath);
+		else
+			rc = UBUS_STATUS_UNKNOWN_ERROR;
+		json_object_put(rec);
+	}
+
+out:
+	hotplug_queue_unlock(lock_fd);
+	if (rc == UBUS_STATUS_OK)
+		hotplug_queue_kick();
+	return rc;
+}
