+struct hq_seen_entry {
+	char boot_id[40];
+	char seqnum[24];
+};
+
+struct hq_seen_ring {
+	uint32_t magic;
+	uint32_t head;
+	struct hq_seen_entry entries[HOTPLUG_SEEN_RING_SIZE];
+};
+
+#define HQ_SEEN_MAGIC 0x48515331U /* "HQS1" */
+
+static int write_all(int fd, const void *buf, size_t len)
+{
+	const char *p = buf;
+
+	while (len > 0) {
+		ssize_t n = write(fd, p, len);
+
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		p += (size_t)n;
+		len -= (size_t)n;
+	}
+	return 0;
+}
+
+static int write_file_atomic(const char *base_dir, const char *dest_path,
+			     const void *data, size_t len, mode_t mode)
+{
+	static unsigned int tmp_seq;
+	char tmp_path[PATH_MAX];
+	int fd;
+
+	if (snprintf(tmp_path, sizeof(tmp_path), "%s/tmp/.w-%ld-%" PRIu64 "-%u.tmp",
+		     base_dir, (long)getpid(), hotplug_queue_mono_ms(), ++tmp_seq) >= (int)sizeof(tmp_path))
+		return -1;
+
+	fd = open(tmp_path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, mode);
+	if (fd < 0)
+		return -1;
+
+	if (write_all(fd, data, len) < 0) {
+		close(fd);
+		unlink(tmp_path);
+		return -1;
+	}
+	if (close(fd) < 0) {
+		unlink(tmp_path);
+		return -1;
+	}
+	if (rename(tmp_path, dest_path) < 0) {
+		unlink(tmp_path);
+		return -1;
+	}
+	return 0;
+}
+
+static int ensure_private_dir(const char *path)
+{
+	struct stat st;
+
+	if (mkdir(path, 0700) < 0 && errno != EEXIST)
+		return -1;
+	if (lstat(path, &st) < 0)
+		return -1;
+	if (!S_ISDIR(st.st_mode))
+		return -1;
+	if (geteuid() == 0 && st.st_uid != 0)
+		return -1;
+	if ((st.st_mode & 07777) != 0700)
+		chmod(path, 0700);
+	return 0;
+}
+
+int hotplug_queue_read_boot_id(char *buf, size_t len)
+{
+	int fd;
+	ssize_t n;
+
+	if (!buf || len < 2)
+		return -1;
+
+	fd = open("/proc/sys/kernel/random/boot_id", O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, len - 1);
+	close(fd);
+	if (n <= 0)
+		return -1;
+	buf[n] = '\0';
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' '))
+		buf[--n] = '\0';
+	return n > 0 ? 0 : -1;
+}
+
+uint64_t hotplug_queue_mono_ms(void)
+{
+	struct timespec ts;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) < 0)
+		return 0;
+	return (uint64_t)ts.tv_sec * 1000ULL + (uint64_t)(ts.tv_nsec / 1000000L);
+}
+
+int hotplug_queue_init_dirs(const char *base_dir)
+{
+	static const char * const subdirs[] = {
+		"tmp", "pending", "inflight", "quarantine", "corrupt"
+	};
+	char path[PATH_MAX];
+	size_t i;
+
+	if (ensure_private_dir(base_dir) < 0)
+		return -1;
+
+	for (i = 0; i < sizeof(subdirs) / sizeof(subdirs[0]); i++) {
+		if (snprintf(path, sizeof(path), "%s/%s", base_dir, subdirs[i]) >= (int)sizeof(path))
+			return -1;
+		if (ensure_private_dir(path) < 0)
+			return -1;
+	}
+	return 0;
+}
+
+int hotplug_queue_write_cap(const char *base_dir, pid_t pid)
+{
+	char boot_id[64];
+	char content[256];
+	char cap_path[PATH_MAX];
+	int len;
+
+	if (hotplug_queue_read_boot_id(boot_id, sizeof(boot_id)) < 0)
+		return -1;
+
+	len = snprintf(content, sizeof(content),
+		       "version=1\nboot_id=%s\npid=%ld\n",
+		       boot_id, (long)pid);
+	if (len <= 0 || len >= (int)sizeof(content))
+		return -1;
+	if (snprintf(cap_path, sizeof(cap_path), "%s/receiver.cap", base_dir) >= (int)sizeof(cap_path))
+		return -1;
+
+	return write_file_atomic(base_dir, cap_path, content, (size_t)len, 0600);
+}
+
+bool hotplug_queue_receiver_active(const char *base_dir)
+{
+	struct stat st;
+	char cap_path[PATH_MAX];
+	char boot_id[64];
+	char buf[256];
+	char expected[96];
+	int fd;
+	ssize_t n;
+
+	if (lstat(base_dir, &st) < 0 || !S_ISDIR(st.st_mode))
+		return false;
+	if (geteuid() == 0 && st.st_uid != 0)
+		return false;
+
+	if (snprintf(cap_path, sizeof(cap_path), "%s/receiver.cap", base_dir) >= (int)sizeof(cap_path))
+		return false;
+	if (lstat(cap_path, &st) < 0 || !S_ISREG(st.st_mode))
+		return false;
+	if (geteuid() == 0 && st.st_uid != 0)
+		return false;
+
+	if (hotplug_queue_read_boot_id(boot_id, sizeof(boot_id)) < 0)
+		return false;
+
+	fd = open(cap_path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		return false;
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return false;
+	buf[n] = '\0';
+
+	if (!strstr(buf, "version=1\n"))
+		return false;
+	if (snprintf(expected, sizeof(expected), "boot_id=%s\n", boot_id) >= (int)sizeof(expected))
+		return false;
+	return strstr(buf, expected) != NULL;
+}
+
+int hotplug_queue_lock(const char *base_dir)
+{
+	char lock_path[PATH_MAX];
+	int fd;
+
+	if (snprintf(lock_path, sizeof(lock_path), "%s/.enqueue.lock", base_dir) >= (int)sizeof(lock_path))
+		return -1;
+	fd = open(lock_path, O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0)
+		return -1;
+	while (flock(fd, LOCK_EX) < 0) {
+		if (errno != EINTR) {
+			close(fd);
+			return -1;
+		}
+	}
+	return fd;
+}
+
+void hotplug_queue_unlock(int lock_fd)
+{
+	if (lock_fd >= 0) {
+		flock(lock_fd, LOCK_UN);
+		close(lock_fd);
+	}
+}
+
+int hotplug_queue_read_stats(const char *base_dir, struct hotplug_queue_stats *st)
+{
+	char path[PATH_MAX];
+	FILE *f;
+	char line[128];
+
+	memset(st, 0, sizeof(*st));
+	if (snprintf(path, sizeof(path), "%s/.stats", base_dir) >= (int)sizeof(path))
+		return -1;
+	f = fopen(path, "re");
+	if (!f)
+		return errno == ENOENT ? 0 : -1;
+
+	while (fgets(line, sizeof(line), f)) {
+		uint64_t val = 0;
+
+		if (sscanf(line, "next_seq=%" SCNu64, &val) == 1)
+			st->next_seq = val;
+		else if (sscanf(line, "dispatched=%" SCNu64, &val) == 1)
+			st->dispatched = val;
+		else if (sscanf(line, "quarantined_total=%" SCNu64, &val) == 1)
+			st->quarantined_total = val;
+		else if (sscanf(line, "expired=%" SCNu64, &val) == 1)
+			st->expired = val;
+		else if (sscanf(line, "overflow=%" SCNu64, &val) == 1)
+			st->overflow = val;
+		else if (sscanf(line, "corrupt=%" SCNu64, &val) == 1)
+			st->corrupt = val;
+		else if (sscanf(line, "deduped=%" SCNu64, &val) == 1)
+			st->deduped = val;
+		else if (sscanf(line, "last_overflow_log_ms=%" SCNu64, &val) == 1)
+			st->last_overflow_log_ms = val;
+	}
+	fclose(f);
+	return 0;
+}
+
+int hotplug_queue_write_stats(const char *base_dir, const struct hotplug_queue_stats *st)
+{
+	char path[PATH_MAX];
+	char buf[512];
+	int len;
+
+	if (snprintf(path, sizeof(path), "%s/.stats", base_dir) >= (int)sizeof(path))
+		return -1;
+	len = snprintf(buf, sizeof(buf),
+		       "next_seq=%" PRIu64 "\n"
+		       "dispatched=%" PRIu64 "\n"
+		       "quarantined_total=%" PRIu64 "\n"
+		       "expired=%" PRIu64 "\n"
+		       "overflow=%" PRIu64 "\n"
+		       "corrupt=%" PRIu64 "\n"
+		       "deduped=%" PRIu64 "\n"
+		       "last_overflow_log_ms=%" PRIu64 "\n",
+		       st->next_seq, st->dispatched, st->quarantined_total,
+		       st->expired, st->overflow, st->corrupt, st->deduped,
+		       st->last_overflow_log_ms);
+	if (len <= 0 || len >= (int)sizeof(buf))
+		return -1;
+	return write_file_atomic(base_dir, path, buf, (size_t)len, 0600);
+}
+
+static bool has_json_suffix(const char *name)
+{
+	size_t len = strlen(name);
+
+	return len > 5 && strcmp(name + len - 5, ".json") == 0;
+}
+
+int hotplug_queue_count_dir(const char *dir_path, size_t *count_out, size_t *bytes_out)
+{
+	DIR *dir;
+	struct dirent *de;
+	size_t count = 0, bytes = 0;
+
+	dir = opendir(dir_path);
+	if (!dir)
+		return -1;
+
+	while ((de = readdir(dir))) {
+		struct stat st;
+
+		if (de->d_name[0] == '.' || !has_json_suffix(de->d_name))
+			continue;
+		if (fstatat(dirfd(dir), de->d_name, &st, AT_SYMLINK_NOFOLLOW) < 0)
+			continue;
+		if (!S_ISREG(st.st_mode))
+			continue;
+		count++;
+		if (st.st_size > 0)
+			bytes += (size_t)st.st_size;
+	}
+	closedir(dir);
+
+	if (count_out)
+		*count_out = count;
+	if (bytes_out)
+		*bytes_out = bytes;
+	return 0;
+}
+
+static int filter_json_dirent(const struct dirent *de)
+{
+	return de->d_name[0] != '.' && has_json_suffix(de->d_name);
+}
+
+int hotplug_queue_prune_dir(const char *dir_path, size_t max_items, size_t max_bytes)
+{
+	struct dirent **list = NULL;
+	int n, i;
+	size_t total_items = 0, total_bytes = 0;
+	size_t *sizes = NULL;
+	char full[PATH_MAX];
+
+	n = scandir(dir_path, &list, filter_json_dirent, alphasort);
+	if (n <= 0) {
+		free(list);
+		return 0;
+	}
+
+	sizes = calloc((size_t)n, sizeof(*sizes));
+	if (!sizes) {
+		for (i = 0; i < n; i++)
+			free(list[i]);
+		free(list);
+		return -1;
+	}
+
+	for (i = 0; i < n; i++) {
+		struct stat st;
+
+		if (snprintf(full, sizeof(full), "%s/%s", dir_path, list[i]->d_name) < (int)sizeof(full) &&
+		    lstat(full, &st) == 0 && S_ISREG(st.st_mode)) {
+			total_items++;
+			if (st.st_size > 0) {
+				sizes[i] = (size_t)st.st_size;
+				total_bytes += sizes[i];
+			}
+		}
+	}
+
+	for (i = 0; i < n && (total_items > max_items || total_bytes > max_bytes); i++) {
+		if (snprintf(full, sizeof(full), "%s/%s", dir_path, list[i]->d_name) < (int)sizeof(full)) {
+			if (unlink(full) == 0) {
+				if (total_items > 0)
+					total_items--;
+				if (total_bytes >= sizes[i])
+					total_bytes -= sizes[i];
+				else
+					total_bytes = 0;
+			}
+		}
+	}
+
+	free(sizes);
+	for (i = 0; i < n; i++)
+		free(list[i]);
+	free(list);
+	return 0;
+}
+
+static int seen_ring_check_and_add(const char *base_dir, const char *boot_id, const char *seqnum)
+{
+	char path[PATH_MAX];
+	struct hq_seen_ring *ring;
+	int fd;
+	ssize_t n;
+	uint32_t i;
+	bool found = false;
+
+	if (!boot_id || !*boot_id || !seqnum || !*seqnum)
+		return 0;
+	if (snprintf(path, sizeof(path), "%s/.seen-seq", base_dir) >= (int)sizeof(path))
+		return -1;
+
+	ring = calloc(1, sizeof(*ring));
+	if (!ring)
+		return -1;
+
+	fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+	if (fd < 0) {
+		free(ring);
+		return -1;
+	}
+
+	n = read(fd, ring, sizeof(*ring));
+	if (n != (ssize_t)sizeof(*ring) || ring->magic != HQ_SEEN_MAGIC) {
+		memset(ring, 0, sizeof(*ring));
+		ring->magic = HQ_SEEN_MAGIC;
+		ring->head = 0;
+	} else {
+		for (i = 0; i < HOTPLUG_SEEN_RING_SIZE; i++) {
+			if (!ring->entries[i].seqnum[0])
+				continue;
+			if (strcmp(ring->entries[i].seqnum, seqnum) == 0 &&
+			    strcmp(ring->entries[i].boot_id, boot_id) == 0) {
+				found = true;
+				break;
+			}
+		}
+	}
+
+	if (!found) {
+		uint32_t idx = ring->head % HOTPLUG_SEEN_RING_SIZE;
+
+		snprintf(ring->entries[idx].boot_id, sizeof(ring->entries[idx].boot_id), "%s", boot_id);
+		snprintf(ring->entries[idx].seqnum, sizeof(ring->entries[idx].seqnum), "%s", seqnum);
+		ring->head = (idx + 1) % HOTPLUG_SEEN_RING_SIZE;
+		if (lseek(fd, 0, SEEK_SET) == 0)
+			(void)write_all(fd, ring, sizeof(*ring));
+	}
+
+	close(fd);
+	free(ring);
+	return found ? 1 : 0;
+}
+
+static int read_sysfs_line(const char *path, char *buf, size_t len)
+{
+	int fd;
+	ssize_t n;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, len - 1);
+	close(fd);
+	if (n <= 0)
+		return -1;
+	buf[n] = '\0';
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' '))
+		buf[--n] = '\0';
+	return n > 0 ? 0 : -1;
+}
+
+static enum hotplug_enqueue_rc enqueue_json_env(const char *base_dir,
+						struct json_object *env_obj,
+						char *id_out,
+						size_t id_out_len)
+{
+	struct json_object *rec = NULL, *tmp_obj = NULL;
+	const char *subsystem = NULL, *devpath = NULL, *devname = NULL;
+	const char *seqnum = NULL, *firmware = NULL, *diskseq = NULL, *timeout_s = NULL;
+	char boot_id[64] = "";
+	char device_key[PATH_MAX];
+	char diskseq_buf[64] = "";
+	char pending_dir[PATH_MAX], dest_path[PATH_MAX];
+	char id_buf[32];
+	uint64_t now_ms = hotplug_queue_mono_ms();
+	uint64_t now_real = (uint64_t)time(NULL);
+	uint64_t fw_ttl_s = HOTPLUG_FW_DEFAULT_TTL_S;
+	uint64_t fw_dev = 0, fw_ino = 0;
+	const char *json_str;
+	size_t json_len, cur_items = 0, cur_bytes = 0;
+	struct hotplug_queue_stats st;
+	int lock_fd = -1;
+	enum hotplug_enqueue_rc rc = HQ_ENQ_ERR;
+
+	if (hotplug_queue_read_boot_id(boot_id, sizeof(boot_id)) < 0)
+		snprintf(boot_id, sizeof(boot_id), "unknown");
+
+	if (json_object_object_get_ex(env_obj, "SUBSYSTEM", &tmp_obj))
+		subsystem = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "DEVPATH", &tmp_obj))
+		devpath = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "DEVNAME", &tmp_obj))
+		devname = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "SEQNUM", &tmp_obj))
+		seqnum = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "FIRMWARE", &tmp_obj))
+		firmware = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "DISKSEQ", &tmp_obj))
+		diskseq = json_object_get_string(tmp_obj);
+	if (json_object_object_get_ex(env_obj, "TIMEOUT", &tmp_obj))
+		timeout_s = json_object_get_string(tmp_obj);
+
+	if (devpath && *devpath)
+		snprintf(device_key, sizeof(device_key), "%s", devpath);
+	else if (subsystem && *subsystem && devname && *devname)
+		snprintf(device_key, sizeof(device_key), "%s:%s", subsystem, devname);
+	else if (subsystem && *subsystem)
+		snprintf(device_key, sizeof(device_key), "%s", subsystem);
+	else
+		snprintf(device_key, sizeof(device_key), "unknown");
+
+	if ((!diskseq || !*diskseq) && subsystem && strcmp(subsystem, "block") == 0 &&
+	    devpath && *devpath && strstr(devpath, "..") == NULL) {
+		char sys_ds[PATH_MAX];
+
+		if (snprintf(sys_ds, sizeof(sys_ds), "/sys/%s/diskseq", devpath) < (int)sizeof(sys_ds) &&
+		    read_sysfs_line(sys_ds, diskseq_buf, sizeof(diskseq_buf)) == 0)
+			diskseq = diskseq_buf;
+	}
+
+	if (firmware && *firmware) {
+		if (timeout_s && *timeout_s) {
+			unsigned long parsed = strtoul(timeout_s, NULL, 10);
+
+			if (parsed >= 1 && parsed <= 300)
+				fw_ttl_s = parsed;
+		}
+		if (devpath && *devpath && strstr(devpath, "..") == NULL) {
+			char sys_fw[PATH_MAX];
+			struct stat fst;
+
+			if (snprintf(sys_fw, sizeof(sys_fw), "/sys/%s/loading", devpath) < (int)sizeof(sys_fw) &&
+			    stat(sys_fw, &fst) == 0) {
+				fw_dev = (uint64_t)fst.st_dev;
+				fw_ino = (uint64_t)fst.st_ino;
+			} else if (snprintf(sys_fw, sizeof(sys_fw), "/sys/%s", devpath) < (int)sizeof(sys_fw) &&
+				   stat(sys_fw, &fst) == 0) {
+				fw_dev = (uint64_t)fst.st_dev;
+				fw_ino = (uint64_t)fst.st_ino;
+			}
+		}
+	}
+
+	lock_fd = hotplug_queue_lock(base_dir);
+	if (lock_fd < 0)
+		return HQ_ENQ_ERR;
+
+	if (hotplug_queue_read_stats(base_dir, &st) < 0)
+		goto out;
+
+	if (seqnum && *seqnum) {
+		int seen = seen_ring_check_and_add(base_dir, boot_id, seqnum);
+
+		if (seen > 0) {
+			st.deduped++;
+			hotplug_queue_write_stats(base_dir, &st);
+			rc = HQ_ENQ_DEDUP;
+			goto out;
+		}
+	}
+
+	rec = json_object_new_object();
+	if (!rec)
+		goto out;
+
+	st.next_seq++;
+	snprintf(id_buf, sizeof(id_buf), "%016" PRIu64, st.next_seq);
+
+	json_object_object_add(rec, "version", json_object_new_int(1));
+	json_object_object_add(rec, "id", json_object_new_string(id_buf));
+	json_object_object_add(rec, "seq", json_object_new_int64((int64_t)st.next_seq));
+	json_object_object_add(rec, "boot_id", json_object_new_string(boot_id));
+	if (seqnum && *seqnum)
+		json_object_object_add(rec, "kernel_seqnum", json_object_new_string(seqnum));
+	json_object_object_add(rec, "enqueued_mono_ms", json_object_new_int64((int64_t)now_ms));
+	json_object_object_add(rec, "enqueued_real_s", json_object_new_int64((int64_t)now_real));
+	json_object_object_add(rec, "device_key", json_object_new_string(device_key));
+	if (diskseq && *diskseq)
+		json_object_object_add(rec, "diskseq", json_object_new_string(diskseq));
+	if (firmware && *firmware) {
+		json_object_object_add(rec, "fw_ttl_s", json_object_new_int64((int64_t)fw_ttl_s));
+		json_object_object_add(rec, "fw_sysfs_dev", json_object_new_int64((int64_t)fw_dev));
+		json_object_object_add(rec, "fw_sysfs_ino", json_object_new_int64((int64_t)fw_ino));
+	}
+	json_object_object_add(rec, "stage", json_object_new_string("pending"));
+	json_object_get(env_obj);
+	json_object_object_add(rec, "env", env_obj);
+
+	json_str = json_object_to_json_string_ext(rec, JSON_C_TO_STRING_PLAIN);
+	if (!json_str)
+		goto out;
+	json_len = strlen(json_str);
+	if (json_len > HOTPLUG_RECORD_MAX_BYTES)
+		goto out;
+
+	if (snprintf(pending_dir, sizeof(pending_dir), "%s/pending", base_dir) >= (int)sizeof(pending_dir))
+		goto out;
+	if (hotplug_queue_count_dir(pending_dir, &cur_items, &cur_bytes) < 0)
+		goto out;
+
+	if (cur_items >= HOTPLUG_QUEUE_MAX_ITEMS ||
+	    cur_bytes + json_len > HOTPLUG_QUEUE_MAX_BYTES) {
+		st.next_seq--;
+		st.overflow++;
+		if (st.last_overflow_log_ms == 0 ||
+		    now_ms - st.last_overflow_log_ms >= HOTPLUG_OVERFLOW_LOG_MS) {
+			st.last_overflow_log_ms = now_ms;
+			syslog(LOG_WARNING,
+			       "openwrt-hotplug queue full (items=%zu bytes=%zu overflow=%" PRIu64 "); rejecting %s",
+			       cur_items, cur_bytes, st.overflow, device_key);
+			fprintf(stderr,
+				"openwrt-udev-forward: hotplug queue full (items=%zu bytes=%zu); rejecting %s\n",
+				cur_items, cur_bytes, device_key);
+		}
+		hotplug_queue_write_stats(base_dir, &st);
+		rc = HQ_ENQ_OVERFLOW;
+		goto out;
+	}
+
+	if (snprintf(dest_path, sizeof(dest_path), "%s/pending/%s.json", base_dir, id_buf) >= (int)sizeof(dest_path))
+		goto out;
+	if (write_file_atomic(base_dir, dest_path, json_str, json_len, 0600) < 0)
+		goto out;
+
+	hotplug_queue_write_stats(base_dir, &st);
+	if (id_out && id_out_len > 0)
+		snprintf(id_out, id_out_len, "%s", id_buf);
+	rc = HQ_ENQ_OK;
+
+out:
+	if (rec)
+		json_object_put(rec);
+	hotplug_queue_unlock(lock_fd);
+	return rc;
+}
+
+enum hotplug_enqueue_rc hotplug_queue_enqueue_envp(const char *base_dir,
+						   char * const *envp,
+						   char *id_out,
+						   size_t id_out_len)
+{
+	struct json_object *env_obj;
+	char * const *e;
+	size_t approx = 0;
+	enum hotplug_enqueue_rc rc;
+
+	env_obj = json_object_new_object();
+	if (!env_obj)
+		return HQ_ENQ_ERR;
+
+	for (e = envp; e && *e; e++) {
+		const char *sep = strchr(*e, '=');
+		size_t klen, vlen;
+		char key[256];
+
+		if (!sep || sep == *e)
+			continue;
+		klen = (size_t)(sep - *e);
+		if (klen >= sizeof(key))
+			continue;
+		vlen = strlen(sep + 1);
+		if (vlen > HOTPLUG_VAL_MAX_BYTES)
+			vlen = HOTPLUG_VAL_MAX_BYTES;
+		if (approx + klen + vlen + 8 > HOTPLUG_RECORD_MAX_BYTES - 2048)
+			break;
+		memcpy(key, *e, klen);
+		key[klen] = '\0';
+		json_object_object_add(env_obj, key, json_object_new_string_len(sep + 1, (int)vlen));
+		approx += klen + vlen + 8;
+	}
+
+	rc = enqueue_json_env(base_dir, env_obj, id_out, id_out_len);
+	json_object_put(env_obj);
+	return rc;
+}
+
+enum hotplug_enqueue_rc hotplug_queue_enqueue_blob(const char *base_dir,
+						   struct blob_attr *env_table,
+						   char *id_out,
+						   size_t id_out_len)
+{
+	struct json_object *env_obj;
+	struct blob_attr *cur;
+	int rem;
+	size_t approx = 0;
+	enum hotplug_enqueue_rc rc;
+
+	env_obj = json_object_new_object();
+	if (!env_obj)
+		return HQ_ENQ_ERR;
+
+	blobmsg_for_each_attr(cur, env_table, rem) {
+		const char *k, *v;
+		size_t klen, vlen;
+
+		if (blobmsg_type(cur) != BLOBMSG_TYPE_STRING)
+			continue;
+		k = blobmsg_name(cur);
+		v = blobmsg_get_string(cur);
+		if (!k || !*k || !v)
+			continue;
+		klen = strlen(k);
+		vlen = strlen(v);
+		if (klen >= 256)
+			continue;
+		if (vlen > HOTPLUG_VAL_MAX_BYTES)
+			vlen = HOTPLUG_VAL_MAX_BYTES;
+		if (approx + klen + vlen + 8 > HOTPLUG_RECORD_MAX_BYTES - 2048)
+			break;
+		json_object_object_add(env_obj, k, json_object_new_string_len(v, (int)vlen));
+		approx += klen + vlen + 8;
+	}
+
+	rc = enqueue_json_env(base_dir, env_obj, id_out, id_out_len);
+	json_object_put(env_obj);
+	return rc;
+}
+
+bool hotplug_queue_valid_id(const char *id)
+{
+	const char *p;
+
+	if (!id || !*id || strlen(id) > 64)
+		return false;
+	for (p = id; *p; p++) {
+		if (!((*p >= '0' && *p <= '9') ||
+		      (*p >= 'a' && *p <= 'z') ||
+		      (*p >= 'A' && *p <= 'Z') ||
+		      *p == '_' || *p == '-'))
+			return false;
+	}
+	return true;
+}
